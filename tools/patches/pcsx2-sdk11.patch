diff --git a/cmake/FindWebP.cmake b/cmake/FindWebP.cmake
index 688419eb8..1cc85fc25 100644
--- a/cmake/FindWebP.cmake
+++ b/cmake/FindWebP.cmake
@@ -143,6 +143,12 @@ if (WebP_LIBRARY AND NOT TARGET WebP::libwebp)
         INTERFACE_COMPILE_OPTIONS "${WebP_COMPILE_OPTIONS}"
         INTERFACE_INCLUDE_DIRECTORIES "${WebP_INCLUDE_DIR}"
     )
+    # The source-built static libwebp archive calls libsharpyuv symbols, but
+    # PCSX2's FindWebP module predates that split and does not add the archive.
+    find_library(WebP_SHARPYUV_LIBRARY NAMES sharpyuv HINTS ${PC_WEBP_LIBDIR} ${PC_WEBP_LIBRARY_DIRS})
+    if(WebP_SHARPYUV_LIBRARY)
+        set_property(TARGET WebP::libwebp APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${WebP_SHARPYUV_LIBRARY}")
+    endif()
 endif ()
 
 if (WebP_DEMUX_LIBRARY AND NOT TARGET WebP::demux)
diff --git a/pcsx2/CMakeLists.txt b/pcsx2/CMakeLists.txt
index 4652ff99f..aeb1ddf51 100644
--- a/pcsx2/CMakeLists.txt
+++ b/pcsx2/CMakeLists.txt
@@ -9,6 +9,15 @@ else()
 endif()
 target_link_libraries(PCSX2 PRIVATE PCSX2_FLAGS)
 
+# Clang 19 emits __isPlatformVersionAtLeast for @available checks. The local
+# macOS 11 SDK does not provide compiler-rt builtins, so link this compiler-rt
+# implementation into the isolated bridge build.
+if(APPLE AND PCSX2_COMPILER_RT_OS_VERSION_CHECK_SOURCE)
+	add_library(PCSX2_COMPILER_RT_VERSION_CHECK OBJECT "${PCSX2_COMPILER_RT_OS_VERSION_CHECK_SOURCE}")
+	set_target_properties(PCSX2_COMPILER_RT_VERSION_CHECK PROPERTIES POSITION_INDEPENDENT_CODE ON)
+	target_sources(PCSX2 PRIVATE $<TARGET_OBJECTS:PCSX2_COMPILER_RT_VERSION_CHECK>)
+endif()
+
 target_compile_features(PCSX2_FLAGS INTERFACE cxx_std_17)
 target_compile_definitions(PCSX2_FLAGS INTERFACE "${PCSX2_DEFS}")
 target_compile_options(PCSX2_FLAGS INTERFACE "${PCSX2_WARNINGS}")
diff --git a/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm b/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm
index 2257b2270..39edfaea1 100644
--- a/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm
+++ b/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm
@@ -198,9 +198,14 @@ static DetectionResult detectIntelGPU(id<MTLDevice> dev, id<MTLLibrary> lib)
 	else if ([name containsString:@"AMD"])
 	{
 		// RDNA+ seems to work fine with depth feedback
+		// The Metal 3 family enum was added after the macOS 11 SDK. Keep this
+		// optimization disabled when building with an older SDK; the runtime
+		// feature test remains enabled for SDKs that declare the family.
+#if __MAC_OS_X_VERSION_MAX_ALLOWED >= 130000
 		if (@available(macOS 13, iOS 16, *))
 			if ([dev supportsFamily:MTLGPUFamilyMetal3])
 				features.depth_feedback = true;
+#endif
 		// ROV doesn't work on AMD GPUs with no render target
 		// Ideally the driver would insert a dummy texture for us (it does on Linux) but the Metal driver doesn't.
 		features.rov_requires_rt = true;
