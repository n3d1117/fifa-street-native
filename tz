import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def resolve_root():
    """Repo root with the on-disk case of every path component.

    os.path.realpath keeps whatever case the caller typed on a case-insensitive
    volume; F_GETPATH asks the kernel for the canonical spelling, which is what
    clang compares #include paths against (-Wnonportable-include-path).
    """
    root = Path(os.path.realpath(__file__)).parent
    try:
        import fcntl
        fd = os.open(root, os.O_RDONLY)
        try:
            return Path(fcntl.fcntl(fd, fcntl.F_GETPATH, b"\0" * 1024).split(b"\0")[0].decode())
        finally:
            os.close(fd)
    except (OSError, AttributeError):
        return root


ROOT = resolve_root()
os.chdir(ROOT)
os.environ["PWD"] = str(ROOT)  # cmake and ninja take the source dir from $PWD, not getcwd()
os.environ["TARZAN_ROOT"] = str(ROOT)
CMAKE = ROOT / "tools/build/cmake-3.31.12/CMake.app/Contents/bin/cmake"
CTEST = CMAKE.with_name("ctest")
ELF = ROOT / "extracted/disc/SLES_503.50"
GEN_CONFIG = ROOT / "config/SLES-50350.symbolmap-entry.toml"
RECOMP_BIN = ROOT / "build/game-metal/ps2recomp/ps2xRecomp/ps2_recomp"
STAMP = ROOT / "build/generate.stamp"
ERROR_RE = re.compile(r"error:|\bFAILED\b|\*\*\*Failed|Traceback|fatal error|^FAIL|failed:|Errors? while running", re.I)


class Missing(Exception):
    """Missing prerequisite -> exit 2."""


class Failed(Exception):
    """Check failed -> exit 1."""


class Run:
    """One tz command: owns the log, the summary and build/last-run.json."""

    def __init__(self, name, verbose):
        self.name, self.verbose = name, verbose
        self.start = time.monotonic()
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        self.log_path = ROOT / "build/logs" / f"{name}-{stamp}.log"
        self.log_path.parent.mkdir(parents=True, exist_ok=True)
        self.log = self.log_path.open("w")
        self.failed = []
        self.notes = []
        self.shown_log = None   # log path to print instead of the command log
        self.context = True

    def say(self, text):
        self.log.write(text + "\n")
        self.log.flush()
        if self.verbose:
            print(text, flush=True)

    def sh(self, cmd, **kw):
        """Run cmd, teeing output to the log; returns exit code."""
        self.say("$ " + " ".join(str(c) for c in cmd))
        proc = subprocess.Popen([str(c) for c in cmd], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, errors="replace", **kw)
        for line in proc.stdout:
            self.log.write(line)
            if self.verbose:
                sys.stdout.write(line)
        proc.wait()
        self.log.flush()
        return proc.returncode

    def must(self, cmd, label=None, **kw):
        rc = self.sh(cmd, **kw)
        if rc == 2 and "tools/disc.py" in " ".join(str(c) for c in cmd):
            raise Missing(self.last_message() or "missing prerequisite")
        if rc != 0:
            self.failed.append(label or str(cmd[0]).split("/")[-1])
            raise Failed(f"{label or cmd[0]} exited {rc}")

    def last_message(self):
        lines = self.log_path.read_text(errors="replace").strip().splitlines()
        return lines[-1] if lines else ""

    def finish(self, code, message=None):
        elapsed = time.monotonic() - self.start
        self.log.close()
        sha = subprocess.run(["git", "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
        record = {"cmd": self.name, "exit": code, "duration_s": round(elapsed, 1), "failed": self.failed,
                  "log": str(self.log_path.relative_to(ROOT)), "git_sha": sha}
        tmp = ROOT / "build/last-run.json.tmp"
        tmp.write_text(json.dumps(record, indent=2) + "\n")
        os.replace(tmp, ROOT / "build/last-run.json")
        word = "PASS" if code == 0 else "FAIL" if code == 1 else "MISSING"
        print(f"{word} {self.name} {elapsed:.1f}s" + (f" - {message}" if message else ""))
        for note in self.notes:
            print(note)
        if code == 1 and not self.verbose and self.context:
            self.print_context()
        print(f"log: {(self.shown_log or self.log_path).relative_to(ROOT)}")
        return code

    def print_context(self):
        lines = self.log_path.read_text(errors="replace").splitlines()
        for i, line in enumerate(lines):
            if ERROR_RE.search(line):
                for out in lines[max(0, i - 3):i + 17]:
                    print("  " + out[:200])
                return
        for out in lines[-20:]:
            print("  " + out[:200])


def require(path, fix):
    if not Path(path).exists():
        raise Missing(f"{Path(path).relative_to(ROOT)} missing -> {fix}")


def tool_python():
    venv = ROOT / "tools/python/bin/python"
    return str(venv) if venv.exists() else sys.executable


def cmake():
    require(CMAKE, "./tz setup")
    return str(CMAKE)


def configured(preset, build_dir):
    return (ROOT / build_dir / "CMakeCache.txt").is_file()


BUILD_TREES = ["build/game-metal"]
LEGACY_TREES = ["build/tests", "build/recompiler", "build/_deps"]  # pre-5c separate trees


def stale_trees():
    """Build trees whose cached source dir is not exactly ROOT (case-sensitive)."""
    stale = []
    for tree in BUILD_TREES:
        cache = ROOT / tree / "CMakeCache.txt"
        if not cache.is_file():
            continue
        for line in cache.read_text(errors="replace").splitlines():
            if line.startswith("CMAKE_HOME_DIRECTORY"):
                if line.split("=", 1)[1] != str(ROOT):
                    stale.append(tree)
                break
    return stale


def check_trees(run, reconfigure):
    for tree in LEGACY_TREES:
        if (ROOT / tree).exists():
            run.say(f"removing obsolete build tree {tree}")
            shutil.rmtree(ROOT / tree)
    stale = stale_trees()
    if not stale:
        return
    if not reconfigure:
        raise Missing(f"{', '.join(stale)} configured from a different path than {ROOT} "
                      "(case-sensitive) -> ./tz build --reconfigure")
    for tree in stale:
        run.say(f"reconfigure: wiping {tree}")
        shutil.rmtree(ROOT / tree)


def game_configured():
    """True when the cached configure saw the generated game sources."""
    cache = ROOT / "build/game-metal/CMakeCache.txt"
    return cache.is_file() and "TARZAN_GAME_CONFIGURED:INTERNAL=ON" in cache.read_text(errors="replace")


def cmake_build(run, preset, build_dir="build/game-metal", reconfigure=False):
    if reconfigure or not configured(preset, build_dir):
        run.must([cmake(), "--preset", "release"], "configure")
    sys.path.insert(0, str(ROOT / "tools"))
    import jobs
    run.must([cmake(), "--build", "--preset", preset, "--parallel", jobs.jobs()], f"build {preset}")


def sha256(path, h=None):
    h = h or hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h


def generate_inputs_hash():
    h = hashlib.sha256()
    for p in (ELF, ROOT / "config/SLES-50350.template.toml", GEN_CONFIG, ROOT / "config/SLES-50350.symbols-entry.csv",
              RECOMP_BIN, ROOT / "tools/generate.py"):
        h.update(p.name.encode())
        sha256(p, h)
    return h.hexdigest()


def run_command(name, args, body):
    run = Run(name, args.verbose)
    try:
        message = body(run)
        return run.finish(0, message)
    except Missing as e:
        print(f"MISSING {name}: {e}")
        run.log.close()
        return 2
    except Failed as e:
        return run.finish(1, str(e))


# ---- commands ---------------------------------------------------------------

def cmd_deps(args):
    sub = args.sub or "status"
    py = sys.executable
    run = Run("deps", args.verbose)
    rc = run.sh([py, "tools/deps.py", sub])
    out = run.log_path.read_text()
    run.log.close()
    print(out.split("\n", 1)[1].rstrip() if "\n" in out else out.rstrip())
    return rc if rc in (0, 2) else 1


def cmd_setup(args):
    def body(run):
        run.must([sys.executable, "tools/deps.py", "sync"], "deps sync")
        # Bootstrap first: it fetches the pinned CMake/Ninja that building capstone from sdist needs.
        run.must(["bash", "toolchain/bootstrap.sh"], "toolchain bootstrap")
        py = tool_python()
        probe = subprocess.run([py, "-c", "import pycdlib, capstone, elftools"], capture_output=True)
        if probe.returncode != 0:
            if not (ROOT / "tools/python/bin/python").exists():
                run.must([sys.executable, "-m", "venv", "tools/python"], "venv")
            env = dict(os.environ, PATH=f"{CMAKE.parent}{os.pathsep}{os.environ.get('PATH', '')}")
            run.must(["tools/python/bin/pip", "install", "-r", "requirements.txt"], "pip install", env=env)
        run.must(["bash", "tools/build-deps.sh"], "build-deps")
        run.must(["git", "config", "core.hooksPath", ".githooks"], "enable pre-commit hook")
        return "toolchain and dependencies ready; next: ./tz disc <iso>"
    return run_command("setup", args, body)


def cmd_disc(args):
    def body(run):
        if not args.iso:
            raise Missing("usage: ./tz disc <path-to-your-iso> (bring your own disc)")
        cmd = [tool_python(), "tools/disc.py", args.iso]
        if args.dest:
            cmd += ["--dest", args.dest, "--report", str(Path(args.dest) / "disc-inventory.json")]
        run.must(cmd, "disc")
        last = run.last_message()
        return last if last.startswith(("disc up to date", "--dest")) else "disc verified, extracted and configured"
    return run_command("disc", args, body)


# Out-of-tree dependency products: stamp inputs are git tree hashes of the relevant subpaths
# (plus the HEAD diff for uncommitted edits), so unrelated commits do not trigger rebuilds.
DEP_PRODUCTS = {
    "bridge": (["build/metal-bridge/pcsx2/pcsx2-gs-bridge/librrv-pcsx2-gs-bridge.dylib"],
               [("pcsx2", None), ("fukami", "tools/pcsx2-gs-bridge")]),
    "spu2": (["build/spu2-backend/librrv_pcsx2_spu2.a"],
             [("fukami", "tools/pcsx2-spu2"), ("pcsx2", "pcsx2/SPU2"), ("pcsx2", "3rdparty/soundtouch")]),
}


def dep_inputs_hash(sources):
    h = hashlib.sha256()
    for dep, sub in sources:
        base = ["git", "-C", f"deps/{dep}"]
        spec = [] if sub is None else ["--", sub]
        rev = f"HEAD:{sub}" if sub else "HEAD"
        h.update(subprocess.run(base + ["rev-parse", rev], capture_output=True, text=True).stdout.encode())
        h.update(subprocess.run(base + ["diff", "HEAD", *spec], capture_output=True).stdout)
    return h.hexdigest()


def rebuild_stale_deps(run):
    stale = []
    for name, (outputs, sources) in DEP_PRODUCTS.items():
        stamp = ROOT / f"build/deps-{name}.stamp"
        want = dep_inputs_hash(sources)
        have = stamp.read_text().strip() if stamp.is_file() else ""
        if want != have or not all((ROOT / o).exists() for o in outputs):
            stale.append((name, stamp, want))
    for name, stamp, want in stale:
        run.say(f"dependency {name} inputs changed: rebuilding")
        run.must(["bash", "tools/build-deps.sh"], f"build-deps {name}", env=dict(os.environ, TARZAN_FORCE=name))
        stamp.write_text(want + "\n")
    return [n for n, _, _ in stale]


def cmd_build(args):
    def body(run):
        require(ELF, "./tz disc <iso>")
        require(GEN_CONFIG, "./tz disc <iso>")
        check_trees(run, args.reconfigure)
        rebuilt = rebuild_stale_deps(run)
        cmake_build(run, "recompiler")
        want = generate_inputs_hash()
        have = STAMP.read_text().strip() if STAMP.is_file() else ""
        gen_dir = ROOT / "generated/SLES-50350-symbolmap-entry"
        note = "generated code current"
        if want != have or not gen_dir.is_dir():
            run.must([tool_python(), "tools/generate.py"], "generate")
            tmp = STAMP.with_suffix(".tmp")
            tmp.write_text(want + "\n")
            os.replace(tmp, STAMP)
            note = "regenerated; " + run.last_message()
        cmake_build(run, "release", reconfigure=not game_configured())
        return note + (f"; rebuilt deps: {', '.join(rebuilt)}" if rebuilt else "")
    return run_command("build", args, body)


def parse_replay(text):
    m = re.search(r"runs=(\d+) mismatch\(full\)=(\d+) mismatch\(fast\)=(\d+).*?skipped=(\d+)", text)
    r = re.search(r"native-rejected=(\d+)", text)
    if not m or not r:
        return None
    return int(m[1]), int(m[2]) + int(m[3]), int(r[1]), int(m[4])


def cmd_test(args):
    def body(run):
        check_trees(run, False)
        cmake_build(run, "tests")
        sys.path.insert(0, str(ROOT / "tools"))
        import jobs
        rc = run.sh([str(CTEST), "--preset", "tests", "-j", jobs.jobs()])
        text = run.log_path.read_text(errors="replace")
        m = re.search(r"(\d+)% tests passed, (\d+) tests failed out of (\d+)", text)
        failed = re.findall(r"^\s*\d+ - (.+?) \(Failed\)|^\s*\d+ - (.+?) \((?:SEGFAULT|Subprocess aborted|Timeout|Exception)", text, re.M)
        names = [a or b for a, b in failed]
        summary = "ctest unparsed"
        if m:
            total, bad = int(m[3]), int(m[2])
            summary = f"ctest {total - bad}/{total} passed"
        if rc != 0:
            run.failed += names or ["ctest"]
            run.notes += [f"  failing: {n}" for n in names[:10]]
            raise Failed(summary)
        run.must([sys.executable, "-m", "unittest", "discover", "-s", "tools/vu/test", "-p", "test_*.py"],
                 "VU generator tests")
        summary += "; VU generator tests passed"
        if not args.full:
            return f"{summary} (quick tier; ./tz test --full adds slow tests and the VU1 replay)"
        if run.sh([str(CTEST), "--preset", "slow", "--no-tests=ignore", "-j", jobs.jobs()]) != 0:
            run.failed.append("slow tests")
            raise Failed(f"{summary}; slow-labelled tests failed")
        vu = ROOT / "generated/vu1-disc-native/vu1rec_guarded.cpp"
        corpus = ROOT / "runtime/regression/vu1"
        if vu.is_file() and (corpus / "catalog").is_dir():
            env = dict(os.environ, PS2X_VU1GEN_DIR=str(vu.parent), PS2X_VU1TEST_OUT=str(ROOT / "build/vu1-replay"))
            run.must(["bash", "tools/vu/test/build.sh"], "build vu1_replay", env=env)
            dirs = [str(p) for p in sorted(corpus.glob("snapshots")) + sorted(corpus.glob("live-*/snapshots"))]
            run.sh(["build/vu1-replay/vu1_replay", str(corpus / "catalog"), ",".join(dirs), "--guarded"])
            result = parse_replay(run.log_path.read_text(errors="replace"))
            if result is None:
                run.failed.append("vu1_replay")
                raise Failed(f"{summary}; vu1 replay produced no result")
            runs, mismatches, rejected, skipped = result
            expected = sum(len(list(Path(d).glob("snap_*"))) for d in dirs)
            if runs < 1106 or runs != expected or mismatches or rejected or skipped:
                run.failed.append("vu1_replay")
                raise Failed(f"{summary}; vu1 replay runs={runs} mismatch={mismatches} rejected={rejected} skipped={skipped}")
            return f"{summary}; vu1 replay runs={runs} mismatch=0 rejected=0 skipped=0"
        return f"{summary}; vu1 replay skipped (generated/vu1-disc-native or runtime/regression/vu1 missing)"
    return run_command("test", args, body)


FULL_REBUILD = re.compile(r"ps2xRuntime/include/(ps2_runtime\w*\.h|ps2_syscalls\.h|ps2_stubs\.h|ps2_recompiled_\w*\.h)")


def lint(run):
    """shellcheck / ruff on tracked shell and Python files; a missing tool only warns."""
    files = subprocess.run(["git", "ls-files", "-z"], capture_output=True, text=True).stdout.split("\0")
    sh = [f for f in files if f.endswith(".sh") and (ROOT / f).exists()]
    py = [f for f in files if (f.endswith(".py") or f == "tz") and (ROOT / f).exists()]
    for tool, targets, cmd in (("shellcheck", sh, ["shellcheck"]), ("ruff", py, ["ruff", "check"])):
        if not shutil.which(tool):
            run.notes.append(f"  WARNING: {tool} not installed; skipped")
        elif targets and run.sh(cmd + targets) != 0:
            run.failed.append(tool)
            raise Failed(f"{tool} reported problems (see log)")


def cmd_check(args):
    def body(run):
        mode = "--tracked" if args.tracked else "--staged"
        run.must([sys.executable, "tools/check-repo-hygiene.py", mode], "hygiene")
        if not args.tracked:
            staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--", "patches"],
                                    capture_output=True, text=True).stdout.split()
            hits = set()
            for f in staged:
                diff = subprocess.run(["git", "diff", "--cached", "-U0", "--", f], capture_output=True, text=True).stdout
                hits.update(FULL_REBUILD.search(l).group(1) for l in diff.splitlines()
                            if l.startswith("+diff --git") and FULL_REBUILD.search(l))
            if hits:
                run.notes.append("  WARNING: staged patches touch " + ", ".join(sorted(hits)) +
                                 " -> full generated-code rebuild (long)")
        lint(run)
        rc = run.sh([sys.executable, "tools/deps.py", "status"])
        status = run.log_path.read_text()
        bad = [l for l in status.splitlines() if re.search(r"UNEXPORTED|no tarzan branch|not synced|\bdirty\b", l)]
        if rc != 0 or bad:
            run.failed.append("deps status")
            run.notes += ["  " + l for l in bad]
            raise Failed("deps dirty or unexported -> commit in deps/<x> and `./tz deps export`")
        return f"hygiene ({mode[2:]}) and deps clean"
    return run_command("check", args, body)


def fmt(value):
    return "unknown" if value is None else value


def wait_for_quiet_machine(run, limit=60):
    """Measurements taken while builds run are not trustworthy: wait up to `limit` s for the
    1-minute load average to drop to the core count, then warn and continue."""
    cores = os.cpu_count() or 1
    deadline = time.monotonic() + limit
    load = os.getloadavg()[0]
    while load > cores and time.monotonic() < deadline:
        time.sleep(5)
        load = os.getloadavg()[0]
    if load > cores:
        run.notes.append(f"  WARNING: load average {load:.1f} > {cores} cores; results (fps, audio underruns) are unreliable")


def cmd_run(args):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out = ROOT / "build/runs" / stamp

    def body(run):
        wait_for_quiet_machine(run)
        if args.app:
            require(args.app, "./tz package --install")
        else:
            require(ELF, "./tz disc <iso>")
            require(ROOT / "build/game-metal/ps2recomp/ps2xRuntime/ps2EntryRunner", "./tz build")
        run.shown_log, run.context = out / "run.log", False
        if args.quit_cycles:
            if not args.app:
                raise Failed("--quit-cycles needs --app")
            reports = Path.home() / "Library/Logs/DiagnosticReports"
            known = set(reports.glob("TarzanFreeridePS2*.crash"))
            bad = 0
            for i in range(args.quit_cycles):
                cdir = out / f"cycle{i + 1:02d}"
                cmd = [sys.executable, "tools/probe/probe.py", "--out", cdir, "--route", args.route or "none",
                       "--app", args.app, "--quit-at-end"]
                rc = run.sh(cmd)
                s = json.loads((cdir / "summary.json").read_text()) if (cdir / "summary.json").is_file() else {}
                ok = s.get("reached") == s.get("target") and s.get("quit_clean") and s.get("exit_code") == 0  # underruns are not a quit property
                run.notes.append(f"cycle {i + 1}: reached {s.get('reached')} quit_clean {s.get('quit_clean')} exit {s.get('exit_code')}")
                bad += not ok
            time.sleep(3)
            new = set(reports.glob("TarzanFreeridePS2*.crash")) - known
            if bad or new:
                run.failed.append("quit cycles")
                raise Failed(f"{bad} bad cycles, {len(new)} new crash reports")
            return f"{args.quit_cycles} clean quit cycles"
        cmd = [sys.executable, "tools/probe/probe.py", "--out", out, "--route", args.route or "none"]
        for flag, value in (("--seconds", args.seconds), ("--route", args.route), ("--fps-target", args.fps_target), ("--save", args.save),
                            ("--user-dir", args.user_dir), ("--app", args.app)):
            if value:
                cmd += [flag, value]
        if args.profile:
            cmd.append("--profile")
        if args.no_skip_logos:
            cmd.append("--no-skip-logos")
        if args.measure:
            cmd.append("--measure")
        rc = run.sh(cmd)
        if rc == 2:
            raise Missing(run.last_message())
        summary_path = out / "summary.json"
        if not summary_path.is_file():
            run.failed.append("probe")
            raise Failed("probe produced no summary: " + run.last_message())
        s = json.loads(summary_path.read_text())
        crash = s["crash"]
        stubs = ", ".join(f"{n} x{c}" for n, c in s["stubs"]) or "none"
        run.notes += [f"reached: {s['reached']}", f"seconds: {s['seconds']:g}",
                      f"scene: {fmt(s.get('scene'))}", f"fps_gameplay: {fmt(s.get('fps_gameplay'))}", f"fps_dispfb2: {fmt(s['fps_dispfb2'])}",
                      f"cpu_user_s: {fmt(s['cpu_user_s'])}", f"cpu_sys_s: {fmt(s['cpu_sys_s'])}",
                      f"vu_fallbacks: {fmt(s['vu_fallbacks'])}", f"audio_underruns: {fmt(s['audio_underruns'])}",
                      f"audio_boundary_underruns: {fmt(s.get('audio_boundary_underruns'))}",
                      "crash: " + ("none" if not crash else f"{crash['signal']} {fmt(crash['pc'])} {fmt(crash['symbol'])}"),
                      f"stubs: {stubs}"]
        for m in s.get("missions", []):
            vu = f" vu1:{','.join(m['vu1_programs'])}" if m.get("vu1_programs") else ""
            mv = "".join(f" movie:{v['name']}:{'end' if v['to_end'] else 'open' if v['played'] else 'missing'}"
                         + (f"({v['seconds']:g}s)" if v["seconds"] else "") for v in m.get("movies", []))
            stubs = ",".join(f"{n}x{c}" for n, c in m.get("stubs", []))
            run.notes.append(f"  mission {m['index'] + 1} {m['name']} [{m.get('type', '')}]: {m['result']}; gameplay "
                             f"{'yes' if m.get('reached') else 'no'}; {fmt(m.get('play_seconds'))} s play, fps {fmt(m.get('fps_dispfb2'))} "
                             f"(min {fmt(m.get('fps_min'))}), cpu {fmt(m.get('cpu_user_s'))} s, fallbacks {fmt(m.get('fallbacks'))}, "
                             f"underruns {fmt(m.get('underruns'))}, stubs {stubs or 'none'}{vu}{mv}")
        if s.get("missions"):
            run.notes.append(f"vu1 snapshots: {s['vu1_snapshots']} ({s['snapshot_files']} files); movies not on disc: "
                             f"{', '.join(s['missing_movies']) or 'none'}")
        if s["black_frames"]:
            run.notes.append(f"black_frames: {s['black_frames']}")
        if s["save_dir_changed"]:
            run.failed.append("save dir changed")
            run.notes.append("FAIL: the real save dir changed during the run")
        if s["audio_underruns"]:
            run.failed.append("audio underruns")
            run.notes.append(f"FAIL: {s['audio_underruns']} steady-state audio underruns")
        if rc != 0:
            run.failed.append(f"reached {s['reached']}, wanted {s['target']}")
            raise Failed(f"reached {s['reached']} (wanted {s['target']})")
        return f"reached {s['reached']}"
    return run_command("run", args, body)


def cmd_package(args):
    def body(run):
        if not args.install:
            require(ROOT / "build/game-metal/ps2recomp/ps2xRuntime/ps2EntryRunner", "./tz build")
        require(ELF, "./tz disc <iso>")
        run.must([sys.executable, "tools/package/package.py"] + (["--install"] if args.install else []), "package")
        lines = [l for l in run.log_path.read_text().splitlines() if l.startswith(("Installed:", "audit:", "/"))]
        return "; ".join(lines[-2:]) or "bundle built"
    return run_command("package", args, body)


def cmd_where(args):
    sys.path.insert(0, str(ROOT / "tools"))
    import where
    code, lines = where.unimplemented() if args.unimplemented else where.where(args.query)
    print("\n".join(lines))
    return 2 if code is None else code


def main():
    p = argparse.ArgumentParser(prog="tz", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    sp.add_parser("setup").set_defaults(fn=cmd_setup)
    d = sp.add_parser("deps")
    d.add_argument("sub", nargs="?", choices=["sync", "export", "status"])
    d.set_defaults(fn=cmd_deps)
    d = sp.add_parser("disc")
    d.add_argument("iso", nargs="?")
    d.add_argument("--dest", help="extract only, into this directory (leaves extracted/ and config untouched)")
    d.set_defaults(fn=cmd_disc)
    b = sp.add_parser("build")
    b.add_argument("--reconfigure", action="store_true", help="wipe and reconfigure build trees configured from another path/case")
    b.set_defaults(fn=cmd_build)
    t = sp.add_parser("test")
    t.add_argument("--full", action="store_true", help="also run slow-labelled tests and the 1,106-run VU1 replay")
    t.set_defaults(fn=cmd_test)
    c = sp.add_parser("check")
    c.add_argument("--tracked", action="store_true")
    c.set_defaults(fn=cmd_check)
    r = sp.add_parser("run")
    r.add_argument("--seconds", type=int)
    r.add_argument("--route", choices=["none", "first-mission", "missions"])
    r.add_argument("--fps-target", type=int, choices=[60, 120], help="opt into a high-FPS target in isolated settings for this run")
    r.add_argument("--measure", action="store_true", help="collect a 60-second steady gameplay window")
    r.add_argument("--no-skip-logos", action="store_true", help="control run for measuring the title boot saving")
    r.add_argument("--user-dir")
    r.add_argument("--save", help="copy a fixture's memcards/ subtree into a fresh isolated user dir")
    r.add_argument("--profile", action="store_true")
    r.add_argument("--app")
    r.add_argument("--quit-cycles", type=int, metavar="N",
                   help="with --app: N launch -> (route) -> AppleEvent quit cycles; fails on non-zero exit or new crash report")
    r.set_defaults(fn=cmd_run)
    k = sp.add_parser("package")
    k.add_argument("--install", action="store_true")
    k.set_defaults(fn=cmd_package)
    w = sp.add_parser("where")
    where_mode = w.add_mutually_exclusive_group(required=True)
    where_mode.add_argument("query", nargs="?")
    where_mode.add_argument("--unimplemented", action="store_true",
                            help="audit configured direct TODO handlers, including underscore aliases")
    w.set_defaults(fn=cmd_where)
    argv = sys.argv[1:]
    verbose = any(a in ("-v", "--verbose") for a in argv)
    args, _extra = p.parse_known_args([a for a in argv if a not in ("-v", "--verbose")])
    args.verbose = verbose
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
