{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchain-llvm19.cmake",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/tools/build/ninja-1.13.1/ninja",
        "CMAKE_PREFIX_PATH": "${sourceDir}/tools/build/llvm19;${sourceDir}/tools/metal-deps/prefix;${sourceDir}/tools/ffmpeg/arm64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "ZERO_AR_DATE": "1"
      }
    },
    {
      "name": "release",
      "displayName": "Native game and recompiler (Metal, Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/game-metal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "ps2EntryRunner"
      ]
    },
    {
      "name": "recompiler",
      "configurePreset": "release",
      "targets": [
        "ps2_recomp"
      ]
    }
  ]
}
