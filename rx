#!/usr/bin/env python3
"""Build and run the native FIFA Street port."""
import argparse
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys

def resolve_root():
    """Repo root with the on-disk case of every path component.

    os.path.realpath keeps whatever case the caller typed on a case-insensitive
    volume; F_GETPATH asks the kernel for the canonical spelling, which is what
    clang compares #include paths against (-Wnonportable-include-path).
    """
    root = Path(os.path.realpath(__file__)).parent
    try:
        import fcntl
        fd = os.open(root, os.O_RDONLY)
        try:
            return Path(fcntl.fcntl(fd, fcntl.F_GETPATH, b"\0" * 1024).split(b"\0")[0].decode())
        finally:
            os.close(fd)
    except (OSError, AttributeError):
        return root

ROOT = resolve_root()
os.chdir(ROOT)
os.environ["PWD"] = str(ROOT)
os.environ["RX_ROOT"] = str(ROOT)
os.environ.pop("__PYVENV_LAUNCHER__", None)
sys.path.insert(0, str(ROOT / "tools"))
import game
import jobs

CMAKE = ROOT / "tools/build/cmake-3.31.12/CMake.app/Contents/bin/cmake"
ELF, TEMPLATE, CONFIG, GENERATED = game.ELF, game.TEMPLATE, game.CONFIG, game.GENERATED
RECOMP_BIN = ROOT / "build/game-metal/ps2recomp/ps2xRecomp/ps2_recomp"
STAMP = ROOT / "build/generate.stamp"


class Commands:
    def must(self, command, label=None, **kwargs):
        subprocess.run([str(value) for value in command], check=True, **kwargs)

    def say(self, message):
        print(message, flush=True)


def require(path, fix):
    if not Path(path).exists():
        raise RuntimeError(f"{path} missing; {fix}")


def tool_python():
    path = ROOT / "tools/python/bin/python"
    return str(path) if path.exists() else sys.executable


def sha256(path, h=None):
    h = h or hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h

def generate_inputs_hash():
    h = hashlib.sha256()
    for p in (ELF, TEMPLATE, CONFIG, RECOMP_BIN, ROOT / "tools/generate.py"):
        if not p.is_file():
            continue
        h.update(p.name.encode())
        sha256(p, h)
    # The compiler binary can stay byte-identical when a working-tree generator edit is
    # pending or a build target was skipped. Include that source diff so build cannot report
    # generated output current before the new emitter has run.
    recomp_root = ROOT / "deps/ps2recomp"
    revision = subprocess.run(
        ["git", "-C", str(recomp_root), "rev-parse", "HEAD"],
        capture_output=True,
        check=True,
    ).stdout
    diff = subprocess.run(
        ["git", "-C", str(recomp_root), "diff", "HEAD", "--", "ps2xRecomp"],
        capture_output=True,
        check=True,
    ).stdout
    h.update(revision)
    h.update(diff)
    return h.hexdigest()

DEP_PRODUCTS = {
    "bridge": (["build/metal-bridge/pcsx2/pcsx2-gs-bridge/librrv-pcsx2-gs-bridge.dylib"],
               [("pcsx2", None), (None, "bridge/gs"), (None, "tools/build-deps.sh"), (None, "cmake/toolchain-llvm19.cmake")]),
    "spu2": (["build/spu2-backend/librrv_pcsx2_spu2.a"],
             [(None, "bridge/spu2"), ("pcsx2", "pcsx2/SPU2"), (None, "tools/build-deps.sh"), (None, "cmake/toolchain-llvm19.cmake")]),
}


def dep_inputs_hash(sources):
    h = hashlib.sha256()
    for dep, sub in sources:
        root = ROOT if dep is None else ROOT / "deps" / dep
        base = ["git", "-C", str(root)]
        spec = [] if sub is None else ["--", sub]
        rev = f"HEAD:{sub}" if sub else "HEAD"
        h.update(subprocess.run(base + ["rev-parse", rev], capture_output=True, text=True).stdout.encode())
        h.update(subprocess.run(base + ["diff", "HEAD", *spec], capture_output=True).stdout)
        files = subprocess.run(base + ["ls-files", "-z", *spec], capture_output=True).stdout.split(b"\0")
        for name in files:
            if not name:
                continue
            path = root / os.fsdecode(name)
            try:
                stat = path.stat()
            except FileNotFoundError:
                continue
            h.update(name)
            h.update(f"{stat.st_mtime_ns}:{stat.st_size}".encode())
    return h.hexdigest()

def rebuild_stale_deps(run):
    stale = []
    for name, (outputs, sources) in DEP_PRODUCTS.items():
        stamp = ROOT / f"build/deps-{name}.stamp"
        want = dep_inputs_hash(sources)
        have = stamp.read_text().strip() if stamp.is_file() else ""
        if want != have or not all((ROOT / o).exists() for o in outputs):
            stale.append((name, stamp, want))
    for name, stamp, want in stale:
        run.say(f"dependency {name} inputs changed: rebuilding")
        run.must(["bash", "tools/build-deps.sh"], f"build-deps {name}", env=dict(os.environ, RX_FORCE=name))
        stamp.write_text(want + "\n")
    return [n for n, _, _ in stale]


def build(args):
    require(CMAKE, "run ./rx setup")
    require(ELF, "run ./rx disc <iso>")
    cache = ROOT / "build/game-metal/CMakeCache.txt"
    if cache.exists():
        source = next((line.split("=", 1)[1] for line in cache.read_text().splitlines()
                       if line.startswith("CMAKE_HOME_DIRECTORY:")), str(ROOT))
        if source != str(ROOT):
            if not args.reconfigure:
                raise RuntimeError("Build directory belongs to another checkout; use ./rx build --reconfigure")
            shutil.rmtree(cache.parent)
    CONFIG.write_text(TEMPLATE.read_text().replace("@ROOT@", str(ROOT)))
    commands = Commands()
    rebuild_stale_deps(commands)
    commands.must([CMAKE, "--preset", "release"])
    commands.must([CMAKE, "--build", "--preset", "recompiler", "--parallel", jobs.jobs()])
    wanted = generate_inputs_hash()
    if not STAMP.exists() or STAMP.read_text().strip() != wanted or not GENERATED.is_dir():
        commands.must([tool_python(), "tools/generate.py"])
        STAMP.write_text(wanted + "\n")
    commands.must([CMAKE, "--preset", "release"])
    commands.must([CMAKE, "--build", "--preset", "release", "--parallel", jobs.jobs()])


def setup(args):
    commands = Commands()
    commands.must([sys.executable, "tools/deps.py"])
    commands.must(["bash", "toolchain/bootstrap.sh"])
    if not (ROOT / "tools/python/bin/python").exists():
        commands.must([sys.executable, "-m", "venv", "tools/python"])
    env = dict(os.environ, PATH=str(CMAKE.parent) + os.pathsep + os.environ.get("PATH", ""))
    commands.must(["tools/python/bin/pip", "install", "-r", "requirements.txt"], env=env)
    commands.must(["bash", "tools/build-deps.sh"])


def ipa(args):
    platform = {"ios": "iphoneos", "tvos": "appletvos",
                "ios-sim": "iphonesimulator", "tvos-sim": "appletvsimulator"}[args.platform]
    require(ELF, "run ./rx disc <iso>")
    os.environ.setdefault("RX_JOBS", "3")
    commands = Commands()
    for script in ("build-deps-embedded.sh", "build-embedded-runtimes.sh",
                   "build-bridge-embedded.sh", "build-game-embedded.sh"):
        commands.must(["bash", "tools/" + script, platform])
    commands.must([tool_python(), "tools/package/ios_app.py", platform])
    if not args.app_only and not args.platform.endswith("-sim"):
        commands.must([tool_python(), "tools/package/ipa.py", platform])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("setup", help="download and build dependencies").set_defaults(action=setup)
    command = commands.add_parser("disc", help="verify and extract your PAL ISO")
    command.add_argument("iso")
    command.set_defaults(action=lambda args: Commands().must([tool_python(), "tools/disc.py", args.iso]))
    command = commands.add_parser("build", help="generate and compile the game")
    command.add_argument("--reconfigure", action="store_true")
    command.set_defaults(action=build)
    command = commands.add_parser("run", help="run the game from the build directory")
    command.set_defaults(action=lambda args: Commands().must([ROOT / "build/game-metal/ps2recomp/ps2xRuntime/ps2EntryRunner"]))
    command = commands.add_parser("package", help="create a macOS app bundle")
    command.add_argument("--install", action="store_true")
    command.set_defaults(action=lambda args: Commands().must([tool_python(), "tools/package/package.py"]
                                                            + (["--install"] if args.install else [])))
    command = commands.add_parser("ipa", help="build an iOS or tvOS app")
    command.add_argument("--platform", required=True, choices=["ios", "tvos", "ios-sim", "tvos-sim"])
    command.add_argument("--app-only", action="store_true")
    command.set_defaults(action=ipa)
    args = parser.parse_args()
    try:
        args.action(args)
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print("rx: " + str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
