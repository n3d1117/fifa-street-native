def main():
    p = argparse.ArgumentParser(prog="rx", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    sp.add_parser("setup").set_defaults(fn=cmd_setup)
    d = sp.add_parser("deps")
    d.add_argument("sub", nargs="?", choices=["sync", "export", "status"])
    d.set_defaults(fn=cmd_deps)
    d = sp.add_parser("disc")
    d.add_argument("iso", nargs="?")
    d.add_argument("--dest", help="extract into this directory instead of extracted/disc")
    d.set_defaults(fn=cmd_disc)
    b = sp.add_parser("build")
    b.add_argument("--reconfigure", action="store_true", help="wipe and reconfigure build trees configured from another path/case")
    b.set_defaults(fn=cmd_build)
    t = sp.add_parser("test")
    t.add_argument("--full", action="store_true", help="also run slow-labelled tests")
    t.set_defaults(fn=cmd_test)
    c = sp.add_parser("check")
    c.add_argument("--tracked", action="store_true")
    c.set_defaults(fn=cmd_check)
    r = sp.add_parser("run")
    r.add_argument("--seconds", type=int)
    r.add_argument("--user-dir")
    r.add_argument("--save", help="copy a fixture's memcards/ subtree into a fresh isolated user dir")
    r.add_argument("--profile", action="store_true")
    r.add_argument("--route", choices=["match"], help="scripted input from the language menu to a quick match; fails unless the match scene opens")
    r.add_argument("--match", action="store_true",
                   help="diagnostic: boot straight into live match play in an isolated user dir (PS2X_BOOT_MATCH hook); reports time_to_play_s")
    r.add_argument("--button-spam", action="store_true",
                   help="alternate Cross/Square/Circle/Triangle/L1/R1 during confirmed match play")
    r.add_argument("--app")
    r.add_argument("--quit-cycles", type=int, metavar="N",
                   help="with --app: N launch -> AppleEvent quit cycles; fails on non-zero exit or new crash report")
    r.set_defaults(fn=cmd_run)
    a = sp.add_parser("ab", help="alternating control/candidate probe runs")
    a.add_argument("--control", action="append", required=True, metavar="ENV=VAL")
    a.add_argument("--candidate", action="append", default=[], metavar="ENV=VAL")
    a.add_argument("--pairs", type=int, default=2)
    a.add_argument("--seconds", type=int)
    a.add_argument("--profile", action="store_true")
    a.add_argument("--match", action="store_true", default=True)
    a.add_argument("--button-spam", action="store_true",
                   help="alternate Cross/Square/Circle/Triangle/L1/R1 during confirmed match play")
    a.set_defaults(fn=cmd_ab)
    k = sp.add_parser("package")
    k.add_argument("--install", action="store_true")
    k.set_defaults(fn=cmd_package)
    k = sp.add_parser("ipa")
    k.add_argument("--platform", required=True, choices=["ios", "tvos", "ios-sim", "tvos-sim"])
    k.add_argument("--app-only", action="store_true", help="build and assemble the app without simulator boot or IPA packaging")
    k.set_defaults(fn=cmd_ipa)
    d = sp.add_parser("device", help="sign, install, run and summarize a USB iOS/tvOS device")
    d.add_argument("device_args", nargs=argparse.REMAINDER)
    d.set_defaults(fn=cmd_device)
    x = sp.add_parser("xcode")
    x.set_defaults(fn=cmd_xcode)
    w = sp.add_parser("where")
    where_mode = w.add_mutually_exclusive_group(required=True)
    where_mode.add_argument("query", nargs="?")
    where_mode.add_argument("--unimplemented", action="store_true",
                            help="audit configured direct TODO handlers, including underscore aliases")
    w.set_defaults(fn=cmd_where)
    argv = sys.argv[1:]
    verbose = any(a in ("-v", "--verbose") for a in argv)
    args, _extra = p.parse_known_args([a for a in argv if a not in ("-v", "--verbose")])
    args.verbose = verbose
    return args.fn(args)



if __name__ == "__main__":
    sys.exit(main())
