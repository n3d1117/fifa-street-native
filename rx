def cmd_deps(args):
    sub = args.sub or "status"
    py = sys.executable
    run = Run("deps", args.verbose)
    rc = run.sh([py, "tools/deps.py", sub])
    out = run.log_path.read_text()
    run.log.close()
    print(out.split("\n", 1)[1].rstrip() if "\n" in out else out.rstrip())
    return rc if rc in (0, 2) else 1


def cmd_setup(args):
    def body(run):
        run.must([sys.executable, "tools/deps.py", "sync"], "deps sync")
        # Bootstrap first: it fetches the pinned CMake/Ninja that building capstone from sdist needs.
        run.must(["bash", "toolchain/bootstrap.sh"], "toolchain bootstrap")
        py = tool_python()
        probe = subprocess.run([py, "-c", "import pycdlib, capstone, elftools"], capture_output=True)
        if probe.returncode != 0:
            if not (ROOT / "tools/python/bin/python").exists():
                run.must([sys.executable, "-m", "venv", "tools/python"], "venv")
            env = dict(os.environ, PATH=f"{CMAKE.parent}{os.pathsep}{os.environ.get('PATH', '')}")
            run.must(["tools/python/bin/pip", "install", "-r", "requirements.txt"], "pip install", env=env)
        run.must(["bash", "tools/build-deps.sh"], "build-deps")
        run.must(["git", "config", "core.hooksPath", ".githooks"], "enable pre-commit hook")
        return "toolchain and dependencies ready; next: ./rx disc <iso>"
    return run_command("setup", args, body)


def cmd_disc(args):
    def body(run):
        if not args.iso:
            raise Missing("usage: ./rx disc <path-to-your-iso> (bring your own disc)")
        cmd = [tool_python(), "tools/disc.py", args.iso]
        if args.dest:
            cmd += ["--dest", args.dest, "--report", str(Path(args.dest) / "disc-inventory.json")]
        run.must(cmd, "disc")
        last = run.last_message()
        return last or "disc verified and extracted"
    return run_command("disc", args, body)


# Out-of-tree dependency products: stamp inputs are git tree hashes of the relevant subpaths
# (plus the HEAD diff for uncommitted edits), so unrelated commits do not trigger rebuilds.
DEP_PRODUCTS = {
    "bridge": (["build/metal-bridge/pcsx2/pcsx2-gs-bridge/librrv-pcsx2-gs-bridge.dylib"],
               [("pcsx2", None), ("fukami", "tools/pcsx2-gs-bridge")]),
    "spu2": (["build/spu2-backend/librrv_pcsx2_spu2.a"],
             [("fukami", "tools/pcsx2-spu2"), ("pcsx2", "pcsx2/SPU2"), ("pcsx2", "3rdparty/soundtouch")]),
}


def dep_inputs_hash(sources):
    h = hashlib.sha256()
    for dep, sub in sources:
        base = ["git", "-C", f"deps/{dep}"]
        spec = [] if sub is None else ["--", sub]
        rev = f"HEAD:{sub}" if sub else "HEAD"
        h.update(subprocess.run(base + ["rev-parse", rev], capture_output=True, text=True).stdout.encode())
        h.update(subprocess.run(base + ["diff", "HEAD", *spec], capture_output=True).stdout)
    return h.hexdigest()


def rebuild_stale_deps(run):
    stale = []
    for name, (outputs, sources) in DEP_PRODUCTS.items():
        stamp = ROOT / f"build/deps-{name}.stamp"
        want = dep_inputs_hash(sources)
        have = stamp.read_text().strip() if stamp.is_file() else ""
        if want != have or not all((ROOT / o).exists() for o in outputs):
            stale.append((name, stamp, want))
    for name, stamp, want in stale:
        run.say(f"dependency {name} inputs changed: rebuilding")
        run.must(["bash", "tools/build-deps.sh"], f"build-deps {name}", env=dict(os.environ, RX_FORCE=name))
        stamp.write_text(want + "\n")
    return [n for n, _, _ in stale]


# Every generated unit includes these: touching one recompiles all of generated/.
GENERATED_INCLUDED_HEADERS = {"ps2_runtime.h", "ps2_runtime_macros.h", "ps2_syscalls.h", "ps2_stubs.h", "ps2_log.h"}


def cmd_build(args):
    def body(run):
        check_trees(run, args.reconfigure)
        rebuilt = rebuild_stale_deps(run)
        cmake_build(run, "recompiler")
        require(ELF, "./rx disc <iso>")
        if not TEMPLATE.is_file():
            raise Missing(f"{TEMPLATE.relative_to(ROOT)} missing -> the recompiler config for {game.GAME['title']} "
                          f"({game.ID}) is not written yet")
        import where
        todo = where.unimplemented()[1][1:]
        if todo:
            raise Failed("configured stubs bound to TODO handlers (unbind them so the guest code runs, or implement them):\n"
                         + "\n".join(todo))
        derived = TEMPLATE.read_text().replace("@ROOT@", str(ROOT))
        if not CONFIG.is_file() or CONFIG.read_text() != derived:
            CONFIG.write_text(derived)
            run.say("config derived from the template")
        changed = subprocess.run(["git", "-C", str(ROOT / "deps/ps2recomp"), "diff", "--name-only", "HEAD"],
                                 capture_output=True, text=True).stdout.split()
        wide = [Path(c).name for c in changed if Path(c).name in GENERATED_INCLUDED_HEADERS]
        if wide:
            run.say(f"WARNING: uncommitted change to {', '.join(wide)} -> full generated-code rebuild (minutes)")
        want = generate_inputs_hash()
        have = STAMP.read_text().strip() if STAMP.is_file() else ""
        note = "generated code current"
        if want != have or not GENERATED.is_dir():
            run.must([tool_python(), "tools/generate.py"], "generate")
            tmp = STAMP.with_suffix(".tmp")
            tmp.write_text(want + "\n")
            os.replace(tmp, STAMP)
            note = "regenerated; " + run.last_message()
        cmake_build(run, "release", reconfigure=not game_configured())
        return note + (f"; rebuilt deps: {', '.join(rebuilt)}" if rebuilt else "")
    return run_command("build", args, body)


def cmd_test(args):
    def body(run):
        check_trees(run, False)
        cmake_build(run, "tests")
        import jobs
        rc = run.sh([str(CTEST), "--preset", "tests", "-j", jobs.jobs()])
        text = run.log_path.read_text(errors="replace")
        m = re.search(r"(\d+)% tests passed, (\d+) tests failed out of (\d+)", text)
        failed = re.findall(r"^\s*\d+ - (.+?) \(Failed\)|^\s*\d+ - (.+?) \((?:SEGFAULT|Subprocess aborted|Timeout|Exception)", text, re.M)
        names = [a or b for a, b in failed]
        summary = "ctest unparsed"
        if m:
            total, bad = int(m[3]), int(m[2])
            summary = f"ctest {total - bad}/{total} passed"
        if rc != 0:
            run.failed += names or ["ctest"]
            run.notes += [f"  failing: {n}" for n in names[:10]]
            raise Failed(summary)
        if not args.full:
            return f"{summary} (quick tier; ./rx test --full adds slow tests)"
        if run.sh([str(CTEST), "--preset", "slow", "--no-tests=ignore", "-j", jobs.jobs()]) != 0:
            run.failed.append("slow tests")
            raise Failed(f"{summary}; slow-labelled tests failed")
        return f"{summary}; slow tests passed"
    return run_command("test", args, body)


FULL_REBUILD = re.compile(r"ps2xRuntime/include/(ps2_runtime\w*\.h|ps2_syscalls\.h|ps2_stubs\.h|ps2_recompiled_\w*\.h)")


def lint(run):
    """shellcheck / ruff on tracked shell and Python files; a missing tool only warns."""
    files = subprocess.run(["git", "ls-files", "-z"], capture_output=True, text=True).stdout.split("\0")
    sh = [f for f in files if f.endswith(".sh") and (ROOT / f).exists()]
    py = [f for f in files if (f.endswith(".py") or f == "rx") and (ROOT / f).exists()]
    for tool, targets, cmd in (("shellcheck", sh, ["shellcheck"]), ("ruff", py, ["ruff", "check"])):
        if not shutil.which(tool):
            run.notes.append(f"  WARNING: {tool} not installed; skipped")
        elif targets and run.sh(cmd + targets) != 0:
            run.failed.append(tool)
            raise Failed(f"{tool} reported problems (see log)")


def cmd_check(args):
    def body(run):
        mode = "--tracked" if args.tracked else "--staged"
        run.must([sys.executable, "tools/check-repo-hygiene.py", mode], "hygiene")
        if not args.tracked:
            staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--", "patches"],
                                    capture_output=True, text=True).stdout.split()
            hits = set()
            for f in staged:
                diff = subprocess.run(["git", "diff", "--cached", "-U0", "--", f], capture_output=True, text=True).stdout
                hits.update(FULL_REBUILD.search(l).group(1) for l in diff.splitlines()
                            if l.startswith("+diff --git") and FULL_REBUILD.search(l))
            if hits:
                run.notes.append("  WARNING: staged patches touch " + ", ".join(sorted(hits)) +
                                 " -> full generated-code rebuild (long)")
        lint(run)
        rc = run.sh([sys.executable, "tools/deps.py", "status"])
        status = run.log_path.read_text()
        bad = [l for l in status.splitlines() if re.search(r"UNEXPORTED|no rx branch|not synced|\bdirty\b", l)]
        if rc != 0 or bad:
            run.failed.append("deps status")
            run.notes += ["  " + l for l in bad]
            raise Failed("deps dirty or unexported -> commit in deps/<x> and `./rx deps export`")
        return f"hygiene ({mode[2:]}) and deps clean"
    return run_command("check", args, body)


def fmt(value):
    return "unknown" if value is None else value


def wait_for_quiet_machine(run, limit=60):
    """Measurements taken while builds run are not trustworthy: wait up to `limit` s for the
    1-minute load average to drop to the core count, then warn and continue."""
    cores = os.cpu_count() or 1
    deadline = time.monotonic() + limit
    load = os.getloadavg()[0]
    while load > cores and time.monotonic() < deadline:
        time.sleep(5)
        load = os.getloadavg()[0]
    if load > cores:
        run.notes.append(f"  WARNING: load average {load:.1f} > {cores} cores; results (fps, audio underruns) are unreliable")


def cmd_run(args):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out = ROOT / "build/runs" / stamp

    def body(run):
        alive = subprocess.run(["pgrep", "-f", str(ROOT / "build/game-metal") + "/.*/ps2EntryRunner"],
                               capture_output=True, text=True).stdout.split()
        if alive:
            raise Missing(f"a ps2EntryRunner from this checkout is already running (pid {', '.join(alive)}); "
                          "one run at a time -> kill it")
        wait_for_quiet_machine(run)
        if args.app:
            require(args.app, "./rx package --install")
        else:
            require(ELF, "./rx disc <iso>")
            require(ROOT / "build/game-metal/ps2recomp/ps2xRuntime/ps2EntryRunner", "./rx build")
        run.shown_log, run.context = out / "run.log", False
        if args.quit_cycles:
            if not args.app:
                raise Failed("--quit-cycles needs --app")
            reports = Path.home() / "Library/Logs/DiagnosticReports"
            pattern = f"{game.GAME['executable']}*.crash"
            known = set(reports.glob(pattern))
            bad = 0
            for i in range(args.quit_cycles):
                cdir = out / f"cycle{i + 1:02d}"
                cmd = [sys.executable, "tools/probe/probe.py", "--out", cdir, "--app", args.app, "--quit-at-end"]
                if args.seconds:
                    cmd += ["--seconds", args.seconds]
                run.sh(cmd)
                s = json.loads((cdir / "summary.json").read_text()) if (cdir / "summary.json").is_file() else {}
                ok = s.get("reached") == s.get("target") and s.get("quit_clean") and s.get("exit_code") == 0
                run.notes.append(f"cycle {i + 1}: reached {s.get('reached')} quit_clean {s.get('quit_clean')} exit {s.get('exit_code')}")
                bad += not ok
            time.sleep(3)
            new = set(reports.glob(pattern)) - known
            if bad or new:
                run.failed.append("quit cycles")
                raise Failed(f"{bad} bad cycles, {len(new)} new crash reports")
            return f"{args.quit_cycles} clean quit cycles"
        cmd = [sys.executable, "tools/probe/probe.py", "--out", out]
        for flag, value in (("--seconds", args.seconds), ("--save", args.save),
                            ("--user-dir", args.user_dir), ("--app", args.app)):
            if value:
                cmd += [flag, value]
        if args.profile:
            cmd.append("--profile")
        if args.route:
            cmd += ["--route", args.route]
        rc = run.sh(cmd)
        if rc == 2:
            raise Missing(run.last_message())
        summary_path = out / "summary.json"
        if not summary_path.is_file():
            run.failed.append("probe")
            raise Failed("probe produced no summary: " + run.last_message())
        s = json.loads(summary_path.read_text())
        crash = s["crash"]
        stubs = ", ".join(f"{n} x{c}" for n, c in s["stubs"]) or "none"
        run.notes += [f"reached: {s['reached']}", f"seconds: {s['seconds']:g}", f"fps_dispfb2: {fmt(s['fps_dispfb2'])}",
                      f"gpu_presents_per_sec: {fmt(s.get('gpu_presents_per_sec'))}",
                      f"cpu_user_s: {fmt(s['cpu_user_s'])}", f"cpu_sys_s: {fmt(s['cpu_sys_s'])}",
                      f"vu_fallbacks: {fmt(s['vu_fallbacks'])}", f"audio_underruns: {fmt(s['audio_underruns'])}",
                      "crash: " + ("none" if not crash else f"{crash['signal']} {fmt(crash['pc'])} {fmt(crash['symbol'])}"),
                      f"stubs: {stubs}"]
        if s.get("scene"):
            run.notes.append(f"scene: {s['scene']}")
        vu1 = s.get("vu1") or {}
        if vu1.get("diff_calls") or os.environ.get("PS2X_VU1_DIFF", "0") not in ("", "0"):
            run.notes.append(f"vu1_diff: calls={vu1.get('diff_calls', 0)} "
                             f"mismatch_full={vu1.get('mismatch_full', 0)} "
                             f"mismatch_fast={vu1.get('mismatch_fast', 0)} "
                             f"budget_stops={vu1.get('interpreter_budget_stops', 0)}")
        if s["black_frames"]:
            run.notes.append(f"black_frames: {s['black_frames']}")
        if s["save_dir_changed"]:
            run.failed.append("save dir changed")
            run.notes.append("FAIL: the real save dir changed during the run")
        if s["audio_underruns"]:
            run.failed.append("audio underruns")
            run.notes.append(f"FAIL: {s['audio_underruns']} steady-state audio underruns")
        if rc != 0:
            run.failed.append(f"reached {s['reached']}, wanted {s['target']}")
            raise Failed(f"reached {s['reached']} (wanted {s['target']})")
        return f"reached {s['reached']}"
    return run_command("run", args, body)


def cmd_package(args):
    def body(run):
        if not args.install:
            require(ROOT / "build/game-metal/ps2recomp/ps2xRuntime/ps2EntryRunner", "./rx build")
        require(ELF, "./rx disc <iso>")
