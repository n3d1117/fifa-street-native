#!/usr/bin/env python3
"""rx: thin sequencer over the repo's real commands. Run from anywhere in the repo.

  rx setup                 deps sync, venv, toolchain bootstrap, tools/build-deps.sh
  rx deps [sync|export|status]
  rx disc <iso> [--dest D] verify SHA-1s and extract the disc (tools/disc.py)
  rx build [--reconfigure] rebuild stale deps and the recompiler, generate if inputs changed, release build
                           (refuses, exit 2, if a build tree was configured from another path/case)
  rx test [--full]         quick tier: ctest (no GUI/slow tests); --full adds the slow-labelled tests
  rx check [--tracked]     repo hygiene, header-rebuild warning, unexported deps
  rx run [--seconds N] [--save DIR] [--user-dir D] [--profile] [--app PATH [--quit-cycles N]]
                           bounded boot run, isolated saves, summary block (tools/probe/probe.py)
  rx package [--install]   icon, bundle, bundle audit, optional /Applications install (tools/package/)
  rx where <0xADDR|name>   generated file, config entry, HLE handler (tools/where.py)
  rx where --unimplemented audit configured direct TODO handlers

Full output goes to build/logs/<cmd>-<UTC>.log; -v streams it. Exit codes:
0 pass, 1 check failed, 2 missing prerequisite (the message names the fix).
"""
