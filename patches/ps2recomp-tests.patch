+            constexpr uint32_t kVifErrMe1 = 1u << 2u;
+            constexpr uint32_t kVifStatEr1 = 1u << 13u;
+            if ((m_ioRegisters[0x10003C20u] & kVifErrMe1) == 0u)
+            {
+                vif1_regs.stat |= kVifStatEr1;
+                m_vif1PendingCommandIrq = false;
+                // PCSX2's VifStallEnable(vif1ch) gates the stall on CHCR.STR.
+                if ((m_ioRegisters[0x10009000u] & 0x100u) != 0u)
+                {
+                    m_vif1Stalled = true;
+                    appendPendingVif1Input(*this, data + pos, sizeBytes - pos);
+                    return;
+                }
+            }
             continue;
         }
     }
+
+    // The loop requires a complete command word. Keep a trailing partial CODE
+    // word so it is not mistaken for the beginning of the next DMA payload.
+    if (pos < sizeBytes)
+        appendPendingVif1Input(*this, data + pos, sizeBytes - pos);
+
+    if (trace && thisCall < 16u)
+        std::cerr << "[tarzan-vif1] exit call=" << thisCall << " consumedBytes=" << pos
+                  << " pendingImageQWC=" << m_vif1PendingPath2ImageQwc << std::endl;
 }
