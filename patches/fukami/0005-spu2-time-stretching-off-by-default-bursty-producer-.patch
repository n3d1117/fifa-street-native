From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 03:52:03 +0200
Subject: [PATCH 5/6] spu2: time stretching off by default (bursty producer
 made it drop frames); underruns counted only after the first audible sample


diff --git a/tools/pcsx2-spu2/rrv_pcsx2_spu2.cpp b/tools/pcsx2-spu2/rrv_pcsx2_spu2.cpp
index 39b3e5e48a9df2a68ca74fee85de3f01a1948b3d..5f009ddecf8f055e16c1d2573012bb815445fea6 100644
--- a/tools/pcsx2-spu2/rrv_pcsx2_spu2.cpp
+++ b/tools/pcsx2-spu2/rrv_pcsx2_spu2.cpp
@@ -453,6 +453,7 @@ struct rrv_spu2
 	// without consuming or counting underruns, so playback begins with a cushion
 	// against the producer's per-frame burstiness instead of a permanently empty ring.
 	bool output_primed{false};
+	bool output_heard{false}; // consumer-thread only: a non-zero sample has been delivered
 	rrv_audio_stretcher audio_stretcher;
 	std::array<float, 64 * 2> stretch_input{};
 	size_t stretch_input_frames{};
@@ -772,7 +773,9 @@ rrv_spu2* rrv_spu2_create(const rrv_spu2_config* cfg)
 	if (cfg)
 		s->cfg = *cfg;
 		const char* stretch = std::getenv("PS2X_AUDIO_STRETCH");
-		s->stretch_enabled = !(stretch && stretch[0] == '0' && stretch[1] == '\0');
+		// Off by default: the guest clocks follow the host clock, and the adaptive stretcher reacts to the
+		// underrun counter of a bursty producer by dropping frames (measured: ~20% of output frames in a match).
+		s->stretch_enabled = stretch && stretch[0] == '1' && stretch[1] == '\0';
 	const u32 frames = next_pow2(s->cfg.output_ring_frames ? s->cfg.output_ring_frames : 8192);
 	s->ring.assign(size_t(frames) * 2, 0.0f);
 	s->ring_mask = frames - 1;
@@ -883,10 +886,17 @@ size_t rrv_spu2_pull_output(rrv_spu2* s, float* dst, size_t frames)
 		dst[2 * i + 1] = s->ring[j + 1];
 	}
 	s->ring_tail.store(tail + avail, std::memory_order_release);
+	if (!s->output_heard)
+	{
+		for (size_t i = 0; i < avail * 2 && !s->output_heard; i++)
+			s->output_heard = dst[i] != 0.0f;
+	}
 	if (avail < frames)
 	{
 		std::memset(dst + 2 * avail, 0, (frames - avail) * 2 * sizeof(float));
-		s->underruns.fetch_add(frames - avail, std::memory_order_relaxed);
+		// A gap before the first audible sample is silence either way (boot, while the IOP catches up).
+		if (s->output_heard)
+			s->underruns.fetch_add(frames - avail, std::memory_order_relaxed);
 	}
 	return avail;
 }
