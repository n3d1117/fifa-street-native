+struct RrvPresentPacer
+{
+    static constexpr double kNtscPeriod = 1001.0 / 60000.0;
+    bool have = false;
+    double target = 0.0;
+    double period = kNtscPeriod;
+
+    RrvPresentPacer()
+    {
+        if (const char* hz = std::getenv("RRV_PCSX2_GS_PRESENT_HZ"); hz && std::strcmp(hz, "50") == 0)
+            period = 1.0 / 50.0;
+    }
+    static RrvPresentPacer& Get()
+    {
+        static RrvPresentPacer pacer;
+        return pacer;
+    }
+    double Plan(double now)
+    {
+        const double earliest = now + 0.002;
+        const double next = target + period;
+        if (!have || earliest > next + 2.0 * period || next > earliest + 2.0 * period || earliest > next)
+            target = earliest;
+        else
+            target = std::max(earliest, next - 2e-6);
+        have = true;
+        return target;
+    }
+    void Present(id<MTLCommandBuffer> buffer, id<MTLDrawable> drawable, bool fifo)
+    {
+        if (fifo)
+            [buffer presentDrawable:drawable atTime:Plan(CACurrentMediaTime())];
+        else
+            [buffer presentDrawable:drawable];
+    }
+};
+}
