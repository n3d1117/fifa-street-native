+void GSSyncRasterizer()
+{
+	// RRV GS-bridge extension. Every bridge entry point that reads GS local
+	// memory behind the renderer's back must call this first: with
+	// GSOptions::SWExtraThreads > 0 the software rasterizer's workers are still
+	// writing the framebuffer/Z pages when Transfer() returns, and PCSX2's own
+	// equivalents (GSInitAndReadFIFO -> InitReadFIFO -> InvalidateLocalMem,
+	// GetOutput -> Sync(1)) do exactly this on the paths it owns. Cheap when
+	// nothing is queued; a no-op with a single-threaded or hardware renderer.
+	if (g_gs_renderer)
+		g_gs_renderer->RrvSyncRasterizer();
+}
+
+u32 GSReadCurrentFIFO(u8* mem, u32 max_bytes)
+{
+	if (!g_gs_renderer || !mem)
+		return 0;
+	GSSyncRasterizer();
+	return g_gs_renderer->RrvReadCurrentFIFO(mem, max_bytes);
+}
+
+bool GSReadLocalMemoryChecked(u8* mem, u32 byte_count, u64 BITBLITBUF, u64 TRXPOS, u64 TRXREG)
+{
+	if (!g_gs_renderer || !mem)
+		return false;
