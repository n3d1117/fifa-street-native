+                    decompressed[1] = scalar;
+                    decompressed[2] = scalar;
+                    decompressed[3] = scalar;
+                }
+                else
+                {
+                    const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                    for (uint32_t c = 0; c < limit; ++c)
+                    {
+                        decompressed[c] = sourceElement(c);
+                    }
+                }
+            }
+            else if (vl == 1u)
+            {
+                if (components == 1)
+                {
+                    const uint32_t scalar = sourceElement(0u);
+                    decompressed[0] = scalar;
+                    decompressed[1] = scalar;
+                    decompressed[2] = scalar;
+                    decompressed[3] = scalar;
+                }
+                else
+                {
+                    const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                    for (uint32_t c = 0; c < limit; ++c)
+                    {
+                        decompressed[c] = sourceElement(c);
+                    }
+                }
+            }
+            else if (vl == 2u)
+            {
+                if (components == 1)
+                {
+                    const uint32_t scalar = sourceElement(0u);
+                    decompressed[0] = scalar;
+                    decompressed[1] = scalar;
+                    decompressed[2] = scalar;
+                    decompressed[3] = scalar;
+                }
+                else
+                {
+                    const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                    for (uint32_t c = 0; c < limit; ++c)
+                    {
+                        decompressed[c] = sourceElement(c);
+                    }
+                }
+            }
+            else if (vl == 3u && vn == 3u)
+            {
+                // V4-5 expands 5:5:5:1 to the high bits of each 8-bit channel.
+                uint16_t packed = 0;
+                if (sourceByteOffset <= availableSourceBytes && sizeof(packed) <= availableSourceBytes - sourceByteOffset)
+                    std::memcpy(&packed, srcBase + sourceByteOffset, sizeof(packed));
+                decompressed[0] = (packed & 0x001Fu) << 3u;
+                decompressed[1] = (packed & 0x03E0u) >> 2u;
+                decompressed[2] = (packed & 0x7C00u) >> 7u;
+                decompressed[3] = (packed & 0x8000u) >> 8u;
+            }
+            else
+            {
+                handledFormat = false;
+            }
+
+            // Unknown compressed format fallback: preserve legacy raw-copy behavior.
+            if (!handledFormat && decoded && !maskEnable && (p.mode == 0u || p.mode == 3u))
+            {
+                uint32_t copyBytes = (bytesPerVector < 16u) ? bytesPerVector : 16u;
+                if (destinationData)
+                    std::memcpy(destinationData + destOff, srcVec, copyBytes);
+                continue;
+            }
+
+            const bool isV45 = (vl == 3u && vn == 3u);
+            // V2 repeats x/y into z/w. V3's fourth lane reads the next
+            // source element (the following vector's x), when present.
+            if (decoded && vn == 1u && vl <= 2u)
+            {
+                decompressed[2] = decompressed[0];
+                decompressed[3] = decompressed[1];
+            }
+            else if (decoded && vn == 2u && vl <= 2u)
+            {
+                decompressed[3] = sourceElement(3u);
+            }
+
+            const bool canAdd = !isV45;
+            const uint32_t mode = isV45 ? 0u : (p.mode & 3u);
+            const uint32_t colIdx = (cyclePos > 3u) ? 3u : cyclePos;
+            const uint32_t maskCycle = (cyclePos > 3u) ? 3u : cyclePos;
+
+            for (uint32_t field = 0u; field < 4u; ++field)
+            {
+                uint32_t maskSpec = 0u;
+                if (maskEnable)
+                {
+                    const uint32_t shift = ((maskCycle * 4u) + field) * 2u;
+                    maskSpec = (p.mask >> shift) & 0x3u;
+                }
+
+                uint32_t writeVal = lanes[field];
+                if (maskSpec == 0u)
+                {
+                    if (handledFormat)
+                    {
+                        writeVal = decompressed[field];
