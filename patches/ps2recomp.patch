+#include "ps2_data_stream.h"
+
+#if defined(__APPLE__)
+#include <pthread/qos.h>
+#endif
+#include "ThreadNaming.h"
+
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+#if defined(PS2X_USE_METAL)
+extern "C" int ps2x_metal_gs_create();
+extern "C" void ps2x_metal_gs_destroy();
+extern "C" int ps2x_metal_gs_submit(uint32_t, const uint8_t *, uint32_t);
+extern "C" int ps2x_metal_gs_reset();
+extern "C" int ps2x_metal_gs_write_csr(uint64_t, uint32_t, int);
+extern "C" int ps2x_metal_gs_vsync(const uint64_t *, uint64_t, uint32_t);
+extern "C" int ps2x_metal_gs_readback(uint64_t *, uint64_t *);
+extern "C" int ps2x_metal_gs_read_local_memory(uint8_t *, uint32_t, uint64_t, uint64_t, uint64_t);
+extern "C" uint32_t ps2x_metal_gs_read_fifo(uint8_t *, uint32_t);
+#endif
+
+namespace
+{
+    constexpr size_t kRingBytes = 16u * 1024u * 1024u;
+    // Larger packets are not copied into the ring; the EE waits while the
+    // worker reads them in place.
+    constexpr uint32_t kBorrowBytes = 1u * 1024u * 1024u;
+    constexpr uint32_t kEarlyPublishBytes = 64u * 1024u;
+    constexpr uint32_t kVifHeaderBytes = (sizeof(Vif1Op) + 15u) & ~15u;
+}
+
+DataStream::DataStream(PS2Memory &memory) : m_memory(memory), m_gs(memory.gs())
+{
+
+}
+
+DataStream::~DataStream()
+{
+    stop();
+}
+
+DataStream::Mode DataStream::defaultMode()
+{
+    return Mode::Worker;
+}
+
+bool DataStream::start(Mode mode)
+{
+    m_mode = mode;
+    m_previousVsyncEnd = 0;
+#if defined(PS2X_USE_METAL)
+    if (mode == Mode::Inline)
+        return ps2x_metal_gs_create() != 0;
+    m_ring = std::make_unique<StreamRing>(
+        kRingBytes, [this](const StreamRing::Op &op, const uint8_t *payload) { execute(op, payload); },
+        [](const StreamRing::Op &op) { return describe(op); });
+    const bool ok = m_ring->start([this] {
+                                      ThreadNaming::SetCurrentThreadName("VU1GSWorker");
+#if defined(__APPLE__)
+                                      pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+#endif
+                                      return ps2x_metal_gs_create() != 0;
+                                  },
+                                  [] { ps2x_metal_gs_destroy(); });
+    if (!ok)
+        m_ring.reset();
+    else
+        std::fprintf(stderr, "[data-stream] worker thread owns VU1, GIF and the GS bridge (%s)\n",
+                     mode == Mode::WorkerSync ? "drain at every kick" : "overlap");
+    return ok;
+#else
+    (void)mode;
+    return true;
+#endif
+}
+
+void DataStream::stop()
+{
+#if defined(PS2X_USE_METAL)
+    if (m_ring)
+    {
+        m_ring->stop();
+        m_ring.reset();
+    }
+    else
+    {
+        ps2x_metal_gs_destroy();
+    }
+#endif
+}
+
+std::string DataStream::describe(const StreamRing::Op &op)
+{
+    static const char *const names[] = {"?",          "GifPacket",  "GifDrain",   "Vif",       "GsReset",
+                                        "GsWriteCsr", "GsVsync",    "GsReadback", "GsReadLocal", "Fence", "GsReadFifo"};
+    std::string text = op.type < sizeof(names) / sizeof(names[0]) ? names[op.type] : "?";
+    text += " arg=0x";
+    char buffer[24];
+    std::snprintf(buffer, sizeof(buffer), "%llx", static_cast<unsigned long long>(op.arg));
+    return text + buffer;
+}
+
+void DataStream::endKick()
+{
+    if (--m_kickDepth != 0 || !deferred())
+        return;
+    m_ring->publish();
+    if (m_mode == Mode::WorkerSync)
+        m_ring->drain("kick end", false);
+}
+
+void DataStream::publishIfIdle()
+{
+    if (m_kickDepth == 0)
+    {
+        m_ring->publish();
+        if (m_mode == Mode::WorkerSync)
+            m_ring->drain("op");
+    }
+    else if (m_ring->pendingBytes() >= kEarlyPublishBytes)
+    {
+        m_ring->publish();
+    }
+}
+
+void DataStream::execute(const StreamRing::Op &op, const uint8_t *payload)
+{
+    switch (op.type)
+    {
+    case OpGifPacket:
+    {
+        GifHeader header;
+        std::memcpy(&header, payload, sizeof(header));
+        const uint8_t *data = (header.flags & 0x400u) ? header.borrowed : payload + sizeof(GifHeader);
+        GifArbiter *arbiter = m_memory.m_gifArbiter;
+        arbiter->submit(static_cast<GifPathId>(header.flags & 0xFFu), data, header.size,
+                        (header.flags & 0x100u) != 0u);
+        if (header.flags & 0x200u)
+            arbiter->drain();
+        break;
+    }
+    case OpGifDrain:
+        m_memory.m_gifArbiter->drain();
+        break;
+    case OpVif:
+    {
+        Vif1Op vif;
+        std::memcpy(&vif, payload, sizeof(vif));
+        vif.payload = vif.payloadBytes ? payload + kVifHeaderBytes : nullptr;
+        m_memory.applyVif1Op(vif);
+        if (vif.kind == Vif1OpKind::Mscal || vif.kind == Vif1OpKind::Mscnt)
+            m_mailbox.stopBits = m_memory.vu1Exec().stopBits;
+        break;
+    }
+    case OpGsReset:
+        execGsReset();
+        break;
+    case OpGsWriteCsr:
+    {
+        WriteCsrArgs args;
+        std::memcpy(&args, payload, sizeof(args));
+        execGsWriteCsr(args.csr, args.mask, args.high != 0u);
+        break;
+    }
+    case OpGsVsync:
+    {
+        VsyncArgs args;
+        std::memcpy(&args, payload, sizeof(args));
+        execGsVsync(args);
+        break;
+    }
+    case OpGsReadback:
+        readbackChecked(m_mailbox.csr, m_mailbox.siglblid);
+        break;
+    case OpGsReadLocal:
+    {
+        ReadLocalArgs args;
+        std::memcpy(&args, payload, sizeof(args));
+        m_mailbox.ok = gsReadLocal(args.dst, args.bytes, args.bitbltbuf, args.trxpos, args.trxreg);
+        break;
+    }
+    case OpFence:
+        break;
+    case OpGsReadFifo:
+    {
+        ReadLocalArgs args;
+        std::memcpy(&args, payload, sizeof(args));
+        m_mailbox.readBytes = gsReadFifo(args.dst, args.bytes);
+        break;
+    }
+    }
+}
+
+void DataStream::vifOp(const Vif1Op &op)
+{
+    if (!deferred())
+    {
+        m_memory.applyVif1Op(op);
+        return;
+    }
+    uint8_t header[kVifHeaderBytes] = {};
+    std::memcpy(header, &op, sizeof(op));
+    m_ring->push(OpVif, static_cast<uint64_t>(op.kind), header, kVifHeaderBytes, op.payload, op.payloadBytes);
+    publishIfIdle();
+}
+
+uint32_t DataStream::vu1Job(const Vif1Op &job, bool wait)
+{
+    if (!deferred())
+    {
+        m_memory.applyVif1Op(job);
+        return m_memory.vu1Exec().stopBits;
+    }
+    uint8_t header[kVifHeaderBytes] = {};
+    std::memcpy(header, &job, sizeof(job));
+    m_ring->push(OpVif, static_cast<uint64_t>(job.kind), header, kVifHeaderBytes);
+    m_gsStale = true;
+    publishIfIdle();
+    if (!wait)
+        return 0u;
+    m_ring->drain("MSCAL with D/T halt enabled");
+    return m_mailbox.stopBits;
+}
+
+void DataStream::gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl, bool drain)
+{
+    if (!deferred())
+    {
+        GifArbiter *arbiter = m_memory.m_gifArbiter;
+        arbiter->submit(path, data, sizeBytes, path2DirectHl);
+        if (drain)
+            arbiter->drain();
+        return;
+    }
+    const bool borrow = sizeBytes > kBorrowBytes;
+    GifHeader header{sizeBytes,
+                     static_cast<uint32_t>(path) | (path2DirectHl ? 0x100u : 0u) | (drain ? 0x200u : 0u) |
+                         (borrow ? 0x400u : 0u),
+                     borrow ? data : nullptr};
+    m_ring->push(OpGifPacket, static_cast<uint64_t>(path), &header, sizeof(header), borrow ? nullptr : data,
+                 borrow ? 0u : sizeBytes);
+    m_gsStale = true;
+    publishIfIdle();
+    if (borrow)
+        m_ring->drain("oversized GIF packet");
+}
+
+void DataStream::gifDrain()
+{
+    if (!deferred())
+    {
+        m_memory.m_gifArbiter->drain();
+        return;
+    }
+    m_ring->push(OpGifDrain, 0, nullptr, 0);
+    m_gsStale = true;
+    publishIfIdle();
+}
+
+#if defined(PS2X_USE_METAL)
+
+void DataStream::readbackChecked(uint64_t &csr, uint64_t &siglblid)
+{
+    if (!ps2x_metal_gs_readback(&csr, &siglblid))
+        throw std::runtime_error("native Metal GS CSR/SIGLBLID readback failed");
+
+}
+
+void DataStream::gifSubmit(GifPathId path, const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!ps2x_metal_gs_submit(static_cast<uint32_t>(path), data, sizeBytes))
+        throw std::runtime_error("native Metal GS rejected GIF packet");
+    if (!m_ring)
+        m_gsStale = true;
+
+}
+
+void DataStream::refreshGs()
+{
+    uint64_t csr = 0, siglblid = 0;
+    if (deferred())
+    {
+        m_ring->push(OpGsReadback, 0, nullptr, 0);
+        m_ring->drain("GS CSR/SIGLBLID observation");
+        csr = m_mailbox.csr;
+        siglblid = m_mailbox.siglblid;
+    }
+    else
+    {
+        readbackChecked(csr, siglblid);
+    }
+    if (deferred() && m_mode == Mode::Worker)
+    {
+        // FIELD belongs to the EE VBlank event, which may precede the queued GS VSync.
+        csr = (csr & ~0x2000ull) | (m_gs.csr.load(std::memory_order_acquire) & 0x2000ull);
+    }
+    m_gs.csr.store(csr, std::memory_order_release);
+    m_gs.siglblid = siglblid;
+    m_gsStale = false;
+}
+
+void DataStream::execGsReset()
+{
+    if (!ps2x_metal_gs_reset())
+        throw std::runtime_error("native Metal GS CSR reset failed");
+}
+
+void DataStream::execGsWriteCsr(uint64_t csr, uint32_t mask, bool high)
+{
+    if (!ps2x_metal_gs_write_csr(csr, mask, high ? 1 : 0))
+        throw std::runtime_error("native Metal GS CSR synchronization failed");
+}
+
+void DataStream::execGsVsync(const VsyncArgs &args)
+{
+    VsyncArgs snapshot = args;
+    if (snapshot.useBridgeCsr && !ps2x_metal_gs_readback(&snapshot.regs[15], &snapshot.regs[18]))
+        throw std::runtime_error("native Metal GS VSync readback failed");
+    if (!ps2x_metal_gs_vsync(snapshot.regs, args.tick, static_cast<uint32_t>(args.tick & 1u)))
+        throw std::runtime_error("native Metal GS VSync failed");
+    uint64_t *csr = &m_mailbox.csr;
+    uint64_t *siglblid = &m_mailbox.siglblid;
+    if (!ps2x_metal_gs_readback(csr, siglblid))
+        throw std::runtime_error("native Metal GS VSync readback failed");
+
+}
+
+void DataStream::gsReset()
+{
+    if (deferred())
+    {
+        m_ring->push(OpGsReset, 0, nullptr, 0);
+        publishIfIdle();
+        return;
+    }
+    execGsReset();
+}
+
+void DataStream::gsWriteCsr(uint64_t authoritativeCsr, uint32_t highWordMask, bool writeHighWord)
+{
+    if (deferred())
+    {
+        const WriteCsrArgs args{authoritativeCsr, highWordMask, writeHighWord ? 1u : 0u};
+        m_ring->push(OpGsWriteCsr, 0, &args, sizeof(args));
+        publishIfIdle();
+        return;
+    }
+    execGsWriteCsr(authoritativeCsr, highWordMask, writeHighWord);
+}
+
+void DataStream::gsVsync(uint64_t tick)
+{
+    const bool bridgeCsr = deferred() && m_gsStale;
+    if (!bridgeCsr)
+        observeGs();
+    VsyncArgs args{{m_gs.pmode, m_gs.smode1, m_gs.smode2, m_gs.srfsh, m_gs.synch1, m_gs.synch2, m_gs.syncv,
+                    m_gs.dispfb1, m_gs.display1, m_gs.dispfb2, m_gs.display2, m_gs.extbuf, m_gs.extdata,
+                    m_gs.extwrite, m_gs.bgcolor, m_gs.csr.load(), m_gs.imr, m_gs.busdir, m_gs.siglblid},
+                   tick,
+                   bridgeCsr ? 1u : 0u};
+    if (deferred())
+    {
+        const bool relaxed = m_mode == Mode::Worker;
+        if (relaxed && m_previousVsyncEnd)
+            m_ring->drainThrough(m_previousVsyncEnd, "previous GS vsync");
+        m_ring->push(OpGsVsync, tick, &args, sizeof(args));
+        m_previousVsyncEnd = m_ring->position();
+        m_ring->publish();
+        if (relaxed)
+        {
+            m_gsStale = true;
+            return;
+        }
+
+            m_ring->drain("GS vsync");
+
+    }
+    else
+    {
+        execGsVsync(args);
+    }
+    m_gs.csr.store(m_mailbox.csr, std::memory_order_release);
+    m_gs.siglblid = m_mailbox.siglblid;
+    m_gsStale = false;
+}
+
+bool DataStream::gsReadLocal(uint8_t *dst, uint32_t byteCount, uint64_t bitbltbuf, uint64_t trxpos,
+                             uint64_t trxreg)
+{
+    if (deferred())
+    {
+        const ReadLocalArgs args{dst, bitbltbuf, trxpos, trxreg, byteCount};
+        m_ring->push(OpGsReadLocal, byteCount, &args, sizeof(args));
+        m_ring->publish();
+        m_ring->drain("GS local-to-host read");
+        return m_mailbox.ok;
+    }
+    return ps2x_metal_gs_read_local_memory(dst, byteCount, bitbltbuf, trxpos, trxreg) != 0;
+}
+
+uint32_t DataStream::gsReadFifo(uint8_t *dst, uint32_t byteCount)
+{
+    if (deferred())
+    {
+        const ReadLocalArgs args{dst, 0, 0, 0, byteCount};
+        m_ring->push(OpGsReadFifo, byteCount, &args, sizeof(args));
+        m_ring->publish();
+        m_ring->drain("VIF1 GS download");
+        return m_mailbox.readBytes;
+    }
+    return ps2x_metal_gs_read_fifo(dst, byteCount);
+}
+
+#else
+
+void DataStream::readbackChecked(uint64_t &, uint64_t &) {}
+void DataStream::gifSubmit(GifPathId, const uint8_t *, uint32_t) {}
+void DataStream::refreshGs() {}
+void DataStream::execGsReset() {}
+void DataStream::execGsWriteCsr(uint64_t, uint32_t, bool) {}
+void DataStream::execGsVsync(const VsyncArgs &) {}
+void DataStream::gsReset() {}
+void DataStream::gsWriteCsr(uint64_t, uint32_t, bool) {}
+void DataStream::gsVsync(uint64_t) {}
+bool DataStream::gsReadLocal(uint8_t *, uint32_t, uint64_t, uint64_t, uint64_t) { return false; }
+uint32_t DataStream::gsReadFifo(uint8_t *dst, uint32_t bytes)
+{
+    return m_memory.m_gsReadFifoCallback ? m_memory.m_gsReadFifoCallback(dst, bytes) : 0u;
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.h b/ps2xRuntime/src/lib/ps2_data_stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..e5865873ec7e9eab8287750a3fd48cb34af5a6af
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_data_stream.h
@@ -0,0 +1,166 @@
+#ifndef PS2_DATA_STREAM_H
+#define PS2_DATA_STREAM_H
+
+#include <cstdint>
+#include <memory>
+
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_stream_ring.h"
+#include "ps2_vif1_ops.h"
+
+// The one ordered interface to the data side: VU1 jobs, GIF packets and the
+// native GS bridge. Producers on the EE call these methods in guest order. In
+// inline mode each call executes immediately on the calling thread. In worker
+// mode the call is copied into an SPSC ring and a worker thread, which owns VU1
+// memory, the GIF arbiter and the GS bridge, executes the ops in the same order.
+//
+// The EE blocks (barrier) only where it observes data-side state: GS CSR and
+// SIGLBLID (observeGs), VU1 code/data accessed by guest loads and stores, an
+// MSCAL/MSCNT whose FBRST D/T enables make the VPU_STAT stop bits depend on the
+// run, GS local-to-host reads, GS vsync, initialize and shutdown.
+//
+// GS CSR and SIGLBLID are a pure function of the packets the bridge has
+// processed. They are read back lazily: submitting only marks them stale, and
+// observeGs() is the explicit drain point that must run before the EE reads or
+// writes any GS privileged register.
+class DataStream
+{
+public:
+    enum class Mode
+    {
+        Inline,     // every op executes on the calling thread
+        Worker,     // a worker executes ops; the EE blocks only at barriers
+        WorkerSync, // as Worker, but the EE also waits at the end of every kick
+    };
+
+    explicit DataStream(PS2Memory &memory);
+    ~DataStream();
+
+    // Creates the GS bridge on its owner thread (the worker, or this thread
+    // inline). stop() destroys it there after draining.
+    bool start(Mode mode);
+    void stop();
+
+    // Waits until the data side has executed every op issued so far.
+    void barrier(const char *why)
+    {
+        if (deferred())
+            m_ring->drain(why);
+    }
+
+    // A kick is one DMA transfer or FIFO store. Ops are published to the worker
+    // when the outermost kick ends.
+    class KickScope
+    {
+    public:
+        explicit KickScope(DataStream &stream) : m_stream(stream) { ++m_stream.m_kickDepth; }
+        ~KickScope() { m_stream.endKick(); }
+        KickScope(const KickScope &) = delete;
+        KickScope &operator=(const KickScope &) = delete;
+
+    private:
+        DataStream &m_stream;
+    };
+
+    // VU1 side ops from the VIF1 front end.
+    void vifOp(const Vif1Op &op);
+    // MSCAL/MSCNT. With wait set the stop bits of the finished job are returned;
+    // otherwise the job may still be running and 0 is returned.
+    uint32_t vu1Job(const Vif1Op &job, bool wait);
+
+    // GIF arbiter ops. gifPacket is arbiter submit followed by drain when
+    // requested; gifDrain is an arbiter batch boundary.
+    void gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl, bool drain);
+    void gifDrain();
+
+    // The arbiter's process function: one packet to the GS bridge.
+    void gifSubmit(GifPathId path, const uint8_t *data, uint32_t sizeBytes);
+
+    void gsReset();
+    void gsWriteCsr(uint64_t authoritativeCsr, uint32_t highWordMask, bool writeHighWord);
+    void gsVsync(uint64_t tick);
+    bool gsReadLocal(uint8_t *dst, uint32_t byteCount, uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg);
+    uint32_t gsReadFifo(uint8_t *dst, uint32_t byteCount);
+
+    void observeGs()
+    {
+        if (m_gsStale)
+            refreshGs();
+    }
+
+    static Mode defaultMode();
+
+private:
+    enum OpType : uint32_t
+    {
+        OpGifPacket = 1,
+        OpGifDrain,
+        OpVif,
+        OpGsReset,
+        OpGsWriteCsr,
+        OpGsVsync,
+        OpGsReadback,
+        OpGsReadLocal,
+        OpFence,
+        OpGsReadFifo,
+    };
+
+    struct GifHeader
+    {
+        uint32_t size;
+        uint32_t flags; // bits 0-7 path, 8 DIRECTHL, 9 drain, 10 borrowed
+        const uint8_t *borrowed;
+    };
+    struct WriteCsrArgs
+    {
+        uint64_t csr;
+        uint32_t mask;
+        uint32_t high;
+    };
+    struct VsyncArgs
+    {
+        uint64_t regs[19];
+        uint64_t tick;
+        uint32_t useBridgeCsr; // CSR and SIGLBLID in regs are stale: take the bridge's
+    };
+    struct ReadLocalArgs
+    {
+        uint8_t *dst;
+        uint64_t bitbltbuf;
+        uint64_t trxpos;
+        uint64_t trxreg;
+        uint32_t bytes;
+    };
+    struct Mailbox
+    {
+        uint64_t csr = 0;
+        uint64_t siglblid = 0;
+        uint32_t stopBits = 0;
+        uint32_t readBytes = 0;
+        bool ok = false;
+    };
+
+    bool deferred() const { return m_ring && !m_ring->onConsumerThread(); }
+
+private:
+    void execute(const StreamRing::Op &op, const uint8_t *payload);
+    static std::string describe(const StreamRing::Op &op);
+    void endKick();
+    void publishIfIdle();
+    void refreshGs();
+    void readbackChecked(uint64_t &csr, uint64_t &siglblid);
+    void execGsReset();
+    void execGsWriteCsr(uint64_t csr, uint32_t mask, bool high);
+    void execGsVsync(const VsyncArgs &args);
+
+    PS2Memory &m_memory;
+    GSRegisters &m_gs;
+    std::unique_ptr<StreamRing> m_ring;
+    Mode m_mode = Mode::Inline;
+    int m_kickDepth = 0;
+    bool m_gsStale = false;
+    uint64_t m_previousVsyncEnd = 0;
+    Mailbox m_mailbox;
+};
+
+#endif
