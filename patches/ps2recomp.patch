+void PS2Memory::resumeVif1AfterStall()
+{
+    if (!m_vif1Stalled)
+        return;
+
+    m_vif1Stalled = false;
+    const size_t pendingSize = m_vif1PendingInput.size() - m_vif1PendingInputOffset;
+    if (pendingSize != 0u)
+        processVIF1Data(m_vif1PendingInput.data() + m_vif1PendingInputOffset,
+                        static_cast<uint32_t>(pendingSize));
+    else
+        m_vif1PendingInput.clear();
