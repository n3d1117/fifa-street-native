-    do                                                    \
-    {                                                     \
-        int32_t _a = (int32_t)(rs);                       \
-        int32_t _b = (int32_t)(rt);                       \
-        int32_t _r = _a + _b;                             \
-        overflow = (((_a ^ _b) >= 0) && ((_a ^ _r) < 0)); \
-        result32 = (uint32_t)_r;                          \
-    } while (0);
