+                                                      uint32_t dx, uint32_t dy)
+        {
+            const bool interlaced = (g_gparam.interlace & 1u) != 0u;
+            const bool frame_mode = (g_gparam.ffmode & 1u) != 0u;
+            const uint32_t omode = g_gparam.omode;
+            const bool pal = omode == 3u || omode == 0x73u;
+            const bool ntsc = omode == 2u || omode == 0x72u;
+
+            uint32_t magh = 0u;
+            uint32_t disp_width = width - 1u;
+            uint32_t disp_height = height - 1u;
+            uint32_t display_dx = dx;
+            uint32_t display_dy = dy;
+            uint64_t smode2 = (static_cast<uint64_t>(interlaced ? 1u : 0u)) |
+                              (static_cast<uint64_t>(interlaced ? (frame_mode ? 1u : 0u) : 1u) << 1u);
+
+            if (pal || ntsc)
+            {
+                const uint32_t clock_factor = (2560u + width - 1u) / width;
+                magh = clock_factor - 1u;
+                disp_width = width * clock_factor - 1u;
+                disp_height = height * (interlaced && frame_mode ? 2u : 1u) - 1u;
+                display_dx = dx * clock_factor + (pal ? 0x293u : 0x27Eu);
+                display_dy = dy + (pal ? (interlaced ? 72u : 36u)
