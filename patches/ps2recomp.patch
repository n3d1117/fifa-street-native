--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_vif1_ops.h
@@ -0,0 +1,48 @@
+#ifndef PS2_VIF1_OPS_H
+#define PS2_VIF1_OPS_H
+
+#include <cstdint>
+
+enum class Vif1OpKind : uint8_t
+{
+    Mpg,
+    Unpack,
+    Mscal,
+    Mscnt,
+    Direct,
+    Path3Unmask,
+};
+
+struct Vif1UnpackParams
+{
+    uint8_t opcode = 0;
+    uint32_t writeVectorCount = 0;
+    uint32_t sourceVectorCount = 0;
+    uint32_t bytesPerVector = 0;
+    uint32_t cl = 0;
+    uint32_t wl = 0;
+    uint32_t vuAddr = 0;
+    uint32_t mode = 0;
+    uint32_t mask = 0;
+    uint32_t row[4] = {};
+    uint32_t col[4] = {};
+    bool zeroExtend = false;
+};
+
+// One data-side operation produced by the VIF1 front end, in command order.
+// payload points into the caller's input and is only valid during emit; a
+// deferred consumer must copy it.
+struct Vif1Op
+{
+    Vif1OpKind kind = Vif1OpKind::Mpg;
+    const uint8_t *payload = nullptr;
+    uint32_t payloadBytes = 0;
+    uint32_t addr = 0; // MPG destination byte address, MSCAL start PC
+    uint32_t top = 0;
+    uint32_t itop = 0;
+    bool directHl = false;
+    uint32_t dtEnable = 0; // MSCAL/MSCNT: FBRST D (bit 0) and T (bit 1) halt enables at issue
+    Vif1UnpackParams unpack;
+};
+
+#endif
