+        // expression reduces to vuAddr+i. The guard also makes its bounds
+        // check unconditional: no destination can wrap or exceed VU1 memory.
+        if (opcode == 0x6Cu)
+        {
+            for (uint32_t i = 0u; i < writeVectorCount; ++i)
+            {
+                std::memcpy(vu1Data + (vuAddr + i) * 16u,
+                            srcBase + static_cast<size_t>(i) * bytesPerVector, 16u);
+            }
+        }
+        else if (opcode == 0x6Du)
+        {
+            for (uint32_t i = 0u; i < writeVectorCount; ++i)
+            {
+                uint16_t sourceLanes[4];
+                uint32_t destinationLanes[4];
+                std::memcpy(sourceLanes, srcBase + static_cast<size_t>(i) * bytesPerVector,
+                            sizeof(sourceLanes));
+                destinationLanes[0] = sourceLanes[0];
+                destinationLanes[1] = sourceLanes[1];
+                destinationLanes[2] = sourceLanes[2];
+                destinationLanes[3] = sourceLanes[3];
+                std::memcpy(vu1Data + (vuAddr + i) * 16u, destinationLanes, sizeof(destinationLanes));
+            }
+        }
+        else
+        {
+            for (uint32_t i = 0u; i < writeVectorCount; ++i)
+            {
+                uint8_t sourceLanes[4];
+                uint32_t destinationLanes[4];
+                std::memcpy(sourceLanes, srcBase + static_cast<size_t>(i) * bytesPerVector,
+                            sizeof(sourceLanes));
+                destinationLanes[0] = sourceLanes[0];
+                destinationLanes[1] = sourceLanes[1];
+                destinationLanes[2] = sourceLanes[2];
+                destinationLanes[3] = sourceLanes[3];
+                std::memcpy(vu1Data + (vuAddr + i) * 16u, destinationLanes, sizeof(destinationLanes));
+            }
+        }
+
+        return;
+    }
