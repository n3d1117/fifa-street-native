diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7180acd2aabd4cd3ce7a1ac993821c69f807245e
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
@@ -0,0 +1,332 @@
+// Native VU1 microprogram registry, MSCAL dispatcher, PATH1 (XGKICK) model and
+// the native dispatcher. See include/runtime/ps2_vu1_recomp.h.
+
+#include "runtime/ps2_vu1_recomp.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/ps2_memory.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+struct Vu1NativeDispatcher::PacketCapture
+{
+    std::vector<std::vector<uint8_t>> packets;
+    size_t count = 0;
+
+    void reset() { count = 0; }
+
+    static void sink(void *user, const uint8_t *data, uint32_t size)
+    {
+        auto *self = static_cast<PacketCapture *>(user);
+        if (self->count == self->packets.size())
+            self->packets.emplace_back(data, data + size);
+        else
+            self->packets[self->count].assign(data, data + size);
+        ++self->count;
+    }
+};
+
+namespace
+{
+
+    void submitPacket(Vu1RecContext &ctx, const uint8_t *data, uint32_t size)
+    {
+        if (ctx.sink)
+            ctx.sink(ctx.sinkUser, data, size);
+        else if (ctx.memory)
+            ctx.memory->submitGifPacket(GifPathId::Path1, data, size);
+        else if (ctx.gs)
+            ctx.gs->processGIFPacket(data, size);
+    }
+
+    // One PATH1 transfer step: exactly the loop body of VU1Interpreter::progressXgkick.
+    // Returns false when the transfer ended (finished or aborted).
+    bool kickStep(Vu1RecContext &ctx)
+    {
+        Vu1RecKick &k = ctx.kick;
+        const uint32_t dataSize = PS2_VU1_DATA_SIZE;
+        if (k.copiedBytes > Vu1RecKick::kBufferSize - 16u)
+        {
+            ++ctx.kickErrors;
+            ctx.failed = true;
+            k.active = false;
+            return false;
+        }
+        const uint64_t eventCycle = k.issueCycle + 1u + 2u * (k.copiedBytes / 16u);
+        const uint32_t qwordOffset = k.copiedBytes;
+        for (uint32_t i = 0; i < 16u; ++i)
+        {
+            const uint32_t source = (k.sourceAddress + k.copiedBytes + i) % dataSize;
+            k.packet[k.copiedBytes + i] = ctx.data[source];
+        }
+        k.copiedBytes += 16u;
+
+        if (k.currentTagEnd == 0u)
+        {
+            uint64_t tagLo = 0;
+            std::memcpy(&tagLo, k.packet.data() + qwordOffset, sizeof(tagLo));
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const uint32_t format = static_cast<uint32_t>((tagLo >> 58) & 0x3u);
+            uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+            uint64_t tagBytes = 16u;
+            if (format == 0u)
+                tagBytes += static_cast<uint64_t>(nloop) * nreg * 16u;
+            else if (format == 1u)
+                tagBytes += ((static_cast<uint64_t>(nloop) * nreg + 1u) & ~1ull) * 8u;
+            else if (format == 2u)
+                tagBytes += static_cast<uint64_t>(nloop) * 16u;
+            else
+            {
+                ++ctx.kickErrors;
+                ctx.failed = true;
+                k.active = false;
+                return false;
+            }
+            if (tagBytes > Vu1RecKick::kBufferSize - qwordOffset)
+            {
+                ++ctx.kickErrors;
+                ctx.failed = true;
+                k.active = false;
+                return false;
+            }
+            k.currentTagEnd = qwordOffset + static_cast<uint32_t>(tagBytes);
+            k.currentTagEop = ((tagLo >> 15) & 1u) != 0u;
+            if (k.currentTagEop)
+                k.totalBytes = k.currentTagEnd;
+        }
+
+        if (k.copiedBytes >= k.currentTagEnd)
+        {
+            if (k.currentTagEop)
+            {
+                k.active = false;
+                k.finishCycle = eventCycle;
+                submitPacket(ctx, k.packet.data(), k.totalBytes);
+                return false;
+            }
+            k.currentTagEnd = 0u;
+            k.currentTagEop = false;
+        }
+        return true;
+    }
+}
+
+namespace
+{
+    std::vector<Vu1RecProgram> &programRegistry()
+    {
+        static std::vector<Vu1RecProgram> programs;
+        return programs;
+    }
+}
+
+void vu1recRegisterProgram(const Vu1RecProgram &program)
+{
+    programRegistry().push_back(program);
+}
+
+size_t vu1recProgramCount()
+{
+    return programRegistry().size();
+}
+
+void vu1rec_kick_start(Vu1RecContext &ctx, uint32_t qwordAddress, uint64_t cycle)
+{
+    Vu1RecKick &k = ctx.kick;
+    k.active = true;
+    k.currentTagEop = false;
+    k.sourceAddress = (qwordAddress * 16u) % PS2_VU1_DATA_SIZE;
+    k.totalBytes = 0u;
+    k.copiedBytes = 0u;
+    k.currentTagEnd = 0u;
+    k.issueCycle = cycle;
+}
+
+void vu1rec_kick_catchup(Vu1RecContext &ctx, uint64_t cycle)
+{
+    Vu1RecKick &k = ctx.kick;
+    while (k.active && k.issueCycle + 1u + 2u * (k.copiedBytes / 16u) <= cycle)
+    {
+        if (!kickStep(ctx))
+            break;
+    }
+}
+
+uint64_t vu1rec_kick_drain(Vu1RecContext &ctx)
+{
+    while (ctx.kick.active)
+    {
+        if (!kickStep(ctx))
+            break;
+    }
+    return ctx.kick.finishCycle;
+}
+
+// ---------------------------------------------------------------------------
+
+Vu1NativeDispatcher::Vu1NativeDispatcher()
+{
+    m_ctx = new Vu1RecContext();
+    m_packetPool = new PacketCapture();
+}
+
+Vu1NativeDispatcher::~Vu1NativeDispatcher()
+{
+    delete m_packetPool;
+    delete m_ctx;
+}
+
+// A program is placed where every one of its words matches micro memory exactly;
+// micro memory only changes between dispatches, so no per-pair guard is needed.
+const Vu1RecProgram *Vu1NativeDispatcher::findProgram(PS2Memory &memory, uint32_t pc, uint32_t &base)
+{
+    const std::vector<Vu1RecProgram> &programs = programRegistry();
+    if (programs.empty())
+        return nullptr;
+    const uint8_t *code = memory.getVU1Code();
+    const uint64_t generation = memory.getVU1CodeGeneration();
+    if (code != m_placementCode || generation != m_placementGeneration)
+    {
+        m_placementCode = code;
+        m_placementGeneration = generation;
+        m_placements.clear();
+        for (const Vu1RecProgram &program : programs)
+        {
+            const uint32_t bytes = program.slots * 8u;
+            for (uint32_t at = 0; at + bytes <= PS2_VU1_CODE_SIZE; at += 8u)
+            {
+                uint64_t first;
+                std::memcpy(&first, code + at, sizeof(first));
+                if (first == program.words[0] && std::memcmp(code + at, program.words, bytes) == 0)
+                    m_placements.push_back({&program, at});
+            }
+        }
+    }
+    for (const Placement &placement : m_placements)
+    {
+        if (pc >= placement.base && pc - placement.base < placement.program->slots * 8u &&
+            placement.program->hasEntry(pc - placement.base))
+        {
+            base = placement.base;
+            return placement.program;
+        }
+    }
+    return nullptr;
+}
+
+namespace
+{
+    // VU1Interpreter::execute() preamble.
+    void prepareState(VU1State &st, uint32_t startPC, uint32_t top, uint32_t itop, bool resume = false)
+    {
+        if (resume) { st.top = top; st.itop = itop; st.stoppedByD = false; st.stoppedByT = false; return; }
+        st.pc = startPC & 0x3FFFu;
+        st.ebit = false;
+        st.haltAfterDelaySlot = false;
+        st.stoppedByD = false;
+        st.stoppedByT = false;
+        st.top = top;
+        st.itop = itop;
+        st.branchPending = false;
+        st.branchTarget = 0;
+        st.branchDelay = 0;
+        st.vf[0][0] = 0.0f;
+        st.vf[0][1] = 0.0f;
+        st.vf[0][2] = 0.0f;
+        st.vf[0][3] = 1.0f;
+    }
+
+    void resetContext(Vu1RecContext &ctx, VU1State *st, uint8_t *data, uint64_t cycle, uint32_t maxCycles,
+                      uint32_t top, uint32_t itop, PS2Memory *memory, GS *gs)
+    {
+        ctx.state = st;
+        ctx.data = data;
+        ctx.cycle = cycle;
+        ctx.maxCycles = maxCycles;
+        ctx.top = top;
+        ctx.itop = itop;
+        ctx.memory = memory;
+        ctx.gs = gs;
+        ctx.sink = nullptr;
+        ctx.sinkUser = nullptr;
+        ctx.failed = false;
+        ctx.failPc = 0;
+        ctx.kickErrors = 0;
+        ctx.backupReg = 0;
+        ctx.backupValue = 0;
+        ctx.kick.active = false;
+        ctx.kick.finishCycle = 0;
+    }
+
+}
+
+bool Vu1NativeDispatcher::mscal(VU1Interpreter &vu1, PS2Memory &memory, GS &gs,
+                                uint32_t startPC, uint32_t top, uint32_t itop, uint32_t maxCycles)
+{
+    return dispatch(vu1, memory, gs, startPC, top, itop, maxCycles, false);
+}
+
+bool Vu1NativeDispatcher::mscnt(VU1Interpreter &vu1, PS2Memory &memory, GS &gs,
+                                uint32_t top, uint32_t itop, uint32_t maxCycles)
+{
+    // Only fully drained continuations with no carried branch hazard can use
+    // a statically scheduled entry with an empty initial pipeline.
+    if (!vu1.canNativeResume())
+        return false;
+    return dispatch(vu1, memory, gs, vu1.state().pc, top, itop, maxCycles, true);
+}
+
+bool Vu1NativeDispatcher::dispatch(VU1Interpreter &vu1, PS2Memory &memory, GS &gs,
+                                uint32_t startPC, uint32_t top, uint32_t itop, uint32_t maxCycles, bool resume)
+{
+    const uint32_t pc = startPC & 0x3FFFu;
+    uint32_t relocBase = 0;
+    const Vu1RecProgram *program = findProgram(memory, pc, relocBase);
+
+    if (!program)
+    {
+        return false;
+    }
+    if (program->hasDebugBits && (vu1.state().dBitEnabled || vu1.state().tBitEnabled))
+    {
+        return false;
+    }
+
+    // Stage all observable output until the native call succeeds. A new
+    // indirect target or exhausted budget must not leak partial registers,
+    // stores or GIF packets into the interpreter fallback.
+    VU1State stagedState = vu1.state();
+    prepareState(stagedState, startPC, top, itop, resume);
+    std::array<uint8_t, PS2_VU1_DATA_SIZE> stagedData;
+    std::memcpy(stagedData.data(), memory.getVU1Data(), stagedData.size());
+    PacketCapture &stagedPackets = *m_packetPool;
+    stagedPackets.reset();
+    Vu1RecContext &ctx = *m_ctx;
+    const uint64_t startCycle = vu1.cycleCount();
+    resetContext(ctx, &stagedState, stagedData.data(), startCycle, maxCycles, top, itop, nullptr, nullptr);
+    ctx.code = memory.getVU1Code();
+    ctx.relocBase = relocBase;
+    ctx.sink = &PacketCapture::sink;
+    ctx.sinkUser = &stagedPackets;
+    program->run(ctx, pc);
+    if (ctx.failed)
+    {
+        return false;
+    }
+    vu1.state() = stagedState;
+    std::memcpy(memory.getVU1Data(), stagedData.data(), stagedData.size());
+    for (size_t i = 0; i < stagedPackets.count; ++i)
+    {
+        const auto &packet = stagedPackets.packets[i];
+        memory.submitGifPacket(GifPathId::Path1, packet.data(), static_cast<uint32_t>(packet.size()));
+    }
+    vu1.adoptNativeCompletion(ctx.cycle, ctx.backupReg, ctx.backupValue);
+    return true;
+}
