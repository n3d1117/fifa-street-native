+                        }
+                        else if (canAdd && mode == 3u)
+                        {
+                            destinationRow[field] = writeVal;
+                        }
+                    }
+                }
+                else if (maskSpec == 1u)
+                {
+                    writeVal = destinationRow[field];
+                }
+                else if (maskSpec == 2u)
+                {
+                    writeVal = p.col[colIdx];
+                }
+                else
+                {
+                    continue; // write-protect
+                }
+
+                lanes[field] = writeVal;
+            }
+
+            if (destinationData)
+                std::memcpy(destinationData + destOff, lanes, sizeof(lanes));
+        }
+    };
+
+    runGeneral(vu1Data, row);
