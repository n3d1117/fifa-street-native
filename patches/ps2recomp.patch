diff --git a/ps2xRuntime/include/runtime/ps2_display_timing.h b/ps2xRuntime/include/runtime/ps2_display_timing.h
new file mode 100644
index 0000000000000000000000000000000000000000..97369b6c63d15e3da1e58be0fd7a22794a542642
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_display_timing.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+class PS2Memory;
+
+// Returns the effective guest VBlank period, including the opt-in cadence
+// experiment, using the same GS mode as EeScheduler.
+uint64_t ps2VsyncPeriodMicroseconds(const PS2Memory &memory);
+
+namespace ps2x::display_timing
+{
+    constexpr uint64_t kQ32One = 1ull << 32u;
+
+    inline uint64_t mpegPtsDeltaToVsyncQ32(uint64_t delta90k, uint64_t periodUs)
+    {
+        if (periodUs == 0u || delta90k > std::numeric_limits<uint64_t>::max() / 1000000u)
+        {
+            return std::numeric_limits<uint64_t>::max();
+        }
+
+        const uint64_t numerator = delta90k * 1000000u;
+        const uint64_t denominator = 90000u * periodUs;
+        const uint64_t whole = numerator / denominator;
+        const uint64_t remainder = numerator % denominator;
+        if (whole > std::numeric_limits<uint64_t>::max() / kQ32One)
+        {
+            return std::numeric_limits<uint64_t>::max();
+        }
+
+        const uint64_t wholeQ32 = whole * kQ32One;
+        const uint64_t remainderQ32 =
+            (remainder * kQ32One + denominator / 2u) / denominator;
+        return wholeQ32 > std::numeric_limits<uint64_t>::max() - remainderQ32
+                   ? std::numeric_limits<uint64_t>::max()
+                   : wholeQ32 + remainderQ32;
+    }
+
+    // MPEG sequence-header intervals are stored in NTSC 59.94-Hz field ticks.
+    inline uint64_t canonicalMpegTicksToVsyncQ32(uint64_t ticksQ32, uint64_t periodUs)
+    {
+        if (periodUs == 0u)
+        {
+            return std::numeric_limits<uint64_t>::max();
+        }
+
+        // (1001 / 60000 seconds per canonical tick) / guest period.
+        uint64_t numerator = 1001000000u;
+        uint64_t denominator = 60000u * periodUs;
+        uint64_t a = numerator;
+        uint64_t b = denominator;
+        while (b != 0u)
+        {
+            const uint64_t remainder = a % b;
+            a = b;
+            b = remainder;
+        }
+        numerator /= a;
+        denominator /= a;
+
+        const uint64_t whole = ticksQ32 / denominator;
+        const uint64_t remainder = ticksQ32 % denominator;
+        if (whole > std::numeric_limits<uint64_t>::max() / numerator)
+        {
+            return std::numeric_limits<uint64_t>::max();
+        }
+        const uint64_t wholeScaled = whole * numerator;
+        const uint64_t remainderScaled = (remainder * numerator + denominator / 2u) / denominator;
+        return wholeScaled > std::numeric_limits<uint64_t>::max() - remainderScaled
+                   ? std::numeric_limits<uint64_t>::max()
+                   : wholeScaled + remainderScaled;
+    }
+}
diff --git a/ps2xRuntime/include/runtime/ps2_host_arena.h b/ps2xRuntime/include/runtime/ps2_host_arena.h
new file mode 100644
index 0000000000000000000000000000000000000000..f53a5a725e409278296173ef4a57faea7e20b9f9
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_arena.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// Configure guest-RAM ranges reserved for runtime-owned heap allocations and asynchronous callback stacks.
+// The caller must set this before loadELF() and ensure neither range overlaps any guest ELF PT_LOAD segment.
+// Ranges are half-open, 16-byte aligned, inside EE RDRAM, and must not overlap each other.
+// Passing four zeroes disables the override.
+void ps2SetRuntimeArena(uint32_t heapBase, uint32_t heapLimit, uint32_t stackFloor, uint32_t stackTop);
+
+// SIF RPC packets are runtime-owned guest RAM: 64 KiB at this base (default 0x1F00000 for fixtures).
+// The caller must keep it clear of every guest segment, heap and stack (the kernel arena is the place).
+void ps2SetRpcPacketPoolBase(uint32_t base);
+uint32_t ps2RpcPacketPoolBase();
+
+// Either range may be disabled independently by passing zero for both bounds.
+
+// Host-owned timing configuration, set once before PS2Runtime::initialize().
+// Defaults reproduce deterministic estimated-cycle timing (used by the tests).
+struct PS2HostConfig
+{
+    // Pace guest hardware time from the host clock (strict: never behind it,
+    // never ahead of it by estimated block costs).
+    bool wallClock = false;
+    // Guest VBlank cadence override: 0 keeps the video mode's own rate; 60 or 120.
+    uint32_t vsyncHz = 0;
+    // Lowest address the IOP module loader may relocate into; 0 keeps the default.
+    uint32_t iopHeapFloor = 0;
+};
+void ps2SetHostConfig(const PS2HostConfig &config);
+const PS2HostConfig &ps2HostConfig();
+
+// Kernel RAM the runtime owns: below the lowest load segment, where no game ELF places data and the
+// game's own heap and stack never reach. From the top down: callback/interrupt stacks (128 KiB), SIF RPC
+// packets (64 KiB), then the runtime heap used by HLE packets and buffers (the rest, at least 64 KiB, down
+// to the 0x10000 floor). Segments are half-open [begin, end). Returns false when the range does not fit or
+// a segment overlaps it. All bounds are 16-byte aligned.
+struct PS2KernelArena
+{
+    uint32_t heapBase = 0, heapLimit = 0;
+    uint32_t rpcPoolBase = 0;
+    uint32_t stackFloor = 0, stackTop = 0;
+};
+
+inline bool ps2KernelArena(const std::vector<std::pair<uint32_t, uint32_t>> &loadSegments, PS2KernelArena &arena)
+{
+    constexpr uint32_t kFloor = 0x00010000u;
+    constexpr uint32_t kStackBytes = 0x00020000u;
+    constexpr uint32_t kRpcPoolBytes = 0x00010000u;
+    constexpr uint32_t kMinHeapBytes = 0x00010000u;
+    if (loadSegments.empty())
+        return false;
+    uint32_t lowest = 0xFFFFFFFFu;
+    for (const auto &segment : loadSegments)
+        lowest = std::min(lowest, segment.first);
+    const uint32_t top = lowest & ~0xFu;
+    if (top < kFloor + kStackBytes + kRpcPoolBytes + kMinHeapBytes)
+        return false;
+    PS2KernelArena next;
+    next.stackTop = top;
+    next.stackFloor = top - kStackBytes;
+    next.rpcPoolBase = next.stackFloor - kRpcPoolBytes;
+    next.heapLimit = next.rpcPoolBase;
+    next.heapBase = kFloor;
+    for (const auto &segment : loadSegments)
+    {
+        if (segment.second > next.heapBase && segment.first < top)
+            return false;
+    }
+    arena = next;
+    return true;
+}
