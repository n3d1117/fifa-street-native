+inline void ps2x_decode_pad_actuators(const uint8_t align[6], const uint8_t data[6], uint8_t& small, uint8_t& large)
+{
+    small = 0u;
+    large = 0u;
+    for (unsigned i = 0; i < 6; ++i)
+    {
+        if (align[i] == 0u)
+            small = static_cast<uint8_t>(data[i] & 1u);
+        else if (align[i] == 1u)
+            large = data[i];
+    }
+}
