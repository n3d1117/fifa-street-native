+
+        memory.m_vif1PendingCommandIrq = false;
+        if ((memory.vif1_regs.stat & (1u << 13u)) != 0u) // Invalid commands do not deliver a VIF IRQ.
+            return false;
+        memory.vif1_regs.stat |= (1u << 11u);
