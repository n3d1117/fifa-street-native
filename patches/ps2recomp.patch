+                u.bytesPerVector = bytesPerVector;
+                u.cl = cl;
+                u.wl = wl;
+                u.vuAddr = vuAddr;
+                u.mode = vif1_regs.mode;
+                u.mask = vif1_regs.mask;
+                std::memcpy(u.row, vif1_regs.row, sizeof(u.row));
+                std::memcpy(u.col, vif1_regs.col, sizeof(u.col));
+                u.zeroExtend = (imm & 0x4000u) != 0u;
+                emit(op);
+                // STMOD 2/3 write the accumulated offset back to ROW, which the
+                // guest can read; recompute it here without touching VU1 memory.
+                if ((vif1_regs.mode & 3u) >= 2u)
+                    unpackVectors(op, nullptr, vif1_regs.row);
             }
             pos += totalBytes;
 
             if (pos > sizeBytes)
                 break;
+            if (stallVif1ForIrq(*this, irq, opcode, data + pos, sizeBytes - pos))
+                return;
             continue;
         }
         else
         {
+            // PCSX2's vifCode_Null path treats an unsupported command as ER1,
+            // independent of CODE.I. ERR.ME1 masks the command error entirely.
+            // In particular, an invalid command's I bit must never produce a
+            // VIF IRQ: games rely on ER1/STC recovery for malformed streams.
+            constexpr uint32_t kVifErrMe1 = 1u << 2u;
+            constexpr uint32_t kVifStatEr1 = 1u << 13u;
+            if ((m_ioRegisters[0x10003C20u] & kVifErrMe1) == 0u)
+            {
+                vif1_regs.stat |= kVifStatEr1;
