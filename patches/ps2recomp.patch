+            };
+
+            auto extend8 = [&](uint8_t raw) -> uint32_t
+            {
+                if (zeroExtend)
+                    return static_cast<uint32_t>(raw);
+                return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(raw)));
+            };
+
+            auto sourceElement = [&](uint32_t component) -> uint32_t
+            {
+                const uint32_t componentBytes = 4u >> vl;
+                const uint32_t offset = sourceByteOffset + component * componentBytes;
