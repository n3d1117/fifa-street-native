+        // Config [[hooks]] inside this function: index in the generated g_ps2InstructionHooks table.
+        struct FunctionHook
+        {
+            size_t index;
+            const InstructionHook *hook;
+        };
+        std::unordered_map<uint32_t, FunctionHook> beforeHooks;
+        std::unordered_map<uint32_t, FunctionHook> afterHooks;
+        for (size_t h = 0; h < cg.m_instructionHooks.size(); ++h)
+        {
+            const InstructionHook &hook = cg.m_instructionHooks[h];
+            if (hook.address < function.start || hook.address >= function.end)
+            {
+                continue;
+            }
+            (hook.after ? afterHooks : beforeHooks)[hook.address] = FunctionHook{h, &hook};
+            if (!hook.after)
+            {
+                // A before-hook sits at a label; an after-hook leaves the instruction's code untouched.
+                analysisResult.entryPoints.insert(hook.address);
+            }
+            if (hook.redirect != 0u)
+            {
+                if (hook.redirect < function.start || hook.redirect >= function.end)
+                {
+                    std::ostringstream oss;
+                    oss << "hook at 0x" << std::hex << hook.address << ": redirect 0x" << hook.redirect
+                        << " is outside " << function.name;
+                    throw std::runtime_error(oss.str());
+                }
+                analysisResult.entryPoints.insert(hook.redirect);
+            }
+        }
+        size_t emittedHooks = 0;
