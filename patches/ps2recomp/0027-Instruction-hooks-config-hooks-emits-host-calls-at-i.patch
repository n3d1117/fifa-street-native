+            if (data.contains("hooks") && data.at("hooks").is_array())
+            {
+                auto readAddress = [](const toml::value &table, const char *key) -> uint32_t
+                {
+                    const auto &v = table.at(key);
+                    if (v.is_string())
+                        return static_cast<uint32_t>(std::stoul(v.as_string(), nullptr, 0));
+                    return static_cast<uint32_t>(v.as_integer());
+                };
+                for (const auto &entry : data.at("hooks").as_array())
+                {
+                    if (!entry.contains("address"))
+                        throw std::runtime_error("[[hooks]] entry lacks `address`");
+                    InstructionHook hook;
+                    hook.address = readAddress(entry, "address");
+                    if (entry.contains("when"))
+                    {
+                        const std::string when = toml::find<std::string>(entry, "when");
+                        if (when != "before" && when != "after")
+                            throw std::runtime_error("[[hooks]] `when` must be \"before\" or \"after\"");
+                        hook.after = (when == "after");
+                    }
+                    if (entry.contains("redirect"))
+                        hook.redirect = readAddress(entry, "redirect");
+                    if (hook.after && hook.redirect != 0)
+                        throw std::runtime_error("[[hooks]] `redirect` needs when = \"before\"");
+                    config.instructionHooks.push_back(hook);
+                }
+            }
+
             if (data.contains("mmio") && data.at("mmio").is_table())
             {
                 const auto &mmioTable = toml::find(data, "mmio").as_table();
@@ -358,6 +388,27 @@ namespace ps2recomp
