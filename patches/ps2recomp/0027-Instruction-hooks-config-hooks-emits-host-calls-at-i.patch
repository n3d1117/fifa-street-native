@@ -1482,6 +1482,19 @@ bool PS2Runtime::replaceFunction(uint32_t address, RecompiledFunction func)
     return true;
 }
 
+bool PS2Runtime::registerInstructionHook(uint32_t address, bool after, InstructionHookFn fn)
+{
+    for (uint32_t i = 0; i < g_ps2InstructionHookCount; ++i)
+    {
+        if (g_ps2InstructionHookAddresses[i] == address && (g_ps2InstructionHookAfter[i] != 0) == after)
+        {
+            g_ps2InstructionHooks[i] = fn;
+            return true;
+        }
+    }
+    return false;
+}
+
 bool PS2Runtime::registerFunction(uint32_t address, RecompiledFunction func)
 {
     return replaceFunction(address, func);
