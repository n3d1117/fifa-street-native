+    void CodeGenerator::setInstructionHooks(std::vector<InstructionHook> hooks)
+    {
+        std::sort(hooks.begin(), hooks.end(), [](const InstructionHook &a, const InstructionHook &b)
+                  { return a.address != b.address ? a.address < b.address : a.after < b.after; });
+        for (size_t i = 1; i < hooks.size(); ++i)
+        {
+            if (hooks[i].address == hooks[i - 1].address && hooks[i].after == hooks[i - 1].after)
+            {
+                std::ostringstream oss;
+                oss << "duplicate [[hooks]] entry at 0x" << std::hex << hooks[i].address;
+                throw std::runtime_error(oss.str());
+            }
+        }
+        m_instructionHooks = std::move(hooks);
+    }
