From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 15:16:12 +0200
Subject: [PATCH 03/84] Resolve sibling directories from PS2X_ROOT_DIR so the
 tree can be a subproject


diff --git a/CMakeLists.txt b/CMakeLists.txt
index c7c7af58daf1f53f3af66f048e911372a95e39fa..97237c030c7203449e278e75e0b33aa6ac5c60af 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,9 @@ endif()
 
 project(PS2RetroX)
 
+# Stay valid when this tree is added as a subdirectory of another project.
+set(PS2X_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}")
+
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
 
 option(PS2X_BUILD_RECOMP "Build ps2xRecomp" ON)
diff --git a/ps2xAnalyzer/CMakeLists.txt b/ps2xAnalyzer/CMakeLists.txt
index 5933bca1455492522882d8a0d1acfdd3565d2c57..a022364ca21227b6a02d10efa0bc58d3c3bb6596 100644
--- a/ps2xAnalyzer/CMakeLists.txt
+++ b/ps2xAnalyzer/CMakeLists.txt
@@ -27,8 +27,8 @@ add_library(ps2_analyzer_lib STATIC ${PS2ANALYZER_LIB_SOURCES})
 
 target_include_directories(ps2_analyzer_lib PUBLIC
     ${CMAKE_CURRENT_SOURCE_DIR}/include
-    ${CMAKE_SOURCE_DIR}/ps2xRecomp/include
-    ${CMAKE_SOURCE_DIR}/ps2xRuntime/include
+    ${PS2X_ROOT_DIR}/ps2xRecomp/include
+    ${PS2X_ROOT_DIR}/ps2xRuntime/include
 )
 
 target_link_libraries(ps2_analyzer_lib PUBLIC
@@ -50,7 +50,7 @@ install(TARGETS ps2_analyzer ps2_analyzer_lib
     ARCHIVE DESTINATION lib
 )
 
-include("${CMAKE_SOURCE_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
+include("${PS2X_ROOT_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
 
 if(CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
     EnableFastReleaseMode(ps2_analyzer_lib)
diff --git a/ps2xRecomp/CMakeLists.txt b/ps2xRecomp/CMakeLists.txt
index 857102a22d61a920d315379b93b2e9befca63098..c0072efcb2f9dc19551ac491a1b5893e94be1518 100644
--- a/ps2xRecomp/CMakeLists.txt
+++ b/ps2xRecomp/CMakeLists.txt
@@ -130,7 +130,7 @@ install(DIRECTORY include/
     DESTINATION include
 )
 
-include("${CMAKE_SOURCE_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
+include("${PS2X_ROOT_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
 
 if(CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
     EnableFastReleaseMode(ps2_recomp_lib)
diff --git a/ps2xTest/CMakeLists.txt b/ps2xTest/CMakeLists.txt
index e279fa1d7e67749b788a14e60ae3a640f5969557..715d94dcb8b010ababea73dc7f1f543b7fa6dc68 100644
--- a/ps2xTest/CMakeLists.txt
+++ b/ps2xTest/CMakeLists.txt
@@ -16,8 +16,8 @@ add_library(ps2_test_function_table OBJECT
 )
 
 target_include_directories(ps2_test_function_table PRIVATE
-    ${CMAKE_SOURCE_DIR}/ps2xRuntime/include
-    ${CMAKE_SOURCE_DIR}/ps2xIOP/include
+    ${PS2X_ROOT_DIR}/ps2xRuntime/include
+    ${PS2X_ROOT_DIR}/ps2xIOP/include
 )
 
 add_library(ps2_test_lib STATIC
@@ -49,10 +49,10 @@ endif()
 
 target_include_directories(ps2_test_lib PRIVATE
     ${CMAKE_CURRENT_SOURCE_DIR}/include
-    ${CMAKE_SOURCE_DIR}/ps2xRecomp/include
-    ${CMAKE_SOURCE_DIR}/ps2xAnalyzer/include
-    ${CMAKE_SOURCE_DIR}/ps2xRuntime/include
-    ${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib
+    ${PS2X_ROOT_DIR}/ps2xRecomp/include
+    ${PS2X_ROOT_DIR}/ps2xAnalyzer/include
+    ${PS2X_ROOT_DIR}/ps2xRuntime/include
+    ${PS2X_ROOT_DIR}/ps2xRuntime/src/lib
 )
 
 target_link_libraries(ps2_test_lib PRIVATE
@@ -80,9 +80,9 @@ endif()
 
 target_include_directories(ps2x_tests PRIVATE
     ${CMAKE_CURRENT_SOURCE_DIR}/include
-    ${CMAKE_SOURCE_DIR}/ps2xRecomp/include
-    ${CMAKE_SOURCE_DIR}/ps2xAnalyzer/include
-    ${CMAKE_SOURCE_DIR}/ps2xRuntime/include
+    ${PS2X_ROOT_DIR}/ps2xRecomp/include
+    ${PS2X_ROOT_DIR}/ps2xAnalyzer/include
+    ${PS2X_ROOT_DIR}/ps2xRuntime/include
 )
 
 target_link_libraries(ps2x_tests PRIVATE
@@ -105,7 +105,7 @@ if(COMMAND ps2x_stage_ffmpeg_runtime_dlls)
     ps2x_stage_ffmpeg_runtime_dlls(ps2x_tests)
 endif()
 
-include("${CMAKE_SOURCE_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
+include("${PS2X_ROOT_DIR}/ps2xRuntime/cmake/ReleaseMode.cmake")
 
 if(CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
     EnableFastReleaseMode(ps2_test_lib)
