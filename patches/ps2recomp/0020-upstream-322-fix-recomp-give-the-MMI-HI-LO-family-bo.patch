-// PMFHL function implementations
-inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
+// MMI HI/LO (128-bit) helpers. HI128 = {hi (UD[0]), hi1 (UD[1])}, LO128 = {lo, lo1}:
