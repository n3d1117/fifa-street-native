@@ -1,3 +1,4 @@
+#include "runtime/ps2_host_arena.h"
 static void setRegU32(R5900Context *ctx, int reg, uint32_t value)
 {
     if (!ctx || reg < 0 || reg > 31)
@@ -89,7 +90,7 @@ static uint32_t rpcAllocPacketAddr(uint8_t *rdram)
         return 0;
 
