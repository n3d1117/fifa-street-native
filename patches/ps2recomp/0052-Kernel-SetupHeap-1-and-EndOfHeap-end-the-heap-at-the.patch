-    uint32_t addr = kRpcPacketPoolBase + (slot * kRpcPacketSize);
+    uint32_t addr = ps2RpcPacketPoolBase() + (slot * kRpcPacketSize);
     rpcZeroRdram(rdram, addr, kRpcPacketSize);
     return addr;
 }
