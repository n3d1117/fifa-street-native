From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 19:53:47 +0200
Subject: [PATCH 52/57] Kernel: SetupHeap(-1) and EndOfHeap end the heap at the
 main thread's stack bottom; SIF RPC packet pool base set by the host (default
 kept for fixtures)

The game's malloc asks for all memory up to 0x1FEC000 and sbrk fails against EndOfHeap, which was a fixed 0x1F00000; the failed malloc returned NULL and EA's allocator then handed out memory from address 0 (.text, then .data), memset to 0xCC55CC55.

diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index c5810a891066409f6d8a5446feab821e8191d06c..daf3c7c4d02a6ed2edb9a4d1c08909348d106c36 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -394,6 +394,9 @@ public:
     uint32_t guestHeapLimit() const;
     uint32_t guestSetupHeapBase() const;
     uint32_t guestSetupHeapLimit() const;
+    // Lowest address of the main thread's stack (SetupThread); SetupHeap(-1) and EndOfHeap end the heap there.
+    void setGuestStackBottom(uint32_t address) { m_guestStackBottom = address; }
+    uint32_t guestStackBottom() const { return m_guestStackBottom; }
     uint32_t reserveAsyncCallbackStack(uint32_t size, uint32_t alignment = 16u);
 
     void drainCompletedDmacHandlers(uint8_t *rdram);
@@ -525,6 +528,7 @@ private:
     uint32_t m_guestHeapSuggestedBase = 0x00100000u;
     uint32_t m_guestSetupHeapBase = 0x00100000u;
     uint32_t m_guestSetupHeapLimit = PS2_RAM_SIZE;
+    uint32_t m_guestStackBottom = 0u;
     bool m_guestSetupHeapConfigured = false;
     bool m_guestHeapConfigured = false;
     uint32_t m_asyncCallbackStackFloor = 0x01F00000u;
