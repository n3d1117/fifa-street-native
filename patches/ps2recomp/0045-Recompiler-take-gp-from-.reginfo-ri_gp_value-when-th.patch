+        tc.Run("elf parser reads gp from .reginfo when there is no _gp symbol", [](TestCase &t) {
+            const auto uniqueSuffix = std::to_string(
+                static_cast<unsigned long long>(std::chrono::steady_clock::now().time_since_epoch().count()));
+            const std::filesystem::path elfPath =
+                std::filesystem::temp_directory_path() / ("ps2recomp-reginfo-" + uniqueSuffix + ".elf");
+
+            const bool writeOk = writeMinimalMipsElfWithReginfo(elfPath, 0x00541470u);
+            t.IsTrue(writeOk, "temporary ELF with .reginfo should be generated");
+            if (!writeOk)
+                return;
+
+            ElfParser parser(elfPath.string());
+            const bool parseOk = parser.parse();
+            t.IsTrue(parseOk, "ELF with .reginfo should parse");
+            if (parseOk)
+            {
+                t.Equals(parser.getReginfoGp(), 0x00541470u, "ri_gp_value is the last word of .reginfo");
+            }
+
+            std::error_code removeError;
+            std::filesystem::remove(elfPath, removeError);
+        });
