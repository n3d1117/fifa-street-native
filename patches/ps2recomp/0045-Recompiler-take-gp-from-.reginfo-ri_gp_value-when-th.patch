+    uint32_t ElfParser::getReginfoGp() const
+    {
+        // Elf32_RegInfo is 24 bytes; ri_gp_value is the last word.
+        for (const auto &sec : m_elf->sections)
+        {
+            if (sec->get_name() != ".reginfo" || sec->get_size() < 24 || !sec->get_data())
+            {
+                continue;
+            }
+            uint32_t gp = 0;
+            std::memcpy(&gp, sec->get_data() + 20, sizeof(gp));
+            return gp;
+        }
+        return 0;
+    }
+
     void ElfParser::setReporter(RecompilerReporter *reporter)
     {
         m_reporter = reporter;
