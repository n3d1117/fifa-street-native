+            if (pending != 0u)
+                idleUntil = 0u;
             if (pending & 1u)
                 pendingDmaInterrupts[9] = totalCycles;
             if ((pending & 2u) && memory.completeSpu2Dma(0))
@@ -999,6 +1003,20 @@ namespace ps2x::iop::detail
