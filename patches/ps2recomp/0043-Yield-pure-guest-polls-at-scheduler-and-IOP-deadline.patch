+void EeScheduler::idlePoll()
+{
+    assertExecutor();
+    if (!ps2HostConfig().wallClock || !currentThread() ||
+        !currentThread()->invocations.empty() || !m_pendingInvocations.empty() ||
+        hasReadyAtOrAbovePriority(currentThread()->currentPriority))
+        return;
+
+    // Force a fresh wall-clock sample before choosing relative deadlines.
+    // This does not charge estimated cycles in wall-clock mode.
+    const auto sampledAt = std::chrono::steady_clock::now();
+    accountCycles(294912u);
+    if (!m_checkpointPending.load(std::memory_order_acquire))
+        waitForEvent(m_runtime.m_iopSubsystem->eeCyclesUntilService(), sampledAt);
+    accountCycles(294912u);
+    // Dispatch interrupts/callbacks before the guest rereads its poll words.
+    throw EeDispatcherTransfer{};
+}
