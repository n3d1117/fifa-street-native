+    uint64_t IopEmulator::eeCyclesUntilService() const noexcept
+    {
+        // Reuse the scheduler's proven idle bound; unknown/runnable work gets
+        // no idle skip. Synchronous RPC work may already have earned credit.
+        const uint64_t next = m_impl->idleUntil > m_impl->totalCycles
+            ? m_impl->limitIdleSkip(m_impl->idleUntil) : m_impl->totalCycles;
+        if (next <= m_impl->eeIssuedIopCycleTarget)
+            return 0u;
+        const uint64_t remaining = next - m_impl->eeIssuedIopCycleTarget;
+        if (remaining > UINT64_MAX / 8u)
+            return UINT64_MAX;
+        return remaining * 8u - m_impl->eeCycleCarry;
+    }
+
     void IopEmulator::runEeCycles(uint64_t eeCycles) noexcept
     {
         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
