@@ -1154,6 +1163,40 @@ int main()
     if (!expect(iop.debugSnapshot().emulatorCycles == 11u,
                 "Normal EE budget accumulation must advance the reset IOP timeline exactly")) return 1;
 
+    // EE idle waits must stop at the same SPU2 deadline as IOP scheduling,
+    // including fractional 1:8 carry and synchronous-work credit.
+    {
+        iop.reset();
+        if (!expect(iop.eeCyclesUntilService() == 0u,
+                    "Unknown/runnable IOP state must forbid an EE idle skip")) return 1;
+        IopHostSpu2 hooks{};
+        hooks.advance = recordIdleSpuAdvance;
+        hooks.nextEvent = nextIdleSpuEvent;
+        hooks.maxIdleStep = 64u;
+        iopSetHostSpu2(hooks);
+        iop.runEeCycles(8u);
+        if (!expect(iop.eeCyclesUntilService() == 63u * 8u,
+                    "EE idle skip must respect the SPU2 service bound")) return 1;
+        idleSpuEvent = idleSpuCycle + 37u;
+        if (!expect(iop.eeCyclesUntilService() == 37u * 8u,
+                    "An earlier SPU2 event must shorten the EE idle deadline")) return 1;
+        iop.runEeCycles(7u);
+        if (!expect(iop.eeCyclesUntilService() == 37u * 8u - 7u,
+                    "EE idle deadline must subtract fractional IOP carry")) return 1;
+        raiseIdleSpuIrq = true;
+        iop.runEeCycles(1u);
+        raiseIdleSpuIrq = false;
+        if (!expect(iop.eeCyclesUntilService() == 0u,
+                    "An SPU2 IRQ raised by the final advance must invalidate the cached idle bound")) return 1;
+        iopSetHostSpu2(IopHostSpu2{});
+        iop.reset();
+        if (!expect(iop.eeCyclesUntilService() == 0u,
+                    "Reset must invalidate a cached IOP idle deadline")) return 1;
+        iop.runEeCycles(8u);
+        if (!expect(iop.eeCyclesUntilService() == UINT64_MAX,
+                    "An unbounded idle deadline must not overflow EE cycle conversion")) return 1;
+    }
+
     // Outside-thread RPC imports must let ready IOP work make progress. The
