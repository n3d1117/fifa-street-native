From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 06:24:06 +0200
Subject: [PATCH 38/44] Link Apple FFmpeg archives directly


diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 1b03d177a970205cafa33fd87d26c359cfa08634..ac0d1fde6741311479f40d76a3d90e9293e9c21a 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -338,6 +338,38 @@ elseif(WIN32)
         "${CMAKE_CURRENT_SOURCE_DIR}/cmake/CopyFfmpegDlls.cmake"
         CACHE INTERNAL
         "Script used to stage FFmpeg runtime DLLs beside executables")
+elseif(APPLE)
+    find_path(FFMPEG_INCLUDE_DIR libavcodec/avcodec.h
+        HINTS "${TARZAN_ROOT}/tools/ffmpeg/arm64/include"
+        REQUIRED)
+    find_library(FFMPEG_AVCODEC_LIBRARY NAMES avcodec
+        HINTS "${TARZAN_ROOT}/tools/ffmpeg/arm64/lib"
+        REQUIRED)
+    find_library(FFMPEG_SWRESAMPLE_LIBRARY NAMES swresample
+        HINTS "${TARZAN_ROOT}/tools/ffmpeg/arm64/lib"
+        REQUIRED)
+    find_library(FFMPEG_AVUTIL_LIBRARY NAMES avutil
+        HINTS "${TARZAN_ROOT}/tools/ffmpeg/arm64/lib"
+        REQUIRED)
+    find_library(FFMPEG_SWSCALE_LIBRARY NAMES swscale
+        HINTS "${TARZAN_ROOT}/tools/ffmpeg/arm64/lib"
+        REQUIRED)
+
+    add_library(ffmpeg INTERFACE)
+    target_include_directories(ffmpeg INTERFACE "${FFMPEG_INCLUDE_DIR}")
+    target_link_libraries(ffmpeg INTERFACE
+        "${FFMPEG_AVCODEC_LIBRARY}"
+        "${FFMPEG_SWRESAMPLE_LIBRARY}"
+        "${FFMPEG_SWSCALE_LIBRARY}"
+        "${FFMPEG_AVUTIL_LIBRARY}"
+        m
+    )
+    target_link_options(ffmpeg INTERFACE
+        -pthread
+        "SHELL:-framework CoreFoundation"
+        "SHELL:-framework CoreVideo"
+        "SHELL:-framework CoreMedia"
+    )
 else()
     find_package(PkgConfig REQUIRED)
     pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET GLOBAL
