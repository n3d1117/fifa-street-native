@@ -359,6 +359,10 @@ namespace ps2x::iop::detail
         if (const auto queueThread = m_queueThreadIds.find(server.queue);
             server.queue != 0u && queueThread != m_queueThreadIds.end() && queueThread->second > 0)
             rpcThreadId = queueThread->second;
+        static const bool traceRpc = std::getenv("PS2X_TRACE_RPC") != nullptr;
+        if (traceRpc)
+            std::fprintf(stderr, "[iop-rpc] begin sid=0x%x fn=0x%x send=%u thread=%d\n", request.sid, request.function,
+                         request.send.size, rpcThreadId);
         uint32_t returnPointer = executor.executeGuestRpcFunction(rpcThreadId,
                                                                   server.function,
                                                                   request.function,
@@ -378,6 +382,8 @@ namespace ps2x::iop::detail
                     m_memory.read32(returnPointer + 8), m_memory.read32(returnPointer + 12),
                     m_memory.read32(0x72bc4u), m_memory.read32(0x72bf4u), m_memory.read32(0x72becu));
         }
+        if (traceRpc)
+            std::fprintf(stderr, "[iop-rpc] end sid=0x%x fn=0x%x return=0x%x\n", request.sid, request.function, returnPointer);
         if (returnPointer == 0u)
             returnPointer = server.buffer;
         if (request.receive.address != 0u && request.receive.size != 0u && returnPointer != 0u)
@@ -423,6 +429,14 @@ namespace ps2x::iop::detail
         std::memcpy(header, packet, sizeof(header));
         if ((header[0] & 0xFFu) != packetSize || header[2] != commandId)
             return false;
+        static const bool traceCmd = std::getenv("PS2X_TRACE_RPC") != nullptr;
+        if (traceCmd)
+        {
+            uint32_t words[8]{};
+            std::memcpy(words, packet, std::min<size_t>(packetSize, sizeof(words)));
+            std::fprintf(stderr, "[sif-cmd ee->iop] cid=0x%x size=%zu w3..7=%08x %08x %08x %08x %08x\n", commandId,
+                         packetSize, words[3], words[4], words[5], words[6], words[7]);
+        }
         const uint32_t entry = commandEntry(commandId);
         if (entry == 0u)
             return false;
