         [[nodiscard]] uint32_t rpcServerCount() const noexcept;
         [[nodiscard]] std::vector<uint32_t> rpcServerSids() const;
 
diff --git a/ps2xIOP/src/emulator/iop_emulator_const.h b/ps2xIOP/src/emulator/iop_emulator_const.h
index 700459740dd51ae1d979d9845ee6016840388b02..8a045114c8a009760a147bd5b8c6377aa44c70f2 100644
