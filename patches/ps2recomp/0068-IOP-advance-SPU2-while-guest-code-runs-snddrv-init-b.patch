From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 01:13:49 +0200
Subject: [PATCH 68/92] IOP: advance SPU2 while guest code runs (snddrv init
 busy-waits on DMA completion); diagnostics for IOP threads, imports, SIF
 commands, RDRAM dump


diff --git a/ps2xIOP/include/ps2x/iop/iop_types.h b/ps2xIOP/include/ps2x/iop/iop_types.h
index 3491440910af1a6b71c367e170f62e364ee82ecb..0be5fb4dc088c999a6f13ef367a17c4f0702a8ba 100644
--- a/ps2xIOP/include/ps2x/iop/iop_types.h
+++ b/ps2xIOP/include/ps2x/iop/iop_types.h
@@ -149,6 +149,7 @@ namespace ps2x::iop
         uint32_t emulatorLoadedModules = 0;
         uint32_t emulatorThreads = 0;
         uint32_t emulatorRpcServers = 0;
+        std::string emulatorThreadStates;
         std::vector<DebugService> services;
         std::vector<std::string> diagnostics;
     };
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index ccfba7973ed4be0dea9e7677c81d7657190755fb..bed9bc476c6c456c734a3574b5def2bee08d881c 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -294,6 +294,12 @@ namespace ps2x::iop::detail
             {
                 cpu.gpr[2] = value;
             };
+            static const bool traceImports = std::getenv("PS2X_TRACE_IOP_IMPORTS") != nullptr;
+            static uint32_t tracedImports = 0;
+            if (traceImports && !(call.library == "intrman" && (call.ordinal == 17u || call.ordinal == 18u)) &&
+                tracedImports++ < 20000u)
+                std::fprintf(stderr, "[iop-import] %s:%u ra=%08x a0=%x a1=%x a2=%x a3=%x\n", call.library.c_str(),
+                             static_cast<unsigned>(call.ordinal), cpu.gpr[31], a0, cpu.gpr[5], cpu.gpr[6], cpu.gpr[7]);
 
             if (iequals(call.library, "sysmem") && sysmem.dispatchImport(call.ordinal, cpu))
                 return ImportDisposition::Handled;
@@ -488,10 +494,14 @@ namespace ps2x::iop::detail
             CpuState *previous = activeCpu;
             activeCpu = &cpu;
             const uint64_t start = totalInstructions;
+            const bool hostSpu2 = iopHostSpu2().advance != nullptr;
             while (!cpu.stopped && !cpu.yielded && totalInstructions - start < instructionBudget)
             {
                 if (!step(cpu))
                     break;
+                // Guest code busy-waits on SPU2 DMA completion (EA snddrv init); SPU2 events must surface while it runs.
+                if (hostSpu2 && (totalInstructions & (kSpu2PollInstructions - 1u)) == 0u)
+                    advanceSpu2();
                 if (!servicingDmaInterrupts && !pendingDmaInterrupts.empty())
                     servicePendingDmaInterrupts();
                 if (!servicingGuestCallbacks && !pendingGuestCallbacks.empty())
@@ -1141,6 +1151,11 @@ namespace ps2x::iop::detail
         return static_cast<uint32_t>(m_impl->modules.size());
     }
 
+    std::string IopEmulator::describeThreads() const
+    {
+        return m_impl->kernel.describeThreads();
+    }
+
     uint32_t IopEmulator::threadCount() const noexcept
     {
         return static_cast<uint32_t>(m_impl->kernel.threadCount());
