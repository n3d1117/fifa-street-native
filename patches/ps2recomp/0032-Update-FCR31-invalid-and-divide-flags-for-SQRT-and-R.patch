From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 22:28:01 +0200
Subject: [PATCH 032/105] Update FCR31 invalid and divide flags for SQRT and
 RSQRT

The root emitter regression failed because SQRT.S and RSQRT.S never updated FCR31. Set I/SI for negative nonzero Ft, D/SD for zero RSQRT Ft, and clear current I/D on each root operation while retaining sticky and unrelated bits. Classify before writing Fd so aliasing Ft is safe. Keep existing arithmetic operands and signed-zero results. Reference: PCSX2 FPU.cpp SQRT_S/RSQRT_S and ps2autotests ee_fpu/fcr.expected sqrt(-1) = FCR31 01020041. ./tz test passes 54/54; full replay and route validation follow in the batch export.

diff --git a/ps2xRecomp/src/lib/fpu_translator.cpp b/ps2xRecomp/src/lib/fpu_translator.cpp
index 3fe00546a5eac8c779abf218de6600f5341fcef1..b468b33eb252c103277ecffe9540e6a0962f3179 100644
--- a/ps2xRecomp/src/lib/fpu_translator.cpp
+++ b/ps2xRecomp/src/lib/fpu_translator.cpp
@@ -66,7 +66,7 @@ namespace ps2recomp
                     fs, ft, fd, fs, ft);
             case COP1_S_SQRT:
                 // R5900 SQRT.S reads Ft (not Fs) and takes sqrt(|Ft|); FPU_SQRT_S applies the PS2 float rules.
-                return fmt::format("ctx->f[{}] = FPU_SQRT_S(fabsf(ctx->f[{}]));", fd, ft);
+                return fmt::format("ctx->fcr31 = ps2_fpu_sqrt_status(ctx->fcr31, ctx->f[{}], false); ctx->f[{}] = FPU_SQRT_S(fabsf(ctx->f[{}]));", ft, fd, ft);
             case COP1_S_ABS:
                 return fmt::format("ctx->f[{}] = FPU_ABS_S(ctx->f[{}]);", fd, fs);
             case COP1_S_MOV:
@@ -85,7 +85,7 @@ namespace ps2recomp
                 return fmt::format("{{ int32_t tmp = FPU_CVT_W_S(ctx->f[{}]); std::memcpy(&ctx->f[{}], &tmp, sizeof(tmp)); }}", fs, fd);
             case COP1_S_RSQRT:
                 // R5900 RSQRT.S is Fs / sqrt(abs(Ft)); FPU_RSQRT_S handles zero Ft and PS2 float semantics.
-                return fmt::format("ctx->f[{}] = FPU_RSQRT_S(ctx->f[{}], ctx->f[{}]);", fd, fs, ft);
+                return fmt::format("ctx->fcr31 = ps2_fpu_sqrt_status(ctx->fcr31, ctx->f[{}], true); ctx->f[{}] = FPU_RSQRT_S(ctx->f[{}], ctx->f[{}]);", ft, fd, fs, ft);
             case COP1_S_ADDA:
                 return fmt::format("FPU_SET_ACC(ctx, FPU_ADD_S(ctx->f[{}], ctx->f[{}]));", fs, ft);
             case COP1_S_SUBA:
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 47ba0ca140e76a9c3880dda050432abde1f91044..51f281e9a9c9f0b6578c5be1adcf76bc9c5b4af6 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -1279,6 +1279,14 @@ inline void ps2_mmi_pdivuw(R5900Context *ctx, int rd, __m128i rs, __m128i rt)
     ctx->hi1 = hiOut[1];
 }
 
+inline uint32_t ps2_fpu_sqrt_status(uint32_t status, float ft, bool reciprocal)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(ft);
+    const bool zero = (bits & 0x7f800000u) == 0;
+    const uint32_t flags = zero ? (reciprocal ? 0x00010020u : 0u) : ((bits >> 31) ? 0x00020040u : 0u);
+    return (status & ~0x00030000u) | flags;
+}
+
 // FPU (COP1) operations
 #define FPU_SET_ACC(ctx, res) (ctx->f_acc = res)
 #define FPU_ADD_S(a, b) ps2_fadd((float)(a), (float)(b))
diff --git a/ps2xTest/src/ps2_fpu_order_tests.cpp b/ps2xTest/src/ps2_fpu_order_tests.cpp
index c194db851b8710599ea558116ce84271f1d01e4e..71116831f8a1651131335d88e16e3e572661d085 100644
--- a/ps2xTest/src/ps2_fpu_order_tests.cpp
+++ b/ps2xTest/src/ps2_fpu_order_tests.cpp
@@ -75,6 +75,32 @@ void register_ps2_fpu_order_tests()
 {
     MiniTest::Case("PS2FpuOrder", [](TestCase &tc)
     {
+        tc.Run("SQRT and RSQRT emit FCR31 cause updates before aliased writes", [](TestCase &t)
+        {
+            for (uint32_t op : {COP1_S_SQRT, COP1_S_RSQRT})
+            {
+                const uint32_t raw = (OPCODE_COP1 << 26) | (COP1_S << 21) | (2u << 16) | (1u << 11) | (2u << 6) | op;
+                const auto code = translate(0x100000u, raw);
+                const auto flags = code.find("ps2_fpu_sqrt_status");
+                t.IsTrue(flags != std::string::npos && flags < code.find("ctx->f[2] ="), "root op must set I/D before overwriting Ft: " + code);
+            }
+        });
+
+        tc.Run("SQRT and RSQRT update I/D causes and retain sticky flags", [](TestCase &t)
+        {
+            uint32_t status = ps2_fpu_sqrt_status(0x01818031u, -4.0f, false);
+            t.Equals(status, 0x01828071u, "negative SQRT sets I/SI and clears D, preserves O/SO/FCC");
+            t.Equals(b(FPU_SQRT_S(fabsf(-4.0f))), b(2.0f), "sqrt(-4) result remains 2");
+            status = ps2_fpu_sqrt_status(status, 4.0f, false);
+            t.Equals(status, 0x01808071u, "valid SQRT clears I keeping SI");
+            status = ps2_fpu_sqrt_status(status, f(0x80000001u), true);
+            t.Equals(status, 0x01818071u, "zero/denormal RSQRT sets D/SD without I");
+            status = ps2_fpu_sqrt_status(status, -4.0f, true);
+            t.Equals(status, 0x01828071u, "negative RSQRT sets I/SI and clears D");
+            status = ps2_fpu_sqrt_status(status, f(0x80000000u), false);
+            t.Equals(status, 0x01808071u, "SQRT(-0) clears I/D and preserves sticky");
+        });
+
         // The R5900's C.LT.S and C.LE.S have the function codes MIPS gives C.OLT (0x34) and C.OLE
         // (0x36), so the title's 1673 c.lt.s and 234 c.le.s arrive as FPU_C_OLT_S and FPU_C_OLE_S.
         tc.Run("C.LT and C.LE treat exponent 255 as the largest numbers", [](TestCase &t)
