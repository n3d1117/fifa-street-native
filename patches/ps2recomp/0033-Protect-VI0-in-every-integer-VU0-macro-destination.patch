From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 22:28:46 +0200
Subject: [PATCH 33/64] Protect VI0 in every integer VU0 macro destination

Each of VIADD/VISUB/VIADDI/VIAND/VIOR/VMTIR/VILWR emitted a write to VI0. The new regression failed for all seven emitters. Drop these writes at translation time while preserving nonzero destinations. Reference: PCSX2 VUops.cpp integer/MTIR/ILWR guards and ps2autotests vu0_macro/integer.expected writes to $0 returning 0000. ./tz test passes 54/54; full replay and route validation follow in the batch export.

diff --git a/ps2xRecomp/src/lib/vu_translation_helpers.cpp b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
index c66bc502c10281fc69dfa0c986bf0d9a0cdf50ea..36e8151a7b2bf198ea9bfc1f5e1fba2a79b8ac4b 100644
--- a/ps2xRecomp/src/lib/vu_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/vu_translation_helpers.cpp
@@ -96,6 +96,8 @@ namespace ps2recomp
 
     std::string CodeGenerator::translateVU_VMTIR(const Instruction &inst)
     {
+        if (inst.rt == 0)
+            return "// VI0 write discarded";
         uint8_t fsf = inst.vectorInfo.fsf;
         return fmt::format("{{ uint32_t bits; float src = _mm_cvtss_f32(_mm_shuffle_ps(ctx->vu0_vf[{}], ctx->vu0_vf[{}], _MM_SHUFFLE(0,0,0,{}))); std::memcpy(&bits, &src, sizeof(bits)); ctx->vi[{}] = (uint16_t)(bits & 0xFFFF); }}", inst.rd, inst.rd, fsf, inst.rt);
     }
@@ -122,6 +124,8 @@ namespace ps2recomp
 
     std::string CodeGenerator::translateVU_VILWR(const Instruction &inst)
     {
+        if (inst.rt == 0)
+            return "// VI0 write discarded";
         return fmt::format("{{ uint32_t addr = (((uint32_t)ctx->vi[{}] & 0xFF) << 4) + {}u; uint32_t v; std::memcpy(&v, runtime->memory().getVU0Data() + addr, 4); ctx->vi[{}] = static_cast<uint16_t>(v); }}",
                            inst.rd, vuFieldOffset(inst.vectorInfo.vectorField), inst.rt); // VILWR.<f> vit, (vis)
     }
@@ -142,27 +146,37 @@ namespace ps2recomp
 
     std::string CodeGenerator::translateVU_VIADD(const Instruction &inst)
     {
+        if (inst.sa == 0)
+            return "// VI0 write discarded";
         return fmt::format("ctx->vi[{}] = ctx->vi[{}] + ctx->vi[{}];", inst.sa, inst.rd, inst.rt); // vid, vis, vit
     }
 
     std::string CodeGenerator::translateVU_VISUB(const Instruction &inst)
     {
+        if (inst.sa == 0)
+            return "// VI0 write discarded";
         return fmt::format("ctx->vi[{}] = ctx->vi[{}] - ctx->vi[{}];", inst.sa, inst.rd, inst.rt); // vid, vis, vit
     }
 
     std::string CodeGenerator::translateVU_VIADDI(const Instruction &inst)
     {
+        if (inst.rt == 0)
+            return "// VI0 write discarded";
         int32_t imm5 = (inst.sa & 0x10) ? static_cast<int32_t>(inst.sa | ~0x1F) : static_cast<int32_t>(inst.sa);
         return fmt::format("ctx->vi[{}] = ctx->vi[{}] + {};", inst.rt, inst.rd, imm5); // vit, vis, imm5
     }
 
     std::string CodeGenerator::translateVU_VIAND(const Instruction &inst)
     {
+        if (inst.sa == 0)
+            return "// VI0 write discarded";
         return fmt::format("ctx->vi[{}] = ctx->vi[{}] & ctx->vi[{}];", inst.sa, inst.rd, inst.rt); // vid, vis, vit
     }
 
     std::string CodeGenerator::translateVU_VIOR(const Instruction &inst)
     {
+        if (inst.sa == 0)
+            return "// VI0 write discarded";
         return fmt::format("ctx->vi[{}] = ctx->vi[{}] | ctx->vi[{}];", inst.sa, inst.rd, inst.rt); // vid, vis, vit
     }
 
diff --git a/ps2xTest/src/ps2_vu0_vf0_tests.cpp b/ps2xTest/src/ps2_vu0_vf0_tests.cpp
index acc7abcce3f88b50278b618c52af8e93847ab168..8ceee5b832b5e78b3f6f41a78422fffcdfbac7de 100644
--- a/ps2xTest/src/ps2_vu0_vf0_tests.cpp
+++ b/ps2xTest/src/ps2_vu0_vf0_tests.cpp
@@ -34,6 +34,27 @@ void register_ps2_vu0_vf0_tests()
 {
     MiniTest::Case("PS2Vu0Vf0", [](TestCase &tc)
     {
+        tc.Run("all integer macro destinations protect VI0", [](TestCase &t)
+        {
+            CodeGenerator gen({}, {});
+            using Emitter = std::string (CodeGenerator::*)(const Instruction &);
+            for (Emitter emit : {&CodeGenerator::translateVU_VIADD, &CodeGenerator::translateVU_VISUB,
+                                 &CodeGenerator::translateVU_VIAND, &CodeGenerator::translateVU_VIOR,
+                                 &CodeGenerator::translateVU_VIADDI, &CodeGenerator::translateVU_VMTIR,
+                                 &CodeGenerator::translateVU_VILWR})
+            {
+                Instruction inst{};
+                inst.rd = 2;
+                inst.vectorInfo.vectorField = 8;
+                const auto zero = (gen.*emit)(inst);
+                t.IsTrue(!contains(zero, "ctx->vi[0] ="), "VI0 must remain zero: " + zero);
+                inst.sa = 1;
+                inst.rt = 1;
+                const auto one = (gen.*emit)(inst);
+                t.IsTrue(contains(one, "ctx->vi[1] ="), "nonzero VI destination must still write: " + one);
+            }
+        });
+
         tc.Run("a fresh guest context has vf0 = (0, 0, 0, 1)", [](TestCase &t)
         {
             // Thread and interrupt contexts start from R5900Context().
