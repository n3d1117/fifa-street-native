From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Thu, 22 Oct 2026 13:39:43 +0200
Subject: [PATCH 095/108] Build the runtime for iOS/tvOS with the embedded LLVM
 toolchain


diff --git a/ps2xRecomp/CMakeLists.txt b/ps2xRecomp/CMakeLists.txt
index c0072efcb2f9dc19551ac491a1b5893e94be1518..0dee00345d9a3fa7d723a46d8198159dc53abe13 100644
--- a/ps2xRecomp/CMakeLists.txt
+++ b/ps2xRecomp/CMakeLists.txt
@@ -120,11 +120,20 @@ PRIVATE
     ps2_recomp_lib
 )
 
-install(TARGETS ps2_recomp ps2_recomp_lib
-    RUNTIME DESTINATION bin
-    LIBRARY DESTINATION lib
-    ARCHIVE DESTINATION lib
-)
+if(IOS OR CMAKE_SYSTEM_NAME STREQUAL "tvOS")
+    install(TARGETS ps2_recomp ps2_recomp_lib
+        BUNDLE DESTINATION bin
+        RUNTIME DESTINATION bin
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib
+    )
+else()
+    install(TARGETS ps2_recomp ps2_recomp_lib
+        RUNTIME DESTINATION bin
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib
+    )
+endif()
 
 install(DIRECTORY include/
     DESTINATION include
diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 329abc11773b1b68be23d4494797c4c9c2789519..252dd12238b532ad084f0521432c3637077c151a 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -668,11 +668,20 @@ if(PS2X_IS_ANDROID)
     target_sources(ps2EntryRunner PRIVATE src/lib/ps2_android_runtime.cpp)
 endif()
 
-install(TARGETS ps2_runtime ps2EntryRunner
-    RUNTIME DESTINATION bin
-    LIBRARY DESTINATION lib
-    ARCHIVE DESTINATION lib
-)
+if(IOS OR CMAKE_SYSTEM_NAME STREQUAL "tvOS")
+    install(TARGETS ps2_runtime ps2EntryRunner
+        BUNDLE DESTINATION bin
+        RUNTIME DESTINATION bin
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib
+    )
+else()
+    install(TARGETS ps2_runtime ps2EntryRunner
+        RUNTIME DESTINATION bin
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib
+    )
+endif()
 
 if(WIN32 AND PS2X_ENABLE_FFMPEG)
     install(DIRECTORY "${FFMPEG_BIN_DIR}/"
diff --git a/ps2xRuntime/cmake/ReleaseMode.cmake b/ps2xRuntime/cmake/ReleaseMode.cmake
index 92ef0d54d5ef058fc1213fa9b809aeb7b4f14286..511f18b88693693c990093eb2cbc297c6d4abf58 100644
--- a/ps2xRuntime/cmake/ReleaseMode.cmake
+++ b/ps2xRuntime/cmake/ReleaseMode.cmake
@@ -1,6 +1,10 @@
 include(CheckIPOSupported)
 
-check_ipo_supported(RESULT IPO_SUPPORTED OUTPUT IPO_ERROR)
+if(IOS OR CMAKE_SYSTEM_NAME STREQUAL "tvOS")
+    set(IPO_SUPPORTED FALSE)
+else()
+    check_ipo_supported(RESULT IPO_SUPPORTED OUTPUT IPO_ERROR)
+endif()
 
 function(EnableFastReleaseMode TargetName)
     message("> Enabling optimization for: ${TargetName}")
@@ -39,4 +43,4 @@ function(EnableFastReleaseMode TargetName)
     else()
         message(WARNING "Interprocedural optimization not supported: ${ipo_error}")
     endif()
-endfunction()
\ No newline at end of file
+endfunction()
