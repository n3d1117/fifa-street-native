From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 12:49:46 +0200
Subject: [PATCH 77/94] VU1 interpreter: skip pipeline commit scans until the
 earliest pending readyCycle; iterate set VI-read bits (interpreter 5.5 -> 10
 Mcyc/s on the match route; HUD clock 0.142 -> 0.236 per wall s; differential
 vs native: 513,982 calls, 0 mismatches)


diff --git a/ps2xRuntime/include/runtime/ps2_vu1.h b/ps2xRuntime/include/runtime/ps2_vu1.h
index 4f8f991a8db76ae784d26aee5684b36add6c4e06..518b86d55c1ff8dc82108ec4490d9d1b0b684a0a 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -233,6 +233,7 @@ private:
     bool m_decodedCodeCacheValid = false;
 
     std::array<FlagPipelineEntry, kMaxFlagEntries> m_flagPipeline{};
+    uint64_t m_nextCommitCycle = UINT64_MAX; // lower bound of the earliest pending readyCycle
     ScalarPipelineEntry m_fdiv{};
     std::array<ScalarPipelineEntry, 2> m_efu{};
     std::array<PendingStore, kMaxPendingStores> m_storePipeline{};
