diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 345818096e9e579313d49ff8c505371c21b3ae28..dbeef3084d7bbe6ceb794cf7436cbe2310415b3b 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -413,6 +413,49 @@ namespace
 namespace
 {
     PS2HostConfig g_hostConfig;
+    std::atomic<bool> g_hostPaused{false};
+    std::atomic<bool> g_hostPausedAcknowledged{false};
+    std::mutex g_hostPauseMutex;
+    std::condition_variable g_hostPauseCv;
+    std::atomic<std::condition_variable *> g_hostPauseWake{nullptr};
+}
+
+void ps2SetHostPaused(bool paused)
+{
+    if (paused)
+        g_hostPausedAcknowledged.store(false, std::memory_order_release);
+    g_hostPaused.store(paused, std::memory_order_release);
+    g_hostPauseCv.notify_all();
+    if (auto *wake = g_hostPauseWake.load(std::memory_order_acquire))
+        wake->notify_all();
+}
+
+bool ps2HostPauseRequested()
+{
+    return g_hostPaused.load(std::memory_order_acquire);
+}
+
+void ps2WaitForHostPause()
+{
+    std::unique_lock lock(g_hostPauseMutex);
+    g_hostPauseCv.wait(lock, [] { return g_hostPausedAcknowledged.load(std::memory_order_acquire); });
+}
+
+void ps2WaitForHostResume()
+{
+    std::unique_lock lock(g_hostPauseMutex);
+    g_hostPauseCv.wait(lock, [] { return !g_hostPaused.load(std::memory_order_acquire); });
+}
+
+void ps2SetHostPauseWake(std::condition_variable *wake)
+{
+    g_hostPauseWake.store(wake, std::memory_order_release);
+}
+
+void ps2SetHostPausedAcknowledged(bool acknowledged)
+{
+    g_hostPausedAcknowledged.store(acknowledged, std::memory_order_release);
+    g_hostPauseCv.notify_all();
 }
 
 void ps2SetHostConfig(const PS2HostConfig &config)
