From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 18:24:44 +0200
Subject: [PATCH 49/62] CD: sceCdCallback records the EE callback; a successful
 sceCdRead completes through it after returning (EA's file layer waits on it)


diff --git a/ps2xRuntime/include/runtime/ee_scheduler.h b/ps2xRuntime/include/runtime/ee_scheduler.h
index c05f012adf1c66d5bc0c415a9d9c90dca9f1b691..c9bf902b2facf713528f6a6baabcef6d79928b08 100644
--- a/ps2xRuntime/include/runtime/ee_scheduler.h
+++ b/ps2xRuntime/include/runtime/ee_scheduler.h
@@ -165,6 +165,8 @@ struct EeAlarm
     uint32_t argument = 0;
     uint32_t gp = 0;
     uint32_t sp = 0;
+    // HLE completion callbacks (sceCdCallback): a0 is the argument itself, not the alarm id.
+    bool rawArgument = false;
 };
 
 struct EeIrqHandler
@@ -318,7 +320,8 @@ public:
     int pollEventFlag(int id, uint32_t bits, uint32_t mode, uint32_t &observedBits);
     void waitEventFlag(int id, uint32_t bits, uint32_t mode, uint32_t resultAddress);
 
-    int setAlarm(uint16_t ticks, uint32_t handler, uint32_t argument, uint32_t gp, uint32_t sp);
+    int setAlarm(uint16_t ticks, uint32_t handler, uint32_t argument, uint32_t gp, uint32_t sp,
+                 bool rawArgument = false);
     int cancelAlarm(int id);
     void queueInvocation(GuestInvocation invocation);
     [[noreturn]] void invokeCurrent(GuestInvocation invocation);
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index 9d6eb28e2addce3db4b977378596347025ee68ea..4741a3797b252b5696897f98a8d7b676f066223d 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -1173,7 +1173,8 @@ int EeScheduler::setAlarm(uint16_t ticks,
                           uint32_t handler,
                           uint32_t argument,
                           uint32_t gp,
-                          uint32_t sp)
+                          uint32_t sp,
+                          bool rawArgument)
 {
     assertExecutor();
     if (handler == 0u || !m_runtime.hasFunction(handler))
@@ -1185,7 +1186,7 @@ int EeScheduler::setAlarm(uint16_t ticks,
     {
         return KE_ERROR;
     }
-    m_alarms.emplace(id, EeAlarm{id, ticks, handler, argument, gp, sp});
+    m_alarms.emplace(id, EeAlarm{id, ticks, handler, argument, gp, sp, rawArgument});
     const uint64_t tickCount = ticks == 0u ? 1u : static_cast<uint64_t>(ticks);
     scheduleEvent(m_eeCycle + tickCount * kAlarmTickCycles,
                   std::chrono::steady_clock::now() + std::chrono::microseconds(tickCount * kAlarmTickMicroseconds),
@@ -2038,9 +2039,16 @@ void EeScheduler::processEvent(const EeEvent &event)
         GuestInvocation invocation{};
         invocation.kind = GuestInvocationKind::Alarm;
         invocation.context.pc = alarm.handler;
-        SET_GPR_U32(&invocation.context, 4, static_cast<uint32_t>(alarm.id));
-        SET_GPR_U32(&invocation.context, 5, static_cast<uint32_t>(alarm.ticks));
-        SET_GPR_U32(&invocation.context, 6, alarm.argument);
+        if (alarm.rawArgument)
+        {
+            SET_GPR_U32(&invocation.context, 4, alarm.argument);
+        }
+        else
+        {
+            SET_GPR_U32(&invocation.context, 4, static_cast<uint32_t>(alarm.id));
+            SET_GPR_U32(&invocation.context, 5, static_cast<uint32_t>(alarm.ticks));
+            SET_GPR_U32(&invocation.context, 6, alarm.argument);
+        }
         SET_GPR_U32(&invocation.context, 28, alarm.gp);
         SET_GPR_U32(&invocation.context, 29, 0u);
         SET_GPR_U32(&invocation.context, 31, 0u);
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
index 0aa5b6d9c1daf5ff336c480c17615c819885d2ad..e1ee1f35c5e35493d1e480ff7d1f07b6279d1180 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/CD.cpp
@@ -204,6 +204,11 @@ namespace ps2_stubs
         return snapshot;
     }
 
+    namespace
+    {
+        uint32_t g_cdCallback = 0u;
+    }
+
     void sceCdRead(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
         const uint32_t a0 = getRegU32(ctx, 4); // usually lbn
@@ -316,6 +321,12 @@ namespace ps2_stubs
         if (ok)
         {
             g_cdStreamingLbn = selected.lbn + selected.sectors;
+            // The EE callback runs from the CD interrupt after the command returns, never
+            // before the caller has seen the accepted status. SCECdFuncRead is function 1.
+            if (g_cdCallback != 0u && runtime->hasFunction(g_cdCallback))
+            {
+                (void)runtime->eeScheduler().setAlarm(1u, g_cdCallback, 1u, getRegU32(ctx, 28), 0u, true);
+            }
             setReturnS32(ctx, 1); // command accepted/success
             return;
         }
@@ -355,7 +366,9 @@ namespace ps2_stubs
 
     void sceCdCallback(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        setReturnS32(ctx, 0);
+        const uint32_t previous = g_cdCallback;
+        g_cdCallback = getRegU32(ctx, 4);
+        setReturnS32(ctx, static_cast<int32_t>(previous));
     }
 
     void sceCdChangeThreadPriority(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
diff --git a/ps2xTest/src/ps2_runtime_kernel_tests.cpp b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
index 2059fe6dd36df2e1d31d279af66e81bc780a0e6d..403e5cf6c515341d2623f2157b7443d6232c3770 100644
--- a/ps2xTest/src/ps2_runtime_kernel_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
@@ -12,6 +12,8 @@
 #include <cstdint>
 #include <cstdlib>
 #include <cstring>
+#include <filesystem>
+#include <fstream>
 #include <sstream>
 #include <stdexcept>
 #include <thread>
@@ -1217,6 +1219,48 @@ void register_ps2_runtime_kernel_tests()
                      "iFlushCache should succeed when guest and host memory are coherent");
         });
 
+        tc.Run("sceCdCallback records the callback and sceCdRead completes through it after returning", [](TestCase &t)
+        {
+            TestEnv env;
+
+            const std::filesystem::path image =
+                std::filesystem::temp_directory_path() /
+                ("ps2x-cd-callback-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + ".bin");
+            {
+                std::ofstream out(image, std::ios::binary);
+                const std::vector<char> sector(2048u * 2u, 'x');
+                out.write(sector.data(), static_cast<std::streamsize>(sector.size()));
+            }
+            PS2Runtime::IoPaths paths = PS2Runtime::getIoPaths();
+            const PS2Runtime::IoPaths savedPaths = paths;
+            paths.cdImage = image;
+            PS2Runtime::setIoPaths(paths);
+
+            constexpr uint32_t kCdCallbackAddr = 0x00270100u;
+            env.runtime.registerFunction(kCdCallbackAddr, &alarmNoopHandler);
+
+            setRegU32(env.ctx, 4, kCdCallbackAddr);
+            ps2_stubs::sceCdCallback(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(static_cast<uint32_t>(getRegS32(env.ctx, 2)), 0u, "first sceCdCallback returns no previous callback");
+
+            setRegU32(env.ctx, 4, 0u);  // lbn
+            setRegU32(env.ctx, 5, 1u);  // sectors
+            setRegU32(env.ctx, 6, 0x6000u);
+            ps2_stubs::sceCdRead(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), 1, "sceCdRead accepts the command");
+            t.Equals(env.rdram[0x6000u], static_cast<uint8_t>('x'), "sceCdRead copies the sector");
+            t.Equals(env.runtime.eeScheduler().cancelAlarm(1), KE_OK,
+                     "the completion callback is pending, not run inline");
+
+            setRegU32(env.ctx, 4, 0u);
+            ps2_stubs::sceCdCallback(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(static_cast<uint32_t>(getRegS32(env.ctx, 2)), kCdCallbackAddr, "sceCdCallback returns the previous callback");
+
+            PS2Runtime::setIoPaths(savedPaths);
+            std::error_code removeError;
+            std::filesystem::remove(image, removeError);
+        });
+
         tc.Run("setup heap and thread invalid ids use documented kernel errors", [](TestCase &t)
         {
             TestEnv env;
