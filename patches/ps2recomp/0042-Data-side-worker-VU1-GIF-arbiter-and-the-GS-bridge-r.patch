+DataStream::~DataStream()
+{
+    stop();
+}
+
+DataStream::Mode DataStream::defaultMode()
+{
+    const char *value = std::getenv("PS2X_VU1_WORKER");
+    if (value)
+    {
+        if (std::strcmp(value, "0") == 0)
+            return Mode::Inline;
+        if (std::strcmp(value, "sync") == 0)
+            return Mode::WorkerSync;
+        if (std::strcmp(value, "1") == 0)
+            return Mode::Worker;
+    }
+    return Mode::Worker;
+}
+
+bool DataStream::start(Mode mode)
+{
+    m_mode = mode;
 #if defined(TARZAN_USE_METAL)
+    if (mode == Mode::Inline)
+        return tarzan_metal_gs_create() != 0;
+    m_ring = std::make_unique<StreamRing>(
+        kRingBytes, [this](const StreamRing::Op &op, const uint8_t *payload) { execute(op, payload); },
+        [](const StreamRing::Op &op) { return describe(op); });
+    const bool ok = m_ring->start([] { return tarzan_metal_gs_create() != 0; },
+                                  [] { tarzan_metal_gs_destroy(); });
+    if (!ok)
+        m_ring.reset();
+    else
+        std::fprintf(stderr, "[data-stream] worker thread owns VU1, GIF and the GS bridge (%s)\n",
+                     mode == Mode::WorkerSync ? "drain at every kick" : "overlap");
+    return ok;
+#else
+    (void)mode;
+    return true;
+#endif
+}
 
