+// Single-producer single-consumer ordered op ring with one consumer thread.
+//
+// The producer copies each op (header, then payload) into the ring and
+// publishes in batches: head is a monotonic byte counter, and the consumer
+// advances tail (both sequentially consistent, which on arm64 is store-release
+// plus load-acquire and keeps the sleep/wake handshakes race free) only after an op has been
+// executed, so tail >= a producer position means every op before it is done.
+// Ops never straddle the end of the ring. drain() is the barrier. The consumer
+// never waits on the producer, so the only blocking edge is producer -> consumer
+// (ring full, drain), which is why a watchdog on those waits catches every hang.
+class StreamRing
+{
+public:
+    struct Op
+    {
+        uint32_t type = 0;
+        uint32_t bytes = 0; // header + payload, rounded up to 16
+        uint64_t arg = 0;
+    };
+    static_assert(sizeof(Op) == 16, "op header must be one slot");
+
+    using ExecFn = std::function<void(const Op &, const uint8_t *payload)>;
+    using NameFn = std::function<std::string(const Op &)>;
+
+    static constexpr uint32_t kWrapType = 0xFFFFFFFFu;
+
+    StreamRing(size_t capacityBytes, ExecFn exec, NameFn name = {}, unsigned watchdogMs = 2000)
+        : m_capacity(roundUp(capacityBytes)), m_buffer(new uint8_t[m_capacity]), m_exec(std::move(exec)),
+          m_name(std::move(name)), m_watchdogMs(watchdogMs)
+    {
+    }
+
+    ~StreamRing() { stop(); }
+
+    StreamRing(const StreamRing &) = delete;
+    StreamRing &operator=(const StreamRing &) = delete;
+
+    // Runs onStart on the consumer thread and returns its result once it has
+    // finished; onStop runs on the same thread after the last op.
+    bool start(std::function<bool()> onStart = {}, std::function<void()> onStop = {})
+    {
+        m_onStart = std::move(onStart);
+        m_onStop = std::move(onStop);
+        pthread_attr_t attributes;
+        pthread_attr_init(&attributes);
+        pthread_attr_setstacksize(&attributes, 16u * 1024u * 1024u);
+        const int error = pthread_create(&m_thread, &attributes, &StreamRing::threadMain, this);
+        pthread_attr_destroy(&attributes);
+        if (error != 0)
+            throw std::runtime_error("StreamRing: could not create the consumer thread");
+        m_started = true;
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_cv.wait(lock, [this] { return m_ready; });
+        if (!m_startOk)
+        {
+            lock.unlock();
+            pthread_join(m_thread, nullptr);
+            m_started = false;
+        }
+        return m_startOk;
+    }
+
+    // Drains, then ends the consumer thread after onStop. Safe to call twice.
+    void stop() noexcept
+    {
+        if (!m_started)
+            return;
+        try
+        {
+            drain("stop");
+        }
+        catch (...)
+        {
+        }
+        m_stop.store(true, std::memory_order_seq_cst);
+        wakeConsumer(true);
+        pthread_join(m_thread, nullptr);
+        m_started = false;
+    }
+
+    bool running() const { return m_started; }
+    bool onConsumerThread() const { return m_started && pthread_equal(pthread_self(), m_thread) != 0; }
+
+    // Producer: appends one op. payload (if any) is copied. Blocks while the
+    // ring is full. Does not publish.
+    void push(uint32_t type, uint64_t arg, const void *a, uint32_t aBytes, const void *b = nullptr,
+              uint32_t bBytes = 0)
+    {
+        rethrowIfFailed();
+        const uint32_t total = roundUp(sizeof(Op) + static_cast<size_t>(aBytes) + bBytes);
+        if (total > m_capacity / 2)
+            throw std::length_error("StreamRing: op larger than half the ring");
+        reserve(total);
+        uint8_t *dst = m_buffer.get() + (m_localHead % m_capacity);
+        const Op header{type, total, arg};
+        std::memcpy(dst, &header, sizeof(header));
+        if (aBytes)
+            std::memcpy(dst + sizeof(Op), a, aBytes);
+        if (bBytes)
+            std::memcpy(dst + sizeof(Op) + aBytes, b, bBytes);
+        m_localHead += total;
+        m_pendingBytes += total;
+    }
+
+    // Largest payload (including a header struct) push() accepts.
+    uint32_t maxPayload() const { return static_cast<uint32_t>(m_capacity / 2 - sizeof(Op)); }
+
+    // Producer: makes everything pushed so far visible to the consumer.
+    void publish()
+    {
+        if (m_localHead == m_publishedHead)
+            return;
+        m_publishedHead = m_localHead;
+        m_pendingBytes = 0;
+        m_head.store(m_localHead, std::memory_order_seq_cst);
+        wakeConsumer(false);
+    }
+
+    // Producer: publishes and returns once every op pushed so far has executed.
+    void drain(const char *why, bool rethrow = true)
+    {
+        publish();
+        waitFor(m_localHead, why);
+        if (rethrow)
+            rethrowIfFailed();
+    }
+
+    // Producer: bytes pushed but not yet published, to let callers batch.
+    uint32_t pendingBytes() const { return m_pendingBytes; }
+
+    // True when the consumer has executed everything pushed so far.
+    bool idle() const { return m_tail.load(std::memory_order_acquire) == m_localHead; }
+
+    void rethrowIfFailed()
+    {
+        if (m_failed.load(std::memory_order_acquire))
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            throw std::runtime_error(m_failure);
+        }
+    }
+
+private:
+    static uint32_t roundUp(size_t n) { return static_cast<uint32_t>((n + 15u) & ~static_cast<size_t>(15u)); }
+
+    static void *threadMain(void *self)
+    {
+        static_cast<StreamRing *>(self)->consume();
+        return nullptr;
+    }
+
+    void wakeConsumer(bool force)
+    {
+        if (force || m_sleeping.load(std::memory_order_seq_cst))
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_cv.notify_all();
+        }
+    }
+
+    // Space for one op of total bytes at the current position, wrapping with a
+    // filler op when it would straddle the end.
+    void reserve(uint32_t total)
+    {
+        for (;;)
+        {
+            const uint32_t offset = static_cast<uint32_t>(m_localHead % m_capacity);
+            const uint32_t untilEnd = m_capacity - offset;
+            const uint32_t need = (untilEnd >= total) ? total : untilEnd + total;
+            if (m_localHead + need - m_tail.load(std::memory_order_acquire) <= m_capacity)
+            {
+                if (untilEnd < total)
+                {
+                    const Op filler{kWrapType, untilEnd, 0};
+                    std::memcpy(m_buffer.get() + offset, &filler, sizeof(filler));
+                    m_localHead += untilEnd;
+                    m_pendingBytes += untilEnd;
+                }
+                return;
+            }
+            publish();
+            waitFor(m_localHead + need - m_capacity, "ring full");
+            rethrowIfFailed();
+        }
+    }
+
+    // Waits until tail >= position. Spins briefly, then sleeps in short slices.
+    void waitFor(uint64_t position, const char *why)
+    {
+        if (m_tail.load(std::memory_order_acquire) >= position)
+            return;
+        const auto begin = std::chrono::steady_clock::now();
+        for (int spin = 0; spin < 2000; ++spin)
+        {
+            if (m_tail.load(std::memory_order_acquire) >= position)
+                return;
+        }
+        m_waiters.fetch_add(1, std::memory_order_seq_cst);
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_doneCv.wait_for(lock, std::chrono::microseconds(200), [&]
+                                  { return m_tail.load(std::memory_order_acquire) >= position ||
+                                           m_failed.load(std::memory_order_acquire); });
+            }
+            if (m_tail.load(std::memory_order_acquire) >= position || m_failed.load(std::memory_order_acquire))
+                break;
+            if (std::chrono::steady_clock::now() - begin > std::chrono::milliseconds(m_watchdogMs))
+            {
+                reportHang(why);
+                std::abort();
+            }
+        }
+        m_waiters.fetch_sub(1, std::memory_order_seq_cst);
+    }
+
+    void reportHang(const char *why)
+    {
+        const uint64_t tail = m_tail.load(std::memory_order_acquire);
+        std::string current = "none";
+        if (tail < m_publishedHead)
+        {
+            Op op;
+            std::memcpy(&op, m_buffer.get() + (tail % m_capacity), sizeof(op));
+            current = m_name ? m_name(op) : ("type " + std::to_string(op.type));
+        }
+        std::fprintf(stderr,
+                     "[data-stream] deadlock watchdog: waited more than %u ms in '%s'; consumer is at %s "
+                     "(tail %llu, published %llu, pushed %llu). Aborting.\n",
+                     m_watchdogMs, why, current.c_str(), static_cast<unsigned long long>(tail),
+                     static_cast<unsigned long long>(m_publishedHead), static_cast<unsigned long long>(m_localHead));
+        std::fflush(stderr);
+    }
+
+    void consume()
+    {
+        bool ok = true;
+        try
+        {
+            if (m_onStart)
+                ok = m_onStart();
+        }
+        catch (const std::exception &e)
+        {
+            fail(e.what());
+            ok = false;
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_startOk = ok;
+            m_ready = true;
+            m_cv.notify_all();
+        }
+        if (!ok)
+            return;
+
+        uint64_t tail = 0;
+        unsigned idleSpins = 0;
+        for (;;)
+        {
+            const uint64_t head = m_head.load(std::memory_order_acquire);
+            if (tail == head)
+            {
+                if (m_stop.load(std::memory_order_acquire))
+                    break;
+                if (++idleSpins < 20000)
+                    continue;
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_sleeping.store(true, std::memory_order_seq_cst);
+                if (m_head.load(std::memory_order_seq_cst) == tail && !m_stop.load(std::memory_order_seq_cst))
+                    m_cv.wait_for(lock, std::chrono::milliseconds(1));
+                m_sleeping.store(false, std::memory_order_seq_cst);
+                idleSpins = 0;
+                continue;
+            }
+            idleSpins = 0;
+            while (tail < head)
+            {
+                const uint8_t *at = m_buffer.get() + (tail % m_capacity);
+                Op op;
+                std::memcpy(&op, at, sizeof(op));
+                if (op.type != kWrapType && !m_failed.load(std::memory_order_relaxed))
+                {
+                    try
+                    {
+                        m_exec(op, at + sizeof(Op));
+                    }
+                    catch (const std::exception &e)
+                    {
+                        fail(e.what());
+                    }
+                    catch (...)
+                    {
+                        fail("unknown exception on the data-side thread");
+                    }
+                }
+                tail += op.bytes;
+                m_tail.store(tail, std::memory_order_seq_cst);
+                if (m_waiters.load(std::memory_order_seq_cst) != 0)
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    m_doneCv.notify_all();
+                }
+            }
+        }
+        try
+        {
+            if (m_onStop)
+                m_onStop();
+        }
+        catch (...)
+        {
+        }
+    }
+
+    void fail(const char *message)
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (!m_failed.load(std::memory_order_relaxed))
+                m_failure = message;
+            m_failed.store(true, std::memory_order_release);
+        }
+        m_doneCv.notify_all();
+    }
+
+    const uint32_t m_capacity;
+    std::unique_ptr<uint8_t[]> m_buffer;
+    ExecFn m_exec;
+    NameFn m_name;
+    const unsigned m_watchdogMs;
+    std::function<bool()> m_onStart;
+    std::function<void()> m_onStop;
+
+    // Producer-private.
+    uint64_t m_localHead = 0;
+    uint64_t m_publishedHead = 0;
+    uint32_t m_pendingBytes = 0;
+
+    alignas(64) std::atomic<uint64_t> m_head{0};
+    alignas(64) std::atomic<uint64_t> m_tail{0};
+    alignas(64) std::atomic<bool> m_sleeping{false};
+    std::atomic<int> m_waiters{0};
+    std::atomic<bool> m_stop{false};
+    std::atomic<bool> m_failed{false};
+    std::string m_failure;
+
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::condition_variable m_doneCv;
+    bool m_ready = false;
+    bool m_startOk = false;
+    bool m_started = false;
+    pthread_t m_thread{};
+};
+
+#endif
