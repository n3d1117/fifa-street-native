diff --git a/ps2xTest/src/ps2_data_stream_tests.cpp b/ps2xTest/src/ps2_data_stream_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..79b997656421f4f5dc9dbefd7ead0de7fe7981e9
--- /dev/null
+++ b/ps2xTest/src/ps2_data_stream_tests.cpp
@@ -0,0 +1,197 @@
+#include "MiniTest.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_stream_ring.h"
+#include "ps2_data_stream.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+namespace
+{
+    uint32_t vifCmd(uint8_t opcode, uint8_t num, uint16_t imm)
+    {
+        return (static_cast<uint32_t>(opcode) << 24) | (static_cast<uint32_t>(num) << 16) | imm;
+    }
+
+    void appendU32(std::vector<uint8_t> &bytes, uint32_t value)
+    {
+        const size_t offset = bytes.size();
+        bytes.resize(offset + sizeof(value));
+        std::memcpy(bytes.data() + offset, &value, sizeof(value));
+    }
+
+    // One VIF1 kick that exercises every op kind: MPG, UNPACK, DIRECT (PATH2),
+    // MSCAL and a PATH3 mask/unmask pair around queued PATH3 data.
+    std::vector<uint8_t> vifKick(uint32_t seed)
+    {
+        std::vector<uint8_t> packet;
+        appendU32(packet, 0x01000101u); // STCYCL CL=1 WL=1
+        appendU32(packet, vifCmd(0x4Au, 2u, 8u * (seed & 7u)));
+        for (uint32_t i = 0; i < 4u; ++i)
+            appendU32(packet, seed * 2654435761u + i);
+        appendU32(packet, vifCmd(0x6Cu, 2u, static_cast<uint16_t>(16u + (seed & 15u) * 4u)));
+        for (uint32_t i = 0; i < 8u; ++i)
+            appendU32(packet, seed * 40503u + i);
+        appendU32(packet, vifCmd(0x50u, 0u, 1u)); // DIRECT 1 qword: a PACKED A+D GIF tag with NLOOP=0
+        appendU32(packet, 0x00000000u);
+        appendU32(packet, 0x10000000u | seed);
+        appendU32(packet, 0x0Eu);
+        appendU32(packet, 0u);
+        appendU32(packet, vifCmd(0x14u, 0u, static_cast<uint16_t>(seed & 3u))); // MSCAL
+        return packet;
+    }
+
+    struct Recorder
+    {
+        std::vector<uint32_t> calls;
+        std::vector<uint64_t> gif;
+    };
+
+    void bind(PS2Memory &mem, GifArbiter &arbiter, Recorder &rec)
+    {
+        mem.setVu1MscalCallback([&rec](uint32_t pc, uint32_t top, uint32_t itop)
+                                { rec.calls.push_back(pc * 1000003u + top * 31u + itop); });
+        arbiter.setProcessPacketFn([&rec](GifPathId path, const uint8_t *data, uint32_t size)
+                                   {
+                                       uint64_t hash = static_cast<uint64_t>(path) * 1099511628211ull + size;
+                                       for (uint32_t i = 0; i < size; ++i)
+                                           hash = (hash ^ data[i]) * 1099511628211ull;
+                                       rec.gif.push_back(hash);
+                                   });
+        mem.setGifArbiter(&arbiter);
+    }
+}
+
+void register_ps2_data_stream_tests()
+{
+    MiniTest::Case("DataStream", [](TestCase &tc)
+    {
+        tc.Run("ring executes ops in order with intact payloads across wrap and random barriers", [](TestCase &t)
+        {
+            struct State
+            {
+                uint64_t next = 0;
+                uint64_t bad = 0;
+                uint64_t sum = 0;
+            } state;
+            StreamRing ring(
+                64u * 1024u,
+                [&state](const StreamRing::Op &op, const uint8_t *payload)
+                {
+                    if (op.arg != state.next)
+                        ++state.bad;
+                    ++state.next;
+                    const uint32_t bytes = op.bytes - sizeof(StreamRing::Op);
+                    for (uint32_t i = 0; i + 8u <= bytes && i < 64u; i += 8u)
+                    {
+                        uint64_t word;
+                        std::memcpy(&word, payload + i, sizeof(word));
+                        if (word != op.arg + i)
+                            ++state.bad;
+                    }
+                    state.sum += op.arg;
+                });
+            t.IsTrue(ring.start(), "ring should start");
+            std::mt19937 rng(7);
+            uint64_t pushed = 0;
+            std::vector<uint8_t> payload(20000);
+            for (int i = 0; i < 20000; ++i)
+            {
+                const uint32_t bytes = 64u + ((rng() % 4 == 0) ? (rng() % 9000) : (rng() % 100));
+                for (uint32_t j = 0; j < 64u; j += 8u)
+                {
+                    const uint64_t word = pushed + j;
+                    std::memcpy(payload.data() + j, &word, sizeof(word));
+                }
+                ring.push(1, pushed, payload.data(), bytes);
+                ++pushed;
+                const uint32_t r = rng() % 64;
+                if (r == 0)
+                {
+                    ring.drain("test");
+                    t.Equals(state.next, pushed, "drain must retire every pushed op");
+                }
+                else if (r < 8)
+                {
+                    ring.publish();
+                }
+            }
+            ring.drain("test end");
+            t.Equals(state.next, pushed, "all ops executed");
+            t.Equals(state.bad, uint64_t{0}, "no reordered or corrupt op");
+            ring.stop();
+        });
+
+        tc.Run("ring reports a consumer exception at the next drain and keeps draining", [](TestCase &t)
+        {
+            std::atomic<int> executed{0};
+            StreamRing ring(
+                4096u,
+                [&executed](const StreamRing::Op &op, const uint8_t *)
+                {
+                    ++executed;
+                    if (op.arg == 3)
+                        throw std::runtime_error("boom");
+                });
+            t.IsTrue(ring.start(), "ring should start");
+            for (uint64_t i = 0; i < 8; ++i)
+                ring.push(1, i, nullptr, 0);
+            bool threw = false;
+            try
+            {
+                ring.drain("test");
+            }
+            catch (const std::runtime_error &e)
+            {
+                threw = std::string(e.what()) == "boom";
+            }
+            t.IsTrue(threw, "drain should rethrow the consumer exception");
+            ring.stop();
+        });
+
+        tc.Run("worker mode matches inline for VU1 memory, jobs and GIF packet order", [](TestCase &t)
+        {
+            PS2Memory inlineMem;
+            PS2Memory workerMem;
+            t.IsTrue(inlineMem.initialize(), "inline memory initialize should succeed");
+            t.IsTrue(workerMem.initialize(), "worker memory initialize should succeed");
+            GifArbiter inlineArbiter;
+            GifArbiter workerArbiter;
+            Recorder inlineRec;
+            Recorder workerRec;
+            bind(inlineMem, inlineArbiter, inlineRec);
+            bind(workerMem, workerArbiter, workerRec);
+            t.IsTrue(inlineMem.dataStream().start(DataStream::Mode::Inline), "inline start");
+            t.IsTrue(workerMem.dataStream().start(DataStream::Mode::Worker), "worker start");
+
+            for (uint32_t seed = 1; seed <= 300; ++seed)
+            {
+                const auto packet = vifKick(seed);
+                inlineMem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+                workerMem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+                if (seed % 50 == 0)
+                {
+                    // An EE load from VU1 data is a barrier: it must see the UNPACK just issued.
+                    t.Equals(workerMem.read32(PS2_VU1_DATA_BASE + 16u * (16u + (seed & 15u) * 4u)),
+                             inlineMem.read32(PS2_VU1_DATA_BASE + 16u * (16u + (seed & 15u) * 4u)),
+                             "EE read of VU1 data must wait for the worker");
+                }
+            }
+            workerMem.dataStream().barrier("test");
+            t.IsTrue(std::memcmp(inlineMem.getVU1Data(), workerMem.getVU1Data(), PS2_VU1_DATA_SIZE) == 0,
+                     "VU1 data memory should match");
+            t.IsTrue(std::memcmp(inlineMem.getVU1Code(), workerMem.getVU1Code(), PS2_VU1_CODE_SIZE) == 0,
+                     "VU1 code memory should match");
+            t.IsTrue(inlineRec.calls == workerRec.calls && inlineRec.calls.size() == 300u,
+                     "MSCAL jobs should run in the same order with the same arguments");
+            t.IsTrue(inlineRec.gif == workerRec.gif && !inlineRec.gif.empty(),
+                     "GIF packets should reach the bridge in the same order");
+            workerMem.dataStream().stop();
+            inlineMem.dataStream().stop();
+        });
+    });
+}
