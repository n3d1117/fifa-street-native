+    tc.Run("control-flow analysis reports a jump to uncovered code as an external entry candidate", [](TestCase &t) {
+        Function caller;
+        caller.name = "caller";
+        caller.start = 0x4000;
+        caller.end = 0x4008;
+        caller.isRecompiled = true;
+        caller.isStub = false;
+
+        Function stub;
+        stub.name = "sdk_stub";
+        stub.start = 0x5000;
+        stub.end = 0x5100;
+        stub.isRecompiled = false;
+        stub.isStub = true;
+
+        Instruction j{};
+        j.address = 0x4000;
+        j.opcode = OPCODE_J;
+        j.target = (0x5040u >> 2) & 0x3FFFFFFu;
+        j.hasDelaySlot = true;
+        j.raw = (OPCODE_J << 26) | (j.target & 0x3FFFFFFu);
+
+        std::vector<Instruction> instructions{j, makeNop(0x4004)};
+        std::vector<Function> functions{caller, stub};
+        std::vector<Section> sections = {
+            {".text", 0x4000u, 0x2000u, 0u, true, false, false, true, nullptr}
+        };
+
+        CodeGenerator gen({}, sections);
+        CodeGenerator::AnalysisResult analysis =
+            gen.collectInternalBranchTargets(caller, instructions, &functions);
+
+        t.IsTrue(analysis.externalEntryPoints.contains(0x5040u),
+                 "tail call into a stub's extent should become a function start");
+    });
+
     tc.Run("control-flow analysis promotes JALR fallthrough as a resumable entry", [](TestCase &t) {
