@@ -1964,6 +1964,87 @@ namespace ps2recomp
             }
         }
 
+        // Tail calls: a J or branch that leaves its function for code no recompiled
+        // function covers (typically inside a stub's extent) marks a function start.
+        // Each new function can expose further targets, so iterate to a fixed point.
+        for (size_t pass = 0; pass < 16u; ++pass)
+        {
+            std::vector<std::pair<uint32_t, uint32_t>> ranges;
+            ranges.reserve(m_functions.size());
+            for (const auto &function : m_functions)
+            {
+                if (function.isRecompiled && !function.isStub && !function.isSkipped &&
+                    function.end > function.start)
+                {
+                    ranges.emplace_back(function.start, function.end);
+                }
+            }
+            std::sort(ranges.begin(), ranges.end());
+            std::vector<uint32_t> prefixMaxEnd;
+            prefixMaxEnd.reserve(ranges.size());
+            uint32_t runningEnd = 0u;
+            for (const auto &range : ranges)
+            {
+                runningEnd = std::max(runningEnd, range.second);
+                prefixMaxEnd.push_back(runningEnd);
+            }
+            auto covered = [&](uint32_t address) -> bool
+            {
+                auto it = std::upper_bound(ranges.begin(), ranges.end(), std::make_pair(address, UINT32_MAX));
+                if (it == ranges.begin())
+                {
+                    return false;
+                }
+                return prefixMaxEnd[static_cast<size_t>(std::distance(ranges.begin(), it)) - 1u] > address;
+            };
+
+            std::unordered_set<uint32_t> tailCallStarts;
+            for (const auto &function : m_functions)
+            {
+                if (!function.isRecompiled || function.isStub || function.isSkipped)
+                {
+                    continue;
+                }
+                auto decodedIt = m_decodedFunctions.find(function.start);
+                if (decodedIt == m_decodedFunctions.end())
+                {
+                    continue;
+                }
+                const auto analysis = m_codeGenerator->collectInternalBranchTargets(
+                    function, decodedIt->second, &m_functions);
+                for (uint32_t target : analysis.externalEntryPoints)
+                {
+                    if (!covered(target))
+                    {
+                        tailCallStarts.insert(target);
+                    }
+                }
+            }
+
+            if (tailCallStarts.empty())
+            {
+                break;
+            }
+
+            const EntryDiscoveryStats tailStats = discoverAdditionalEntryPointsImpl(
+                m_functions,
+                m_decodedFunctions,
+                m_sections,
+                nullptr,
+                [this](Function &function)
+                { return decodeFunction(function); },
+                tailCallStarts);
+            if (tailStats.discoveredCount == 0u)
+            {
+                break;
+            }
+            m_reporter.recordAdditionalEntryPoints(tailStats.discoveredCount);
+            std::ostringstream msg;
+            msg << "tail-call discovery pass " << (pass + 1u) << ": "
+                << tailStats.discoveredCount << " new function start(s)";
+            m_reporter.progress(msg.str());
+        }
+
