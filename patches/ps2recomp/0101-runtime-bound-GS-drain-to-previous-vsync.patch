+        tc.Run("frame fence waits through its position without draining later work", [](TestCase &t)
+        {
+            std::atomic<bool> release{false};
+            std::atomic<bool> firstDone{false};
+            std::atomic<bool> secondDone{false};
+            StreamRing ring(4096u, [&](const StreamRing::Op &op, const uint8_t *)
+            {
+                if (op.arg == 1)
+                    firstDone.store(true);
+                else
+                {
+                    while (!release.load())
+                        std::this_thread::yield();
+                    secondDone.store(true);
+                }
+            });
+            t.IsTrue(ring.start(), "ring should start");
+            ring.push(1, 1, nullptr, 0);
+            const auto frameEnd = ring.position();
+            ring.push(1, 2, nullptr, 0);
+            ring.drainThrough(frameEnd, "frame fence test");
+            t.IsTrue(firstDone.load(), "frame work must complete");
+            t.IsTrue(!secondDone.load(), "later work must not be required to complete");
+            release.store(true);
+            ring.drain("test end");
+            t.IsTrue(secondDone.load(), "final drain must complete later work");
+            ring.stop();
+        });
+
         tc.Run("worker mode matches inline for VU1 memory, jobs and GIF packet order", [](TestCase &t)
