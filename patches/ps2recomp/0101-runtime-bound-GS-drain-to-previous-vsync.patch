--- a/ps2xRuntime/include/runtime/ps2_perf.h
+++ b/ps2xRuntime/include/runtime/ps2_perf.h
@@ -10,10 +10,12 @@ struct Ps2PerfSnapshot
     double drain_wait_seconds = 0.0;
     uint64_t vsync_drains = 0;
     uint64_t vsync_worker_busy = 0;
+    double stream_full_wait_seconds = 0.0;
 };
 
 Ps2PerfSnapshot ps2GetPerfSnapshot();
 void ps2PublishPerfSnapshot();
+void ps2RecordStreamFullWait(double seconds);
 void ps2RecordVsyncDrain(double seconds, bool workerBusy);
 
 #endif
