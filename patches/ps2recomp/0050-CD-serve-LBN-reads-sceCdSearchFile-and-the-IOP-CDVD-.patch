new file mode 100644
index 0000000000000000000000000000000000000000..7ef698b8e3275fef3a7432b94ca37dd8f78e6f20
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/lbn_map.h
@@ -0,0 +1,202 @@
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop
+{
+    // Serves disc LBN reads from an extracted tree. `<root>/.lbn-map` lists one line each:
+    //   volume <sectors>
+    //   file <lbn> <sectors> <relative path>
+    //   gap <lbn> <sectors> <blob offset>      (non-zero sectors no file covers, in .lbn-gaps.bin)
+    // Sectors the map does not name read as zero inside the volume; outside it a read fails.
+    class LbnMap
+    {
+    public:
+        static constexpr uint32_t kSectorSize = 2048u;
+        static constexpr const char *kMapName = ".lbn-map";
+        static constexpr const char *kGapsName = ".lbn-gaps.bin";
+
+        struct File
+        {
+            uint32_t lbn = 0;
+            uint32_t sectors = 0;
+            uint64_t sizeBytes = 0;
+            std::string relativePath;
+        };
+
+        bool load(const std::filesystem::path &root)
+        {
+            m_root = root;
+            m_files.clear();
+            m_gaps.clear();
+            m_blob.clear();
+            m_volumeSectors = 0;
+            m_loaded = false;
+
+            std::ifstream map(root / kMapName);
+            if (!map)
+                return false;
+            std::string line;
+            while (std::getline(map, line))
+            {
+                std::istringstream fields(line);
+                std::string kind;
+                fields >> kind;
+                if (kind == "volume")
+                {
+                    fields >> m_volumeSectors;
+                }
+                else if (kind == "file")
+                {
+                    File file;
+                    fields >> file.lbn >> file.sectors;
+                    fields.get();
+                    std::getline(fields, file.relativePath);
+                    std::error_code ec;
+                    file.sizeBytes = std::filesystem::file_size(root / file.relativePath, ec);
+                    if (ec)
+                        file.sizeBytes = static_cast<uint64_t>(file.sectors) * kSectorSize;
+                    m_files.push_back(std::move(file));
+                }
+                else if (kind == "gap")
+                {
+                    Gap gap;
+                    fields >> gap.lbn >> gap.sectors >> gap.blobOffset;
+                    m_gaps.push_back(gap);
+                }
+            }
+            std::ifstream blob(root / kGapsName, std::ios::binary);
+            if (blob)
+                m_blob.assign(std::istreambuf_iterator<char>(blob), std::istreambuf_iterator<char>());
+            std::sort(m_files.begin(), m_files.end(), [](const File &a, const File &b) { return a.lbn < b.lbn; });
+            std::sort(m_gaps.begin(), m_gaps.end(), [](const Gap &a, const Gap &b) { return a.lbn < b.lbn; });
+            m_loaded = m_volumeSectors != 0u && !m_files.empty();
+            return m_loaded;
+        }
+
+        [[nodiscard]] bool loaded() const noexcept { return m_loaded; }
+        [[nodiscard]] uint32_t volumeSectors() const noexcept { return m_volumeSectors; }
+        [[nodiscard]] const std::filesystem::path &root() const noexcept { return m_root; }
+        [[nodiscard]] const std::vector<File> &files() const noexcept { return m_files; }
+
+        // `path` is relative to the disc root, '/' or '\' separated, optional ";1" suffix.
+        [[nodiscard]] const File *find(std::string path) const
+        {
+            for (char &c : path)
+            {
+                if (c == '\\')
+                    c = '/';
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            }
+            while (!path.empty() && path.front() == '/')
+                path.erase(path.begin());
+            if (const size_t version = path.rfind(';'); version != std::string::npos)
+                path.erase(version);
+            for (const File &file : m_files)
+            {
+                if (equalsLower(file.relativePath, path))
+                    return &file;
+            }
+            return nullptr;
+        }
+
+        // Reads `sectors` sectors starting at `lbn` into dst (sectors * kSectorSize bytes).
+        [[nodiscard]] bool read(uint32_t lbn, uint32_t sectors, uint8_t *dst) const
+        {
+            if (!m_loaded || static_cast<uint64_t>(lbn) + sectors > m_volumeSectors)
+                return false;
+            uint32_t done = 0;
+            while (done < sectors)
+            {
+                const uint32_t at = lbn + done;
+                uint8_t *out = dst + static_cast<size_t>(done) * kSectorSize;
+                const File *file = fileAt(at);
+                if (!file)
+                {
+                    readSector(at, out);
+                    ++done;
+                    continue;
+                }
+                // One contiguous read for the part of the request inside this file.
+                const uint32_t run = std::min(sectors - done, file->lbn + file->sectors - at);
+                std::memset(out, 0, static_cast<size_t>(run) * kSectorSize);
+                const uint64_t offset = static_cast<uint64_t>(at - file->lbn) * kSectorSize;
+                if (offset < file->sizeBytes)
+                {
+                    std::ifstream in(m_root / file->relativePath, std::ios::binary);
+                    if (!in)
+                        return false;
+                    in.seekg(static_cast<std::streamoff>(offset));
+                    in.read(reinterpret_cast<char *>(out),
+                            static_cast<std::streamsize>(std::min<uint64_t>(
+                                static_cast<uint64_t>(run) * kSectorSize, file->sizeBytes - offset)));
+                }
+                done += run;
+            }
+            return true;
+        }
+
+    private:
+        struct Gap
+        {
+            uint32_t lbn = 0;
+            uint32_t sectors = 0;
+            uint64_t blobOffset = 0;
+        };
+
+        static bool equalsLower(const std::string &a, const std::string &lowerB)
+        {
+            if (a.size() != lowerB.size())
+                return false;
+            for (size_t i = 0; i < a.size(); ++i)
+            {
+                if (std::tolower(static_cast<unsigned char>(a[i])) != lowerB[i])
+                    return false;
+            }
+            return true;
+        }
+
+        const File *fileAt(uint32_t lbn) const
+        {
+            auto file = std::upper_bound(m_files.begin(), m_files.end(), lbn,
+                                         [](uint32_t value, const File &f) { return value < f.lbn; });
+            if (file == m_files.begin())
+                return nullptr;
+            --file;
+            return lbn < file->lbn + file->sectors ? &*file : nullptr;
+        }
+
+        // A sector outside every file: the gap blob or zero.
+        void readSector(uint32_t lbn, uint8_t *dst) const
+        {
+            std::memset(dst, 0, kSectorSize);
+            auto gap = std::upper_bound(m_gaps.begin(), m_gaps.end(), lbn,
+                                        [](uint32_t value, const Gap &g) { return value < g.lbn; });
+            if (gap != m_gaps.begin())
+            {
+                --gap;
+                if (lbn < gap->lbn + gap->sectors)
+                {
+                    const uint64_t offset = gap->blobOffset + static_cast<uint64_t>(lbn - gap->lbn) * kSectorSize;
+                    if (offset + kSectorSize <= m_blob.size())
+                        std::memcpy(dst, m_blob.data() + offset, kSectorSize);
+                }
+            }
+        }
+
+        std::filesystem::path m_root;
+        std::vector<File> m_files;
+        std::vector<Gap> m_gaps;
+        std::vector<uint8_t> m_blob;
+        uint32_t m_volumeSectors = 0;
+        bool m_loaded = false;
+    };
+}
