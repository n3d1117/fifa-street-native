From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Thu, 22 Oct 2026 12:17:40 +0200
Subject: [PATCH 094/100] runtime: finish long source DMA chains

The ordinary VIF/GIF source-chain walker silently stopped after 4096 tags,
leaving CHCR.TAG at CNT while publishing partial work. Roma's city intro
then timed out in guest 0x3BF7F0 and called the NULL error callback through
0x3D23B0 / 0x48EBC8. Successful venue runs retain the same NULL callback.

Port the 1<<20 runaway guard used by KillzoneRecomp patch 0010. Require a
real terminal condition at guard exhaustion instead of reporting success.
Regression tests cover an END and VIF command beyond 4096 tags and a
nonterminating NEXT chain without a DMA completion interrupt.

Measured with PS2X_SCALE=4 PS2X_CHEAT_UNLOCK_VENUES=1 PS2X_VIDEO_MODE=ntsc
PS2X_BOOT_MATCH=venue=5 ./rx run --match --seconds 60: before, fault at
31.3 s after 4096 tags / 3193744 bytes, last tag CNT. With --seconds 120
after the fix, the diagnostic trace reached END after 4099 tags / 3193840
bytes and continued 122.3 s without a fault. Diagnostics were removed.
./rx build && ./rx test --full passed 59/59 including slow tests.

Source: https://github.com/drakolordx7/KillzoneRecomp/blob/master/patches/ps2recomp/0010-vif1-unpack-dma-chains-quadword-loads-mmi.patch

diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index bcb0325f43b2e5e46215d69db48bce88ac678f69..b5d10f1967ca6cef7c2ee8b9a5c63471890b6164 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1469,7 +1469,7 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                     uint32_t asr1 = m_ioRegisters[channelBase + 0x50];
                     uint32_t asp = (chcr >> 4) & 0x3u;
                     const bool tieEnabled = (chcr & (1u << 7)) != 0u;
-                    const int kMaxChainTags = 4096;
+                    constexpr int kMaxChainTags = 1 << 20;
                     std::vector<uint8_t> chainBuf;
 
                     auto appendData = [&](uint32_t srcAddr, uint32_t qwCount)
@@ -1527,6 +1527,7 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                         channelBase == 0x10009000u || channelBase == 0x10008000u;
                     const bool transferTagData = isVifChannel && (chcr & 0x40u) != 0u;
 
+                    bool chainEnded = false;
                     int tagsProcessed = 0;
                     uint32_t lastTagUpper = (chcr >> 16) & 0xFFFFu;
 
@@ -1643,9 +1644,14 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                         if (irq && tieEnabled)
                             endChain = true;
                         if (endChain)
+                        {
+                            chainEnded = true;
                             break;
+                        }
                     }
 
+                    if (tagsProcessed >= kMaxChainTags && !chainEnded)
+                        throw std::runtime_error("DMA source chain exceeded runaway tag guard without termination");
                     m_ioRegisters[channelBase + 0x30] = tagAddr;
                     m_ioRegisters[channelBase + 0x40] = asr0;
                     m_ioRegisters[channelBase + 0x50] = asr1;
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index 15934cd2028564b5ff6e1bbf5537abaece23466b..000e97cbf2d49db3d9e561a92d7ab3f9b787c811 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -11,6 +11,7 @@
 #include <algorithm>
 #include <cstdint>
 #include <cstring>
+#include <stdexcept>
 #include <vector>
 
 namespace
@@ -2203,6 +2204,49 @@ void register_ps2_memory_tests()
             t.IsTrue(payloadOk, "live VIF1 packet payload should reach the GIF callback");
         });
 
+        tc.Run("VIF1 source chain consumes END beyond 4096 tags", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            constexpr uint32_t kChannel = 0x10009000u;
+            constexpr uint32_t kChain = 0x50000u;
+            constexpr uint32_t kCntTags = 4097u;
+            for (uint32_t i = 0; i < kCntTags; ++i)
+                writeDmaTag(mem.getRDRAM(), kChain + i * 16u, makeDmaTag(0u, 1u, 0u));
+            writeDmaTag(mem.getRDRAM(), kChain + kCntTags * 16u, makeDmaTag(1u, 7u, 0u));
+            const uint32_t commands[4] = {0x01001234u, 0u, 0u, 0u};
+            std::memcpy(mem.getRDRAM() + kChain + (kCntTags + 1u) * 16u, commands, sizeof(commands));
+            mem.writeIORegister(kChannel + 0x30u, kChain);
+            mem.writeIORegister(kChannel, 0x185u);
+            t.Equals(mem.readIORegister(kChannel) & 0xFFFF0100u, 0x70000000u,
+                     "long source chain must consume END before clearing STR");
+            t.Equals(mem.vif1_regs.cycle, 0x1234u, "commands after the old cap must execute");
+            const auto causes = mem.consumeCompletedDmacCauses();
+            t.Equals(causes.size(), static_cast<size_t>(1u), "long source chain must complete once");
+        });
+
+        tc.Run("DMA source chain runaway guard cannot publish completion", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            constexpr uint32_t kChannel = 0x10009000u;
+            constexpr uint32_t kChain = 0x50000u;
+            writeDmaTag(mem.getRDRAM(), kChain, makeDmaTag(0u, 2u, kChain));
+            mem.writeIORegister(kChannel + 0x30u, kChain);
+            bool rejected = false;
+            try
+            {
+                mem.writeIORegister(kChannel, 0x185u);
+            }
+            catch (const std::runtime_error &)
+            {
+                rejected = true;
+            }
+            t.IsTrue(rejected, "a nonterminating chain must report guard exhaustion");
+            t.IsTrue(mem.consumeCompletedDmacCauses().empty(), "guard exhaustion must not queue DMA completion");
+            t.Equals(mem.readIORegister(0x1000E010u) & 2u, 0u, "guard exhaustion must not raise D_STAT");
+        });
+
         tc.Run("VIF1 DMA chain latches terminal tag bits in CHCR", [](TestCase &t)
         {
             PS2Memory mem;
