+            uint32_t inner = 0u;
+            std::memcpy(&inner, rdram.data() + kMpegAddr + 0x40u, sizeof(inner));
+            t.Equals(inner, kWorkAddr, "guest MPEG handle should reference its work memory");
+            for (uint32_t offset : {0u, 4u, 8u})
+            {
