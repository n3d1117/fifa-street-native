-        t.IsTrue(lqc2.find("& ~0xFu") == std::string::npos, "LQC2 must preserve the unaligned effective address");
-        t.IsTrue(sqc2.find("& ~0xFu") == std::string::npos, "SQC2 must preserve the unaligned effective address");
