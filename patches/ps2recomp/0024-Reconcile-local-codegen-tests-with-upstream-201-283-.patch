         std::string code = translateUnfixed(inst);
         const uint8_t format = inst.rs;
         if (format == COP2_QMTC2 && inst.rd == 0)
-            return "// QMTC2 to VF0 ignored";
+            return "// QMTC2 to $vf0 discarded";
         if (format < kCop2Co)
             return code;
 
