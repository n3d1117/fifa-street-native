 // The load expression a row must produce for a given decoded fixture.
 static std::string lqc2ExpectedLoad(const Lqc2MemoryPath &path, const Instruction &inst)
 {
+    std::ostringstream ss;
+    if (!path.hasHint && path.isMmio)
+    {
+        // Without a resolved address the I/O path loads through the address built from the
+        // instruction's own operands (our emitter never folds inst.mmioAddress into the load).
+        ss << "runtime->Load128(rdram, ctx, PS2_QWORD_ADDR(ADD32(GPR_U32(ctx, " << inst.rs << "), "
+           << inst.simmediate << ")))";
+        return ss.str();
+    }
     if (path.expectedLoad != nullptr)
     {
         return path.expectedLoad;
     }
-    std::ostringstream ss;
     ss << "READ128(ADD32(GPR_U32(ctx, " << inst.rs << "), " << inst.simmediate << "))";
     return ss.str();
 }
