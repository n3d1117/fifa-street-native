From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 17:13:49 +0200
Subject: [PATCH 18/91] upstream #320: fix(runtime): keep VU0 vf0 hardwired to
 (0, 0, 0, 1)

Kept our equivalent LDC2/LQC2 vf0 handling; took the rest.

diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index 81bb23d028f816b8705d2ed92f89908756aeb20f..d57dc0e410bc3c94377bdd1310d6cfec0ce01dcb 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -148,7 +148,10 @@ struct alignas(16) R5900Context
     {
         std::memset(this, 0, sizeof(*this));
 
-        // Initialize VU0 registers
+        // Initialize VU0 registers. vf0 is hardwired to (0, 0, 0, 1) on the VU; thread and
+        // interrupt contexts are built from this constructor, and VU0 code reads vf0.w (a
+        // vrsqrt with fs = vf0.w in a fresh context must compute 1/sqrt(ft), not 0/sqrt(ft)).
+        vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
         vu0_q = 1.0f; // Q register usually initialized to 1.0
 
         // Reset COP0 registers
