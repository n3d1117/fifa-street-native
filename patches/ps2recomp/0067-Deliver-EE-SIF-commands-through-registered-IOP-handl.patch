+    void writeSifCommandIrx(TestHost &host, uint32_t address)
+    {
+        writeRpcServerIrx(host, address);
+        constexpr uint32_t load = 0x10000u;
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t setUser = load + 0x114u;
+        constexpr uint32_t setSystem = load + 0x11Cu;
+        constexpr uint32_t add = load + 0x124u;
+        constexpr uint32_t remove = load + 0x12Cu;
+        const auto jal = [](uint32_t target) { return 0x0C000000u | (target >> 2u); };
+        ProgramHeader program{};
+        std::memcpy(&program, host.guest.data() + address + sizeof(ElfHeader), sizeof(program));
+        program.filesz = 0x800u;
+        program.memsz = 0x800u;
+        std::memcpy(host.guest.data() + address + sizeof(ElfHeader), &program, sizeof(program));
+        uint8_t *image = host.guest.data() + address + codeOffset;
+        std::memset(image, 0, 0x800u);
+        std::memset(image + 0x4F0u, 0xBC, 0x90u);
+        std::vector<uint32_t> entry{0x27BDFFE0u, 0xAFBF001Cu};
+        const auto imm = [&entry](uint32_t reg, uint32_t value) {
+            entry.push_back(0x3C000000u | (reg << 16u) | (value >> 16u));
+            entry.push_back(0x34000000u | (reg << 21u) | (reg << 16u) | (value & 0xFFFFu));
+        };
+        const auto call = [&entry, &jal](uint32_t target) {
+            entry.push_back(jal(target)); entry.push_back(0u);
+        };
+        imm(28u, load + 0x780u);
+        imm(4u, load + 0x500u);
+        entry.push_back(0x24050004u);
+        call(setUser);
+        imm(4u, load + 0x540u);
+        entry.push_back(0x24050004u);
+        call(setSystem);
+        for (uint32_t cid : {3u, 0x80000003u})
+        {
+            imm(4u, cid);
+            imm(5u, load + 0x300u);
+            imm(6u, load + (cid == 3u ? 0x600u : 0x620u));
+            call(add);
+        }
+        entry.insert(entry.end(), {0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x00001021u});
+        std::memcpy(image, entry.data(), entry.size() * sizeof(uint32_t));
+        const uint32_t imports[] = {
+            0x41E00000u, 0u, 0x101u, 0x63666973u, 0x0000646Du,
+            0x03E00008u, 0x24000008u,
+            0x03E00008u, 0x24000009u,
+            0x03E00008u, 0x2400000Au,
+            0x03E00008u, 0x2400000Bu,
+            0u, 0u,
+        };
+        std::memcpy(image + 0x100u, imports, sizeof(imports));
+        const uint32_t handler[] = {
+            0x27BDFFE0u, // addiu sp, sp, -32
+            0xAFBF001Cu, // sw ra, 28(sp)
+            0xACA40000u, // sw a0, 0(a1): transient packet pointer
+            0x8C880010u, // lw t0, 16(a0): payload
+            0xACBC0008u, // sw gp, 8(a1)
+            0xACA80004u, // sw t0, 4(a1)
+            0xACA5000Cu, // sw a1, 12(a1): registered argument
+            0x2409FFFFu, // addiu t1, zero, -1
+            0x15090004u, // bne t0, t1, return
+            0u,
+            0x8C840008u, // lw a0, 8(a0): remove this command id
+            jal(remove),
+            0u,
+            0x8FBF001Cu,
+            0x27BD0020u,
+            0x03E00008u,
+            0u,
+        };
+        std::memcpy(image + 0x300u, handler, sizeof(handler));
+    }
