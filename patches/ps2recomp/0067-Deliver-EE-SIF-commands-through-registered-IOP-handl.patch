+    uint32_t IopRpcBridge::commandEntry(uint32_t commandId) const
+    {
+        const bool system = (commandId & 0x80000000u) != 0u;
+        const CmdTable &table = system ? m_systemCommands : m_userCommands;
+        const uint32_t index = commandId & 0x7FFFFFFFu;
+        const uint32_t stride = system ? 12u : 8u;
+        if (table.address == 0u || index >= table.count || index > IopMemory::RamSize / stride)
+            return 0u;
+        const uint64_t entry = static_cast<uint64_t>(table.address) + index * stride;
+        if (entry > UINT32_MAX || !m_memory.ownsRamRange(static_cast<uint32_t>(entry), stride))
+            return 0u;
+        return static_cast<uint32_t>(entry);
+    }
+
+    bool IopRpcBridge::handleCommand(uint32_t commandId, const void *packet, size_t packetSize,
+                                     IopGuestExecutor &executor)
+    {
+        if (!packet || packetSize < 16u || packetSize > 112u)
+            return false;
+        uint32_t header[3]{};
+        std::memcpy(header, packet, sizeof(header));
+        if ((header[0] & 0xFFu) != packetSize || header[2] != commandId)
+            return false;
+        const uint32_t entry = commandEntry(commandId);
+        if (entry == 0u)
+            return false;
+        const uint32_t function = m_memory.read32(entry);
+        if (function == 0u)
+            return false;
+        const uint32_t argument = m_memory.read32(entry + 4u);
+        const auto registration = m_commandRegistrations.find(commandId);
+        const uint32_t gp = registration != m_commandRegistrations.end() &&
+                            registration->second.function == function ? registration->second.gp : 0u;
+
+        // The SDK passes a temporary interrupt-stack copy, independent of the handler table.
+        const uint32_t packetAddress = m_memory.allocate(128u, 16u);
+        if (packetAddress == 0u)
+            return false;
+        struct PacketAllocation
+        {
+            IopMemory &memory;
+            uint32_t address;
+            ~PacketAllocation() { (void)memory.freeAllocation(address); }
+        } allocation{m_memory, packetAddress};
+        if (!m_memory.zeroRam(packetAddress, 128u) || !m_memory.writeRam(packetAddress, packet, packetSize))
+            return false;
+        (void)executor.executeGuestFunction(function, packetAddress, argument, 0u, 0u, gp);
+        return true;
+    }
