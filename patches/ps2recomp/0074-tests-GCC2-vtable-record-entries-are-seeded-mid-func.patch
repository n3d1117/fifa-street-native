@@ -2112,6 +2166,28 @@ void register_ps2_recompiler_tests()
                      "a stack-frame allocation is a function start even when no terminator precedes it");
         });
 
+        tc.Run("elf parser seeds GCC2 vtable record entries but not mid-function words", [](TestCase &t) {
+            const auto elfPath = std::filesystem::temp_directory_path() /
+                                 ("ps2recomp-vtable-records-" +
+                                  std::to_string(static_cast<unsigned long long>(
+                                      std::chrono::steady_clock::now().time_since_epoch().count())) + ".elf");
+            t.IsTrue(writeMinimalMipsElfWithVtableRecords(elfPath), "ELF should be generated");
+            ElfParser parser(elfPath.string());
+            t.IsTrue(parser.parse(), "ELF should parse");
+            const auto functions = parser.extractFunctions();
+            const auto hasStart = [&functions](uint32_t start) {
+                return std::any_of(functions.begin(), functions.end(),
+                                   [start](const Function &f) { return f.start == start; });
+            };
+            t.IsTrue(hasStart(0x00100020u), "a leaf in a {adjustment, pointer, id} record is a function start");
+            t.IsFalse(hasStart(0x00100060u), "a record pointing into the middle of straight-line code is not split out");
+            const auto &alias = parser.aliasEntryHints();
+            t.IsTrue(std::find(alias.begin(), alias.end(), 0x00100060u) != alias.end(),
+                     "the rejected pointer is kept as a resume label");
+            std::error_code ec;
+            std::filesystem::remove(elfPath, ec);
+        });
+
