@@ -153,6 +157,8 @@ private:
     std::unique_ptr<StreamRing> m_ring;
     Mode m_mode = Mode::Inline;
     int m_kickDepth = 0;
+    std::atomic<uint64_t> m_pendingVifJobs{0};
+    std::array<std::atomic<uint64_t>, 4> m_pendingGifByPath{};
     bool m_gsStale = false;
     bool m_verify = false;
     uint64_t m_shadowCsr = 0;
diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index c303406579ca3ef6afc943967fb21c64f6ddb947..659e719f6fc1ca163257f8b2f5707893244442d1 100644
