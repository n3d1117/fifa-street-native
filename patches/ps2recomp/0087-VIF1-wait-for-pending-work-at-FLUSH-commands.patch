+        const auto drained = m_memory.m_gifArbiter->drain(pathMask);
+        for (uint32_t path = 1u; path <= 3u; ++path)
+            m_pendingGifByPath[path].fetch_sub(drained[path], std::memory_order_release);
         break;
+    }
     case OpVif:
     {
         Vif1Op vif;
@@ -151,7 +160,10 @@ void DataStream::execute(const StreamRing::Op &op, const uint8_t *payload)
         vif.payload = vif.payloadBytes ? payload + kVifHeaderBytes : nullptr;
         m_memory.applyVif1Op(vif);
         if (vif.kind == Vif1OpKind::Mscal || vif.kind == Vif1OpKind::Mscnt)
+        {
             m_mailbox.stopBits = m_memory.vu1Exec().stopBits;
+            m_pendingVifJobs.fetch_sub(1u, std::memory_order_release);
+        }
         break;
     }
     case OpGsReset:
@@ -208,6 +220,8 @@ uint32_t DataStream::vu1Job(const Vif1Op &job, bool wait)
     }
     uint8_t header[kVifHeaderBytes] = {};
     std::memcpy(header, &job, sizeof(job));
+    if (!wait && (job.kind == Vif1OpKind::Mscal || job.kind == Vif1OpKind::Mscnt))
+        m_pendingVifJobs.fetch_add(1u, std::memory_order_release);
     m_ring->push(OpVif, static_cast<uint64_t>(job.kind), header, kVifHeaderBytes);
     m_gsStale = true;
     publishIfIdle();
@@ -217,6 +231,36 @@ uint32_t DataStream::vu1Job(const Vif1Op &job, bool wait)
     return m_mailbox.stopBits;
 }
 
+void DataStream::vifFlush(uint8_t gifPathMask, const char *why)
+{
+    if (!deferred())
+    {
+        if (gifPathMask != 0u)
+            m_memory.m_gifArbiter->drain(gifPathMask);
+        return;
+    }
+
+    bool pending = m_pendingVifJobs.load(std::memory_order_acquire) != 0u;
+    for (uint32_t path = 1u; path <= 3u; ++path)
+    {
+        if ((gifPathMask & (1u << path)) != 0u &&
+            m_pendingGifByPath[path].load(std::memory_order_acquire) != 0u)
+        {
+            pending = true;
+            break;
+        }
+    }
+    if (!pending)
+        return;
+
+    // FLUSH can occur inside a VIF kick. Publish earlier commands, then queue
+    // a path-selective arbiter drain behind them before waiting on the worker.
+    if (gifPathMask != 0u)
+        m_ring->push(OpGifDrain, gifPathMask, nullptr, 0);
+    m_ring->publish();
+    m_ring->drain(why);
+}
+
 void DataStream::gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl, bool drain)
 {
     if (!deferred())
@@ -232,6 +276,9 @@ void DataStream::gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeByt
                      static_cast<uint32_t>(path) | (path2DirectHl ? 0x100u : 0u) | (drain ? 0x200u : 0u) |
                          (borrow ? 0x400u : 0u),
                      borrow ? data : nullptr};
+    const uint32_t pathIndex = static_cast<uint32_t>(path);
+    if (pathIndex <= 3u)
+        m_pendingGifByPath[pathIndex].fetch_add(1u, std::memory_order_release);
     m_ring->push(OpGifPacket, static_cast<uint64_t>(path), &header, sizeof(header), borrow ? nullptr : data,
                  borrow ? 0u : sizeBytes);
     m_gsStale = true;
@@ -247,7 +294,7 @@ void DataStream::gifDrain()
         m_memory.m_gifArbiter->drain();
         return;
     }
-    m_ring->push(OpGifDrain, 0, nullptr, 0);
+    m_ring->push(OpGifDrain, 0x0Eu, nullptr, 0);
     m_gsStale = true;
     publishIfIdle();
 }
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.h b/ps2xRuntime/src/lib/ps2_data_stream.h
