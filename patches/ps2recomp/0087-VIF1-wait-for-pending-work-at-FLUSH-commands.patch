--- a/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
+++ b/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
@@ -39,12 +39,24 @@ void GifArbiter::submit(GifPathId pathId, const uint8_t *data, uint32_t sizeByte
     m_queue.push_back(std::move(pkt));
 }
 
-void GifArbiter::drain()
+std::array<uint32_t, 4> GifArbiter::drain(uint8_t pathMask)
 {
+    std::array<uint32_t, 4> drained{};
     if (!m_processFn)
-        return;
+        return drained;
+
+    std::vector<GifArbiterPacket> selected;
+    std::vector<GifArbiterPacket> retained;
+    selected.reserve(m_queue.size());
+    retained.reserve(m_queue.size());
+    for (auto &pkt : m_queue)
+    {
+        const uint32_t path = static_cast<uint32_t>(pkt.pathId);
+        ((pathMask & (1u << path)) != 0u ? selected : retained).push_back(std::move(pkt));
+    }
+    m_queue = std::move(retained);
 
-    std::stable_sort(m_queue.begin(), m_queue.end(),
+    std::stable_sort(selected.begin(), selected.end(),
                      [](const GifArbiterPacket &a, const GifArbiterPacket &b)
                      {
                          // DIRECTHL cannot preempt PATH3 IMAGE transfers.
@@ -58,15 +70,16 @@ void GifArbiter::drain()
                          return pathPriority(a.pathId) < pathPriority(b.pathId);
                      });
 
-    for (size_t i = 0; i < m_queue.size(); ++i)
+    for (size_t i = 0; i < selected.size(); ++i)
     {
-        auto &pkt = m_queue[i];
+        auto &pkt = selected[i];
         if (!pkt.data.empty())
         {
             m_processFn(pkt.pathId, pkt.data.data(), static_cast<uint32_t>(pkt.data.size()));
+            ++drained[static_cast<uint32_t>(pkt.pathId)];
         }
     }
-    m_queue.clear();
+    return drained;
 }
 
 uint8_t GifArbiter::pathPriority(GifPathId id)
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
