diff --git a/ps2xTest/src/ps2_data_stream_tests.cpp b/ps2xTest/src/ps2_data_stream_tests.cpp
index 79b997656421f4f5dc9dbefd7ead0de7fe7981e9..b94d32b8eeb4fe758235ff50b9e7f76006f2b46e 100644
--- a/ps2xTest/src/ps2_data_stream_tests.cpp
+++ b/ps2xTest/src/ps2_data_stream_tests.cpp
@@ -4,10 +4,14 @@
 #include "ps2_data_stream.h"
 
 #include <atomic>
+#include <chrono>
+#include <condition_variable>
 #include <cstdint>
 #include <cstring>
+#include <mutex>
 #include <random>
 #include <stdexcept>
+#include <thread>
 #include <vector>
 
 namespace
@@ -193,5 +197,123 @@ void register_ps2_data_stream_tests()
             workerMem.dataStream().stop();
             inlineMem.dataStream().stop();
         });
+
+        tc.Run("VIF1 FLUSHE waits for a queued VU1 job", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "memory initialize should succeed");
+            GifArbiter arbiter;
+            Recorder rec;
+            bind(mem, arbiter, rec);
+
+            std::mutex mutex;
+            std::condition_variable cv;
+            bool entered = false;
+            bool release = false;
+            mem.setVu1MscalCallback([&](uint32_t, uint32_t, uint32_t)
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                entered = true;
+                cv.notify_all();
+                cv.wait(lock, [&] { return release; });
+            });
+            t.IsTrue(mem.dataStream().start(DataStream::Mode::Worker), "worker start");
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, vifCmd(0x14u, 0u, 0u)); // MSCAL
+            appendU32(packet, vifCmd(0x10u, 0u, 0u)); // FLUSHE
+            std::atomic<bool> returned{false};
+            std::thread producer([&]
+            {
+                mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+                returned.store(true, std::memory_order_release);
+            });
+
+            bool callbackEntered = false;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                callbackEntered = cv.wait_for(lock, std::chrono::seconds(3), [&] { return entered; });
+            }
+            const bool waitedForVu = !returned.load(std::memory_order_acquire);
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                release = true;
+            }
+            cv.notify_all();
+            producer.join();
+            t.IsTrue(callbackEntered, "queued MSCAL should reach the worker");
+            t.IsTrue(waitedForVu, "FLUSHE must hold the VIF producer until the preceding VU1 job completes");
+            t.IsTrue(returned.load(std::memory_order_acquire), "FLUSHE should resume after the VU1 job completes");
+            mem.dataStream().stop();
+        });
+
+        tc.Run("VIF1 FLUSH waits for preceding PATH2 GIF packets", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "memory initialize should succeed");
+            GifArbiter arbiter;
+            std::mutex mutex;
+            std::condition_variable cv;
+            bool entered = false;
+            bool release = false;
+            arbiter.setProcessPacketFn([&](GifPathId, const uint8_t *, uint32_t)
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                entered = true;
+                cv.notify_all();
+                cv.wait(lock, [&] { return release; });
+            });
+            mem.setGifArbiter(&arbiter);
+            t.IsTrue(mem.dataStream().start(DataStream::Mode::Worker), "worker start");
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, vifCmd(0x50u, 0u, 1u)); // DIRECT, one QWC to PATH2
+            for (uint32_t word : {0u, 0x10000000u, 0x0Eu, 0u})
+                appendU32(packet, word); // valid PACKED A+D GIF tag
+            appendU32(packet, vifCmd(0x11u, 0u, 0u)); // FLUSH
+            std::atomic<bool> returned{false};
+            std::thread producer([&]
+            {
+                mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+                returned.store(true, std::memory_order_release);
+            });
+
+            bool callbackEntered = false;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                callbackEntered = cv.wait_for(lock, std::chrono::seconds(3), [&] { return entered; });
+            }
+            const bool waitedForGif = !returned.load(std::memory_order_acquire);
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                release = true;
+            }
+            cv.notify_all();
+            producer.join();
+            t.IsTrue(callbackEntered, "DIRECT packet should reach the GIF worker");
+            t.IsTrue(waitedForGif, "FLUSH must hold VIF until its preceding PATH2 transfer drains");
+            t.IsTrue(returned.load(std::memory_order_acquire), "FLUSH should resume after PATH2 drains");
+            mem.dataStream().stop();
+        });
+
+        tc.Run("VIF1 FLUSH leaves PATH3 queued for FLUSHA", [](TestCase &t)
+        {
+            std::vector<uint8_t> emitted;
+            GifArbiter arbiter([&](GifPathId path, const uint8_t *, uint32_t)
+            {
+                emitted.push_back(static_cast<uint8_t>(path));
+            });
+            const std::vector<uint8_t> packet(16u, 0u);
+            arbiter.submit(GifPathId::Path3, packet.data(), static_cast<uint32_t>(packet.size()));
+
+            const auto flushResult = arbiter.drain(0x06u); // FLUSH: PATH1 and PATH2
+            t.Equals(flushResult[3], static_cast<uint32_t>(0u), "FLUSH must not retire PATH3");
+            t.IsTrue(!arbiter.empty(), "PATH3 should remain queued after FLUSH");
+            t.Equals(emitted.size(), static_cast<size_t>(0u), "FLUSH must leave PATH3 unsubmitted");
+
+            const auto flushaResult = arbiter.drain(0x0Eu); // FLUSHA: all GIF paths
+            t.Equals(flushaResult[3], static_cast<uint32_t>(1u), "FLUSHA should retire PATH3");
+            t.Equals(emitted.size(), static_cast<size_t>(1u), "FLUSHA should submit the queued PATH3 packet");
+        });
     });
 }
