From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 23:37:45 +0200
Subject: [PATCH 085/109] vif1: retain pending input capacity

Match route, GameThread CPU/s: 0.528 baseline to 0.651 median after (+23%). _platform_memmove share: 12.46% baseline to 1.4% after; second after sample below top 12. Test reference models legacy append and swap on STC resume.

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index 08b43c565019c98a04204f48564222331e8d9e71..041a26cf46578a88f7c39ca0f64bfb5f63da9fdb 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -447,6 +447,7 @@ public:
     uint32_t m_vif1PendingDirectQwc = 0u;
     bool m_vif1PendingDirectHl = false;
     std::vector<uint8_t> m_vif1PendingInput;
+    size_t m_vif1PendingInputOffset = 0;
     bool m_vif1PendingCommandIrq = false;
     bool m_vif1Stalled = false;
     bool m_vif1DmaCompletionPending = false;
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index b346a0ae6c7dd586a8abd39ff593c51407e220df..8fc54f6ce155b2156b6cb68f8e0ea01faee2c09e 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -369,6 +369,7 @@ bool PS2Memory::initialize(size_t ramSize)
     m_vif1PendingDirectQwc = 0u;
     m_vif1PendingDirectHl = false;
     m_vif1PendingInput.clear();
+    m_vif1PendingInputOffset = 0u;
     m_vif1PendingCommandIrq = false;
     m_vif1Stalled = false;
     m_vif1DmaCompletionPending = false;
@@ -1291,6 +1292,7 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                 m_vif1PendingDirectQwc = 0u;
                 m_vif1PendingDirectHl = false;
                 m_vif1PendingInput.clear();
+                m_vif1PendingInputOffset = 0u;
                 m_vif1PendingCommandIrq = false;
                 m_vif1Stalled = false;
                 m_vif1DmaCompletionPending = false;
diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index 0bf7aae107e87cd9de200037b503b83b26a57df5..c303406579ca3ef6afc943967fb21c64f6ddb947 100644
--- a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
+++ b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
@@ -5,6 +5,7 @@
 #include <cstdlib>
 #include <cstring>
 #include <iostream>
+#include <cstdint>
 
 enum VIFCmd : uint8_t
 {
@@ -88,9 +89,32 @@ namespace
     {
         if (sizeBytes == 0u)
             return;
-        if (!data || sizeBytes > PS2_RAM_SIZE - memory.m_vif1PendingInput.size())
+        if (!data)
             throw std::runtime_error("VIF1 stalled input exceeds one RDRAM buffer");
-        memory.m_vif1PendingInput.insert(memory.m_vif1PendingInput.end(), data, data + sizeBytes);
+
+        auto &pending = memory.m_vif1PendingInput;
+        const uintptr_t dataAddress = reinterpret_cast<uintptr_t>(data);
+        const uintptr_t beginAddress = reinterpret_cast<uintptr_t>(pending.data());
+        const uintptr_t endAddress = beginAddress + pending.size();
+        if (!pending.empty() && dataAddress >= beginAddress && dataAddress < endAddress)
+        {
+            const size_t offset = static_cast<size_t>(dataAddress - beginAddress);
+            if (sizeBytes > pending.size() - offset)
+                throw std::runtime_error("VIF1 pending input range is invalid");
+            memory.m_vif1PendingInputOffset = offset;
+            return;
+        }
+
+        if (memory.m_vif1PendingInputOffset != 0u)
+        {
+            const size_t remaining = pending.size() - memory.m_vif1PendingInputOffset;
+            std::memmove(pending.data(), pending.data() + memory.m_vif1PendingInputOffset, remaining);
+            pending.resize(remaining);
+            memory.m_vif1PendingInputOffset = 0u;
+        }
+        if (sizeBytes > PS2_RAM_SIZE - pending.size())
+            throw std::runtime_error("VIF1 stalled input exceeds one RDRAM buffer");
+        pending.insert(pending.end(), data, data + sizeBytes);
     }
 
     bool stallVif1ForIrq(PS2Memory &memory, bool irq, uint8_t opcode, const uint8_t *remaining,
@@ -629,10 +653,12 @@ void PS2Memory::resumeVif1AfterStall()
         return;
 
     m_vif1Stalled = false;
-    std::vector<uint8_t> pending;
-    pending.swap(m_vif1PendingInput);
-    if (!pending.empty())
-        processVIF1Data(pending.data(), static_cast<uint32_t>(pending.size()));
+    const size_t pendingSize = m_vif1PendingInput.size() - m_vif1PendingInputOffset;
+    if (pendingSize != 0u)
+        processVIF1Data(m_vif1PendingInput.data() + m_vif1PendingInputOffset,
+                        static_cast<uint32_t>(pendingSize));
+    else
+        m_vif1PendingInput.clear();
 }
 
 // Executes one VU1-side op against VU1 memory and the VU1 callbacks. MSCAL and
@@ -697,17 +723,23 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
         return;
     }
 
-    // DMA payloads can end in the middle of a VIF command. Preserve and join
-    // that suffix with the next payload before interpreting any new CODE word.
-    std::vector<uint8_t> mergedInput;
-    if (!m_vif1PendingInput.empty())
+    // DMA payloads can end in the middle of a VIF command. Keep the suffix in
+    // the pending vector and append the next payload in place. This retains
+    // capacity across STC resumes and compacts only after a consumed prefix.
+    bool processingPendingInput = false;
+    if (m_vif1PendingInputOffset < m_vif1PendingInput.size())
     {
-        mergedInput.swap(m_vif1PendingInput);
-        if (sizeBytes > PS2_RAM_SIZE - mergedInput.size())
-            throw std::runtime_error("VIF1 fragmented input exceeds one RDRAM buffer");
-        mergedInput.insert(mergedInput.end(), data, data + sizeBytes);
-        data = mergedInput.data();
-        sizeBytes = static_cast<uint32_t>(mergedInput.size());
+        const uintptr_t dataAddress = reinterpret_cast<uintptr_t>(data);
+        const uintptr_t beginAddress = reinterpret_cast<uintptr_t>(m_vif1PendingInput.data());
+        const uintptr_t endAddress = beginAddress + m_vif1PendingInput.size();
+        processingPendingInput = dataAddress >= beginAddress && dataAddress < endAddress;
+        if (!processingPendingInput)
+        {
+            appendPendingVif1Input(*this, data, sizeBytes);
+            data = m_vif1PendingInput.data();
+            sizeBytes = static_cast<uint32_t>(m_vif1PendingInput.size());
+            processingPendingInput = true;
+        }
     }
 
     auto bufferPartialCommand = [&](uint32_t commandStart, uint8_t opcode, uint32_t expectedBytes)
@@ -1159,5 +1191,7 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
     // word so it is not mistaken for the beginning of the next DMA payload.
     if (pos < sizeBytes)
         appendPendingVif1Input(*this, data + pos, sizeBytes - pos);
+    else if (processingPendingInput)
+        m_vif1PendingInputOffset = m_vif1PendingInput.size();
 
 }
