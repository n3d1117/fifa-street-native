@@ -1,6 +1,7 @@
 #include "MiniTest.h"
 #include "runtime/ps2_memory.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <cstring>
 #include <vector>
@@ -82,6 +83,43 @@ void register_ps2_vif_error_tests()
             t.Equals(mem.vif1_regs.cycle, 0x0102u, "STC should resume and execute the buffered tail");
         });
 
+        tc.Run("VIF1 stall resume preserves appended byte order", [](TestCase &t)
+        {
+            PS2Memory resumed;
+            PS2Memory reference;
+            t.IsTrue(resumed.initialize(), "resumed memory initialize should succeed");
+            t.IsTrue(reference.initialize(), "reference memory initialize should succeed");
+            resumed.m_ioRegisters[0x10009000u] = 0x100u;
+
+            std::vector<uint8_t> first;
+            appendWord(first, 0x40000000u); // Reserved opcode stalls with ER1.
+            appendWord(first, 0x01010102u); // STCYCL, WL=1, CL=2.
+            resumed.processVIF1Data(first.data(), static_cast<uint32_t>(first.size()));
+
+            std::vector<uint8_t> legacyPending(first.begin() + 4, first.end());
+            std::vector<uint8_t> appended;
+            appendWord(appended, 0x01010304u);
+            appendWord(appended, 0x01010506u);
+            appendWord(appended, 0x01010708u);
+            for (size_t offset = 0; offset < appended.size(); offset += 5u)
+            {
+                const size_t count = std::min<size_t>(5u, appended.size() - offset);
+                resumed.processVIF1Data(appended.data() + offset, static_cast<uint32_t>(count));
+                // Reference the former vector append and swap-on-resume algorithm.
+                legacyPending.insert(legacyPending.end(), appended.begin() + offset,
+                                     appended.begin() + offset + count);
+            }
+
+            std::vector<uint8_t> legacyResume;
+            legacyResume.swap(legacyPending);
+            t.Equals(legacyResume.size(), static_cast<size_t>(16u), "legacy resume should consume the complete tail");
+            resumed.writeIORegister(kVifFbrstReg, 0x8u);
+            reference.processVIF1Data(legacyResume.data(), static_cast<uint32_t>(legacyResume.size()));
+            t.Equals(resumed.vif1_regs.cycle, reference.vif1_regs.cycle,
+                     "stall/resume command output should match the legacy byte-vector sequence");
+            t.Equals(resumed.vif1_regs.cycle, 0x0708u, "all appended STCYCL commands should execute in order");
+        });
+
         tc.Run("ERR.ME1 masks invalid opcode and continues without IRQ", [](TestCase &t)
         {
             PS2Memory mem;
