diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2a4156c9255f613aee81edd3595c6054582dc65d
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_data_stream.cpp
@@ -0,0 +1,101 @@
+#include "ps2_data_stream.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <stdexcept>
+
+#if defined(TARZAN_USE_METAL)
+extern "C" int tarzan_metal_gs_submit(uint32_t, const uint8_t *, uint32_t);
+extern "C" int tarzan_metal_gs_reset();
+extern "C" int tarzan_metal_gs_write_csr(uint64_t, uint32_t, int);
+extern "C" int tarzan_metal_gs_vsync(const uint64_t *, uint64_t, uint32_t);
+extern "C" int tarzan_metal_gs_readback(uint64_t *, uint64_t *);
+extern "C" int tarzan_metal_gs_read_local_memory(uint8_t *, uint32_t, uint64_t, uint64_t, uint64_t);
+#endif
+
+DataStream::DataStream(GSRegisters &gs) : m_gs(gs)
+{
+    const char *verify = std::getenv("PS2X_GS_VERIFY");
+    m_verify = verify && verify[0] == '1';
+}
+
+#if defined(TARZAN_USE_METAL)
+
+void DataStream::readbackInto(uint64_t &csr, uint64_t &siglblid, const char *what)
+{
+    if (!tarzan_metal_gs_readback(&csr, &siglblid))
+        throw std::runtime_error(what);
+}
+
+void DataStream::gifSubmit(GifPathId path, const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!tarzan_metal_gs_submit(static_cast<uint32_t>(path), data, sizeBytes))
+        throw std::runtime_error("native Metal GS rejected GIF packet");
+    m_gsStale = true;
+    if (m_verify)
+        readbackInto(m_shadowCsr, m_shadowSiglblid, "native Metal GS CSR/SIGLBLID readback failed");
+}
+
+void DataStream::refreshGs()
+{
+    uint64_t csr = 0, siglblid = 0;
+    readbackInto(csr, siglblid, "native Metal GS CSR/SIGLBLID readback failed");
+    if (m_verify && (csr != m_shadowCsr || siglblid != m_shadowSiglblid))
+    {
+        std::fprintf(stderr,
+                     "[gs-verify] lazy readback differs from eager: csr 0x%llx vs 0x%llx, siglblid 0x%llx vs 0x%llx\n",
+                     static_cast<unsigned long long>(csr), static_cast<unsigned long long>(m_shadowCsr),
+                     static_cast<unsigned long long>(siglblid), static_cast<unsigned long long>(m_shadowSiglblid));
+        std::abort();
+    }
+    m_gs.csr.store(csr, std::memory_order_release);
+    m_gs.siglblid = siglblid;
+    m_gsStale = false;
+}
+
+void DataStream::gsReset()
+{
+    if (!tarzan_metal_gs_reset())
+        throw std::runtime_error("native Metal GS CSR reset failed");
+}
+
+void DataStream::gsWriteCsr(uint64_t authoritativeCsr, uint32_t highWordMask, bool writeHighWord)
+{
+    if (!tarzan_metal_gs_write_csr(authoritativeCsr, highWordMask, writeHighWord ? 1 : 0))
+        throw std::runtime_error("native Metal GS CSR synchronization failed");
+}
+
+void DataStream::gsVsync(uint64_t tick)
+{
+    observeGs();
+    const uint64_t regs[19] = {
+        m_gs.pmode, m_gs.smode1, m_gs.smode2, m_gs.srfsh, m_gs.synch1, m_gs.synch2,
+        m_gs.syncv, m_gs.dispfb1, m_gs.display1, m_gs.dispfb2, m_gs.display2,
+        m_gs.extbuf, m_gs.extdata, m_gs.extwrite, m_gs.bgcolor, m_gs.csr.load(),
+        m_gs.imr, m_gs.busdir, m_gs.siglblid};
+    if (!tarzan_metal_gs_vsync(regs, tick, static_cast<uint32_t>(tick & 1u)))
+        throw std::runtime_error("native Metal GS VSync failed");
+    uint64_t csr = 0, siglblid = 0;
+    readbackInto(csr, siglblid, "native Metal GS VSync readback failed");
+    m_gs.csr.store(csr, std::memory_order_release);
+    m_gs.siglblid = siglblid;
+    m_gsStale = false;
+}
+
+bool DataStream::gsReadLocal(uint8_t *dst, uint32_t byteCount, uint64_t bitbltbuf, uint64_t trxpos,
+                             uint64_t trxreg)
+{
+    return tarzan_metal_gs_read_local_memory(dst, byteCount, bitbltbuf, trxpos, trxreg) != 0;
+}
+
+#else
+
+void DataStream::readbackInto(uint64_t &, uint64_t &, const char *) {}
+void DataStream::gifSubmit(GifPathId, const uint8_t *, uint32_t) {}
+void DataStream::refreshGs() {}
+void DataStream::gsReset() {}
+void DataStream::gsWriteCsr(uint64_t, uint32_t, bool) {}
+void DataStream::gsVsync(uint64_t) {}
+bool DataStream::gsReadLocal(uint8_t *, uint32_t, uint64_t, uint64_t, uint64_t) { return false; }
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.h b/ps2xRuntime/src/lib/ps2_data_stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..e895e18c8c97104348c782920376ca16a69981a3
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_data_stream.h
@@ -0,0 +1,44 @@
+#ifndef PS2_DATA_STREAM_H
+#define PS2_DATA_STREAM_H
+
+#include <cstdint>
+
+#include "runtime/ps2_memory.h"
+
+// The one ordered interface to the data side (GIF packets and the native GS
+// bridge). Every bridge call from the GIF/XGKICK/CSR/VBlank paths goes through
+// here, so a consumer thread can later own the bridge without changing callers.
+//
+// GS CSR and SIGLBLID are a pure function of the packets the bridge has
+// processed. They are read back lazily: gifSubmit only marks them stale, and
+// observeGs() is the explicit drain point that must run before the EE reads or
+// writes any GS privileged register.
+class DataStream
+{
+public:
+    explicit DataStream(GSRegisters &gs);
+
+    void gifSubmit(GifPathId path, const uint8_t *data, uint32_t sizeBytes);
+    void gsReset();
+    void gsWriteCsr(uint64_t authoritativeCsr, uint32_t highWordMask, bool writeHighWord);
+    void gsVsync(uint64_t tick);
+    bool gsReadLocal(uint8_t *dst, uint32_t byteCount, uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg);
+
+    void observeGs()
+    {
+        if (m_gsStale)
+            refreshGs();
+    }
+
+private:
+    void refreshGs();
+    void readbackInto(uint64_t &csr, uint64_t &siglblid, const char *what);
+
+    GSRegisters &m_gs;
+    bool m_gsStale = false;
+    bool m_verify = false;
+    uint64_t m_shadowCsr = 0;
+    uint64_t m_shadowSiglblid = 0;
+};
+
+#endif
