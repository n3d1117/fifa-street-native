+// Executes one VU1-side op against VU1 memory and the VU1 callbacks. MSCAL and
+// MSCNT leave the VPU_STAT stop bits of the job in vu1Exec().stopBits.
+void PS2Memory::applyVif1Op(const Vif1Op &op)
+{
+    switch (op.kind)
+    {
+    case Vif1OpKind::Mpg:
+    {
+        const uint32_t destAddr = op.addr;
+        const uint32_t mpgBytes = op.payloadBytes;
+        if (m_vu1Code && destAddr < PS2_VU1_CODE_SIZE && mpgBytes > 0)
+        {
+            uint32_t copyBytes = mpgBytes;
+            if (destAddr + copyBytes > PS2_VU1_CODE_SIZE)
+                copyBytes = PS2_VU1_CODE_SIZE - destAddr;
+            // VIF1 commonly replays an unchanged microprogram. Keep
+            // the native-image generation stable for byte-identical
+            // uploads so MSCAL/MSCNT can reuse the cached hash/image.
+            if (std::memcmp(m_vu1Code + destAddr, op.payload, copyBytes) != 0)
+            {
+                std::memcpy(m_vu1Code + destAddr, op.payload, copyBytes);
+                markVU1CodeModified();
+            }
+        }
+        break;
+    }
+    case Vif1OpKind::Unpack:
+    {
+        uint32_t row[4] = {op.unpack.row[0], op.unpack.row[1], op.unpack.row[2], op.unpack.row[3]};
+        unpackVectors(op, m_vu1Data, row);
+        break;
+    }
+    case Vif1OpKind::Mscal:
+        m_vu1Exec.dtEnable = op.dtEnable;
+        m_vu1Exec.stopBits = 0u;
+        if (m_vu1MscalCallback)
+            m_vu1MscalCallback(op.addr, op.top, op.itop);
+        break;
+    case Vif1OpKind::Mscnt:
+        m_vu1Exec.dtEnable = op.dtEnable;
+        m_vu1Exec.stopBits = 0u;
+        if (m_vu1MscntCallback)
+            m_vu1MscntCallback(op.top, op.itop);
+        break;
+    case Vif1OpKind::Direct:
+    case Vif1OpKind::Path3Unmask:
+        break;
+    }
