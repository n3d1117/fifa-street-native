From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 16:25:44 +0200
Subject: [PATCH 082/100] mmi: PSLLVW/PSRLVW/PSRAVW shift rt by rs on words 0
 and 2 with 64-bit sign-extended results; PADDUH/PSUBUH saturate unsigned
 (PCSX2 MMI.cpp semantics)


diff --git a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
index 149186a8dd84a61884bcf070e815a420ef7569e2..41a951ea3ec9eff477308df4f64b5562416c01f0 100644
--- a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
@@ -105,9 +105,9 @@ namespace ps2recomp
         case MMI1_PEXTUW:
             return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PEXTUW(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
         case MMI1_PADDUH:
-            return fmt::format("SET_GPR_VEC(ctx, {}, _mm_add_epi16(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
+            return fmt::format("SET_GPR_VEC(ctx, {}, _mm_adds_epu16(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
         case MMI1_PSUBUH:
-            return fmt::format("SET_GPR_VEC(ctx, {}, _mm_sub_epi16(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
+            return fmt::format("SET_GPR_VEC(ctx, {}, _mm_subs_epu16(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
         case MMI1_PEXTUH:
             return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PEXTUH(GPR_VEC(ctx, {}), GPR_VEC(ctx, {})));", rd, rs, rt);
         case MMI1_PADDUB:
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 2b7999e203e959181c00b0446298facffcbe9175..042ba5170d48f0cf7453ea620ad3e6ffff20dede 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -874,48 +874,33 @@ inline __m128i ps2_ppacb(__m128i rs, __m128i rt)
 #define PS2_PSRLVW(a, b) _mm_custom_srlv_epi32((__m128i)(a), (__m128i)(b))
 #define PS2_PSRAVW(a, b) _mm_custom_srav_epi32((__m128i)(a), (__m128i)(b))
 
-inline __m128i _mm_custom_sllv_epi32(__m128i a, __m128i count)
-{
-    alignas(16) int32_t a_arr[4];
-    alignas(16) int32_t count_arr[4];
-    alignas(16) int32_t result[4];
-
-    std::memcpy(a_arr, &a, sizeof(a));
-    std::memcpy(count_arr, &count, sizeof(count));
-
-    for (int i = 0; i < 4; i++)
+// PSLLVW/PSRLVW/PSRAVW: shift rt's word 0 and word 2 by the low 5 bits of rs's word 0 and
+// word 2; each 32-bit result is sign-extended into its 64-bit doubleword (PCSX2 MMI.cpp).
+inline __m128i ps2_mmi_var_shift_w(__m128i rs, __m128i rt, int kind)
+{
+    alignas(16) uint32_t s[4];
+    alignas(16) uint32_t t[4];
+    alignas(16) int64_t r[2];
+    _mm_store_si128(reinterpret_cast<__m128i *>(s), rs);
+    _mm_store_si128(reinterpret_cast<__m128i *>(t), rt);
+    for (int i = 0; i < 2; i++)
     {
-        result[i] = a_arr[i] << (count_arr[i] & 0x1F);
-    }
-
-    __m128i out;
-    std::memcpy(&out, result, sizeof(out));
-    return out;
-}
-
-inline __m128i _mm_custom_srlv_epi32(__m128i a, __m128i count)
-{
-    int32_t a_arr[4], count_arr[4], result[4];
-    _mm_storeu_si128((__m128i *)a_arr, a);
-    _mm_storeu_si128((__m128i *)count_arr, count);
-    for (int i = 0; i < 4; i++)
-    {
-        result[i] = (uint32_t)a_arr[i] >> (count_arr[i] & 0x1F);
-    }
-    return _mm_loadu_si128((__m128i *)result);
-}
-
-inline __m128i _mm_custom_srav_epi32(__m128i a, __m128i count)
-{
-    int32_t a_arr[4], count_arr[4], result[4];
-    _mm_storeu_si128((__m128i *)a_arr, a);
-    _mm_storeu_si128((__m128i *)count_arr, count);
-    for (int i = 0; i < 4; i++)
-    {
-        result[i] = a_arr[i] >> (count_arr[i] & 0x1F);
+        const uint32_t sh = s[i * 2] & 0x1F;
+        const uint32_t v = t[i * 2];
+        int32_t out;
+        if (kind == 0)
+            out = static_cast<int32_t>(v << sh);
+        else if (kind == 1)
+            out = static_cast<int32_t>(v >> sh);
+        else
+            out = static_cast<int32_t>(v) >> sh;
+        r[i] = out;
     }
-    return _mm_loadu_si128((__m128i *)result);
+    return _mm_load_si128(reinterpret_cast<const __m128i *>(r));
 }
+inline __m128i _mm_custom_sllv_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 0); }
+inline __m128i _mm_custom_srlv_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 1); }
+inline __m128i _mm_custom_srav_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 2); }
 
 // MMI HI/LO (128-bit) helpers. HI128 = {hi (UD[0]), hi1 (UD[1])}, LO128 = {lo, lo1}:
 // HI.UL[0..1] are the low/high 32 bits of hi, HI.UL[2..3] of hi1 (same for LO);
diff --git a/ps2xTest/src/ps2_mmi_hilo_tests.cpp b/ps2xTest/src/ps2_mmi_hilo_tests.cpp
index 4c0137288a3fa5be1a0dc8c933173ffc5f63701a..7037a38794814bf3d72e56487f94cb66fcebae11 100644
--- a/ps2xTest/src/ps2_mmi_hilo_tests.cpp
+++ b/ps2xTest/src/ps2_mmi_hilo_tests.cpp
@@ -508,5 +508,28 @@ void register_ps2_mmi_hilo_tests()
             CodeGenerator gen({}, {});
             checkEmit(t, gen, makeMmi(MMI_MMI3, MMI3_PDIVUW, 3, 4, 5), "ps2_mmi_pdivuw(ctx, 3, GPR_VEC(ctx, 4), GPR_VEC(ctx, 5))", "PDIVUW");
         });
+        // ---- PSLLVW / PSRLVW / PSRAVW ----
+        tc.Run("variable word shifts shift rt by rs, words 0 and 2, sign-extended", [](TestCase &t)
+        {
+            const __m128i rs = vec4(0x00000004u, 0x11111111u, 0x00000021u, 0x22222222u);
+            const __m128i rt = vec4(0x90000001u, 0x33333333u, 0x80000010u, 0x44444444u);
+            auto lo = [](__m128i v) { return static_cast<uint64_t>(_mm_cvtsi128_si64(v)); };
+            auto hi = [](__m128i v) { return static_cast<uint64_t>(_mm_extract_epi64(v, 1)); };
+            __m128i r = PS2_PSLLVW(rs, rt);
+            t.Equals(lo(r), 0x0000000000000010ULL, "PSLLVW lo");
+            t.Equals(hi(r), 0x0000000000000020ULL, "PSLLVW hi");
+            r = PS2_PSRLVW(rs, rt);
+            t.Equals(lo(r), 0x0000000009000000ULL, "PSRLVW lo");
+            t.Equals(hi(r), 0x0000000040000008ULL, "PSRLVW hi");
+            r = PS2_PSRAVW(rs, rt);
+            t.Equals(lo(r), 0xFFFFFFFFF9000000ULL, "PSRAVW lo");
+            t.Equals(hi(r), 0xFFFFFFFFC0000008ULL, "PSRAVW hi");
+        });
+        tc.Run("PADDUH and PSUBUH saturate unsigned", [](TestCase &t)
+        {
+            CodeGenerator gen({}, {});
+            checkEmit(t, gen, makeMmi(MMI_MMI1, MMI1_PADDUH, 3, 4, 5), "_mm_adds_epu16(GPR_VEC(ctx, 4), GPR_VEC(ctx, 5))", "PADDUH");
+            checkEmit(t, gen, makeMmi(MMI_MMI1, MMI1_PSUBUH, 3, 4, 5), "_mm_subs_epu16(GPR_VEC(ctx, 4), GPR_VEC(ctx, 5))", "PSUBUH");
+        });
     });
 }
