         [[nodiscard]] bool readRam(uint32_t address, void *destination, size_t size) const;
         [[nodiscard]] bool writeRam(uint32_t address, const void *source, size_t size);
         [[nodiscard]] bool zeroRam(uint32_t address, size_t size);
+        [[nodiscard]] bool isKnownNonImportStub(uint32_t address) const noexcept;
+        void markKnownNonImportStub(uint32_t address) noexcept;
+        void clearKnownNonImportStubs() noexcept;
         [[nodiscard]] bool ownsRamRange(uint32_t address, size_t size) const;
         [[nodiscard]] bool isHardwareAddress(uint32_t address) const;
         [[nodiscard]] std::string readString(uint32_t address, size_t limit = 1024u) const;
@@ -89,9 +92,11 @@ namespace ps2x::iop::detail
         [[nodiscard]] uint32_t readHardware32(uint32_t address) const;
         void writeHardware32(uint32_t address, uint32_t value);
         void markOwned(uint32_t address, size_t size);
+        void invalidateImportStubWords(uint32_t address, size_t size) noexcept;
 
         std::vector<uint8_t> m_ram;
         std::vector<uint8_t> m_owned;
+        std::vector<uint64_t> m_nonImportStubWords;
         std::vector<uint8_t> m_scratch;
         std::unordered_map<uint32_t, uint32_t> m_hardware;
         std::vector<Allocation> m_allocations;
diff --git a/ps2xIOP/src/emulator/imports/iop_imports.cpp b/ps2xIOP/src/emulator/imports/iop_imports.cpp
index 2590c4fda37882d1f4a4702277f5fdb6dc8a31f3..3dedc1dcb0d3c59fae1ad7828564cf8da00d5cbf 100644
--- a/ps2xIOP/src/emulator/imports/iop_imports.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_imports.cpp
@@ -4,6 +4,8 @@
 
 #include <algorithm>
 #include <cctype>
+#include <cstdio>
+#include <cstdlib>
 #include <utility>
 
 namespace ps2x::iop::detail
@@ -38,15 +40,57 @@ namespace ps2x::iop::detail
     IopImportRegistry::IopImportRegistry(IopMemory &memory) noexcept
         : m_memory(memory)
     {
+        if (const char *enabled = std::getenv("PS2X_IOP_IMPORT_CACHE"))
+            m_cacheEnabled = std::string_view(enabled) != "0";
+        if (const char *verify = std::getenv("PS2X_IOP_IMPORT_VERIFY"))
+            m_verifyEnabled = std::string_view(verify) == "1";
     }
 
-    void IopImportRegistry::reset()
+    IopImportRegistry::~IopImportRegistry()
+    {
+        if (m_verifyEnabled)
+            std::fprintf(stderr, "[iop-import-verify] mismatches=%llu\n", static_cast<unsigned long long>(m_verifyMismatchCount));
+    }
+
+    void IopImportRegistry::clearDecodeCache()
     {
         m_decodeCache.clear();
+        m_memory.clearKnownNonImportStubs();
+    }
+
+    void IopImportRegistry::reset()
+    {
+        clearDecodeCache();
         m_libraries.clear();
     }
 
     std::optional<IopImportCall> IopImportRegistry::decode(uint32_t pc) const
+    {
+        if (!m_cacheEnabled || !m_memory.isKnownNonImportStub(pc))
+        {
+            auto result = decodeSlow(pc);
+            if (m_cacheEnabled && !result)
+                m_memory.markKnownNonImportStub(pc);
+            return result;
+        }
+
+        if (m_verifyEnabled)
+        {
+            const auto slow = decodeSlow(pc);
+            if (slow)
+            {
+                ++m_verifyMismatchCount;
+                if (m_verifyReportedCount < 10u)
+                {
+                    std::fprintf(stderr, "[iop-import-verify] pc=0x%08x fast=0 slow=1\n", IopMemory::physicalAddress(pc));
+                    ++m_verifyReportedCount;
+                }
+            }
+        }
+        return std::nullopt;
+    }
+
+    std::optional<IopImportCall> IopImportRegistry::decodeSlow(uint32_t pc) const
     {
         if (m_memory.read32(pc) != 0x03E00008u)
             return std::nullopt;
@@ -138,7 +182,7 @@ namespace ps2x::iop::detail
 
     bool IopImportRegistry::releaseExportTable(uint32_t address)
     {
-        m_decodeCache.clear();
+        clearDecodeCache();
         return m_libraries.erase(IopMemory::physicalAddress(address)) != 0u;
     }
 
@@ -194,7 +238,7 @@ namespace ps2x::iop::detail
 
     void IopImportRegistry::eraseRange(uint32_t base, uint32_t size)
     {
-        m_decodeCache.clear();
+        clearDecodeCache();
         for (auto library = m_libraries.begin(); library != m_libraries.end();)
         {
             if (library->first >= base && library->first < base + size)
