From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sat, 24 Oct 2026 22:31:07 +0200
Subject: [PATCH 107/112] iop: reject non-stub PCs without reading guest memory

imports.decode() runs on every IOP instruction and starts with two guest
memory reads looking for the jr ra/delay-slot stub pattern, which is almost
never true. A 64 KiB bitmap of physical instruction words now records the
negative result, invalidated by RAM writes, bulk loads, resets and inbound
SPU2 DMA. PS2X_IOP_IMPORT_CACHE=0 restores the old path and
PS2X_IOP_IMPORT_VERIFY=1 re-decodes every short-circuit and compares.

diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 9b88578634b3b5ff66abc6bc0c3d09d7db137a8d..5b2170bbd7ce8f1c032314d39fc140c6e1274db8 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -50,7 +50,7 @@ namespace ps2x::iop::detail
     }
 
     IopMemory::IopMemory()
-        : m_ram(RamSize), m_owned(RamSize), m_scratch(ScratchSize)
+        : m_ram(RamSize), m_owned(RamSize), m_nonImportStubWords(RamSize / 4u / 64u), m_scratch(ScratchSize)
     {
         reset();
     }
@@ -59,6 +59,7 @@ namespace ps2x::iop::detail
     {
         std::fill(m_ram.begin(), m_ram.end(), uint8_t{0});
         std::fill(m_owned.begin(), m_owned.end(), uint8_t{0});
+        clearKnownNonImportStubs();
         std::fill(m_scratch.begin(), m_scratch.end(), uint8_t{0});
         m_hardware.clear();
         m_allocations.clear();
@@ -137,6 +138,7 @@ namespace ps2x::iop::detail
         if (phys < RamSize)
         {
             m_ram[phys] = value;
+            invalidateImportStubWords(phys, sizeof(value));
             markOwned(phys, sizeof(value));
             return;
         }
@@ -167,6 +169,7 @@ namespace ps2x::iop::detail
         if (phys + 1u < RamSize)
         {
             std::memcpy(m_ram.data() + phys, &value, sizeof(value));
+            invalidateImportStubWords(phys, sizeof(value));
             markOwned(phys, sizeof(value));
             return;
         }
@@ -185,6 +188,7 @@ namespace ps2x::iop::detail
         if ((phys & 3u) == 0u && phys + 3u < RamSize)
         {
             std::memcpy(m_ram.data() + phys, &value, sizeof(value));
+            invalidateImportStubWords(phys, sizeof(value));
             markOwned(phys, sizeof(value));
             return;
         }
@@ -228,6 +232,7 @@ namespace ps2x::iop::detail
         if (size != 0u)
         {
             std::memcpy(m_ram.data() + phys, source, size);
+            invalidateImportStubWords(phys, size);
             markOwned(phys, size);
         }
         return true;
@@ -241,11 +246,45 @@ namespace ps2x::iop::detail
         if (size != 0u)
         {
             std::memset(m_ram.data() + phys, 0, size);
+            invalidateImportStubWords(phys, size);
             markOwned(phys, size);
         }
         return true;
     }
 
+    bool IopMemory::isKnownNonImportStub(uint32_t address) const noexcept
+    {
+        const uint32_t phys = physicalAddress(address);
+        if (phys >= RamSize)
+            return false;
+        const uint32_t word = phys >> 2u;
+        return (m_nonImportStubWords[word >> 6u] & (uint64_t{1} << (word & 63u))) != 0u;
+    }
+
+    void IopMemory::markKnownNonImportStub(uint32_t address) noexcept
+    {
+        const uint32_t phys = physicalAddress(address);
+        if (phys >= RamSize)
+            return;
+        const uint32_t word = phys >> 2u;
+        m_nonImportStubWords[word >> 6u] |= uint64_t{1} << (word & 63u);
+    }
+
+    void IopMemory::clearKnownNonImportStubs() noexcept
+    {
+        std::fill(m_nonImportStubWords.begin(), m_nonImportStubWords.end(), uint64_t{0});
+    }
+
+    void IopMemory::invalidateImportStubWords(uint32_t address, size_t size) noexcept
+    {
+        if (size == 0u || address >= RamSize)
+            return;
+        const uint32_t firstWord = address >> 2u;
+        const uint32_t lastWord = static_cast<uint32_t>((address + size - 1u) >> 2u);
+        for (uint32_t word = firstWord; word <= lastWord; ++word)
+            m_nonImportStubWords[word >> 6u] &= ~(uint64_t{1} << (word & 63u));
+    }
+
     bool IopMemory::ownsRamRange(uint32_t address, size_t size) const
     {
         const uint32_t phys = physicalAddress(address);
@@ -358,6 +397,8 @@ namespace ps2x::iop::detail
         const uint32_t phys = madr & (RamSize - 1u) & ~1u;
         const uint64_t bytes = std::min<uint64_t>(words * 4u, RamSize - phys);
         m_spu2DmaEnd[core] = madr + static_cast<uint32_t>(words * 4u);
+        if ((chcr & 1u) == 0u)
+            invalidateImportStubWords(phys, static_cast<size_t>(bytes));
         g_hostSpu2.dmaStart(core, reinterpret_cast<uint16_t *>(m_ram.data() + phys), madr,
                             static_cast<uint32_t>(bytes / 2u), (chcr & 1u) != 0u, spu2Cycle());
     }
