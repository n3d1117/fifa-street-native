 // Either range may be disabled independently by passing zero for both bounds.
+
+// Host-owned timing configuration, set once before PS2Runtime::initialize().
+// Defaults reproduce deterministic estimated-cycle timing (used by the tests).
+struct PS2HostConfig
+{
+    // Pace guest hardware time from the host clock (strict: never behind it,
+    // never ahead of it by estimated block costs).
+    bool wallClock = false;
+    // Guest VBlank cadence override: 0 keeps the video mode's own rate; 60 or 120.
+    uint32_t vsyncHz = 0;
+    // Lowest address the IOP module loader may relocate into; 0 keeps the default.
+    uint32_t iopHeapFloor = 0;
+};
+void ps2SetHostConfig(const PS2HostConfig &config);
+const PS2HostConfig &ps2HostConfig();
