@@ -132,4 +132,9 @@ namespace ps2x::iop
 
         virtual void log(LogLevel level, std::string_view message) = 0;
     };
+
+    // Lowest guest-IOP address the module loader may relocate into (heap floor).
+    // Call before the IOP is created; values outside [0x10000, default], or not
+    // 256-byte aligned, are ignored. Default: IopMemory::HeapBase.
+    void setIopHeapFloor(uint32_t floor) noexcept;
 }
