+void VU1Interpreter::adoptNativeCompletion(uint64_t cycle, uint8_t backupReg, int32_t backupValue)
+{
+    resetScheduler();
+    m_cycle = cycle;
+    m_state.cycles = cycle;
+    m_lastRunEnded = true;
+    m_viBranchBackupValid = backupReg != 0u;
+    m_viBranchBackupReg = backupReg;
+    m_viBranchBackupValue = backupValue;
+}
+
