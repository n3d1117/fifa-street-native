+        require(first && first->ordinal == 3u, "initial import ordinal decode failed");
+        memory.write32(0x1018u, 0x24000007u);
+        const auto updated = imports.decode(0x1014u);
+        require(updated && updated->ordinal == 7u && updated->version == 0x0310u,
+                "changed delay-slot ordinal returned stale cached data");
