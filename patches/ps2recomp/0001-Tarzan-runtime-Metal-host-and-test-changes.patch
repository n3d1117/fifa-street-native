+        require(afterReset && afterReset->library == "resetlib" && afterReset->version == 0x0210u,
+                "reset did not invalidate cached import identity");
+
+        updateImportIdentity(memory, 0x1000u, 0x0110u, "reload");
+        imports.eraseRange(0x1000u, 64u);
+        const auto afterReload = imports.decode(0x1014u);
+        require(afterReload && afterReload->library == "reload" && afterReload->version == 0x0110u,
+                "eraseRange did not invalidate cached import identity at the reused physical PC");
