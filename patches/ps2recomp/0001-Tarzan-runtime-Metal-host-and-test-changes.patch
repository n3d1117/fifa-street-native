+struct Vu1RecRoundingGuard
+{
+    int previous;
+    bool ok;
+    Vu1RecRoundingGuard() : previous(std::fegetround()), ok(std::fesetround(FE_TOWARDZERO) == 0) {}
+    ~Vu1RecRoundingGuard()
+    {
+        if (ok && previous != -1)
