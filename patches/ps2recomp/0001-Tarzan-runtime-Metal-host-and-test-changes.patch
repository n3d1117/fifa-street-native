+        memory.write32(persistent, 0x12345678u);
+        for (unsigned iteration = 0; iteration < 1000; ++iteration)
+        {
+            const uint32_t temporary = memory.allocate(2048u);
+            if (!expect(temporary != 0u, "freed transient IOP buffers exhausted the heap")) return false;
+            if (!expect(temporary >= persistent + 4096u, "transient allocation overlaps live memory")) return false;
+            if (!expect(memory.freeAllocation(temporary), "transient free failed")) return false;
