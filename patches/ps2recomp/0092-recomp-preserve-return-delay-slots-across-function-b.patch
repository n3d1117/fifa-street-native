 {
     MiniTest::Case("PS2Recompiler", [](TestCase &tc)
                    {
+        tc.Run("return restores SP when another symbol owns its delay slot", [](TestCase &t) {
+            const auto root = std::filesystem::temp_directory_path() /
+                ("ps2recomp-split-slot-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+            std::filesystem::create_directories(root);
+            const auto elf = root / "slot.elf", config = root / "slot.toml", output = root / "output";
+            t.IsTrue(writeMinimalMipsElfWithInitializer(elf, "split_return", 0x100000u, true) &&
+                     writeRecompilerTestConfig(config, elf, output, {}), "split-slot inputs must be written");
+            PS2Recompiler recompiler(config.string());
+            t.IsTrue(recompiler.initialize() && recompiler.recompile(), "split-slot ELF must translate");
+            recompiler.generateOutput();
+            std::ifstream file(output / "split_return_0x100000.cpp");
+            const std::string code{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+            const auto restore = code.find("ADD32(GPR_U32(ctx, 29), 48)");
+            t.IsTrue(restore != std::string::npos && restore < code.find("ctx->pc = jumpTarget;"),
+                     "JR RA must execute the real stack restoration before returning across a symbol boundary");
+            std::error_code error;
+            std::filesystem::remove_all(root, error);
+        });
+
+        tc.Run("entry discovery and reslicing retain a boundary return delay slot", [](TestCase &t) {
+            std::vector<Function> functions{
+                makeFunction("owner", 0x1000u, 0x1020u),
+                makeFunction("slot_owner", 0x1014u, 0x1020u),
+                makeFunction("caller", 0x2000u, 0x2008u)};
+            std::unordered_map<uint32_t, std::vector<Instruction>> decoded;
+            decoded[0x1000u] = {makeNopLike(0x1000u), makeNopLike(0x1004u),
+                makeNopLike(0x1008u), makeNopLike(0x100cu), makeJrRa(0x1010u),
+                makeNopLike(0x1014u), makeNopLike(0x1018u), makeNopLike(0x101cu)};
+            decoded[0x1014u] = {makeNopLike(0x1014u), makeNopLike(0x1018u), makeNopLike(0x101cu)};
+            decoded[0x2000u] = {makeAbsJump(0x2000u, 0x1008u, OPCODE_J), makeNopLike(0x2004u)};
+            std::vector<Section> sections{{".text", 0x1000u, 0x3000u, 0u, true, false, false, true, nullptr}};
+            PS2Recompiler::DiscoverAdditionalEntryPoints(functions, decoded, sections);
+            t.IsTrue(decoded.contains(0x1008u) && decoded.at(0x1008u).back().address == 0x1014u,
+                     "discovery must include the slot even when it has a separate entry");
+            PS2Recompiler::ResliceEntryFunctions(functions, decoded);
+            t.IsTrue(decoded.contains(0x1008u) && decoded.at(0x1008u).back().address == 0x1014u,
+                     "late reslicing must not trim the slot back off");
+        });
+
