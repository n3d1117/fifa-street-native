     // The op the worker is executing right now, 0 between ops.
     uint32_t executingOpType() const { return m_executingOpType.load(std::memory_order_acquire); }
+    struct WorkerOpSnapshot
+    {
+        uint32_t type = 0;
+        uint64_t nanoseconds = 0;
+    };
+    WorkerOpSnapshot workerOpSnapshot() const;
 
 private:
     void execute(const StreamRing::Op &op, const uint8_t *payload);
@@ -164,6 +170,8 @@ private:
     std::unique_ptr<StreamRing> m_ring;
     Mode m_mode = Mode::Inline;
     std::atomic<uint32_t> m_executingOpType{0};
+    std::atomic<uint64_t> m_diagnosticOp{0};
+    bool m_opDiagnostics = false;
     int m_kickDepth = 0;
     bool m_gsStale = false;
     bool m_verify = false;
diff --git a/ps2xRuntime/src/lib/ps2_state_dump.cpp b/ps2xRuntime/src/lib/ps2_state_dump.cpp
index 4d146d3e41840cfb4a7d92405a69af4d2fd64551..373e020228e8273cf1fd4d96905fd6834fcbfe9e 100644
--- a/ps2xRuntime/src/lib/ps2_state_dump.cpp
+++ b/ps2xRuntime/src/lib/ps2_state_dump.cpp
@@ -3,6 +3,7 @@
 // between [state-begin] and [state-end]. PS2X_DUMP_STATE_EVERY=<seconds> repeats it, which separates a
 // stationary wait from slow progress. Kept out of every header the generated code includes.
 #include "ps2_runtime.h"
+#include "ps2_data_stream.h"
 #include "runtime/ee_scheduler.h"
 #include "Kernel/Syscalls/Helpers/State.h"
 
@@ -75,9 +76,14 @@ void dumpState(PS2Runtime &runtime)
     // second, so the samples are also counted per thread id.
     std::map<uint32_t, uint32_t> histogram;
     std::map<int, uint32_t> cpuSamples;
+    std::map<uint32_t, uint32_t> workerSamples;
+    std::map<uint32_t, uint64_t> workerMaxNanoseconds;
     uint32_t samples = 0;
     for (int i = 0; i < 200; ++i)
     {
+        const auto worker = runtime.memory().dataStream().workerOpSnapshot();
+        ++workerSamples[worker.type];
+        workerMaxNanoseconds[worker.type] = std::max(workerMaxNanoseconds[worker.type], worker.nanoseconds);
         if (const R5900Context *ctx = runtime.eeScheduler().currentContext())
         {
             ++histogram[ctx->pc];
@@ -145,9 +151,17 @@ void dumpState(PS2Runtime &runtime)
         out << " oldest_kind=" << invocationKindName(static_cast<uint8_t>(ee.oldestPendingKind));
     out << "\n";
     if (ee.ringPresent)
+    {
+        const auto worker = runtime.memory().dataStream().workerOpSnapshot();
         out << "data ring pushed=" << ee.ringPushed << " published=" << ee.ringPublished
             << " consumed=" << ee.ringConsumed << " worker_op=" << ee.workerOpType
+            << " worker_op_live=" << worker.type << " worker_op_ms=" << worker.nanoseconds / 1e6
             << " failed=" << static_cast<unsigned>(ee.ringFailed) << "\n";
+        out << "data worker samples (op -> 5ms samples/max dwell ms):";
+        for (const auto &[type, count] : workerSamples)
+            out << " " << type << "x" << count << "/" << workerMaxNanoseconds[type] / 1e6;
+        out << "\n";
+    }
     else
         out << "data ring inline worker_op=0\n";
     for (const EeSemaphoreSnapshot &s : ee.semaphores)
