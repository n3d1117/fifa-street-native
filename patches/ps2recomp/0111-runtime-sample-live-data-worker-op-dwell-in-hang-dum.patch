From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 25 Oct 2026 08:58:26 +0100
Subject: [PATCH 111/112] runtime: sample live data-worker op dwell in hang
 dumps

Publish an atomic op/start stamp only for EE profiling or timed state dumps. Sample live op ages separately from the cached EE snapshot so repeated ring positions cannot be mistaken for a wedged worker. The tvOS reproduction showed repeated GsVsync operations, usually about one field old, rather than a seconds-long readback op. Full runtime test tier passes (60 tests); macOS NTSC/PAL and physical iOS/tvOS routes exercised the diagnostics and disabled path.

diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
index aaf62723fb3ec00fb984b631a53f27eb68758a45..fcd3aa11781270981a6e78245f5362154403552c 100644
--- a/ps2xRuntime/src/lib/ps2_data_stream.cpp
+++ b/ps2xRuntime/src/lib/ps2_data_stream.cpp
@@ -43,6 +43,11 @@ DataStream::DataStream(PS2Memory &memory) : m_memory(memory), m_gs(memory.gs())
     m_perfEnabled = perf && std::strcmp(perf, "1") == 0;
     const char *vsyncDrain = std::getenv("PS2X_GS_VSYNC_DRAIN");
     m_vsyncDrain = vsyncDrain && std::strcmp(vsyncDrain, "1") == 0;
+    const char *profile = std::getenv("PS2X_EE_PROFILE");
+    const char *dumpAt = std::getenv("PS2X_DUMP_STATE_AT");
+    const char *dumpEvery = std::getenv("PS2X_DUMP_STATE_EVERY");
+    m_opDiagnostics = (profile && profile[0] == '1') || (dumpAt && std::atof(dumpAt) > 0.0) ||
+                      (dumpEvery && std::atof(dumpEvery) > 0.0);
 }
 
 DataStream::~DataStream()
@@ -149,11 +154,24 @@ void DataStream::publishIfIdle()
 void DataStream::execute(const StreamRing::Op &op, const uint8_t *payload)
 {
     m_executingOpType.store(op.type, std::memory_order_release);
+    if (m_opDiagnostics)
+    {
+        const uint64_t micros = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+        m_diagnosticOp.store((micros << 8u) | op.type, std::memory_order_release);
+    }
     struct ClearOnExit
     {
         std::atomic<uint32_t> &flag;
-        ~ClearOnExit() { flag.store(0u, std::memory_order_release); }
-    } clearOnExit{m_executingOpType};
+        std::atomic<uint64_t> &diagnostic;
+        bool enabled;
+        ~ClearOnExit()
+        {
+            if (enabled)
+                diagnostic.store(0u, std::memory_order_release);
+            flag.store(0u, std::memory_order_release);
+        }
+    } clearOnExit{m_executingOpType, m_diagnosticOp, m_opDiagnostics};
     switch (op.type)
     {
     case OpGifPacket:
@@ -220,6 +238,16 @@ void DataStream::execute(const StreamRing::Op &op, const uint8_t *payload)
     }
 }
 
+DataStream::WorkerOpSnapshot DataStream::workerOpSnapshot() const
+{
+    const uint64_t op = m_diagnosticOp.load(std::memory_order_acquire);
+    if (!op)
+        return {};
+    const uint64_t now = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    return {static_cast<uint32_t>(op & 0xFFu), (now - (op >> 8u)) * 1000u};
+}
+
 void DataStream::vifOp(const Vif1Op &op)
 {
     if (!deferred())
