From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Fri, 23 Oct 2026 15:06:04 +0200
Subject: [PATCH 104/109] runtime: reduce diagnostic sampling frequency


diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index 46a2f912c11ef13e83e508a4d0348b9af2489375..60160b5d33ef562ff2d4a43b2d2fbaea91886861 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -518,7 +518,7 @@ namespace ps2x::iop::detail
         uint32_t runCpu(CpuState &cpu, uint32_t instructionBudget)
         {
             static thread_local uint32_t perfSlices = 0;
-            constexpr double sampleWeight = 8.0;
+            constexpr double sampleWeight = 64.0;
             const bool perfSample = perfBreakdownEnabled() && (++perfSlices % static_cast<uint32_t>(sampleWeight) == 0u);
             const auto perfStart = perfSample ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
             CpuState *previous = activeCpu;
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index d67293a022bc2c03d615ea74393575c04747169c..12e38986717d83e260e99d6cd043045629a4683b 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -417,11 +417,11 @@ void EeScheduler::run()
             continue;
         }
 
-        const bool perfSample = ps2PerfBreakdownEnabled() && (++perfDispatches % 32u == 0u);
+        const bool perfSample = ps2PerfBreakdownEnabled() && (++perfDispatches % 1024u == 0u);
         const auto perfStart = perfSample ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
         const auto recordPerf = [&] {
             if (perfSample)
-                ps2RecordEeExecution(std::chrono::duration<double>(std::chrono::steady_clock::now() - perfStart).count() * 32.0);
+                ps2RecordEeExecution(std::chrono::duration<double>(std::chrono::steady_clock::now() - perfStart).count() * 1024.0);
         };
         try
         {
diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index f55dbe84f702b7d5c8c16b5ef8577dcea65cb81b..3558c91321a0c07ea3f9e9e85b2ac1aef677d6ca 100644
--- a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
+++ b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
@@ -692,7 +692,7 @@ void PS2Memory::applyVif1Op(const Vif1Op &op)
     case Vif1OpKind::Unpack:
     {
         static thread_local uint32_t perfUnpacks = 0;
-        constexpr double sampleWeight = 8.0;
+        constexpr double sampleWeight = 64.0;
         const bool perfSample = ps2PerfBreakdownEnabled() && (++perfUnpacks % static_cast<uint32_t>(sampleWeight) == 0u);
         uint32_t row[4] = {op.unpack.row[0], op.unpack.row[1], op.unpack.row[2], op.unpack.row[3]};
         const auto perfStart = perfSample ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
index 102e42fb51a67d6c1106d456c74dd94bb94e4ed0..f8655ebcdb1a789f2b63196f0599ec0edc0042a4 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
@@ -67,14 +67,14 @@ namespace
         explicit KickPerfScope(bool work) : enabled(false)
         {
             static thread_local uint32_t calls = 0;
-            enabled = work && ps2PerfBreakdownEnabled() && (++calls % 256u == 0u);
+            enabled = work && ps2PerfBreakdownEnabled() && (++calls % 1024u == 0u);
             if (enabled)
                 start = std::chrono::steady_clock::now();
         }
         ~KickPerfScope()
         {
             if (enabled)
-                ps2RecordXgkick(std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count() * 256.0);
+                ps2RecordXgkick(std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count() * 1024.0);
         }
     };
 
