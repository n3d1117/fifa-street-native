From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 16:52:56 +0200
Subject: [PATCH 09/96] upstream #316: truncate and saturate FPU CVT.W.S like
 the EE FPU


diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 4739b4b4d527a7a33c5d8b35421b2c4fa6a0e9b1..a7945bdf3270138cb5a088d350b3418598abf08d 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -364,6 +364,17 @@ inline __m128 ps2_vu_min_ps(__m128 a, __m128 b)
     return _mm_castsi128_ps(_mm_blendv_epi8(_mm_min_epi32(ai, bi), _mm_max_epi32(ai, bi), bothNegative));
 }
 
+// CVT.W.S: the EE always truncates toward zero, whatever FCR31 says. A magnitude of 2^31 or more
+// saturates by sign to 0x7FFFFFFF / 0x80000000. The EE has no Inf/NaN, so exponent-255 patterns are
+// just large numbers and saturate the same way (as PCSX2's interpreter CVT_W does).
+inline int32_t ps2_fcvt_w(float a)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(a);
+    if ((bits & PS2_FLOAT_EXP_MASK) <= 0x4E800000u) // exponent <= 157: |a| < 2^31
+        return static_cast<int32_t>(a);
+    return (bits & PS2_FLOAT_SIGN_MASK) ? INT32_MIN : INT32_MAX;
+}
+
 enum class Ps2VecOp
 {
     Add,
@@ -906,7 +917,7 @@ inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
 #define FPU_FLOOR_W_S(a) ((int32_t)floorf((float)(a)))
 #define FPU_CVT_S_W(a) ((float)(int32_t)(a))
 #define FPU_CVT_S_L(a) ((float)(int64_t)(a))
-#define FPU_CVT_W_S(a) ((int32_t)nearbyintf((float)(a)))
+#define FPU_CVT_W_S(a) ps2_fcvt_w((float)(a))
 #define FPU_CVT_L_S(a) ((int64_t)(float)(a))
 #define FPU_C_F_S(a, b) (0)
 // The R5900 FPU implements only C.F, C.EQ, C.LT and C.LE, on the function codes MIPS gives C.F,
diff --git a/ps2xTest/src/ps2_float_semantics_tests.cpp b/ps2xTest/src/ps2_float_semantics_tests.cpp
index 4c521c20a7aba9bc622419b240ace8c92a1a9327..7afb2f23407a86d72b0d5c326b60d06d0643a22f 100644
--- a/ps2xTest/src/ps2_float_semantics_tests.cpp
+++ b/ps2xTest/src/ps2_float_semantics_tests.cpp
@@ -257,5 +257,24 @@ void register_ps2_float_semantics_tests()
             t.IsTrue(rsqrt.find("ctx->f[2] = FPU_RSQRT_S(ctx->f[3], ctx->f[4])") != std::string::npos,
                      "RSQRT.S should compute fs / sqrt(ft) but got: " + rsqrt);
         });
+
+        tc.Run("FPU CVT.W.S truncates toward zero and saturates by sign", [](TestCase &t)
+        {
+            const auto cvt = [](float f) { return static_cast<uint32_t>(FPU_CVT_W_S(f)); };
+            // 2.5 and 3.7 differ between round-to-nearest (2/4) and truncation (2/3).
+            t.Equals(cvt(3.7f), 3u, "3.7 should truncate to 3");
+            t.Equals(cvt(-3.7f), static_cast<uint32_t>(-3), "-3.7 should truncate toward zero to -3");
+            t.Equals(cvt(0.999f), 0u, "0.999 should truncate to 0");
+            // A volume scale like 0.9 * 0x3FFF = 14744.7 truncates to 14744, not 14745.
+            t.Equals(cvt(FPU_MUL_S(0.9f, 16383.0f)), 14744u, "0.9 * 0x3FFF should truncate to 14744");
+            t.Equals(cvt(floatOf(0x4EFFFFFFu)), 0x7FFFFF80u, "the largest float below 2^31 should convert exactly");
+            t.Equals(cvt(2147483648.0f), 0x7FFFFFFFu, "2^31 should saturate to 0x7FFFFFFF");
+            t.Equals(cvt(-2147483648.0f), 0x80000000u, "-2^31 should give 0x80000000");
+            t.Equals(cvt(1.0e20f), 0x7FFFFFFFu, "1e20 should saturate to 0x7FFFFFFF");
+            t.Equals(cvt(-1.0e20f), 0x80000000u, "-1e20 should saturate to 0x80000000");
+            t.Equals(cvt(floatOf(0x7FFFFFFFu)), 0x7FFFFFFFu, "+max (a NaN pattern on the host) should saturate to 0x7FFFFFFF");
+            t.Equals(cvt(floatOf(0xFFC00000u)), 0x80000000u, "a negative exponent-255 pattern should saturate to 0x80000000");
+            t.Equals(cvt(floatOf(0x00000001u)), 0u, "a denormal should convert to 0");
+        });
     });
 }
