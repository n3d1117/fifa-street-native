+void EeScheduler::recordContext(const char *reason, const GuestThread &item)
+{
+    const R5900Context &ctx = item.activeContext();
+    m_contextHistory[m_contextHistoryCount++ % m_contextHistory.size()] = {
+        reason, item.id, static_cast<uint32_t>(item.invocations.size()),
+        item.invocations.empty() ? UINT32_MAX : static_cast<uint32_t>(item.invocations.back().kind),
+        ctx.pc, getRegU32(&ctx, 31), getRegU32(&ctx, 29), ctx.cop0_epc, ctx.branch_pc, ctx.in_delay_slot};
+}
+
+void EeScheduler::dumpContextHistory(FILE *out) const
+{
+    const uint64_t begin = m_contextHistoryCount > m_contextHistory.size()
+                               ? m_contextHistoryCount - m_contextHistory.size() : 0u;
+    std::fprintf(out, "[ee-context-history] begin current=%d events=%llu\n",
+                 m_currentThreadId, static_cast<unsigned long long>(m_contextHistoryCount - begin));
+    for (uint64_t n = begin; n < m_contextHistoryCount; ++n)
+    {
+        const auto &e = m_contextHistory[n % m_contextHistory.size()];
+        std::fprintf(out, "[ee-context-history] #%llu thread=%d reason=%s depth=%u kind=%u pc=0x%x ra=0x%x sp=0x%x epc=0x%x branch=0x%x delay=%u\n",
+                     static_cast<unsigned long long>(n), e.threadId, e.reason, e.depth, e.kind,
+                     e.pc, e.ra, e.sp, e.epc, e.branchPc, static_cast<unsigned>(e.delaySlot));
+    }
+    for (const auto &[id, item] : m_threads)
+    {
+        const auto print = [&](const R5900Context &ctx, size_t depth) {
+            std::fprintf(out, "[ee-context-history] live thread=%d status=%u depth=%zu pc=0x%x ra=0x%x sp=0x%x epc=0x%x branch=0x%x delay=%u\n",
+                         id, static_cast<unsigned>(item.status), depth, ctx.pc, getRegU32(&ctx, 31),
+                         getRegU32(&ctx, 29), ctx.cop0_epc, ctx.branch_pc, static_cast<unsigned>(ctx.in_delay_slot));
+        };
+        print(item.context, 0u);
+        for (size_t i = 0; i < item.invocations.size(); ++i)
+            print(item.invocations[i].context, i + 1u);
+    }
+    std::fprintf(out, "[ee-context-history] end\n");
+}
