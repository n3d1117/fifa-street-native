 {
     MiniTest::Case("PS2RuntimeKernel", [](TestCase &tc)
     {
+        tc.Run("context history wraps chronologically and preserves saved nested contexts", [](TestCase &t)
+        {
+            TestEnv env;
+            EeScheduler &ee = env.runtime.eeScheduler();
+            env.ctx.pc = 0x123400u;
+            env.ctx.cop0_epc = 0x456700u;
+            env.ctx.branch_pc = 0x1233fcu;
+            env.ctx.in_delay_slot = true;
+            SET_GPR_U32(&env.ctx, 31, 0x987600u);
+            SET_GPR_U32(&env.ctx, 29, 0x20000u);
+            ee.bindMainContextForSyscall(env.ctx, env.rdram.data());
+            for (unsigned i = 0; i < 20; ++i)
+            {
+                GuestInvocation invocation{};
+                invocation.kind = GuestInvocationKind::Interrupt;
+                invocation.context.pc = 0x300000u + i * 4u;
+                SET_GPR_U32(&invocation.context, 29, 0x40000u);
+                try { ee.invokeCurrent(std::move(invocation)); }
+                catch (const EeDispatcherTransfer &) {}
+            }
+            const auto dump = [&]() {
+                FILE *file = std::tmpfile();
+                if (!file) throw std::runtime_error("context history test tmpfile failed");
+                ee.dumpContextHistory(file);
+                std::rewind(file);
+                std::string text;
+                std::array<char, 512> buffer{};
+                while (std::fgets(buffer.data(), buffer.size(), file)) text += buffer.data();
+                std::fclose(file);
+                return text;
+            };
+            const std::string history = dump();
+            t.IsTrue(history.find("events=32") != std::string::npos,
+                     "history must retain only the last 32 transition records");
+            t.IsTrue(history.find("#10 thread=1 reason=invocation-save depth=4") != std::string::npos &&
+                     history.find("#41 thread=1 reason=invocation-enter depth=20") != std::string::npos &&
+                     history.find("#9 thread=") == std::string::npos,
+                     "wrapped records must be emitted oldest first with invocation identity");
+            t.IsTrue(history.find("depth=0 pc=0x123400 ra=0x987600 sp=0x20000 epc=0x456700 branch=0x1233fc delay=1") != std::string::npos,
+                     "fault dump must include suspended base registers and delay-slot state");
+            t.IsTrue(history.find("depth=20 kind=0 pc=0x30004c") != std::string::npos,
+                     "nested IRQ entry must retain its own PC and kind");
+            ee.reset(env.rdram.data(), env.ctx);
+            const std::string reset = dump();
+            t.IsTrue(reset.find("events=1") != std::string::npos && reset.find("reason=invocation-enter") == std::string::npos,
+                     "reset must discard history from the previous runtime");
