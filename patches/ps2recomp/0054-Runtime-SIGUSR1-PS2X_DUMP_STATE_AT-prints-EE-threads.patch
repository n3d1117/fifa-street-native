diff --git a/ps2xRuntime/src/lib/ps2_state_dump.cpp b/ps2xRuntime/src/lib/ps2_state_dump.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c6d8f6592d0a5745c0c19807316442926b3da58a
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_state_dump.cpp
@@ -0,0 +1,146 @@
+// Hang diagnosis in one block: PS2X_DUMP_STATE_AT=<seconds> or SIGUSR1 prints the EE kernel state, a
+// one-second sample of the running guest pc, the IOP state and the latest SIF RPC events to stderr
+// between [state-begin] and [state-end]. Kept out of every header the generated code includes.
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+#include "Kernel/Syscalls/Helpers/State.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <sstream>
+#include <thread>
+#include <vector>
+
+namespace
+{
+std::atomic<bool> g_dumpRequested{false};
+
+const char *statusName(EeThreadStatus status)
+{
+    switch (status)
+    {
+    case EeThreadStatus::Running: return "running";
+    case EeThreadStatus::Ready: return "ready";
+    case EeThreadStatus::Waiting: return "waiting";
+    case EeThreadStatus::WaitingSuspended: return "waiting+suspended";
+    case EeThreadStatus::Suspended: return "suspended";
+    case EeThreadStatus::Dormant: return "dormant";
+    }
+    return "?";
+}
+
+const char *waitName(EeWaitReason reason)
+{
+    switch (reason)
+    {
+    case EeWaitReason::None: return "-";
+    case EeWaitReason::Sleep: return "sleep";
+    case EeWaitReason::Semaphore: return "semaphore";
+    case EeWaitReason::EventFlag: return "eventflag";
+    case EeWaitReason::VSync: return "vsync";
+    case EeWaitReason::External: return "external";
+    case EeWaitReason::Mpeg: return "mpeg";
+    }
+    return "?";
+}
+
+void dumpState(PS2Runtime &runtime)
+{
+    // Sample the running guest pc for one second (racy reads of a 32-bit pc are fine for a histogram).
+    std::map<uint32_t, uint32_t> histogram;
+    uint32_t samples = 0;
+    for (int i = 0; i < 200; ++i)
+    {
+        if (const R5900Context *ctx = runtime.eeScheduler().currentContext())
+        {
+            ++histogram[ctx->pc];
+            ++samples;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+
+    std::ostringstream out;
+    out << std::hex << "[state-begin]\n";
+    const EeKernelSnapshot ee = runtime.eeScheduler().snapshot();
+    out << "ee cycle=" << std::dec << ee.eeCycle << " running_thread=" << ee.runningThreadId
+        << " vsync_tick=" << runtime.eeScheduler().currentVSyncTick() << "\n";
+    for (const EeThreadSnapshot &t : ee.threads)
+    {
+        out << "ee thread id=" << t.id << " " << statusName(t.status) << " wait=" << waitName(t.waitReason)
+            << "(" << t.waitId << ") prio=" << t.currentPriority << std::hex << " pc=0x" << t.pc << " ra=0x" << t.ra
+            << " sp=0x" << t.sp << " entry=0x" << t.entry << std::dec << " inv_depth=" << t.invocationDepth
+            << " suspend=" << t.suspendCount << " wakeups=" << t.wakeupCount << "\n";
+    }
+    for (const EeSemaphoreSnapshot &s : ee.semaphores)
+        out << "ee sema id=" << s.id << " count=" << s.count << "/" << s.maxCount << " waiters=" << s.waiters << "\n";
+    for (const EeEventFlagSnapshot &f : ee.eventFlags)
+        out << "ee eventflag id=" << f.id << std::hex << " bits=0x" << f.bits << std::dec << " waiters=" << f.waiters << "\n";
+
+    std::vector<std::pair<uint32_t, uint32_t>> top(histogram.begin(), histogram.end());
+    std::sort(top.begin(), top.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+    out << "ee pc samples=" << samples << ":";
+    for (size_t i = 0; i < top.size() && i < 12u; ++i)
+        out << std::hex << " 0x" << top[i].first << "x" << std::dec << top[i].second;
+    out << "\n";
+
+    const ps2x::iop::DebugSnapshot iop = runtime.iopDebugSnapshot();
+    out << "iop cycles=" << iop.emulatorCycles << " instructions=" << iop.emulatorInstructions
+        << " modules=" << iop.emulatorLoadedModules << " threads=" << iop.emulatorThreads
+        << " rpc_servers=" << iop.emulatorRpcServers << "\n";
+    for (const std::string &line : iop.diagnostics)
+        out << "iop diag " << line << "\n";
+
+    {
+        std::vector<SifRpcDebugEvent> events;
+        {
+            std::lock_guard<std::mutex> lock(g_rpc_mutex);
+            for (const SifRpcDebugEvent &event : g_sif_rpc_debug_history)
+                if (event.seq != 0u)
+                    events.push_back(event);
+        }
+        std::sort(events.begin(), events.end(), [](const auto &a, const auto &b) { return a.seq < b.seq; });
+        const size_t first = events.size() > 10u ? events.size() - 10u : 0u;
+        for (size_t i = first; i < events.size(); ++i)
+        {
+            const SifRpcDebugEvent &e = events[i];
+            out << "sif rpc #" << e.seq << " " << e.op << std::hex << " sid=0x" << e.sid << " fn=0x" << e.rpcNum
+                << " send=0x" << e.sendSize << " recv=0x" << e.recvSize << " flags=0x" << e.flags << " thread=" << std::dec
+                << e.threadId << std::hex << " pc=0x" << e.pc << " ra=0x" << e.ra << " end=0x" << e.endFunc << std::dec
+                << " result=" << e.result << "\n";
+        }
+    }
+    out << "[state-end]\n";
+    std::fputs(out.str().c_str(), stderr);
+    std::fflush(stderr);
+}
+} // namespace
+
+void ps2InstallStateDump(PS2Runtime &runtime)
+{
+    static std::atomic<bool> installed{false};
+    if (installed.exchange(true))
+        return;
+    std::signal(SIGUSR1, [](int) { g_dumpRequested.store(true); });
+    double atSeconds = 0.0;
+    if (const char *value = std::getenv("PS2X_DUMP_STATE_AT"))
+        atSeconds = std::atof(value);
+    std::thread([&runtime, atSeconds] {
+        const auto started = std::chrono::steady_clock::now();
+        bool timedDone = atSeconds <= 0.0;
+        for (;;)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+            if (g_dumpRequested.exchange(false) || (!timedDone && elapsed >= atSeconds))
+            {
+                timedDone = true;
+                dumpState(runtime);
+            }
+        }
+    }).detach();
+}
