From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Wed, 21 Oct 2026 08:24:58 +0200
Subject: [PATCH 88/88] runtime: bound ordered GS vsync backlog and preserve EE
 FIELD

Per-vsync worker drains expose EE-side IOP/SPU2 mixing to Metal stalls.
Port PCSX2 MTGS's default two-vsync allowance, waiting through only the
oldest excess snapshot. Keep CSR/SIGLBLID, VU1, halt and download barriers.
Retain the EE's FIELD when observing delayed bridge results.

PS2X_GS_VSYNC_QUEUE=0 retains per-vsync draining. PS2X_GS_VSYNC_VERIFY=1
checks snapshot-predicted versus actual bridge registers and eager/lazy
readbacks; keep the eager reference current across CSR writes/reset/vsync.
Regression tests cover a checkpoint with later blocked work and an EE
FIELD update while VU1 and two queued vsyncs are outstanding.

Cold --match: original baseline 6080 underruns / 181.897 ms max EE wait;
updated queue=0 control 5598 / 169.117 ms; queue=2 4829 / 140.931 ms and
4955 / 141.990 ms, at 50 fps with no verifier mismatch. Fixed pipelines
already compile at setup; later dynamic specialization bursts still
exceed 40 ms. This mitigates rather than resolves cold-cache starvation.

Warm profiled two-pair A/B: control 50/50 fps, candidate 50/49.2 fps;
underruns 0/0 versus 0/943. Median process CPU +1.4%, energy +176.6%.
An initial A/B control hit the existing 2 s stream watchdog in GS drawing;
its cause is unproven and its CPU comparison was discarded. Six subsequent
consecutive warm matches: all 50 fps, one had 3067 underruns, five zero.
No claim of an energy improvement or a resolved warm flake.

Validation: ./rx build; ./rx test --full (57/57 plus slow tier);
PS2X_GS_VSYNC_VERIFY=1 ./rx run --seconds 60 (50 fps, zero underruns).
Temporary timing probes removed; all original Metal caches restored.

diff --git a/ps2xRuntime/include/runtime/ps2_stream_ring.h b/ps2xRuntime/include/runtime/ps2_stream_ring.h
index 0703628c17d03406aa7146df120f1ef07b2b2229..666b8b97223be35d501dd849eb21e98fbb8aee07 100644
--- a/ps2xRuntime/include/runtime/ps2_stream_ring.h
+++ b/ps2xRuntime/include/runtime/ps2_stream_ring.h
@@ -143,6 +143,16 @@ public:
             rethrowIfFailed();
     }
 
+    // Producer: an ordered completion checkpoint, including unpublished ops.
+    uint64_t position() const { return m_localHead; }
+
+    void waitThrough(uint64_t position, const char *why)
+    {
+        publish();
+        waitFor(position, why);
+        rethrowIfFailed();
+    }
+
     // Producer: bytes pushed but not yet published, to let callers batch.
     uint32_t pendingBytes() const { return m_pendingBytes; }
 
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
index 6158df4aa987b2063780dc68dfa6024452dd45b3..166b20ddffa00561345e30f51a0d5f7d09d6ee95 100644
--- a/ps2xRuntime/src/lib/ps2_data_stream.cpp
+++ b/ps2xRuntime/src/lib/ps2_data_stream.cpp
@@ -32,6 +32,18 @@ DataStream::DataStream(PS2Memory &memory) : m_memory(memory), m_gs(memory.gs())
 {
     const char *verify = std::getenv("PS2X_GS_VERIFY");
     m_verify = verify && verify[0] == '1';
+    const char *vsyncVerify = std::getenv("PS2X_GS_VSYNC_VERIFY");
+    m_vsyncVerify = vsyncVerify && std::strcmp(vsyncVerify, "1") == 0;
+    m_verify = m_verify || m_vsyncVerify;
+    if (const char *queue = std::getenv("PS2X_GS_VSYNC_QUEUE"))
+    {
+        char *end = nullptr;
+        const long size = std::strtol(queue, &end, 10);
+        if (end != queue && *end == '\0' && size >= 0 && size <= 16)
+            m_vsyncQueueSize = static_cast<unsigned>(size);
+        else
+            throw std::invalid_argument("PS2X_GS_VSYNC_QUEUE must be an integer from 0 to 16");
+    }
 }
 
 DataStream::~DataStream()
@@ -57,6 +69,8 @@ DataStream::Mode DataStream::defaultMode()
 bool DataStream::start(Mode mode)
 {
     m_mode = mode;
+    m_vsyncPositions.clear();
+    m_verifiedVsyncs = 0;
 #if defined(PS2X_USE_METAL)
     if (mode == Mode::Inline)
         return ps2x_metal_gs_create() != 0;
@@ -84,6 +98,9 @@ void DataStream::stop()
     {
         m_ring->stop();
         m_ring.reset();
+        if (m_vsyncVerify)
+            std::fprintf(stderr, "[gs-vsync-verify] checked %llu ordered snapshots; mismatches=0\n",
+                         static_cast<unsigned long long>(m_verifiedVsyncs));
     }
     else
     {
@@ -303,7 +320,10 @@ void DataStream::refreshGs()
     {
         readbackChecked(csr, siglblid);
     }
-    m_gs.csr.store(csr, std::memory_order_release);
+    // FIELD advances on the EE even while an older GS snapshot is rendering.
+    constexpr uint64_t field = 0x2000ull;
+    const uint64_t eeCsr = m_gs.csr.load(std::memory_order_acquire);
+    m_gs.csr.store((csr & ~field) | (eeCsr & field), std::memory_order_release);
     m_gs.siglblid = siglblid;
     m_gsStale = false;
 }
@@ -312,12 +332,16 @@ void DataStream::execGsReset()
 {
     if (!ps2x_metal_gs_reset())
         throw std::runtime_error("native Metal GS CSR reset failed");
+    if (m_verify && !ps2x_metal_gs_readback(&m_shadowCsr, &m_shadowSiglblid))
+        throw std::runtime_error("native Metal GS CSR/SIGLBLID readback failed");
 }
 
 void DataStream::execGsWriteCsr(uint64_t csr, uint32_t mask, bool high)
 {
     if (!ps2x_metal_gs_write_csr(csr, mask, high ? 1 : 0))
         throw std::runtime_error("native Metal GS CSR synchronization failed");
+    if (m_verify && !ps2x_metal_gs_readback(&m_shadowCsr, &m_shadowSiglblid))
+        throw std::runtime_error("native Metal GS CSR/SIGLBLID readback failed");
 }
 
 void DataStream::execGsVsync(const VsyncArgs &args)
@@ -331,6 +355,22 @@ void DataStream::execGsVsync(const VsyncArgs &args)
     uint64_t *siglblid = &m_mailbox.siglblid;
     if (!ps2x_metal_gs_readback(csr, siglblid))
         throw std::runtime_error("native Metal GS VSync readback failed");
+    if (m_vsyncVerify)
+    {
+        const uint64_t predictedCsr = (snapshot.regs[15] & ~0x2000ull) | ((args.tick & 1u) << 13);
+        if (*csr != predictedCsr || *siglblid != snapshot.regs[18])
+        {
+            std::fprintf(stderr, "[gs-vsync-verify] register mismatch at tick %llu\n",
+                         static_cast<unsigned long long>(args.tick));
+            std::abort();
+        }
+        ++m_verifiedVsyncs;
+    }
+    if (m_verify)
+    {
+        m_shadowCsr = *csr;
+        m_shadowSiglblid = *siglblid;
+    }
 }
 
 void DataStream::gsReset()
@@ -370,7 +410,17 @@ void DataStream::gsVsync(uint64_t tick)
     {
         m_ring->push(OpGsVsync, tick, &args, sizeof(args));
         m_ring->publish();
-        m_ring->drain("GS vsync");
+        // PCSX2 MTGS::PostVsyncStart defaults VsyncQueueSize to two.
+        // Wait only through the oldest excess vsync, never the newer work.
+        const unsigned limit = m_mode == Mode::WorkerSync ? 0u : m_vsyncQueueSize;
+        m_vsyncPositions.push_back(m_ring->position());
+        if (m_vsyncPositions.size() > limit)
+        {
+            m_ring->waitThrough(m_vsyncPositions.front(), "GS vsync queue");
+            m_vsyncPositions.pop_front();
+        }
+        if (limit != 0u)
+            return;
     }
     else
     {
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.h b/ps2xRuntime/src/lib/ps2_data_stream.h
