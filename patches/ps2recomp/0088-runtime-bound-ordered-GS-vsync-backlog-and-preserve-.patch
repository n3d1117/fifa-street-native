 #include <memory>
 
 #include "runtime/ps2_memory.h"
@@ -17,7 +18,7 @@
 // The EE blocks (barrier) only where it observes data-side state: GS CSR and
 // SIGLBLID (observeGs), VU1 code/data accessed by guest loads and stores, an
 // MSCAL/MSCNT whose FBRST D/T enables make the VPU_STAT stop bits depend on the
-// run, GS local-to-host reads, GS vsync, initialize and shutdown.
+// run, GS local-to-host reads, the bounded vsync queue, initialize and shutdown.
 //
 // GS CSR and SIGLBLID are a pure function of the packets the bridge has
 // processed. They are read back lazily: submitting only marks them stale, and
@@ -158,6 +159,10 @@ private:
     int m_kickDepth = 0;
     bool m_gsStale = false;
     bool m_verify = false;
+    bool m_vsyncVerify = false;
+    uint64_t m_verifiedVsyncs = 0;
+    unsigned m_vsyncQueueSize = 2;
+    std::deque<uint64_t> m_vsyncPositions;
     uint64_t m_shadowCsr = 0;
     uint64_t m_shadowSiglblid = 0;
     Mailbox m_mailbox;
diff --git a/ps2xTest/src/ps2_data_stream_tests.cpp b/ps2xTest/src/ps2_data_stream_tests.cpp
index 79b997656421f4f5dc9dbefd7ead0de7fe7981e9..ff7ab2c0c73df86dd3c6ba4e5f03f7e036a9eca6 100644
--- a/ps2xTest/src/ps2_data_stream_tests.cpp
+++ b/ps2xTest/src/ps2_data_stream_tests.cpp
@@ -126,6 +126,30 @@ void register_ps2_data_stream_tests()
             ring.stop();
         });
 
+        tc.Run("a vsync checkpoint completes without draining later blocked work", [](TestCase &t)
+        {
+            std::atomic<bool> release{false};
+            std::atomic<unsigned> completed{0};
+            StreamRing ring(4096u, [&](const StreamRing::Op &op, const uint8_t *)
+            {
+                if (op.arg == 2u)
+                    while (!release.load(std::memory_order_acquire))
+                        std::this_thread::yield();
+                completed.fetch_add(1u, std::memory_order_release);
+            });
+            t.IsTrue(ring.start(), "ring should start");
+            ring.push(1, 1, nullptr, 0);
+            const uint64_t firstVsync = ring.position();
+            ring.push(1, 2, nullptr, 0);
+            ring.waitThrough(firstVsync, "oldest vsync");
+            t.Equals(completed.load(std::memory_order_acquire), 1u,
+                     "waiting for one vsync must leave newer work in flight");
+            release.store(true, std::memory_order_release);
+            ring.drain("remaining vsyncs");
+            t.Equals(completed.load(std::memory_order_acquire), 2u, "drain still retires all work");
+            ring.stop();
+        });
+
         tc.Run("ring reports a consumer exception at the next drain and keeps draining", [](TestCase &t)
         {
             std::atomic<int> executed{0};
@@ -153,6 +177,36 @@ void register_ps2_data_stream_tests()
             ring.stop();
         });
 
+#if defined(PS2X_USE_METAL)
+        tc.Run("vsync can run ahead of blocked VU1 and readback preserves the EE field", [](TestCase &t)
+        {
+            if (std::getenv("PS2X_GS_VSYNC_QUEUE"))
+                return;
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "memory initialize");
+            std::atomic<bool> release{false};
+            mem.setVu1MscalCallback([&](uint32_t, uint32_t, uint32_t)
+            {
+                while (!release.load(std::memory_order_acquire))
+                    std::this_thread::yield();
+            });
+            auto &stream = mem.dataStream();
+            t.IsTrue(stream.start(DataStream::Mode::Worker), "worker start");
+            Vif1Op job;
+            job.kind = Vif1OpKind::Mscal;
+            stream.vu1Job(job, false);
+            stream.gsVsync(1);
+            stream.gsVsync(2);
+            // The scheduler advances FIELD on the EE after posting the snapshot.
+            mem.gs().csr.store(0x2000ull);
+            release.store(true, std::memory_order_release);
+            stream.observeGs();
+            t.Equals(mem.gs().csr.load() & 0x2000ull, uint64_t{0x2000},
+                     "delayed readback must not restore an older worker FIELD");
+            stream.stop();
+        });
+#endif
+
         tc.Run("worker mode matches inline for VU1 memory, jobs and GIF packet order", [](TestCase &t)
         {
             PS2Memory inlineMem;
