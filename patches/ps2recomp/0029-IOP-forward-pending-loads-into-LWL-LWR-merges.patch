+    bool testUnalignedLoadPairs()
+    {
+        IopMemory memory;
+        IopCpuCore core(memory);
+        memory.write32(0x1000u, 0x44332211u);
+        memory.write32(0x1004u, 0x88776655u);
+        const uint32_t expected[] = {0u, 0x55443322u, 0x66554433u, 0x77665544u};
+        for (uint32_t offset = 1u; offset <= 3u; ++offset)
+        {
+            for (bool leftFirst : {false, true})
+            {
+                for (uint32_t initial : {0u, 0xAABBCCDDu})
+                {
+                    IopCpuState cpu{};
+                    cpu.gpr[4] = 0x1000u;
+                    cpu.gpr[8] = initial;
+                    const uint32_t left = 0x88880000u | (offset + 3u); // lwl t0, offset+3(a0)
+                    const uint32_t right = 0x98880000u | offset;       // lwr t0, offset(a0)
+                    memory.write32(0u, leftFirst ? left : right);
+                    memory.write32(4u, leftFirst ? right : left);
+                    memory.write32(8u, 0u);
+                    if (!expect(core.executeInstruction(cpu) && cpu.gpr[8] == initial && cpu.pendingLoad,
+                                "first unaligned load bypassed its load delay") ||
+                        !expect(core.executeInstruction(cpu), "second unaligned load stopped") ||
+                        !expect(core.executeInstruction(cpu) && cpu.gpr[8] == expected[offset],
+                                leftFirst ? "LWL/LWR lost bytes from pending LWL" : "LWR/LWL lost bytes from pending LWR"))
+                        return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    bool testUnalignedLoadMergeSources()
+    {
+        IopMemory memory;
+        IopCpuCore core(memory);
+        memory.write32(0x1000u, 0x44332211u);
+        memory.write32(0x1004u, 0xAABBCCDDu);
+        const uint32_t pendingExpected[2][4] = {
+            {0x11BBCCDDu, 0x2211CCDDu, 0x332211DDu, 0x44332211u},
+            {0x44332211u, 0xAA443322u, 0xAABB4433u, 0xAABBCC44u},
+        };
+        const uint32_t registerExpected[2][4] = {
+            {0x11345678u, 0x22115678u, 0x33221178u, 0x44332211u},
+            {0x44332211u, 0x12443322u, 0x12344433u, 0x12345644u},
+        };
+        for (uint32_t right = 0u; right < 2u; ++right)
+            for (uint32_t offset = 0u; offset < 4u; ++offset)
+                for (uint32_t priorRt : {0u, 8u, 9u})
+                {
+                    IopCpuState cpu{};
+                    cpu.gpr[4] = 0x1000u;
+                    cpu.gpr[8] = 0x12345678u;
+                    memory.write32(0u, 0x8C800004u | (priorRt << 16u)); // lw priorRt, 4(a0)
+                    memory.write32(4u, (right ? 0x98880000u : 0x88880000u) | offset);
+                    memory.write32(8u, 0u);
+                    const uint32_t expected = priorRt == 8u ? pendingExpected[right][offset] : registerExpected[right][offset];
+                    if (!expect(core.executeInstruction(cpu) && core.executeInstruction(cpu) &&
+                                    core.executeInstruction(cpu) && cpu.gpr[8] == expected,
+                                "unaligned load used the wrong merge source") ||
+                        !expect(cpu.gpr[0] == 0u && (priorRt != 9u || cpu.gpr[9] == 0xAABBCCDDu),
+                                "unaligned load corrupted another load destination"))
+                        return false;
+                }
+        return true;
+    }
+
+    bool testOrdinaryLoadDelay()
+    {
+        IopMemory memory;
+        IopCpuCore core(memory);
+        memory.write32(0x1000u, 0xAABBCCDDu);
+        for (uint32_t consumer : {0x01004821u, 0xAC880004u, 0x24080007u}) // addu t1,t0,zero; sw t0,4(a0); addiu t0,zero,7
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = 0x1000u;
+            cpu.gpr[8] = 0x12345678u;
+            memory.write32(0u, 0x8C880000u); // lw t0,0(a0)
+            memory.write32(4u, consumer);
+            if (!expect(core.executeInstruction(cpu) && cpu.gpr[8] == 0x12345678u &&
+                            core.executeInstruction(cpu), "ordinary load bypassed its delay") ||
+                !expect(cpu.gpr[8] == (consumer == 0x24080007u ? 7u : 0xAABBCCDDu),
+                        "ordinary load commit or overwrite changed") ||
+                !expect(consumer != 0x01004821u || cpu.gpr[9] == 0x12345678u,
+                        "ALU read a pending load") ||
+                !expect(consumer != 0xAC880004u || memory.read32(0x1004u) == 0x12345678u,
+                        "store read a pending load"))
+                return false;
+        }
+        return true;
+    }
+
