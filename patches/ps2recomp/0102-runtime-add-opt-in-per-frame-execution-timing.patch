@@ -2,6 +2,17 @@
 #define PS2_PERF_H
 
 #include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+inline bool ps2PerfLogEnabled() noexcept
+{
+    static const bool enabled = [] {
+        const char *value = std::getenv("PS2X_PERF_LOG");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
 
 struct Ps2PerfSnapshot
 {
@@ -11,11 +22,18 @@ struct Ps2PerfSnapshot
     uint64_t vsync_drains = 0;
     uint64_t vsync_worker_busy = 0;
     double stream_full_wait_seconds = 0.0;
+    double ee_seconds = 0.0;
+    double iop_seconds = 0.0;
+    double vif_unpack_seconds = 0.0;
+    double xgkick_seconds = 0.0;
 };
 
 Ps2PerfSnapshot ps2GetPerfSnapshot();
 void ps2PublishPerfSnapshot();
 void ps2RecordStreamFullWait(double seconds);
 void ps2RecordVsyncDrain(double seconds, bool workerBusy);
+void ps2RecordEeExecution(double seconds);
+void ps2RecordVifUnpack(double seconds);
+void ps2RecordXgkick(double seconds);
 
 #endif
