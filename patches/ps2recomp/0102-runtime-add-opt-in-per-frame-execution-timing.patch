index 1c38c14a771ba9e33675d65ea96624e8475b37b5..426d6789d6001d9eb1a2ca8d4ae80cdb43058730 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -1,4 +1,5 @@
 #include "runtime/ee_scheduler.h"
+#include "runtime/ps2_perf.h"
 #include "ps2x/iop/iop_subsystem.h"
 #include "runtime/ps2_display_timing.h"
 #include "runtime/ps2_host_arena.h"
@@ -223,6 +224,7 @@ void EeScheduler::run()
         const char *value = std::getenv("PS2X_EE_IOP_IDLE");
         return !value || value[0] != '0' || value[1] != '\0';
     }();
+    uint32_t perfDispatches = 0;
 
     while (!m_stopRequested.load(std::memory_order_acquire))
     {
@@ -415,22 +417,31 @@ void EeScheduler::run()
             continue;
         }
 
+        const bool perfSample = ps2PerfLogEnabled() && (++perfDispatches % 32u == 0u);
+        const auto perfStart = perfSample ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        const auto recordPerf = [&] {
+            if (perfSample)
+                ps2RecordEeExecution(std::chrono::duration<double>(std::chrono::steady_clock::now() - perfStart).count() * 32.0);
+        };
         try
         {
             m_insideInterrupt = !running->invocations.empty() && running->invocations.back().kind == GuestInvocationKind::Interrupt;
             m_guestExecuting.store(true, std::memory_order_release);
             g_ps2GuestUnwinding = false;
             function(m_rdram, &context, &m_runtime);
+            recordPerf();
             m_guestExecuting.store(false, std::memory_order_release);
             m_insideInterrupt = false;
         }
         catch (const EeDispatcherTransfer &)
         {
+            recordPerf();
             m_guestExecuting.store(false, std::memory_order_release);
             m_insideInterrupt = false;
         }
         catch (...)
         {
+            recordPerf();
             m_guestExecuting.store(false, std::memory_order_release);
             m_running.store(false, std::memory_order_release);
             publishSnapshot();
