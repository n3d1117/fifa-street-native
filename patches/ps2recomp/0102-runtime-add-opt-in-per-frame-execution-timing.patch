From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Fri, 23 Oct 2026 14:08:17 +0200
Subject: [PATCH 102/108] runtime: add opt-in per-frame execution timing


diff --git a/ps2xIOP/include/ps2x/iop/iop_perf.h b/ps2xIOP/include/ps2x/iop/iop_perf.h
new file mode 100644
index 0000000000000000000000000000000000000000..805351d475c81d83f443033e2aaf540ba97c1917
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_perf.h
@@ -0,0 +1,6 @@
+#pragma once
+
+namespace ps2x::iop
+{
+double iopPerfExecutionSeconds() noexcept;
+}
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index f7999edec3ffc8726eedfbd12ec50477791f7d6b..d69ead2b4b70ac2da14cb1ae5ad4f1a221ff5a69 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -18,8 +18,10 @@
 #include "imports/iop_vblank.h"
 #include "iop_emulator_const.h"
 #include "ps2x/iop/iop_host_spu2.h"
+#include "ps2x/iop/iop_perf.h"
 
 #include <algorithm>
+#include <atomic>
 #include <cctype>
 #include <chrono>
 #include <cstdio>
@@ -31,6 +33,28 @@
 #include <thread>
 #include <utility>
 
+namespace ps2x::iop
+{
+namespace
+{
+std::atomic<double> g_perfExecutionSeconds{0.0};
+
+bool perfLogEnabled() noexcept
+{
+    static const bool enabled = [] {
+        const char *value = std::getenv("PS2X_PERF_LOG");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+}
+
+double iopPerfExecutionSeconds() noexcept
+{
+    return g_perfExecutionSeconds.load(std::memory_order_acquire);
+}
+}
+
 namespace ps2x::iop::detail
 {
     namespace
@@ -493,6 +517,10 @@ namespace ps2x::iop::detail
 
         uint32_t runCpu(CpuState &cpu, uint32_t instructionBudget)
         {
+            static thread_local uint32_t perfSlices = 0;
+            constexpr double sampleWeight = 8.0;
+            const bool perfSample = perfLogEnabled() && (++perfSlices % static_cast<uint32_t>(sampleWeight) == 0u);
+            const auto perfStart = perfSample ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
             CpuState *previous = activeCpu;
             activeCpu = &cpu;
             const uint64_t start = totalInstructions;
@@ -510,6 +538,10 @@ namespace ps2x::iop::detail
                     servicePendingGuestCallbacks();
             }
             activeCpu = previous;
+            if (perfSample)
+                g_perfExecutionSeconds.fetch_add(
+                    std::chrono::duration<double>(std::chrono::steady_clock::now() - perfStart).count() * sampleWeight,
+                    std::memory_order_relaxed);
             return static_cast<uint32_t>(totalInstructions - start);
         }
 
diff --git a/ps2xRuntime/include/runtime/ps2_perf.h b/ps2xRuntime/include/runtime/ps2_perf.h
index 917090d27eef5feed2f222609c76d656652f2326..c0ef869778ebf5e60c14da49a52f46f81bfa1316 100644
--- a/ps2xRuntime/include/runtime/ps2_perf.h
