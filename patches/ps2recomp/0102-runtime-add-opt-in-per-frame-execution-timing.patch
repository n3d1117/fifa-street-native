+    std::atomic<double> g_perfEeSeconds{0.0};
+    std::atomic<double> g_perfVifUnpackSeconds{0.0};
+    std::atomic<double> g_perfXgkickSeconds{0.0};
     std::atomic<uint64_t> g_perfVsyncDrains{0};
     std::atomic<uint64_t> g_perfVsyncWorkerBusy{0};
 
@@ -627,9 +631,17 @@ Ps2PerfSnapshot ps2GetPerfSnapshot()
             g_perfDrainWaitSeconds.load(std::memory_order_acquire),
             g_perfVsyncDrains.load(std::memory_order_acquire),
             g_perfVsyncWorkerBusy.load(std::memory_order_acquire),
-            g_perfStreamFullWaitSeconds.load(std::memory_order_acquire)};
+            g_perfStreamFullWaitSeconds.load(std::memory_order_acquire),
+            g_perfEeSeconds.load(std::memory_order_acquire),
+            ps2x::iop::iopPerfExecutionSeconds(),
+            g_perfVifUnpackSeconds.load(std::memory_order_acquire),
+            g_perfXgkickSeconds.load(std::memory_order_acquire)};
 }
 
+void ps2RecordEeExecution(double seconds) { g_perfEeSeconds.fetch_add(seconds, std::memory_order_relaxed); }
+void ps2RecordVifUnpack(double seconds) { g_perfVifUnpackSeconds.fetch_add(seconds, std::memory_order_relaxed); }
+void ps2RecordXgkick(double seconds) { g_perfXgkickSeconds.fetch_add(seconds, std::memory_order_relaxed); }
+
 void ps2RecordStreamFullWait(double seconds)
 {
     g_perfStreamFullWaitSeconds.store(g_perfStreamFullWaitSeconds.load(std::memory_order_relaxed) + seconds,
