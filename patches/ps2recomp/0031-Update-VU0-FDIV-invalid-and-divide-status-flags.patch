diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index ba1064314537c5df289423e8c48f5cb23e3d0943..47ba0ca140e76a9c3880dda050432abde1f91044 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -1469,6 +1469,25 @@ static inline void ps2_vu0_set_mac(R5900Context *ctx, __m128 result, uint32_t de
 }
 #define PS2_VU0_SET_MAC(ctx_ptr, result, dest, ...) ps2_vu0_set_mac((ctx_ptr), (result), (dest) __VA_OPT__(,) __VA_ARGS__)
 
+enum class Ps2Vu0Fdiv { Div, Sqrt, Rsqrt };
+
+template <Ps2Vu0Fdiv Op>
+inline uint16_t ps2_vu0_fdiv_status(uint16_t status, float fs, float ft)
+{
+    const uint32_t s = std::bit_cast<uint32_t>(fs);
+    const uint32_t t = std::bit_cast<uint32_t>(ft);
+    const bool sz = (s & 0x7f800000u) == 0;
+    const bool tz = (t & 0x7f800000u) == 0;
+    uint32_t flags;
+    if constexpr (Op == Ps2Vu0Fdiv::Div)
+        flags = tz ? (sz ? 0x10u : 0x20u) : 0u;
+    else if constexpr (Op == Ps2Vu0Fdiv::Sqrt)
+        flags = (!tz && (t >> 31)) ? 0x10u : 0u;
+    else
+        flags = tz ? (0x20u | (sz ? 0x10u : 0u)) : ((t >> 31) ? 0x10u : 0u);
+    return static_cast<uint16_t>((status & ~0x30u) | flags | (flags << 6));
+}
+
 // Additional VU0 operations
 #define PS2_VSQRT(x) sqrtf(x)
 #define PS2_VRSQRT(x) (1.0f / sqrtf(x))
