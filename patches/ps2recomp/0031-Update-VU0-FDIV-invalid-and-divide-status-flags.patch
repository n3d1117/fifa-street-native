         });
 
+        tc.Run("FDIV translations update I/D status before writing Q", [](TestCase &t)
+        {
+            for (uint32_t op : {VU0_S2_VDIV, VU0_S2_VSQRT, VU0_S2_VRSQRT})
+            {
+                const auto code = translate(0x100000u, cop2Special2(0, 2, 1, op));
+                const auto flags = code.find("ps2_vu0_fdiv_status");
+                t.IsTrue(flags != std::string::npos && flags < code.find("ctx->vu0_q ="), "FDIV must update I/D and sticky status: " + code);
+            }
+        });
+
+        tc.Run("FDIV cause flags clear while sticky flags survive", [](TestCase &t)
+        {
+            uint16_t status = ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Div>(0x145u, 1.0f, 0.0f);
+            t.Equals(static_cast<uint32_t>(status), 0x965u, "VDIV(1,0) sets D/SD and preserves FMAC");
+            status = ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Div>(status, 1.0f, 2.0f);
+            t.Equals(static_cast<uint32_t>(status), 0x945u, "valid VDIV clears D but retains SD");
+            status = ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Sqrt>(status, 0.0f, -4.0f);
+            t.Equals(static_cast<uint32_t>(status), 0xd55u, "VSQRT(-4) sets I/SI");
+            status = ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Sqrt>(status, 0.0f, runtimeBits(0x80000001u));
+            t.Equals(static_cast<uint32_t>(status), 0xd45u, "negative denormal is zero and clears I");
+            t.Equals(static_cast<uint32_t>(ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Div>(0, 0.0f, -0.0f)), 0x410u, "VDIV(0,0) sets I only");
+            t.Equals(static_cast<uint32_t>(ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Rsqrt>(0, 0.0f, -0.0f)), 0xc30u, "VRSQRT(0,0) sets both I/D");
+            t.Equals(static_cast<uint32_t>(ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Rsqrt>(0, 1.0f, 0.0f)), 0x820u, "VRSQRT(1,0) sets D");
+            t.Equals(static_cast<uint32_t>(ps2_vu0_fdiv_status<Ps2Vu0Fdiv::Rsqrt>(0, 1.0f, -4.0f)), 0x410u, "VRSQRT(1,-4) sets I");
+        });
+
         tc.Run("RSQRT is fs / sqrt(|ft|)", [](TestCase &t)
         {
             t.Equals(bits(ps2_vu_rsqrt(1.0f, 4.0f)), bits(0.5f), "1 / sqrt(4)");
