From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Wed, 21 Oct 2026 17:54:46 +0200
Subject: [PATCH 090/112] Pad: DualShock 2 shoulder pressure bytes are L1, R1,
 L2, R2

Bytes 17/18 carried L2 and R1 swapped, so games that read shoulder buttons by
pressure (FIFA Street's 'R1 Statistics') saw physical L2 as R1. Order per PCSX2
PadDualshock2.cpp; test pins all four shoulder slots.

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
index 9d47733dc5dfd3b6974c5fc41ee6d20fb5ba257a..b627fb13d91bba6bbc9f54209c665e75c5a4558c 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
@@ -267,8 +267,9 @@ namespace ps2_stubs
             data[14] = pressureValue(state, portState, kPadBtnCross);
             data[15] = pressureValue(state, portState, kPadBtnSquare);
             data[16] = pressureValue(state, portState, kPadBtnL1);
-            data[17] = pressureValue(state, portState, kPadBtnL2);
-            data[18] = pressureValue(state, portState, kPadBtnR1);
+            // DualShock 2 pressure order is L1, R1, L2, R2 (PCSX2 PadDualshock2.cpp, libpad padButtonStatus).
+            data[17] = pressureValue(state, portState, kPadBtnR1);
+            data[18] = pressureValue(state, portState, kPadBtnL2);
             data[19] = pressureValue(state, portState, kPadBtnR2);
         }
 
diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index eac7f908d63a92b337562f2b8667741892ada607..f56a33f91560b0b113a444f21fe7ca4676ad10f1 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -359,6 +359,17 @@ void register_pad_input_tests()
             t.Equals(readButtons(rdram), static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), "pressure packet should retain active-low buttons");
             t.Equals(data[14], static_cast<uint8_t>(0xFF), "pressure packet should include Cross pressure");
 
+            // DualShock 2 pressure bytes 16..19 are L1, R1, L2, R2 (PCSX2 PadDualshock2.cpp).
+            const uint16_t shoulders[4] = {kPadBtnL1, kPadBtnR1, kPadBtnL2, kPadBtnR2};
+            for (int pressed = 0; pressed < 4; ++pressed)
+            {
+                ps2_stubs::setPadOverrideState(static_cast<uint16_t>(0xFFFFu & ~shoulders[pressed]), 0x80, 0x80, 0x80, 0x80);
+                runPadRead(ctx, rdram);
+                for (int slot = 0; slot < 4; ++slot)
+                    t.Equals(data[16 + slot], static_cast<uint8_t>(slot == pressed ? 0xFF : 0),
+                             "shoulder pressure bytes should be ordered L1, R1, L2, R2");
+            }
+
             ps2_stubs::scePadExitPressMode(rdram.data(), &ctx, nullptr);
             runPadRead(ctx, rdram);
             t.Equals(data[1], static_cast<uint8_t>(0x73), "exiting pressure mode should restore the analog packet ID");
