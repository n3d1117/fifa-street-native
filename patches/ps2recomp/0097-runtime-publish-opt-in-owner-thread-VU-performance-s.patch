             t.Equals(vu1.cycleCount(), uint64_t(17u), "failed native cycles must not advance guest time");
             t.Equals(fx.data[7], uint8_t(0x55u), "native stores must not change fallback memory");
             t.Equals(fx.mem.gifCopyCount(), gifBefore, "failed native packets must not reach GS");
+            t.Equals(native.fallbacks(), uint64_t(1), "perf snapshot counts the existing failed-native fallback");
+            const double nativeSeconds = native.seconds();
+            native.noteInterpreterRun(0, 0.25);
+            t.Equals(native.seconds(), nativeSeconds + 0.25, "perf time includes the existing interpreter timing");
         });
 
         tc.Run("reserved opcodes stop before executing or corrupting state", [](TestCase &t)
