From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Fri, 23 Oct 2026 01:13:15 +0200
Subject: [PATCH 097/102] runtime: publish opt-in owner-thread VU performance
 snapshots


diff --git a/ps2xRuntime/include/runtime/ps2_perf.h b/ps2xRuntime/include/runtime/ps2_perf.h
new file mode 100644
index 0000000000000000000000000000000000000000..884b85630f2410f89d5a5b8d278c29d88b9ab070
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_perf.h
@@ -0,0 +1,15 @@
+#ifndef PS2_PERF_H
+#define PS2_PERF_H
+
+#include <cstdint>
+
+struct Ps2PerfSnapshot
+{
+    double vu1_seconds = 0.0;
+    uint64_t vu_fallbacks = 0;
+};
+
+Ps2PerfSnapshot ps2GetPerfSnapshot();
+void ps2PublishPerfSnapshot();
+
+#endif
diff --git a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
index 540c7d56e3e83d8a3ad1d2c986518b4ed5ac0c62..5b2bb979e8026ab9ff2d95254dda6e4a9771d8d1 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
@@ -141,6 +141,8 @@ public:
         m_stats.vu1Cycles += cycles;
         m_vu1Seconds += seconds;
     }
+    double seconds() const { return m_vu1Seconds; }
+    uint64_t fallbacks() const { return m_stats.fallbackNoProgram + m_stats.fallbackFailed; }
     static double now();
     void printStats(const char *why);
 
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
index 6158df4aa987b2063780dc68dfa6024452dd45b3..1b46625b955b3aac119acb449e32699d6828cea3 100644
--- a/ps2xRuntime/src/lib/ps2_data_stream.cpp
+++ b/ps2xRuntime/src/lib/ps2_data_stream.cpp
@@ -1,4 +1,6 @@
 #include "ps2_data_stream.h"
+#include "runtime/ps2_perf.h"
+#include "ThreadNaming.h"
 
 #include <cstdio>
 #include <cstdlib>
@@ -32,6 +34,8 @@ DataStream::DataStream(PS2Memory &memory) : m_memory(memory), m_gs(memory.gs())
 {
     const char *verify = std::getenv("PS2X_GS_VERIFY");
     m_verify = verify && verify[0] == '1';
+    const char *perf = std::getenv("PS2X_PERF_LOG");
+    m_perfEnabled = perf && std::strcmp(perf, "1") == 0;
 }
 
 DataStream::~DataStream()
@@ -63,7 +67,10 @@ bool DataStream::start(Mode mode)
     m_ring = std::make_unique<StreamRing>(
         kRingBytes, [this](const StreamRing::Op &op, const uint8_t *payload) { execute(op, payload); },
         [](const StreamRing::Op &op) { return describe(op); });
-    const bool ok = m_ring->start([] { return ps2x_metal_gs_create() != 0; },
+    const bool ok = m_ring->start([this] {
+                                      if (m_perfEnabled) ThreadNaming::SetCurrentThreadName("VU1GSWorker");
+                                      return ps2x_metal_gs_create() != 0;
+                                  },
                                   [] { ps2x_metal_gs_destroy(); });
     if (!ok)
         m_ring.reset();
@@ -322,6 +329,8 @@ void DataStream::execGsWriteCsr(uint64_t csr, uint32_t mask, bool high)
 
 void DataStream::execGsVsync(const VsyncArgs &args)
 {
+    if (m_perfEnabled)
+        ps2PublishPerfSnapshot();
     VsyncArgs snapshot = args;
     if (snapshot.useBridgeCsr && !ps2x_metal_gs_readback(&snapshot.regs[15], &snapshot.regs[18]))
         throw std::runtime_error("native Metal GS VSync readback failed");
diff --git a/ps2xRuntime/src/lib/ps2_data_stream.h b/ps2xRuntime/src/lib/ps2_data_stream.h
index c85e6cd27fa06f7c2c5ee4394b4b3995e265310f..e1109611342662f0866874ce13fe7b575926b527 100644
--- a/ps2xRuntime/src/lib/ps2_data_stream.h
+++ b/ps2xRuntime/src/lib/ps2_data_stream.h
@@ -158,6 +158,7 @@ private:
     int m_kickDepth = 0;
     bool m_gsStale = false;
     bool m_verify = false;
+    bool m_perfEnabled = false;
     uint64_t m_shadowCsr = 0;
     uint64_t m_shadowSiglblid = 0;
     Mailbox m_mailbox;
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index dbeef3084d7bbe6ceb794cf7436cbe2310415b3b..98fee21dba8334dd612b96e09abf21d4885a27f9 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1,3 +1,4 @@
+#include "runtime/ps2_perf.h"
 #include "runtime/ps2_vu0_recomp.h"
 #include "runtime/ps2_vu1_recomp.h"
 #include "ps2_runtime.h"
@@ -112,6 +113,9 @@ Ps2GuestWriteObserver g_ps2GuestWriteObserver = nullptr;
 
 namespace
 {
+    std::atomic<double> g_perfVu1Seconds{0.0};
+    std::atomic<uint64_t> g_perfVuFallbacks{0};
+
     Vu1NativeDispatcher &vu1NativeDispatcher()
     {
         static Vu1NativeDispatcher dispatcher;
@@ -609,6 +613,19 @@ static void UploadFrame(Texture2D &tex, PS2Runtime *rt, uint32_t &outWidth, uint
 
 #endif
 
+Ps2PerfSnapshot ps2GetPerfSnapshot()
+{
+    return {g_perfVu1Seconds.load(std::memory_order_acquire),
+            g_perfVuFallbacks.load(std::memory_order_acquire)};
+}
+
+void ps2PublishPerfSnapshot()
+{
+    const auto &dispatcher = vu1NativeDispatcher();
+    g_perfVu1Seconds.store(dispatcher.seconds(), std::memory_order_release);
+    g_perfVuFallbacks.store(dispatcher.fallbacks(), std::memory_order_release);
+}
+
 PS2Runtime::PS2Runtime()
 {
     m_iopHost = std::make_unique<PS2IopHostAdapter>(*this);
