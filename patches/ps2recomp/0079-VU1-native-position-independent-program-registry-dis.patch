+// A program is placed where every one of its words matches micro memory exactly;
+// micro memory only changes between dispatches, so no per-pair guard is needed.
+const Vu1RecProgram *Vu1NativeDispatcher::findProgram(PS2Memory &memory, uint32_t pc, uint32_t &base)
+{
+    if (!m_programsEnabled)
+        return nullptr;
+    const std::vector<Vu1RecProgram> &programs = programRegistry();
+    if (programs.empty())
+        return nullptr;
+    const uint8_t *code = memory.getVU1Code();
+    const uint64_t generation = memory.getVU1CodeGeneration();
+    if (code != m_placementCode || generation != m_placementGeneration)
+    {
+        m_placementCode = code;
+        m_placementGeneration = generation;
+        m_placements.clear();
+        for (const Vu1RecProgram &program : programs)
+        {
+            const uint32_t bytes = program.slots * 8u;
+            for (uint32_t at = 0; at + bytes <= PS2_VU1_CODE_SIZE; at += 8u)
+            {
+                uint64_t first;
+                std::memcpy(&first, code + at, sizeof(first));
+                if (first == program.words[0] && std::memcmp(code + at, program.words, bytes) == 0)
+                    m_placements.push_back({&program, at});
+            }
+        }
+    }
+    for (const Placement &placement : m_placements)
+    {
+        if (pc >= placement.base && pc - placement.base < placement.program->slots * 8u &&
+            placement.program->hasEntry(pc - placement.base))
+        {
+            base = placement.base;
+            return placement.program;
+        }
+    }
+    return nullptr;
+}
