+// Position-independent microprogram: the dispatcher proves that the exact words
+// sit at some micro-memory base and passes that base in Vu1RecContext::relocBase.
+// Entries are program-relative byte PCs.
+struct Vu1RecProgram
+{
+    const char *name = nullptr;
+    uint32_t slots = 0;
+    uint64_t hash = 0;            // FNV-1a over the program words
+    const uint64_t *words = nullptr;
+    const uint32_t *entries = nullptr;
+    size_t entryCount = 0;
+    Vu1RecFn full = nullptr;
+    bool hasDebugBits = false;
+
+    bool hasEntry(uint32_t relPc) const
+    {
+        for (size_t i = 0; i < entryCount; ++i)
+            if (entries[i] == relPc)
+                return true;
+        return false;
+    }
+};
+
+void vu1recRegisterProgram(const Vu1RecProgram &program);
+size_t vu1recProgramCount();
+
+struct Vu1RecProgramRegistrar
+{
+    Vu1RecProgramRegistrar(const char *name, uint32_t slots, uint64_t hash, const uint64_t *words,
+                           const uint32_t *entries, size_t count, Vu1RecFn full, bool hasDebugBits)
+    {
+        Vu1RecProgram program;
+        program.name = name;
+        program.slots = slots;
+        program.hash = hash;
+        program.words = words;
+        program.entries = entries;
+        program.entryCount = count;
+        program.full = full;
+        program.hasDebugBits = hasDebugBits;
+        vu1recRegisterProgram(program);
+    }
+};
