+enum class Vif1OpKind : uint8_t
+{
+    Mpg,
+    Unpack,
+    Mscal,
+    Mscnt,
+    Direct,
+    Path3Unmask,
+};
+
+struct Vif1UnpackParams
+{
+    uint8_t opcode = 0;
+    uint32_t writeVectorCount = 0;
+    uint32_t sourceVectorCount = 0;
+    uint32_t bytesPerVector = 0;
+    uint32_t cl = 0;
+    uint32_t wl = 0;
+    uint32_t vuAddr = 0;
+    uint32_t mode = 0;
+    uint32_t mask = 0;
+    uint32_t row[4] = {};
+    uint32_t col[4] = {};
+    bool zeroExtend = false;
+};
+
+// One data-side operation produced by the VIF1 front end, in command order.
+// payload points into the caller's input and is only valid during emit; a
+// deferred consumer must copy it.
+struct Vif1Op
+{
+    Vif1OpKind kind = Vif1OpKind::Mpg;
+    const uint8_t *payload = nullptr;
+    uint32_t payloadBytes = 0;
+    uint32_t addr = 0; // MPG destination byte address, MSCAL start PC
+    uint32_t top = 0;
+    uint32_t itop = 0;
+    bool directHl = false;
+    Vif1UnpackParams unpack;
+};
+
+// Decodes one UNPACK into VU1 data memory. row is the ROW register, updated by
+// STMOD modes 2 and 3. With vu1Data null only the ROW update is computed, which
+// is how the front end keeps the guest-visible register without touching VU1
+// memory.
+void unpackVectors(const Vif1Op &op, uint8_t *vu1Data, uint32_t (&row)[4])
+{
+    const Vif1UnpackParams &p = op.unpack;
+    const uint8_t opcode = p.opcode;
+    const uint8_t vn = (opcode >> 2) & 0x3;
+    const uint8_t vl = opcode & 0x3;
+    const bool maskEnable = (opcode & 0x10u) != 0u;
+    const int components = vn + 1;
+    const uint32_t writeVectorCount = p.writeVectorCount;
+    const uint32_t sourceVectorCount = p.sourceVectorCount;
+    const uint32_t bytesPerVector = p.bytesPerVector;
+    const uint32_t cl = p.cl;
+    const uint32_t wl = p.wl;
+    const uint32_t vuAddr = p.vuAddr;
+    const bool zeroExtend = p.zeroExtend;
+    const uint32_t availableSourceBytes = op.payloadBytes;
+    const uint8_t *srcBase = op.payload;
+    uint32_t srcIndex = 0u;
+    for (uint32_t writeIndex = 0; writeIndex < writeVectorCount; ++writeIndex)
+    {
+        const uint32_t cyclePos = writeIndex % wl;
+        const bool sourceReadCycle = (cl >= wl) || (cyclePos < cl);
+
+        uint32_t destVec = 0;
+        if (cl >= wl)
+        {
+            destVec = (vuAddr + (writeIndex / wl) * cl + cyclePos) & 0x3FFu;
+        }
+        else
+        {
+            destVec = (vuAddr + writeIndex) & 0x3FFu;
+        }
+
+        uint32_t destOff = destVec * 16u;
+        if (destOff + 16u > PS2_VU1_DATA_SIZE)
+        {
+            if (sourceReadCycle && srcIndex < sourceVectorCount)
+                ++srcIndex;
+            continue;
+        }
+
+        uint32_t lanes[4] = {0u, 0u, 0u, 0u};
+        if (vu1Data)
+            std::memcpy(lanes, vu1Data + destOff, sizeof(lanes));
+        uint32_t beforeLanes[4];
+        std::memcpy(beforeLanes, lanes, sizeof(beforeLanes));
+        uint32_t decompressed[4] = {0u, 0u, 0u, 0u};
+        const uint32_t sourceByteOffset = srcIndex * bytesPerVector;
+        const bool decoded = sourceByteOffset < availableSourceBytes;
+
+        const uint8_t *srcVec = nullptr;
+        // Fill writes hold the pointer at the next unconsumed
+        // vector, so they can still read it without advancing.
+        if (decoded)
+        {
+            srcVec = srcBase + sourceByteOffset;
+            if (sourceReadCycle && srcIndex < sourceVectorCount)
+                ++srcIndex;
+        }
+
+        auto extend16 = [&](uint16_t raw) -> uint32_t
+        {
+            if (zeroExtend)
+                return static_cast<uint32_t>(raw);
+            return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(raw)));
+        };
+
+        auto extend8 = [&](uint8_t raw) -> uint32_t
+        {
+            if (zeroExtend)
+                return static_cast<uint32_t>(raw);
+            return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(raw)));
+        };
+
+        auto sourceElement = [&](uint32_t component) -> uint32_t
+        {
+            const uint32_t componentBytes = 4u >> vl;
+            const uint32_t offset = sourceByteOffset + component * componentBytes;
+            if (offset > availableSourceBytes || componentBytes > availableSourceBytes - offset)
+                return 0u;
+            if (vl == 0u)
+            {
+                uint32_t value = 0u;
+                std::memcpy(&value, srcBase + offset, sizeof(value));
+                return value;
+            }
+            if (vl == 1u)
+            {
+                uint16_t value = 0u;
+                std::memcpy(&value, srcBase + offset, sizeof(value));
+                return extend16(value);
+            }
+            return extend8(srcBase[offset]);
+        };
+
+        bool handledFormat = true;
+        if (!decoded)
+        {
+            // The UNPACK source pointer can reach the end of the
+            // supplied data during fill writes; those reads are zero.
+        }
+        else if (vl == 0u)
+        {
+            if (components == 1)
+            {
+                const uint32_t scalar = sourceElement(0u);
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    decompressed[c] = sourceElement(c);
+                }
+            }
+        }
+        else if (vl == 1u)
+        {
+            if (components == 1)
+            {
+                const uint32_t scalar = sourceElement(0u);
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    decompressed[c] = sourceElement(c);
+                }
+            }
+        }
+        else if (vl == 2u)
+        {
+            if (components == 1)
+            {
+                const uint32_t scalar = sourceElement(0u);
+                decompressed[0] = scalar;
+                decompressed[1] = scalar;
+                decompressed[2] = scalar;
+                decompressed[3] = scalar;
+            }
+            else
+            {
+                const uint32_t limit = (components > 4) ? 4u : static_cast<uint32_t>(components);
+                for (uint32_t c = 0; c < limit; ++c)
+                {
+                    decompressed[c] = sourceElement(c);
+                }
+            }
+        }
+        else if (vl == 3u && vn == 3u)
+        {
+            // V4-5 expands 5:5:5:1 to the high bits of each 8-bit channel.
+            uint16_t packed = 0;
+            if (sourceByteOffset <= availableSourceBytes && sizeof(packed) <= availableSourceBytes - sourceByteOffset)
+                std::memcpy(&packed, srcBase + sourceByteOffset, sizeof(packed));
+            decompressed[0] = (packed & 0x001Fu) << 3u;
+            decompressed[1] = (packed & 0x03E0u) >> 2u;
+            decompressed[2] = (packed & 0x7C00u) >> 7u;
+            decompressed[3] = (packed & 0x8000u) >> 8u;
+        }
+        else
+        {
+            handledFormat = false;
+        }
+
+        // Unknown compressed format fallback: preserve legacy raw-copy behavior.
+        if (!handledFormat && decoded && !maskEnable && (p.mode == 0u || p.mode == 3u))
+        {
+            uint32_t copyBytes = (bytesPerVector < 16u) ? bytesPerVector : 16u;
+            if (vu1Data)
+                std::memcpy(vu1Data + destOff, srcVec, copyBytes);
+            continue;
+        }
+
+        const bool isV45 = (vl == 3u && vn == 3u);
+        // V2 repeats x/y into z/w. V3's fourth lane reads the next
+        // source element (the following vector's x), when present.
+        if (decoded && vn == 1u && vl <= 2u)
+        {
+            decompressed[2] = decompressed[0];
+            decompressed[3] = decompressed[1];
+        }
+        else if (decoded && vn == 2u && vl <= 2u)
+        {
+            decompressed[3] = sourceElement(3u);
+        }
+
+        const bool canAdd = !isV45;
+        const uint32_t mode = isV45 ? 0u : (p.mode & 3u);
+        const uint32_t colIdx = (cyclePos > 3u) ? 3u : cyclePos;
+        const uint32_t maskCycle = (cyclePos > 3u) ? 3u : cyclePos;
+
+        for (uint32_t field = 0u; field < 4u; ++field)
+        {
+            uint32_t maskSpec = 0u;
+            if (maskEnable)
+            {
+                const uint32_t shift = ((maskCycle * 4u) + field) * 2u;
+                maskSpec = (p.mask >> shift) & 0x3u;
+            }
+
+            uint32_t writeVal = lanes[field];
+            if (maskSpec == 0u)
+            {
+                if (handledFormat)
+                {
+                    writeVal = decompressed[field];
+                    if (canAdd && (mode == 1u || mode == 2u))
+                    {
+                        writeVal = writeVal + row[field];
+                        if (mode == 2u)
+                            row[field] = writeVal;
+                    }
+                    else if (canAdd && mode == 3u)
+                    {
+                        row[field] = writeVal;
+                    }
+                }
+            }
+            else if (maskSpec == 1u)
+            {
+                writeVal = row[field];
+            }
+            else if (maskSpec == 2u)
+            {
+                writeVal = p.col[colIdx];
+            }
+            else
+            {
+                continue; // write-protect
+            }
+
+            lanes[field] = writeVal;
+        }
+
+        if (vu1Data)
+            std::memcpy(vu1Data + destOff, lanes, sizeof(lanes));
+    }
+}
+
