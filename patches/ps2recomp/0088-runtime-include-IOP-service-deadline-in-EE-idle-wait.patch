From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Wed, 21 Oct 2026 15:40:40 +0200
Subject: [PATCH 88/97] runtime: include IOP service deadline in EE idle waits


diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index 9321ca1a811bc1e13c7a6db613986d176f1ea0d8..e7434d5c1e22ba6ce63f65d6a31322e9ea534a2c 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -206,6 +206,10 @@ void EeScheduler::run()
 {
     assertExecutor();
     m_running.store(true, std::memory_order_release);
+    static const bool includeIopServiceDeadline = [] {
+        const char *value = std::getenv("PS2X_EE_IOP_IDLE");
+        return !value || value[0] != '0' || value[1] != '\0';
+    }();
 
     while (!m_stopRequested.load(std::memory_order_acquire))
     {
@@ -223,7 +227,25 @@ void EeScheduler::run()
                 copyMainContextToRuntime();
                 publishIdleDebugContext();
                 publishSnapshot();
-                waitForEvent();
+                if (ps2HostConfig().wallClock && includeIopServiceDeadline)
+                {
+                    const uint64_t iopServiceCycles = m_runtime.m_iopSubsystem->eeCyclesUntilService();
+                    if (iopServiceCycles == 0u)
+                    {
+                        // Zero means the IOP cannot safely idle-skip. Sample the
+                        // wall clock in a short quantum so its runnable work can
+                        // advance even when no EE thread is ready.
+                        accountCycles(294912u);
+                    }
+                    else
+                    {
+                        waitForEvent(iopServiceCycles);
+                    }
+                }
+                else
+                {
+                    waitForEvent();
+                }
                 continue;
             }
             if (next)
