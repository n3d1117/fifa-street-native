+++ b/ps2xIOP/src/emulator/core/iop_cpu.cpp
@@ -31,13 +31,13 @@ namespace ps2x::iop::detail
 
     void IopCpuCore::raiseException(IopCpuState &cpu, uint32_t code, uint32_t faultPc, bool delaySlot, std::optional<uint32_t> badAddress) const
     {
-        static const char* trace = std::getenv("TARZAN_TRACE_FAULTS");
+        static const char* trace = std::getenv("PS2X_TRACE_FAULTS");
         if (trace && trace[0] == '1')
         {
             static unsigned logged = 0;
             if (logged++ < 16)
                 std::fprintf(stderr,
-                    "[tarzan-iop-exception] pc=%08x instruction=%08x code=%u delay=%d bad=%08x status=%08x cause=%08x sp=%08x ra=%08x a0=%08x a1=%08x gp=%08x\n",
+                    "[iop-exception] pc=%08x instruction=%08x code=%u delay=%d bad=%08x status=%08x cause=%08x sp=%08x ra=%08x a0=%08x a1=%08x gp=%08x\n",
                     faultPc, m_memory.read32(faultPc), code, delaySlot ? 1 : 0,
                     badAddress.value_or(0), cpu.cop0[12], cpu.cop0[13], cpu.gpr[29],
                     cpu.gpr[31], cpu.gpr[4], cpu.gpr[5], cpu.gpr[28]);
