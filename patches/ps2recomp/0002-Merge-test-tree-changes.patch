 class TestCase;
 using TestRunnerCallback = std::function<void(TestCase&)>;
@@ -120,8 +121,31 @@ public:
         m_beforeEach = fn;
     }
 
+    static bool MatchesFilter(const std::string &testName, const char *filter)
+    {
+        if (!filter || !*filter)
+            return true;
+
+        const std::string filterList(filter);
+        size_t start = 0;
+        while (start <= filterList.size())
+        {
+            const size_t comma = filterList.find(',', start);
+            const size_t end = comma == std::string::npos ? filterList.size() : comma;
+            const std::string token = filterList.substr(start, end - start);
+            if (!token.empty() && testName.find(token) != std::string::npos)
+                return true;
+            if (comma == std::string::npos)
+                break;
+            start = comma + 1;
+        }
+        return false;
+    }
+
     static int Run()
     {
+        const char *filter = std::getenv("MINITEST_FILTER");
+        const bool filterActive = filter && *filter;
         int failedCount = 0;
         int totalTests = 0;
 
@@ -144,6 +168,8 @@ public:
             {
                 const std::string& testName = cc.first;
                 const TestRunnerCallback& testFn = cc.second;
+                if (!MatchesFilter(testName, filter))
+                    continue;
 
                 totalTests++;
                 testCase.ClearFailures();
@@ -200,6 +226,12 @@ public:
             }
         }
 
+        if (filterActive && totalTests == 0)
+        {
+            std::cerr << "MINITEST_FILTER matched no test names: " << filter << std::endl;
+            failedCount++;
+        }
+
         std::cout << "\n========================================" << std::endl;
         std::cout << "Total Tests: " << totalTests << std::endl;
         std::cout << "Passed: " << (totalTests - failedCount) << std::endl;
