+    namespace
+    {
+        bool HasBranchDelaySlot(uint32_t w)
+        {
+            const uint32_t op = w >> 26;
+            if (op == 0u)
+            {
+                const uint32_t fn = w & 0x3Fu;
+                return fn == 0x08u || fn == 0x09u; // jr, jalr
+            }
+            if (op == 1u)
+                return true; // REGIMM branches
+            if (op == 0x10u || op == 0x11u || op == 0x12u || op == 0x13u)
+            {
+                const uint32_t rs = (w >> 21) & 0x1Fu;
+                return rs == 8u || rs == 9u; // COPz branches
+            }
+            return op == 2u || op == 3u || (op >= 4u && op <= 7u) || (op >= 0x14u && op <= 0x17u);
+        }
+    }
+
+    bool PS2Recompiler::IsBranchDelaySlotAddress(const std::function<bool(uint32_t, uint32_t &)> &readWord, uint32_t target)
+    {
+        uint32_t prev = 0u;
+        return target >= 4u && readWord(target - 4u, prev) && HasBranchDelaySlot(prev);
+    }
+
+    bool PS2Recompiler::IsPlausibleGuessedEntryStart(const std::function<bool(uint32_t, uint32_t &)> &readWord, uint32_t target)
+    {
+        const auto endsFunction = [](uint32_t w)
+        {
+            const uint32_t op = w >> 26;
+            if (op == 2u)
+                return true; // j
+            if (op == 0u)
+            {
+                const uint32_t fn = w & 0x3Fu;
+                return fn == 0x08u || fn == 0x0Du; // jr, break
+            }
+            // b label: beq $zero,$zero
+            return op == 4u && ((w >> 21) & 0x1Fu) == 0u && ((w >> 16) & 0x1Fu) == 0u;
+        };
+
+        uint32_t prev = 0u;
+        if (target < 4u || !readWord(target - 4u, prev))
+            return true; // start of code
+        if (HasBranchDelaySlot(prev))
+            return false; // target is a delay slot
+        uint32_t first = 0u;
+        if (readWord(target, first) && ((first >> 16) == 0x27BDu || (first >> 16) == 0x67BDu) && (first & 0x8000u) != 0u)
+            return true; // allocates a stack frame: a function start even after unreachable padding code
+        uint32_t addr = target - 4u;
+        uint32_t word = prev;
+        while (word == 0u && addr >= 4u) // alignment padding
+        {
+            addr -= 4u;
+            if (!readWord(addr, word))
+                return true;
+        }
+        if (word == 0u)
+            return true;
+        if (endsFunction(word))
+            return true; // padding followed the terminator's delay slot
+        uint32_t before = 0u;
+        return addr >= 4u && readWord(addr - 4u, before) && endsFunction(before);
+    }
