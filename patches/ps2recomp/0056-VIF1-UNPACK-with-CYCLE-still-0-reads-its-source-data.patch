@@ -792,6 +792,38 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
         // Track most-recent command for VIFn_CODE emulation.
         vif1_regs.code = cmd;
         vif1_regs.num = num;
+        {
+            // PS2X_TRACE_FAULTS=1: remember the last VIF1 codes so an ER1 can be explained.
+            static thread_local std::array<uint32_t, 24> recent{};
+            static thread_local size_t recentCount = 0;
+            recent[recentCount++ % recent.size()] = cmd;
+            static const bool trace = [] {
+                const char *value = std::getenv("PS2X_TRACE_FAULTS");
+                return value && std::strcmp(value, "1") == 0;
+            }();
+            const bool known = opcode == VIF_NOP || opcode == VIF_STCYCL || opcode == VIF_OFFSET || opcode == VIF_BASE ||
+                               opcode == VIF_ITOP || opcode == VIF_STMOD || opcode == VIF_MARK || opcode == VIF_FLUSHE ||
+                               opcode == VIF_FLUSH || opcode == VIF_FLUSHA || opcode == VIF_STMASK || opcode == VIF_STROW ||
+                               opcode == VIF_STCOL || opcode == VIF_MPG || opcode == VIF_DIRECT || opcode == VIF_DIRECTHL ||
+                               opcode == VIF_MSCAL || opcode == VIF_MSCNT || opcode == VIF_MSCALF || (opcode & 0x60u) == 0x60u ||
+                               opcode == VIF_MSKPATH3;
+            static std::atomic<uint32_t> reported{0u};
+            if (trace && !known && reported.fetch_add(1u) < 4u)
+            {
+                std::fprintf(stderr, "[vif1-er1] invalid code 0x%08x at byte %u of %u cycle=0x%04x mode=%u; previous codes (oldest first):", cmd, commandStart, sizeBytes, static_cast<unsigned>(vif1_regs.cycle), static_cast<unsigned>(vif1_regs.mode));
+                const size_t total = std::min(recentCount, recent.size());
+                for (size_t i = 0; i < total; ++i)
+                    std::fprintf(stderr, " %08x", recent[(recentCount - total + i) % recent.size()]);
+                std::fprintf(stderr, "\n[vif1-er1] bytes before:");
+                for (uint32_t b = commandStart >= 64u ? commandStart - 64u : 0u; b < commandStart; b += 4u)
+                {
+                    uint32_t word;
+                    std::memcpy(&word, data + b, 4);
+                    std::fprintf(stderr, " %08x", word);
+                }
+                std::fprintf(stderr, "\n");
+            }
+        }
         if (opcode == VIF_NOP)
         {
             if (stallVif1ForIrq(*this, irq, opcode, data + pos, sizeBytes - pos))
@@ -1038,6 +1070,9 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
