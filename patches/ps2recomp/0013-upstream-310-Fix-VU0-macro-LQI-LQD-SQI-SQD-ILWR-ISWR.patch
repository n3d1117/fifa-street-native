+    // Macro-mode LQI/LQD/SQI/SQD access VU0 data memory (4 KB, addressed in qwords by the VI register), not RDRAM.
+    // Encoding: LQI/LQD: ft = rt, is = rd. SQI/SQD: fs = rd, it = rt.
+    // VI0 is hard-wired to zero: its post-increment / pre-decrement is dropped (kept from our earlier local fix).
     std::string CodeGenerator::translateVU_VLQI(const Instruction &inst)
     {
-        const uint8_t vis = static_cast<uint8_t>((inst.raw >> 11) & 0xFu);
-        const uint8_t vft = static_cast<uint8_t>((inst.raw >> 16) & 0x1Fu);
-        uint8_t dest_mask = inst.vectorInfo.vectorField;
-        return fmt::format("{{ if ({} != 0) {{ uint32_t addr = PS2_VU0_DATA_BASE + (((uint32_t)ctx->vi[{}] << 4) & 0xFFF); "
-                           "__m128 res = _mm_castsi128_ps(READ128(addr)); "
+        const uint8_t vis = inst.rd;
+        const uint8_t vft = inst.rt;
+        const uint8_t dest_mask = inst.vectorInfo.vectorField;
