From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 16:52:41 +0200
Subject: [PATCH 06/65] upstream #277: Fix SQRT.S and RSQRT.S operand selection
 in the FPU translator


diff --git a/ps2xRecomp/src/lib/fpu_translator.cpp b/ps2xRecomp/src/lib/fpu_translator.cpp
index 6f2f1c9d425dd980e5884c28c3fb6874779c3eaa..67fcfd203c30cd8d87e5b0486901da3183218bb9 100644
--- a/ps2xRecomp/src/lib/fpu_translator.cpp
+++ b/ps2xRecomp/src/lib/fpu_translator.cpp
@@ -67,7 +67,7 @@ namespace ps2recomp
                     fs, ft, fd);
             case COP1_S_SQRT:
                 // R5900 SQRT.S reads Ft (not Fs) and takes sqrt(|Ft|); FPU_SQRT_S applies the PS2 float rules.
-                return fmt::format("ctx->f[{}] = FPU_SQRT_S(ctx->f[{}]);", fd, ft);
+                return fmt::format("ctx->f[{}] = FPU_SQRT_S(fabsf(ctx->f[{}]));", fd, ft);
             case COP1_S_ABS:
                 return fmt::format("ctx->f[{}] = FPU_ABS_S(ctx->f[{}]);", fd, fs);
             case COP1_S_MOV:
