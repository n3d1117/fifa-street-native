+        tc.Run("VCLIP uses integer comparisons with denormal bounds", [](TestCase &t)
+        {
+            const auto code = translate(0x100000u, cop2Special2(0, 2, 1, VU0_S2_VCLIPw));
+            t.IsTrue(contains(code, "ps2_vu0_clip(ctx->vu0_clip_flags, ctx->vu0_vf[1], ctx->vu0_vf[2])"), "CLIP must use PS2 bit comparisons: " + code);
+        });
+
+        tc.Run("CLIP excludes denormals and compares exponent 255 by bits", [](TestCase &t)
+        {
+            const __m128 zero = _mm_setzero_ps();
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(1u)), zero), 0u, "positive denormal vs zero has no +x");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(0x807fffffu)), zero), 0u, "negative denormal vs zero has no negative bits");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(0x00800000u)), _mm_set1_ps(runtimeBits(1u))), 0x15u, "minimum normal exceeds denormal bound");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(2.0f), _mm_set1_ps(-1.0f)), 0x15u, "hardware FULL POS x -1");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(-2.0f), _mm_set1_ps(-1.0f)), 0x2au, "hardware FULL NEG x -1");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(0x7fffffffu)), zero), 0x15u, "hardware MAX x zero");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(0xffffffffu)), zero), 0x2au, "hardware MIN x zero");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(runtimeBits(0x7fffffffu)), _mm_set1_ps(runtimeBits(0x7f800000u))), 0x15u, "exponent 255 compares mantissa");
+            t.Equals(ps2_vu0_clip(0, _mm_set1_ps(-0.0f), zero), 0u, "signed zeros do not clip");
+            t.Equals(ps2_vu0_clip(0xffffffffu, zero, zero), 0xffffc0u, "history shifts and retains 24 bits");
+        });
