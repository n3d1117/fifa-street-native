diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 51f281e9a9c9f0b6578c5be1adcf76bc9c5b4af6..2b7999e203e959181c00b0446298facffcbe9175 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -1477,6 +1477,18 @@ static inline void ps2_vu0_set_mac(R5900Context *ctx, __m128 result, uint32_t de
 }
 #define PS2_VU0_SET_MAC(ctx_ptr, result, dest, ...) ps2_vu0_set_mac((ctx_ptr), (result), (dest) __VA_OPT__(,) __VA_ARGS__)
 
+inline uint32_t ps2_vu0_clip(uint32_t history, __m128 fs, __m128 ft)
+{
+    const uint32_t w = static_cast<uint32_t>(PS2_EXTRACT_EPI32_3(_mm_castps_si128(ft)));
+    // A zero/denormal bound excludes every denormal Fs, including signed ones.
+    const __m128i bound = _mm_set1_epi32((w & 0x7f800000u) ? (w & 0x7fffffffu) : 0x007fffffu);
+    const __m128i bits = _mm_castps_si128(fs);
+    const uint32_t pos = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(bits, bound))));
+    const uint32_t neg = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(_mm_xor_si128(bits, _mm_set1_epi32(0x80000000u)), bound))));
+    const uint32_t flags = (pos & 1u) | ((neg & 1u) << 1) | ((pos & 2u) << 1) | ((neg & 2u) << 2) | ((pos & 4u) << 2) | ((neg & 4u) << 3);
+    return ((history << 6) | flags) & 0x00ffffffu;
+}
+
 enum class Ps2Vu0Fdiv { Div, Sqrt, Rsqrt };
 
 template <Ps2Vu0Fdiv Op>
