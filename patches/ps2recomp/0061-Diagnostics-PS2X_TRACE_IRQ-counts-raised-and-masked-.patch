From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 21:21:07 +0200
Subject: [PATCH 61/77] Diagnostics: PS2X_TRACE_IRQ counts raised and masked
 interrupts per cause each second


diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index 4741a3797b252b5696897f98a8d7b676f066223d..04d989533db638b828ed0d5560e0186d6af014b8 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -8,6 +8,7 @@
 #include "ps2_runtime_macros.h"
 
 #include <algorithm>
+#include <map>
 #include <atomic>
 #include <cassert>
 #include <cstdio>
@@ -1369,6 +1370,32 @@ void EeScheduler::dispatchIrq(bool dmac, uint32_t cause)
 {
     assertExecutor();
     const uint32_t mask = dmac ? m_enabledDmacMask : m_enabledIntcMask;
+    {
+        // PS2X_TRACE_IRQ=1: once a second, how many interrupts of each cause were raised and delivered.
+        static const bool trace = [] {
+            const char *value = std::getenv("PS2X_TRACE_IRQ");
+            return value && value[0] == '1';
+        }();
+        if (trace)
+        {
+            static std::map<uint32_t, std::pair<uint32_t, uint32_t>> counts; // key: dmac<<8|cause -> raised, masked
+            static auto last = std::chrono::steady_clock::now();
+            auto &entry = counts[(dmac ? 0x100u : 0u) | cause];
+            ++entry.first;
+            if (cause < 32u && (mask & (1u << cause)) == 0u)
+                ++entry.second;
+            const auto now = std::chrono::steady_clock::now();
+            if (now - last >= std::chrono::seconds(1))
+            {
+                last = now;
+                std::fprintf(stderr, "[irq] 1s:");
+                for (auto &[key, value] : counts)
+                    std::fprintf(stderr, " %s%u=%u(masked %u)", (key & 0x100u) ? "dmac" : "intc", key & 0xFFu, value.first, value.second);
+                std::fprintf(stderr, "\n");
+                counts.clear();
+            }
+        }
+    }
     if (cause < 32u && (mask & (1u << cause)) == 0u)
     {
         return;
