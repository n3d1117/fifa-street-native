From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 19:34:57 +0200
Subject: [PATCH 051/106] Runtime: ps2KernelStackArena derives the
 callback/interrupt stack range below the lowest PT_LOAD (never on the game
 stack or heap); test


diff --git a/ps2xRuntime/include/runtime/ps2_host_arena.h b/ps2xRuntime/include/runtime/ps2_host_arena.h
index f57518f1c9bd234cb400658c033c9eb9d030dc47..fff1e838d06ae99ef23491a7e14273dfb0240c60 100644
--- a/ps2xRuntime/include/runtime/ps2_host_arena.h
+++ b/ps2xRuntime/include/runtime/ps2_host_arena.h
@@ -1,6 +1,9 @@
 #pragma once
 
+#include <algorithm>
 #include <cstdint>
+#include <utility>
+#include <vector>
 
 // Configure guest-RAM ranges reserved for runtime-owned heap allocations and asynchronous callback stacks.
 // The caller must set this before loadELF() and ensure neither range overlaps any guest ELF PT_LOAD segment.
@@ -24,3 +27,32 @@ struct PS2HostConfig
 };
 void ps2SetHostConfig(const PS2HostConfig &config);
 const PS2HostConfig &ps2HostConfig();
+
+// Kernel-side stacks for guest callbacks and interrupts: the highest 256 KiB (at least 64 KiB) of RDRAM
+// below the lowest load segment and above the 0x80000 kernel-reserved floor, where no game ELF places
+// data. Segments are half-open [begin, end). Returns false when no such range exists or any segment
+// overlaps it; otherwise floor/top are 16-byte aligned and ready for ps2SetRuntimeArena(0, 0, floor, top).
+inline bool ps2KernelStackArena(const std::vector<std::pair<uint32_t, uint32_t>> &loadSegments,
+                                uint32_t &floor, uint32_t &top)
+{
+    constexpr uint32_t kReservedFloor = 0x00080000u;
+    constexpr uint32_t kMaxSize = 0x00040000u;
+    constexpr uint32_t kMinSize = 0x00010000u;
+    if (loadSegments.empty())
+        return false;
+    uint32_t lowest = 0xFFFFFFFFu;
+    for (const auto &segment : loadSegments)
+        lowest = std::min(lowest, segment.first);
+    const uint32_t newTop = lowest & ~0xFu;
+    if (newTop < kReservedFloor + kMinSize)
+        return false;
+    const uint32_t newFloor = std::max(kReservedFloor, newTop - kMaxSize);
+    for (const auto &segment : loadSegments)
+    {
+        if (segment.second > newFloor && segment.first < newTop)
+            return false;
+    }
+    floor = newFloor;
+    top = newTop;
+    return true;
+}
diff --git a/ps2xTest/src/ps2_runtime_kernel_tests.cpp b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
index 10bf4e397e8d00508c42c02f8984b4f1405829ca..5178d9dfb863dacfd36e88060cbe51b0642f0d96 100644
--- a/ps2xTest/src/ps2_runtime_kernel_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
@@ -1264,6 +1264,22 @@ void register_ps2_runtime_kernel_tests()
             std::filesystem::remove_all(root, removeError);
         });
 
+        tc.Run("kernel stack arena sits below every load segment and clear of the game stack and heap", [](TestCase &t)
+        {
+            uint32_t floor = 0u, top = 0u;
+            // FIFA Street: one PT_LOAD 0x100000..0x57E900, SetupThread stack 0x1FF0000..0x2000000, heap 0x57E900..
+            t.IsTrue(ps2KernelStackArena({{0x00100000u, 0x0057E900u}}, floor, top), "arena exists below the ELF");
+            t.Equals(top, 0x00100000u, "arena ends at the lowest load address");
+            t.Equals(floor, 0x000C0000u, "arena is 256 KiB");
+            t.IsTrue(top <= 0x00100000u && floor >= 0x00080000u, "arena avoids the ELF and the kernel-reserved floor");
+            t.IsTrue(top <= 0x0057E900u && top <= 0x01FF0000u, "arena is clear of the game heap and stack");
+
+            t.IsTrue(!ps2KernelStackArena({{0x00084000u, 0x00200000u}}, floor, top), "too little room below the ELF is refused");
+            t.IsTrue(!ps2KernelStackArena({}, floor, top), "no segments is refused");
+            t.IsTrue(ps2KernelStackArena({{0x00300000u, 0x00400000u}, {0x00100000u, 0x00200000u}}, floor, top) && top == 0x00100000u,
+                     "the lowest of several segments bounds the arena");
+        });
+
         tc.Run("setup heap and thread invalid ids use documented kernel errors", [](TestCase &t)
         {
             TestEnv env;
