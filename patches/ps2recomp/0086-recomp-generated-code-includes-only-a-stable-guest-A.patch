-// PSLLVW/PSRLVW/PSRAVW: shift rt's word 0 and word 2 by the low 5 bits of rs's word 0 and
-// word 2; each 32-bit result is sign-extended into its 64-bit doubleword (PCSX2 MMI.cpp).
-inline __m128i ps2_mmi_var_shift_w(__m128i rs, __m128i rt, int kind)
-{
-    alignas(16) uint32_t s[4];
-    alignas(16) uint32_t t[4];
-    alignas(16) int64_t r[2];
-    _mm_store_si128(reinterpret_cast<__m128i *>(s), rs);
-    _mm_store_si128(reinterpret_cast<__m128i *>(t), rt);
-    for (int i = 0; i < 2; i++)
-    {
-        const uint32_t sh = s[i * 2] & 0x1F;
-        const uint32_t v = t[i * 2];
-        int32_t out;
-        if (kind == 0)
-            out = static_cast<int32_t>(v << sh);
-        else if (kind == 1)
-            out = static_cast<int32_t>(v >> sh);
-        else
-            out = static_cast<int32_t>(v) >> sh;
-        r[i] = out;
-    }
-    return _mm_load_si128(reinterpret_cast<const __m128i *>(r));
-}
-inline __m128i _mm_custom_sllv_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 0); }
-inline __m128i _mm_custom_srlv_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 1); }
-inline __m128i _mm_custom_srav_epi32(__m128i rs, __m128i rt) { return ps2_mmi_var_shift_w(rs, rt, 2); }
