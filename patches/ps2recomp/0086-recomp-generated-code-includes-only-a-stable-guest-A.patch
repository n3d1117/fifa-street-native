-#define PS2_VSUB(a, b) ps2_vsub((__m128)(a), (__m128)(b))
-#define PS2_VMUL(a, b) ps2_vmul((__m128)(a), (__m128)(b))
-#define PS2_VDIV(a, b) _mm_div_ps((__m128)(a), (__m128)(b))
