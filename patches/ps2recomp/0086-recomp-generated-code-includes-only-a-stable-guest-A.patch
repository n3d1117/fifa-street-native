+            hiOut[lane] = ps2_mmi_sext32(dividend);
+        }
+    }
+    ctx->lo = loOut[0];
+    ctx->hi = hiOut[0];
+    ctx->lo1 = loOut[1];
+    ctx->hi1 = hiOut[1];
+}
