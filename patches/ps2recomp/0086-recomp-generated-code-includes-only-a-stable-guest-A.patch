-inline __m128i ps2_ppach(__m128i rs, __m128i rt)
-{
-    const __m128i mask = _mm_setr_epi8(
-        0, 1, 4, 5, 8, 9, 12, 13,  // from rt: halfwords 0,2,4,6
-        0, 1, 4, 5, 8, 9, 12, 13); // from rs: halfwords 0,2,4,6
