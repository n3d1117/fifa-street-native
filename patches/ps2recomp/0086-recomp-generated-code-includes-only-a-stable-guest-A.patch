+// 128-bit accesses are LQ, SQ, LQC2 and SQC2. The EE ignores the low four bits of their effective
+// address (PCSX2's interpreter and recompiler mask them the same way), so neither macro can touch
+// a misaligned quadword.
+#define PS2_QWORD_ADDR(addr) ((uint32_t)(addr) & ~0xFu)
+
+#define READ128(addr) ([&]() -> __m128i {                     \
+    uint32_t _addr = PS2_QWORD_ADDR(addr);                    \
+    return Ps2IsSpecialAddress(_addr)                \
+        ? ps2GuestLoad128(runtime, rdram, ctx, _addr)                 \
+        : FAST_READ128(_addr); }())
+
+#define WRITE8(addr, val)                                                            \
+    do                                                                               \
+    {                                                                                \
+        uint32_t _addr = (addr);                                                     \
+        if (Ps2IsSpecialAddress(_addr))                                     \
+            ps2GuestStore8(runtime, rdram, ctx, _addr, (val));                               \
+        else                                                                         \
+        {                                                                            \
+            ps2TraceGuestWrite(rdram, _addr, 1u, (uint8_t)(val), 0u, "WRITE8", ctx); \
+            FAST_WRITE8(_addr, (val));                                               \
+        }                                                                            \
+    } while (0)
+
+#define WRITE16(addr, val)                                                             \
+    do                                                                                 \
+    {                                                                                  \
+        uint32_t _addr = (addr);                                                       \
+        if (Ps2IsSpecialAddress(_addr))                                       \
+            ps2GuestStore16(runtime, rdram, ctx, _addr, (val));                                \
+        else                                                                           \
+        {                                                                              \
+            ps2TraceGuestWrite(rdram, _addr, 2u, (uint16_t)(val), 0u, "WRITE16", ctx); \
+            FAST_WRITE16(_addr, (val));                                                \
+        }                                                                              \
+    } while (0)
+
+#define WRITE32(addr, val)                                                             \
+    do                                                                                 \
+    {                                                                                  \
+        uint32_t _addr = (addr);                                                       \
+        if (Ps2IsSpecialAddress(_addr))                                       \
+            ps2GuestStore32(runtime, rdram, ctx, _addr, (val));                                \
+        else                                                                           \
+        {                                                                              \
+            ps2TraceGuestWrite(rdram, _addr, 4u, (uint32_t)(val), 0u, "WRITE32", ctx); \
+            FAST_WRITE32(_addr, (val));                                                \
+        }                                                                              \
+    } while (0)
+
+#define WRITE64(addr, val)                                                             \
+    do                                                                                 \
+    {                                                                                  \
+        uint32_t _addr = (addr);                                                       \
+        if (Ps2IsSpecialAddress(_addr))                                       \
+            ps2GuestStore64(runtime, rdram, ctx, _addr, (val));                                \
+        else                                                                           \
+        {                                                                              \
+            ps2TraceGuestWrite(rdram, _addr, 8u, (uint64_t)(val), 0u, "WRITE64", ctx); \
