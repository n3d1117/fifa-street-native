-// Packed Absolute (PABS)
-#define PS2_PABSW(a) _mm_abs_epi32((__m128i)(a))
-#define PS2_PABSH(a) _mm_abs_epi16((__m128i)(a))
-#define PS2_PABSB(a) _mm_abs_epi8((__m128i)(a))
