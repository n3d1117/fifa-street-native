+#define READ8(addr) ([&]() -> uint8_t {                       \
+    uint32_t _addr = (uint32_t)(addr);                        \
+    return Ps2IsSpecialAddress(_addr)                \
+        ? ps2GuestLoad8(runtime, rdram, ctx, _addr)                   \
+        : FAST_READ8(_addr); }())
+
+#define READ16(addr) ([&]() -> uint16_t {                     \
+    uint32_t _addr = (uint32_t)(addr);                        \
+    return Ps2IsSpecialAddress(_addr)                \
+        ? ps2GuestLoad16(runtime, rdram, ctx, _addr)                  \
+        : FAST_READ16(_addr); }())
+
+#define READ32(addr) ([&]() -> uint32_t {                     \
+    uint32_t _addr = (uint32_t)(addr);                        \
+    return Ps2IsSpecialAddress(_addr)                \
+        ? ps2GuestLoad32(runtime, rdram, ctx, _addr)                  \
+        : FAST_READ32(_addr); }())
