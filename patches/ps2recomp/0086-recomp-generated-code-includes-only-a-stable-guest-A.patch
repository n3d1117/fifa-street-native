-inline __m128i ps2_ppacw(__m128i rs, __m128i rt)
-{
-    // rs = [rs3 rs2 rs1 rs0], rt = [rt3 rt2 rt1 rt0]
-    return _mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(rt), _mm_castsi128_ps(rs), _MM_SHUFFLE(2, 0, 2, 0)));
