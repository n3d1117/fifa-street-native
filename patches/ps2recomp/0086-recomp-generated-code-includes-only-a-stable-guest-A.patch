+// QFSRV: Quadword Funnel Shift Right Variable
+// Concatenates rs || rt (256 bits) and right-shifts by SA bits, taking lower 128 bits.
+inline __m128i ps2_qfsrv(__m128i rs, __m128i rt, uint32_t sa)
+{
+    if (sa == 0)
+        return rt;
+    if (sa >= 128)
+    {
+        if (sa >= 256)
+            return _mm_setzero_si128();
+        uint32_t shift = sa - 128;
+        if (shift == 0)
+            return rs;
+        // Shift rs right by (sa-128) bits
+        uint32_t byteShift = shift / 8;
+        uint32_t bitShift = shift % 8;
+        // Byte shift rs right
+        alignas(16) uint8_t buf[16] = {};
+        alignas(16) uint8_t src[16];
+        _mm_store_si128((__m128i *)src, rs);
+        for (uint32_t i = 0; i + byteShift < 16; i++)
+            buf[i] = src[i + byteShift];
+        __m128i result = _mm_load_si128((__m128i *)buf);
+        if (bitShift > 0)
+            result = _mm_or_si128(_mm_srli_epi64(result, bitShift),
+                                  _mm_slli_epi64(_mm_bsrli_si128(result, 8), 64 - bitShift));
+        return result;
+    }
+    // sa is 1..127: result = (rs || rt) >> sa, lower 128 bits
+    uint32_t byteShift = sa / 8;
+    uint32_t bitShift = sa % 8;
+    alignas(16) uint8_t combined[32];
+    _mm_store_si128((__m128i *)(combined), rt);      // low 128 bits
+    _mm_store_si128((__m128i *)(combined + 16), rs); // high 128 bits
+    // Shift right by byteShift bytes
+    alignas(16) uint8_t shifted[16];
+    for (uint32_t i = 0; i < 16; i++)
+        shifted[i] = (i + byteShift < 32) ? combined[i + byteShift] : 0;
+    __m128i result = _mm_load_si128((__m128i *)shifted);
+    if (bitShift > 0)
+    {
+        uint8_t extra = (byteShift + 16 < 32) ? combined[byteShift + 16] : 0;
+        __m128i hi_byte = _mm_insert_epi8(_mm_setzero_si128(), extra, 15);
+        alignas(16) uint8_t src32[32];
+        for (uint32_t i = 0; i < 32; i++)
+            src32[i] = combined[i];
+        uint64_t lo0, lo1, hi0, hi1;
+        std::memcpy(&lo0, src32, 8);
+        std::memcpy(&lo1, src32 + 8, 8);
+        std::memcpy(&hi0, src32 + 16, 8);
+        std::memcpy(&hi1, src32 + 24, 8);
+        // 256-bit right shift by sa bits
+        uint64_t r0, r1;
+        if (sa < 64)
+        {
+            r0 = (lo0 >> sa) | (lo1 << (64 - sa));
+            r1 = (lo1 >> sa) | (hi0 << (64 - sa));
+        }
+        else if (sa < 128)
+        {
+            uint32_t s = sa - 64;
+            if (s == 0)
+            {
+                r0 = lo1;
+                r1 = hi0;
+            }
+            else
+            {
+                r0 = (lo1 >> s) | (hi0 << (64 - s));
+                r1 = (hi0 >> s) | (hi1 << (64 - s));
+            }
+        }
+        else
+        {
+            r0 = 0;
+            r1 = 0; // handled above
+        }
+        result = _mm_set_epi64x((long long)r1, (long long)r0);
+    }
+    return result;
+}
+#define PS2_QFSRV(rs, rt, sa) ps2_qfsrv((__m128i)(rs), (__m128i)(rt), (uint32_t)(sa))
+#define PS2_PCPYLD(rs, rt) _mm_unpacklo_epi64(rt, rs)
+// MMI permutations, per the EE Core Instruction Set Manual. The halfword forms
+// act on each 64-bit doubleword independently.
+#define PS2_PEXEH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(3, 0, 1, 2)), _MM_SHUFFLE(3, 0, 1, 2)) // h0<->h2
+#define PS2_PEXCH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0)) // h1<->h2
+#define PS2_PREVH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(0, 1, 2, 3)), _MM_SHUFFLE(0, 1, 2, 3)) // h3,h2,h1,h0
+#define PS2_PEXEW(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 0, 1, 2))  // w0<->w2
+#define PS2_PEXCW(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 1, 2, 0))  // w1<->w2
+#define PS2_PROT3W(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 0, 2, 1)) // w0,w1,w2 <- w1,w2,w0; w3 kept
+
+inline uint32_t ps2_vu0_lane_bits(uint32_t mask)
+{
+    return ((mask & 1u) << 3) | ((mask & 2u) << 1) | ((mask & 4u) >> 1) | ((mask & 8u) >> 3);
+}
+
+// FMAC flushes tiny results before the register write. Retain U in a local value;
+// two nonzero operands can produce zero only by cancellation or underflow.
+template <Ps2VecOp Op>
+inline __m128 ps2_vu0_arith(uint32_t &underflow, __m128 a, __m128 b)
+{
+    __m128 result;
+    if constexpr (Op == Ps2VecOp::Add)
+        result = ps2_vadd(a, b);
+    else if constexpr (Op == Ps2VecOp::Sub)
+        result = ps2_vsub(a, b);
+    else
+        result = ps2_vmul(a, b);
+    const __m128i expMask = _mm_set1_epi32(0x7f800000);
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i ai = _mm_castps_si128(a), bi = _mm_castps_si128(b);
+    const __m128i az = _mm_cmpeq_epi32(_mm_and_si128(ai, expMask), zero);
+    const __m128i bz = _mm_cmpeq_epi32(_mm_and_si128(bi, expMask), zero);
+    __m128i excluded = _mm_or_si128(az, bz);
+    if constexpr (Op != Ps2VecOp::Mul)
+    {
+        const __m128i magnitude = _mm_set1_epi32(0x7fffffff);
+        excluded = _mm_or_si128(excluded, _mm_cmpeq_epi32(_mm_and_si128(ai, magnitude), _mm_and_si128(bi, magnitude)));
+    }
+    const __m128i rz = _mm_cmpeq_epi32(_mm_and_si128(_mm_castps_si128(result), expMask), zero);
+    uint32_t tiny = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_andnot_si128(excluded, rz))));
+    if constexpr (Op != Ps2VecOp::Mul)
+        tiny |= underflow & static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(rz)));
+    underflow = tiny;
+    return result;
+}
+
+static inline void ps2_vu0_set_mac(R5900Context *ctx, __m128 result, uint32_t dest, uint32_t underflow = 0)
+{
+    const __m128i bits = _mm_castps_si128(result);
+    const __m128i magnitude = _mm_and_si128(bits, _mm_set1_epi32(0x7fffffff));
+    const __m128i exp = _mm_and_si128(bits, _mm_set1_epi32(0x7f800000));
+    const __m128i zeroExp = _mm_cmpeq_epi32(exp, _mm_setzero_si128());
+    const uint32_t z = ps2_vu0_lane_bits(_mm_movemask_ps(_mm_castsi128_ps(zeroExp))) & dest;
+    const uint32_t s = ps2_vu0_lane_bits(_mm_movemask_ps(result)) & dest;
+    const __m128i denormal = _mm_andnot_si128(_mm_cmpeq_epi32(magnitude, _mm_setzero_si128()), zeroExp);
+    const uint32_t u = ps2_vu0_lane_bits(underflow | _mm_movemask_ps(_mm_castsi128_ps(denormal))) & dest;
+    const uint32_t o = ps2_vu0_lane_bits(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exp, _mm_set1_epi32(0x7f800000))))) & dest;
+    ctx->vu0_mac_flags = z | (s << 4) | (u << 8) | (o << 12);
+    const uint32_t flags = (z != 0) | ((s != 0) << 1) | ((u != 0) << 2) | ((o != 0) << 3);
+    ctx->vu0_status = static_cast<uint16_t>((ctx->vu0_status & ~0x0fu) | flags | (flags << 6));
+}
+#define PS2_VU0_SET_MAC(ctx_ptr, result, dest, ...) ps2_vu0_set_mac((ctx_ptr), (result), (dest) __VA_OPT__(,) __VA_ARGS__)
+
+inline uint32_t ps2_vu0_clip(uint32_t history, __m128 fs, __m128 ft)
+{
+    const uint32_t w = static_cast<uint32_t>(PS2_EXTRACT_EPI32_3(_mm_castps_si128(ft)));
+    // A zero/denormal bound excludes every denormal Fs, including signed ones.
+    const __m128i bound = _mm_set1_epi32((w & 0x7f800000u) ? (w & 0x7fffffffu) : 0x007fffffu);
+    const __m128i bits = _mm_castps_si128(fs);
+    const uint32_t pos = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(bits, bound))));
+    const uint32_t neg = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(_mm_xor_si128(bits, _mm_set1_epi32(0x80000000u)), bound))));
+    const uint32_t flags = (pos & 1u) | ((neg & 1u) << 1) | ((pos & 2u) << 1) | ((neg & 2u) << 2) | ((pos & 4u) << 2) | ((neg & 4u) << 3);
+    return ((history << 6) | flags) & 0x00ffffffu;
+}
+
+enum class Ps2Vu0Fdiv { Div, Sqrt, Rsqrt };
+
+template <Ps2Vu0Fdiv Op>
+inline uint16_t ps2_vu0_fdiv_status(uint16_t status, float fs, float ft)
+{
+    const uint32_t s = std::bit_cast<uint32_t>(fs);
+    const uint32_t t = std::bit_cast<uint32_t>(ft);
+    const bool sz = (s & 0x7f800000u) == 0;
+    const bool tz = (t & 0x7f800000u) == 0;
+    uint32_t flags;
+    if constexpr (Op == Ps2Vu0Fdiv::Div)
+        flags = tz ? (sz ? 0x10u : 0x20u) : 0u;
+    else if constexpr (Op == Ps2Vu0Fdiv::Sqrt)
+        flags = (!tz && (t >> 31)) ? 0x10u : 0u;
+    else
+        flags = tz ? (0x20u | (sz ? 0x10u : 0u)) : ((t >> 31) ? 0x10u : 0u);
+    return static_cast<uint16_t>((status & ~0x30u) | flags | (flags << 6));
+}
