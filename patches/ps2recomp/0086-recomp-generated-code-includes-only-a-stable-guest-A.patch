-static inline void ps2_vu0_set_mac(R5900Context *ctx, __m128 result, uint32_t dest, uint32_t underflow = 0)
-{
-    const __m128i bits = _mm_castps_si128(result);
-    const __m128i magnitude = _mm_and_si128(bits, _mm_set1_epi32(0x7fffffff));
-    const __m128i exp = _mm_and_si128(bits, _mm_set1_epi32(0x7f800000));
-    const __m128i zeroExp = _mm_cmpeq_epi32(exp, _mm_setzero_si128());
-    const uint32_t z = ps2_vu0_lane_bits(_mm_movemask_ps(_mm_castsi128_ps(zeroExp))) & dest;
-    const uint32_t s = ps2_vu0_lane_bits(_mm_movemask_ps(result)) & dest;
-    const __m128i denormal = _mm_andnot_si128(_mm_cmpeq_epi32(magnitude, _mm_setzero_si128()), zeroExp);
-    const uint32_t u = ps2_vu0_lane_bits(underflow | _mm_movemask_ps(_mm_castsi128_ps(denormal))) & dest;
-    const uint32_t o = ps2_vu0_lane_bits(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(exp, _mm_set1_epi32(0x7f800000))))) & dest;
-    ctx->vu0_mac_flags = z | (s << 4) | (u << 8) | (o << 12);
-    const uint32_t flags = (z != 0) | ((s != 0) << 1) | ((u != 0) << 2) | ((o != 0) << 3);
-    ctx->vu0_status = static_cast<uint16_t>((ctx->vu0_status & ~0x0fu) | flags | (flags << 6));
-}
-#define PS2_VU0_SET_MAC(ctx_ptr, result, dest, ...) ps2_vu0_set_mac((ctx_ptr), (result), (dest) __VA_OPT__(,) __VA_ARGS__)
