-// FMAC flushes tiny results before the register write. Retain U in a local value;
-// two nonzero operands can produce zero only by cancellation or underflow.
-template <Ps2VecOp Op>
-inline __m128 ps2_vu0_arith(uint32_t &underflow, __m128 a, __m128 b)
-{
-    __m128 result;
-    if constexpr (Op == Ps2VecOp::Add)
-        result = ps2_vadd(a, b);
-    else if constexpr (Op == Ps2VecOp::Sub)
-        result = ps2_vsub(a, b);
-    else
-        result = ps2_vmul(a, b);
-    const __m128i expMask = _mm_set1_epi32(0x7f800000);
-    const __m128i zero = _mm_setzero_si128();
-    const __m128i ai = _mm_castps_si128(a), bi = _mm_castps_si128(b);
-    const __m128i az = _mm_cmpeq_epi32(_mm_and_si128(ai, expMask), zero);
-    const __m128i bz = _mm_cmpeq_epi32(_mm_and_si128(bi, expMask), zero);
-    __m128i excluded = _mm_or_si128(az, bz);
-    if constexpr (Op != Ps2VecOp::Mul)
-    {
-        const __m128i magnitude = _mm_set1_epi32(0x7fffffff);
-        excluded = _mm_or_si128(excluded, _mm_cmpeq_epi32(_mm_and_si128(ai, magnitude), _mm_and_si128(bi, magnitude)));
-    }
-    const __m128i rz = _mm_cmpeq_epi32(_mm_and_si128(_mm_castps_si128(result), expMask), zero);
-    uint32_t tiny = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_andnot_si128(excluded, rz))));
-    if constexpr (Op != Ps2VecOp::Mul)
-        tiny |= underflow & static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(rz)));
-    underflow = tiny;
-    return result;
-}
