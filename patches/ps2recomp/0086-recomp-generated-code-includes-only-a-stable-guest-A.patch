-    ctx->hi = (ctx->hi & 0xFFFFFFFF00000000ULL) | ps2_mmi_word_u32(rs, 1);
-    ctx->lo1 = (ctx->lo1 & 0xFFFFFFFF00000000ULL) | ps2_mmi_word_u32(rs, 2);
-    ctx->hi1 = (ctx->hi1 & 0xFFFFFFFF00000000ULL) | ps2_mmi_word_u32(rs, 3);
