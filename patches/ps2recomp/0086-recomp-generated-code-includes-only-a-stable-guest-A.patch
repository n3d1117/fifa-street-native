+#define READ64(addr) ([&]() -> uint64_t {                     \
+    uint32_t _addr = (uint32_t)(addr);                        \
+    return Ps2IsSpecialAddress(_addr)                \
+        ? ps2GuestLoad64(runtime, rdram, ctx, _addr)                  \
+        : FAST_READ64(_addr); }())
