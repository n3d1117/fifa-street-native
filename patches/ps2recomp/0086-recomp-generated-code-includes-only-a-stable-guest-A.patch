diff --git a/ps2xRuntime/include/ps2_guest_abi.h b/ps2xRuntime/include/ps2_guest_abi.h
new file mode 100644
index 0000000000000000000000000000000000000000..493760ac1a572a7b3e0fd069de38de1484634417
--- /dev/null
+++ b/ps2xRuntime/include/ps2_guest_abi.h
@@ -0,0 +1,266 @@
+#ifndef PS2_GUEST_ABI_H
+#define PS2_GUEST_ABI_H
+
+// The only runtime interface generated code may include (with ps2_guest_macros.h and the generated
+// declaration headers). Keep it small and stable: an edit here recompiles every generated unit, an edit
+// to ps2_runtime.h or any other runtime header does not.
+//
+// PS2Runtime is opaque to generated code: it is passed along and handed to the entry points below.
+
+#include <cstdint>
+#include <cstring>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(USE_SSE2NEON)
+#include "sse2neon.h"
+#else
+#include <immintrin.h> // For SSE/AVX instructions
+#include <smmintrin.h> // For SSE4.1 instructions
+#endif
+
+#include "runtime/ps2_address.h"
+
+class PS2Runtime;
+
+enum PS2Exception
+{
+    EXCEPTION_TLB_REFILL = 0x02,          // TLB refill/load exception
+    EXCEPTION_ADDRESS_ERROR_LOAD = 0x04,  // Address error on load
+    EXCEPTION_ADDRESS_ERROR_STORE = 0x05, // Address error on store
+    EXCEPTION_SYSCALL = 0x08,             // SYSCALL instruction
+    EXCEPTION_BREAKPOINT = 0x09,          // BREAK instruction
+    EXCEPTION_RESERVED_INSTRUCTION = 0x0A,
+    EXCEPTION_INTEGER_OVERFLOW = 0x0C, // From MIPS spec
+    EXCEPTION_TRAP = 0x0D,             // Trap instruction condition met
+};
+
+// PS2 CPU context (R5900)
+struct alignas(16) R5900Context
+{
+    // General Purpose Registers (128-bit)
+    __m128i r[32]; // Main registers
+
+    // Control registers
+    uint32_t pc;         // Program counter
+    uint64_t insn_count; // Instruction counter
+    uint64_t hi, lo;     // HI/LO registers for mult/div results
+    uint64_t hi1, lo1;   // Secondary HI/LO registers for MULT1/DIV1
+    uint32_t sa;         // Shift amount register
+
+    // VU0 registers (when used in macro mode)
+    __m128 vu0_vf[32];        // VU0 vector float registers
+    uint16_t vi[16];          // VU0 vector integer registers
+    float vu0_q;              // VU0 Q register (quotient)
+    float vu0_p;              // VU0 P register (EFU result)
+    float vu0_i;              // VU0 I register (integer value)
+    __m128 vu0_r;             // VU0 R register
+    __m128 vu0_acc;           // VU0 ACC accumulator register
+    uint16_t vu0_status;      // VU0 status register
+    uint32_t vu0_mac_flags;   // VU0 MAC flags
+    uint32_t vu0_clip_flags;  // VU0 clipping flags
+    uint32_t vu0_clip_flags2; // VU0 clipping flags
+    uint32_t vu0_cmsar0;      // VU0 microprogram start address
+    uint32_t vu0_cmsar1;      // VU0 microprogram start address
+    uint32_t vu0_cmsar2;      // VU0 microprogram start address
+    uint32_t vu0_cmsar3;      // VU0 microprogram start address
+    uint32_t vu0_vpu_stat;
+    uint32_t vu0_vpu_stat2; // extra VPU status (used by CR_VPU_STAT2)
+    uint32_t vu0_vpu_stat3; // extra VPU status 3
+    uint32_t vu0_vpu_stat4; // extra VPU status 4
+    uint32_t vu0_tpc;       // TPC (VU0 PC)
+    uint32_t vu0_tpc2;      // second TPC
+    uint32_t vu0_fbrst;     // VIF/VU reset register
+    uint32_t vu0_fbrst2;    // FBRST2
+    uint32_t vu0_fbrst3;    // FBRST3
+    uint32_t vu0_fbrst4;    // FBRST4
+    uint32_t vu0_itop;
+    uint32_t vu0_top;
+    uint32_t vu0_info;
+    uint32_t vu0_xitop; // VU0 XITOP - input ITOP for VIF/VU sync
+    uint32_t vu0_pc;
+
+    float vu0_cf[4]; // VU0 FMAC control floating-point registers
+
+    // COP0 System control registers
+    uint32_t cop0_index;
+    uint32_t cop0_random;
+    uint32_t cop0_entrylo0;
+    uint32_t cop0_entrylo1;
+    uint32_t cop0_context;
+    uint32_t cop0_pagemask;
+    uint32_t cop0_wired;
+    uint32_t cop0_badvaddr;
+    uint32_t cop0_count;
+    uint32_t cop0_entryhi;
+    uint32_t cop0_compare;
+    uint32_t cop0_status;
+    uint32_t cop0_cause;
+    uint32_t cop0_epc;
+    uint32_t cop0_prid;
+    uint32_t cop0_config;
+    uint32_t cop0_badpaddr;
+    uint32_t cop0_debug;
+    uint32_t cop0_perf;
+    uint32_t cop0_taglo;
+    uint32_t cop0_taghi;
+    uint32_t cop0_errorepc;
+
+    // LL/SC reservation state (not part of COP0 Status bits).
+    uint32_t llbit;
+    uint32_t lladdr;
+
+    // Delay slot state tracking
+    bool in_delay_slot;
+    uint32_t branch_pc;
+
+    // COP2 control registers (VU0 integer + control)
+    uint32_t cop2_ccr[32];
+
+    // FPU registers (COP1)
+    float f[32];
+    float f_acc;    // FPU accumulator
+    uint32_t fcr31; // Control/status register
+
+    R5900Context()
+    {
+        std::memset(this, 0, sizeof(*this));
+
+        // Initialize VU0 registers. vf0 is hardwired to (0, 0, 0, 1) on the VU; thread and
+        // interrupt contexts are built from this constructor, and VU0 code reads vf0.w (a
+        // vrsqrt with fs = vf0.w in a fresh context must compute 1/sqrt(ft), not 0/sqrt(ft)).
+        vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+        vu0_q = 1.0f; // Q register usually initialized to 1.0
+
+        // Reset COP0 registers
+        cop0_random = 47; // Start at maximum value
+        // Status as the EE kernel leaves it at handoff. IE (bit 0) and EIE
+        // (bit 16) are separate enables and guest code reads both; libkernel's
+        // StartThread refuses to run while IE is clear.
+        cop0_status = 0x00010001; // EIE | IE
+        cop0_prid = 0x00002e20; // CPU ID for R5900
+
+        in_delay_slot = false;
+        branch_pc = 0;
+    }
+
+    // Defined in ps2_runtime.h (needs <iostream>).
+    void dump() const;
+
+    ~R5900Context() = default;
+};
+
+inline uint32_t getRegU32(const R5900Context *ctx, int reg)
+{
+    // Check if reg is valid (0-31)
+    if (reg < 0 || reg > 31)
+        return 0;
+    if (reg == 0)
+        return 0;
+    return static_cast<uint32_t>(_mm_extract_epi32(ctx->r[reg], 0));
+}
+
+inline void setReturnU32(R5900Context *ctx, uint32_t value)
+{
+    // R5900 sign-extends 32-bit results into 64-bit GPR, even for unsigned values.
+    ctx->r[2] = _mm_set_epi64x(0, static_cast<int64_t>(static_cast<int32_t>(value))); // $v0
+}
+
+inline void setReturnS32(R5900Context *ctx, int32_t value)
+{
+    // Signed 32-bit return should be sign-extended when observed as 64-bit.
+    ctx->r[2] = _mm_set_epi64x(0, static_cast<int64_t>(value)); // $v0
+}
+
+inline void setReturnU64(R5900Context *ctx, uint64_t value)
+{
+    // Keep both conventions: full 64-bit value in $v0 and high 32-bit in $v1.
+    ctx->r[2] = _mm_set_epi64x(0, static_cast<int64_t>(value));
+    ctx->r[3] = _mm_set_epi64x(0, static_cast<int64_t>(static_cast<uint32_t>(value >> 32)));
+}
+
+inline void ps2TraceGuestWrite(uint8_t *rdram,
+                               uint32_t guestAddr,
+                               uint32_t size,
+                               uint64_t valueLo,
+                               uint64_t valueHi,
+                               const char *op,
+                               const R5900Context *ctx)
+{
+    (void)rdram;
+    (void)guestAddr;
+    (void)size;
+    (void)valueLo;
+    (void)valueHi;
+    (void)op;
+    (void)ctx;
+}
+
+enum class Ps2GuestBranchKind
+{
+    DirectJump,
+    DirectCall,
+    IndirectJump,
+    IndirectCall,
+    Return,
+};
+
+using Ps2GuestFunction = void (*)(uint8_t *, R5900Context *, PS2Runtime *);
+
+// Host code at an instruction address inside a recompiled function, declared by config
+// `[[hooks]]` so the recompiler emits the call. A `before` hook with a redirect jumps
+// there when it returns nonzero; otherwise the return value is ignored.
+using Ps2InstructionHookFn = uint32_t (*)(uint8_t *, R5900Context *, PS2Runtime *);
+
+// Entry points into the runtime, defined in ps2_runtime.cpp. Generated code reaches the runtime only
+// through these; the PS2Runtime class definition is not needed.
+
+// True: the call returned normally and generated code continues at the fall-through.
+bool ps2GuestDispatchBranch(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t targetPc,
+                            uint32_t sourcePc, uint32_t fallthroughPc, Ps2GuestBranchKind kind,
+                            const char *debugName);
+// True: the EE scheduler asked this guest thread to yield; return to the caller.
+bool ps2GuestCheckpointDue(PS2Runtime *runtime, uint32_t cycles = 32u) noexcept;
+
+// Slow paths of READ*/WRITE*: addresses that are not plain RDRAM (MMIO, scratchpad, VU memory, kseg2).
+uint8_t ps2GuestLoad8(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr);
+uint16_t ps2GuestLoad16(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr);
+uint32_t ps2GuestLoad32(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr);
+uint64_t ps2GuestLoad64(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr);
+__m128i ps2GuestLoad128(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr);
+void ps2GuestStore8(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint8_t value);
+void ps2GuestStore16(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint16_t value);
+void ps2GuestStore32(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint32_t value);
+void ps2GuestStore64(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint64_t value);
+void ps2GuestStore128(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, __m128i value);
+
+void ps2GuestSignalException(PS2Runtime *runtime, R5900Context *ctx, PS2Exception exception);
+void ps2GuestSyscall(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t encodedSyscallId);
+void ps2GuestBreak(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestTrap(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestTlbr(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestTlbwi(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestTlbwr(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestTlbp(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx);
+void ps2GuestClearLLBit(PS2Runtime *runtime, R5900Context *ctx);
+void ps2GuestKickGifDmaChain(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t dPcrValue,
+                             uint32_t dStatValue, uint32_t tadr, uint32_t chcr);
+void ps2GuestVu0Execute(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t address);
+void ps2GuestVu0Start(PS2Runtime *runtime, uint8_t *rdram, R5900Context *ctx, uint32_t address);
+uint8_t *ps2GuestVu0Data(PS2Runtime *runtime);
+
+namespace ps2_stubs
+{
+    void TODO_NAMED(const char *name, uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+}
+
+// Generated by ps2xRecomp in register_functions.cpp, read by the runtime's lookupFunction.
+extern const uint32_t g_ps2RecompiledFunctionTableBase;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount;
+extern Ps2GuestFunction g_ps2RecompiledFunctionTable[];
+extern const uint32_t g_ps2InstructionHookCount;
+extern const uint32_t g_ps2InstructionHookAddresses[];
+extern const uint8_t g_ps2InstructionHookAfter[];
+extern Ps2InstructionHookFn g_ps2InstructionHooks[];
+
+#endif // PS2_GUEST_ABI_H
diff --git a/ps2xRuntime/include/ps2_guest_macros.h b/ps2xRuntime/include/ps2_guest_macros.h
new file mode 100644
index 0000000000000000000000000000000000000000..45c36b0a3e759b2904df8c1c6cc7eeb1c95f2290
--- /dev/null
+++ b/ps2xRuntime/include/ps2_guest_macros.h
@@ -0,0 +1,1565 @@
+#ifndef PS2_GUEST_MACROS_H
+#define PS2_GUEST_MACROS_H
+#include <cstdint>
+#include <cmath>
+#include <cstring>
+#include <bit>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(USE_SSE2NEON)
+#include "sse2neon.h"
+#else
+#include <immintrin.h> // For SSE/AVX intrinsics
+#endif
+
+#include "ps2_guest_abi.h"
+
+static inline int32_t Ps2ExtractEpi32(__m128i v, int index)
+{
+    switch (index & 3)
+    {
+    case 0:
+        return _mm_extract_epi32(v, 0);
+    case 1:
+        return _mm_extract_epi32(v, 1);
+    case 2:
+        return _mm_extract_epi32(v, 2);
+    default:
+        return _mm_extract_epi32(v, 3);
+    }
+}
+
+static inline int64_t Ps2ExtractEpi64(__m128i v, int index)
+{
+    if ((index & 1) == 0)
+    {
+        return _mm_cvtsi128_si64(v);
+    }
+    else
+    {
+        return _mm_extract_epi64(v, 1);
+    }
+}
+
+static inline uint32_t ps2_clz32(uint32_t x)
+{
+    return static_cast<uint32_t>(std::countl_zero(x));
+}
+
+static inline uint64_t Ps2HiLoToU64(uint64_t hi, uint64_t lo)
+{
+    return ((hi & 0xFFFFFFFFull) << 32) | (lo & 0xFFFFFFFFull);
+}
+
+static inline uint64_t Ps2SignExt32ToU64(uint32_t v)
+{
+    return (uint64_t)(int64_t)(int32_t)v;
+}
+
+// PLZCW: Count leading bits that match the sign bit, minus 1.
+// For positive values: count leading zeros minus 1 (excludes sign bit).
+// For negative values: count leading ones minus 1 (excludes sign bit).
+// Special cases: 0x00000000 -> 31, 0xFFFFFFFF -> 31.
+static inline uint32_t ps2_plzcw32(uint32_t x)
+{
+    if (x == 0 || x == 0xFFFFFFFF)
+        return 31;
+    if (x & 0x80000000u)
+        x = ~x; // If sign bit set, invert to count leading ones as zeros
+    return static_cast<uint32_t>(std::countl_zero(x)) - 1;
+}
+
+#define PS2_BLENDV_PS(a, b, mask) _mm_blendv_ps((a), (b), (mask))
+#define PS2_MIN_EPI32(a, b) _mm_min_epi32((a), (b))
+#define PS2_MAX_EPI32(a, b) _mm_max_epi32((a), (b))
+#define PS2_SHUFFLE_EPI8(v, mask) _mm_shuffle_epi8((v), (mask))
