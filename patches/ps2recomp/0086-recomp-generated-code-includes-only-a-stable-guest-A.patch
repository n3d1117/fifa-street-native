+static inline void Ps2SetGprLow64(R5900Context *ctx, int reg, __m128i new_low)
+{
+    if (reg != 0)
+    {
+        ctx->r[reg] = _mm_castpd_si128(_mm_move_sd(_mm_castsi128_pd(ctx->r[reg]), _mm_castsi128_pd(new_low)));
+    }
+}
