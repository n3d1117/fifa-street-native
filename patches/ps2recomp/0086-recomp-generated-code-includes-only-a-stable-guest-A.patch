+inline uint32_t ps2_fpu_sqrt_status(uint32_t status, float ft, bool reciprocal)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(ft);
+    const bool zero = (bits & 0x7f800000u) == 0;
+    const uint32_t flags = zero ? (reciprocal ? 0x00010020u : 0u) : ((bits >> 31) ? 0x00020040u : 0u);
+    return (status & ~0x00030000u) | flags;
+}
