-// FPU comparisons, MIN.S and MAX.S order PS2 floats as sign-magnitude numbers. The EE has no NaN
-// or Inf: an exponent-255 pattern (what ps2_fdiv returns for x / 0, 0x7FFFFFFF) is the largest
-// magnitude, and any exponent-0 pattern is zero (the FPU flushes denormals). Host float compares
-// would see a NaN and answer false, so a clamp such as min(x, limit) would let x through.
-inline int32_t ps2_fkey(float a)
-{
-    const uint32_t bits = std::bit_cast<uint32_t>(a);
-    if ((bits & PS2_FLOAT_EXP_MASK) == 0u)
-        return 0;
-    const int32_t magnitude = static_cast<int32_t>(bits & ~PS2_FLOAT_SIGN_MASK);
-    return (bits & PS2_FLOAT_SIGN_MASK) ? -magnitude : magnitude;
-}
-
-// The selected operand, with an exponent-0 pattern flushed to a signed zero (PCSX2 MAX_S/MIN_S
-// return fpuDouble of it). On a tie the first operand wins, as std::max/std::min do.
-inline float ps2_fflush(float a)
-{
-    const uint32_t bits = std::bit_cast<uint32_t>(a);
-    return (bits & PS2_FLOAT_EXP_MASK) == 0u ? std::bit_cast<float>(bits & PS2_FLOAT_SIGN_MASK) : a;
-}
-
-inline float ps2_fmax(float a, float b)
-{
-    return ps2_fflush(ps2_fkey(a) < ps2_fkey(b) ? b : a);
-}
-
-inline float ps2_fmin(float a, float b)
-{
-    return ps2_fflush(ps2_fkey(b) < ps2_fkey(a) ? b : a);
-}
-
-// VU MAX/MINI compare the raw lanes as integers, the larger magnitude winning among two negative
-// values (PCSX2 VUops.cpp fp_max/fp_min). Exponent-255 lanes are numbers here too; nothing is
-// flushed.
-inline __m128 ps2_vu_max_ps(__m128 a, __m128 b)
-{
-    const __m128i ai = _mm_castps_si128(a);
-    const __m128i bi = _mm_castps_si128(b);
-    const __m128i bothNegative = _mm_srai_epi32(_mm_and_si128(ai, bi), 31);
-    return _mm_castsi128_ps(_mm_blendv_epi8(_mm_max_epi32(ai, bi), _mm_min_epi32(ai, bi), bothNegative));
-}
-
-inline __m128 ps2_vu_min_ps(__m128 a, __m128 b)
-{
-    const __m128i ai = _mm_castps_si128(a);
-    const __m128i bi = _mm_castps_si128(b);
-    const __m128i bothNegative = _mm_srai_epi32(_mm_and_si128(ai, bi), 31);
-    return _mm_castsi128_ps(_mm_blendv_epi8(_mm_min_epi32(ai, bi), _mm_max_epi32(ai, bi), bothNegative));
-}
-
-// CVT.W.S: the EE always truncates toward zero, whatever FCR31 says. A magnitude of 2^31 or more
-// saturates by sign to 0x7FFFFFFF / 0x80000000. The EE has no Inf/NaN, so exponent-255 patterns are
-// just large numbers and saturate the same way (as PCSX2's interpreter CVT_W does).
-inline int32_t ps2_fcvt_w(float a)
-{
-    const uint32_t bits = std::bit_cast<uint32_t>(a);
-    if ((bits & PS2_FLOAT_EXP_MASK) <= 0x4E800000u) // exponent <= 157: |a| < 2^31
-        return static_cast<int32_t>(a);
-    return (bits & PS2_FLOAT_SIGN_MASK) ? INT32_MIN : INT32_MAX;
-}
-
-// VU0 macro-mode FDIV unit (PCSX2 VUops.cpp _vuDIV, _vuSQRT, _vuRSQRT). DIV and SQRT are the FPU's
-// rules: a zero or denormal divisor gives +-max with the sign of fs xor ft, SQRT takes |ft|.
-// RSQRT differs from the FPU's: a zero or denormal ft gives +-max with the sign of fs xor ft, or
-// +-0 with that sign when fs is zero as well; otherwise fs / sqrt(|ft|).
-inline float ps2_vu_rsqrt(float fs, float ft)
-{
-    const uint32_t s = std::bit_cast<uint32_t>(fs);
-    const uint32_t t = std::bit_cast<uint32_t>(ft);
-    if ((t & PS2_FLOAT_EXP_MASK) != 0u)
-        return ps2_frsqrt(fs, ft);
-    const uint32_t sign = (s ^ t) & PS2_FLOAT_SIGN_MASK;
-    return std::bit_cast<float>((s & PS2_FLOAT_EXP_MASK) != 0u ? (sign | PS2_FLOAT_MAX_BITS) : sign);
-}
-
-// VFTOIn: x * 2^n truncated toward zero. |x * 2^n| >= 2^31 (exponent 158 or more, so the VU's
-// exponent-255 numbers too) saturates by sign to 0x7FFFFFFF / 0x80000000 (PCSX2 VUops.cpp
-// floatToInt). cvttps alone returns 0x80000000 for both signs.
-inline __m128i ps2_vu_ftoi(__m128 value, float scale)
-{
-    const __m128 scaled = _mm_mul_ps(value, _mm_set1_ps(scale));
-    const __m128i bits = _mm_castps_si128(scaled);
-    const __m128i big = _mm_cmpgt_epi32(_mm_and_si128(bits, _mm_set1_epi32(0x7FFFFFFF)), _mm_set1_epi32(0x4EFFFFFF));
-    const __m128i saturated = _mm_xor_si128(_mm_set1_epi32(0x7FFFFFFF), _mm_srai_epi32(bits, 31));
-    return _mm_or_si128(_mm_and_si128(big, saturated), _mm_andnot_si128(big, _mm_cvttps_epi32(scaled)));
-}
-
-enum class Ps2VecOp
-{
-    Add,
-    Sub,
-    Mul
-};
-
-// Lane by lane through the scalar helpers; only reached when a result lane has exponent 255.
-PS2_FLOAT_NOINLINE inline __m128 ps2_vslow(__m128 a, __m128 b, Ps2VecOp op)
-{
-    alignas(16) float la[4], lb[4], lr[4];
-    _mm_store_ps(la, a);
-    _mm_store_ps(lb, b);
-    for (int i = 0; i < 4; ++i)
-    {
-        switch (op)
-        {
-        case Ps2VecOp::Add:
-            lr[i] = ps2_fadd_slow(la[i], lb[i]);
-            break;
-        case Ps2VecOp::Sub:
-            lr[i] = ps2_fsub_slow(la[i], lb[i]);
-            break;
-        default:
-            lr[i] = ps2_fmul_slow(la[i], lb[i]);
-            break;
-        }
-    }
-    return _mm_load_ps(lr);
-}
-
-// r is the host result of a op b. As in ps2_fnormal, testing r alone finds every lane that needs the double
-// path. Results with exponent 0 are flushed to +-0.
-inline __m128 ps2_vfinish(__m128 a, __m128 b, __m128 r, Ps2VecOp op)
-{
-    const __m128i expMask = _mm_set1_epi32(0x7F800000);
-    const __m128i rexp = _mm_and_si128(_mm_castps_si128(r), expMask);
-    if (_mm_movemask_epi8(_mm_cmpeq_epi32(rexp, expMask)) != 0)
-        return ps2_vslow(a, b, op);
-    const __m128i flush = _mm_and_si128(_mm_cmpeq_epi32(rexp, _mm_setzero_si128()), _mm_set1_epi32(0x7FFFFFFF));
-    return _mm_castsi128_ps(_mm_andnot_si128(flush, _mm_castps_si128(r)));
-}
-
-inline __m128 ps2_vadd(__m128 a, __m128 b)
-{
-    return ps2_vfinish(a, b, _mm_add_ps(a, b), Ps2VecOp::Add);
-}
-
-inline __m128 ps2_vsub(__m128 a, __m128 b)
-{
-    return ps2_vfinish(a, b, _mm_sub_ps(a, b), Ps2VecOp::Sub);
-}
-
-inline __m128 ps2_vmul(__m128 a, __m128 b)
-{
-    return ps2_vfinish(a, b, _mm_mul_ps(a, b), Ps2VecOp::Mul);
-}
