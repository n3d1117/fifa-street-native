diff --git a/ps2xTest/src/main.cpp b/ps2xTest/src/main.cpp
index 07a3f71d0e9569ca2e2270a8e28bfa5afc01d015..8dd98763f6710ebab40ddcd9f1d78dcd825ecbba 100644
--- a/ps2xTest/src/main.cpp
+++ b/ps2xTest/src/main.cpp
@@ -26,6 +26,7 @@ void register_ps2_vu0_ftoi_tests();
 void register_ps2_vu0_vf0_tests();
 void register_ps2_qword_access_tests();
 void register_ps2_mmi_hilo_tests();
+void register_ps2_mmi_permutation_tests();
 void reset_ps2_test_function_table();
 
 int main()
@@ -56,6 +57,7 @@ int main()
     register_ps2_vu0_vf0_tests();
     register_ps2_qword_access_tests();
     register_ps2_mmi_hilo_tests();
