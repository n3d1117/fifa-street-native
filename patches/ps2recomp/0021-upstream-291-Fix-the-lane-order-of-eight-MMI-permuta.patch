From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 17:13:53 +0200
Subject: [PATCH 21/38] upstream #291: Fix the lane order of eight MMI
 permutation instructions


diff --git a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
index 99a153b75d02999599ea4263f1ca8cefc88cfcb5..149186a8dd84a61884bcf070e815a420ef7569e2 100644
--- a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
@@ -343,17 +343,14 @@ namespace ps2recomp
 
     std::string CodeGenerator::translatePEXEH(const Instruction &inst)
     {
-        // Swaps halfwords 1<->3 and 5<->7 within the 128-bit register
-        return fmt::format("SET_GPR_VEC(ctx, {}, _mm_shufflelo_epi16(_mm_shufflehi_epi16(GPR_VEC(ctx, {}), _MM_SHUFFLE(2,3,0,1)), _MM_SHUFFLE(2,3,0,1)));",
+        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PEXEH(GPR_VEC(ctx, {})));",
                            inst.rd, inst.rt);
     }
 
 
     std::string CodeGenerator::translatePREVH(const Instruction &inst)
     {
-        // Reverses the order of the 8 halfwords
-        return fmt::format("{{ __m128i mask = _mm_setr_epi8(14,15, 12,13, 10,11, 8,9, 6,7, 4,5, 2,3, 0,1); "
-                           "SET_GPR_VEC(ctx, {}, PS2_SHUFFLE_EPI8(GPR_VEC(ctx, {}), mask)); }}",
+        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PREVH(GPR_VEC(ctx, {})));",
                            inst.rd, inst.rt);
     }
 
@@ -379,8 +376,7 @@ namespace ps2recomp
 
     std::string CodeGenerator::translatePROT3W(const Instruction &inst)
     {
-        // Rotates words left by 3: [d,c,b,a] -> [a,d,c,b]
-        return fmt::format("SET_GPR_VEC(ctx, {}, _mm_shuffle_epi32(GPR_VEC(ctx, {}), _MM_SHUFFLE(0,3,2,1)));",
+        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PROT3W(GPR_VEC(ctx, {})));",
                            inst.rd, inst.rt);
     }
 
@@ -407,8 +403,7 @@ namespace ps2recomp
 
     std::string CodeGenerator::translatePEXCH(const Instruction &inst)
     {
-        // Parallel Exchange Center Halfword (same as MMI2 PEXEH)
-        return fmt::format("SET_GPR_VEC(ctx, {}, _mm_shufflelo_epi16(_mm_shufflehi_epi16(GPR_VEC(ctx, {}), _MM_SHUFFLE(2,3,0,1)), _MM_SHUFFLE(2,3,0,1)));",
+        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_PEXCH(GPR_VEC(ctx, {})));",
                            inst.rd, inst.rt);
     }
 
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index cfc12cde8005ffac384d7cbb50ad7266fec54052..453fa0c6ca44565c13f6e03b2b560d619101c3d3 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -861,8 +861,10 @@ inline __m128i ps2_ppacb(__m128i rs, __m128i rt)
 #define PS2_PPACB(a, b) ps2_ppacb((__m128i)(a), (__m128i)(b))
 
 // Packed Interleave (PINT)
-#define PS2_PINTH(a, b) _mm_unpacklo_epi16(_mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)))
-#define PS2_PINTEH(a, b) _mm_unpackhi_epi16(_mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)))
+// PINTH: rt's lower four halfwords interleaved with rs's upper four.
+#define PS2_PINTH(rs, rt) _mm_unpacklo_epi16((__m128i)(rt), _mm_unpackhi_epi64((__m128i)(rs), (__m128i)(rs)))
+// PINTEH: in each word, the even halfword of rt (low) and of rs (high).
+#define PS2_PINTEH(rs, rt) _mm_or_si128(_mm_and_si128((__m128i)(rt), _mm_set1_epi32(0xFFFF)), _mm_slli_epi32((__m128i)(rs), 16))
 
 // Packed Multiply-Add (PMADD)
 #define PS2_PMADDW(a, b) _mm_add_epi32(_mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(1, 0, 3, 2)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(1, 0, 3, 2))), _mm_mullo_epi32(_mm_shuffle_epi32((__m128i)(a), _MM_SHUFFLE(3, 2, 1, 0)), _mm_shuffle_epi32((__m128i)(b), _MM_SHUFFLE(3, 2, 1, 0))))
@@ -1405,9 +1407,14 @@ inline __m128i ps2_qfsrv(__m128i rs, __m128i rt, uint32_t sa)
 }
 #define PS2_QFSRV(rs, rt, sa) ps2_qfsrv((__m128i)(rs), (__m128i)(rt), (uint32_t)(sa))
 #define PS2_PCPYLD(rs, rt) _mm_unpacklo_epi64(rt, rs)
-#define PS2_PEXEH(rs) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rs, _MM_SHUFFLE(2, 3, 0, 1)), _MM_SHUFFLE(2, 3, 0, 1))
-#define PS2_PEXEW(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(2, 3, 0, 1))
-#define PS2_PROT3W(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(0, 3, 2, 1))
+// MMI permutations, per the EE Core Instruction Set Manual. The halfword forms
+// act on each 64-bit doubleword independently.
+#define PS2_PEXEH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(3, 0, 1, 2)), _MM_SHUFFLE(3, 0, 1, 2)) // h0<->h2
+#define PS2_PEXCH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0)) // h1<->h2
+#define PS2_PREVH(rt) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rt, _MM_SHUFFLE(0, 1, 2, 3)), _MM_SHUFFLE(0, 1, 2, 3)) // h3,h2,h1,h0
+#define PS2_PEXEW(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 0, 1, 2))  // w0<->w2
+#define PS2_PEXCW(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 1, 2, 0))  // w1<->w2
+#define PS2_PROT3W(rt) _mm_shuffle_epi32(rt, _MM_SHUFFLE(3, 0, 2, 1)) // w0,w1,w2 <- w1,w2,w0; w3 kept
 
 // VU0 macro-mode MAC flags for the fields in dest (bit 3 = x ... bit 0 = w): zero in
 // bits 0-3, sign in bits 4-7 (overflow and underflow are not modelled). The status
