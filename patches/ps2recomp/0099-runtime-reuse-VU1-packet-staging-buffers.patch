 #include <string>
 #include <vector>
 
+struct Vu1NativeDispatcher::PacketCapture
+{
+    std::vector<std::vector<uint8_t>> packets;
+    size_t count = 0;
+
+    void reset() { count = 0; }
+
+    static void sink(void *user, const uint8_t *data, uint32_t size)
+    {
+        auto *self = static_cast<PacketCapture *>(user);
+        if (self->count == self->packets.size())
+            self->packets.emplace_back(data, data + size);
+        else
+            self->packets[self->count].assign(data, data + size);
+        ++self->count;
+    }
+};
+
