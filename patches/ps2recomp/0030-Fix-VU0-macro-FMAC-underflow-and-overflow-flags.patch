diff --git a/ps2xTest/src/ps2_vu0_fdiv_tests.cpp b/ps2xTest/src/ps2_vu0_fdiv_tests.cpp
index 21d92183b632bc9d0221ac56f6be85662f7e4a59..3e9c078e6c19e13c284ad864ebf35f655122b52a 100644
--- a/ps2xTest/src/ps2_vu0_fdiv_tests.cpp
+++ b/ps2xTest/src/ps2_vu0_fdiv_tests.cpp
@@ -57,6 +57,43 @@ void register_ps2_vu0_fdiv_tests()
 {
     MiniTest::Case("PS2Vu0Fdiv", [](TestCase &tc)
     {
+        tc.Run("FMAC records underflow and overflow before flushing", [](TestCase &t)
+        {
+            R5900Context ctx{};
+            ps2_vu0_set_mac(&ctx, _mm_set1_ps(fromBits(0x00400000u)), 8u);
+            t.Equals(ctx.vu0_mac_flags, 0x0808u, "x denormal sets U and Z");
+            t.Equals(static_cast<uint32_t>(ctx.vu0_status), 0x0145u, "U/Z and sticky US/ZS");
+            ps2_vu0_set_mac(&ctx, _mm_set1_ps(fromBits(0x7f800000u)), 4u);
+            t.Equals(ctx.vu0_mac_flags, 0x4000u, "y exponent 255 sets O");
+            t.Equals(static_cast<uint32_t>(ctx.vu0_status), 0x0348u, "O/OS replace current U/Z, keep sticky");
+            ps2_vu0_set_mac(&ctx, _mm_set1_ps(1.0f), 15u);
+            t.Equals(static_cast<uint32_t>(ctx.vu0_status), 0x0340u, "valid FMAC clears current flags only");
+        });
+
+        tc.Run("VMUL underflow survives FTZ and excludes unwritten lanes", [](TestCase &t)
+        {
+            R5900Context ctx{};
+            uint32_t underflow = 0;
+            const __m128 result = ps2_vu0_arith<Ps2VecOp::Mul>(underflow, _mm_set1_ps(runtimeBits(0x00800000u)), _mm_set1_ps(0.5f));
+            ps2_vu0_set_mac(&ctx, result, 8u, underflow);
+            t.Equals(ctx.vu0_mac_flags, 0x0808u, "VMUL.x(min_normal, 0.5) sets x U/Z");
+            t.Equals(static_cast<uint32_t>(ctx.vu0_status), 0x0145u, "U/US survive flushing");
+            underflow = 0;
+            const __m128 cancel = ps2_vu0_arith<Ps2VecOp::Sub>(underflow, _mm_set1_ps(1.0f), _mm_set1_ps(1.0f));
+            ps2_vu0_set_mac(&ctx, cancel, 4u, underflow);
+            t.Equals(ctx.vu0_mac_flags, 4u, "exact cancellation has Z but no U");
+            const __m128 product = ps2_vu0_arith<Ps2VecOp::Mul>(underflow, _mm_set1_ps(runtimeBits(0x00800000u)), _mm_set1_ps(0.5f));
+            const __m128 sum = ps2_vu0_arith<Ps2VecOp::Add>(underflow, _mm_setzero_ps(), product);
+            ps2_vu0_set_mac(&ctx, sum, 8u, underflow);
+            t.Equals(ctx.vu0_mac_flags, 0x0808u, "MADD with zero ACC retains tiny product U");
+            const __m128 overflow = ps2_vu0_arith<Ps2VecOp::Mul>(underflow, _mm_set1_ps(runtimeBits(0x7f7fffffu)), _mm_set1_ps(2.0f));
+            ps2_vu0_set_mac(&ctx, overflow, 2u, underflow);
+            t.Equals(ctx.vu0_mac_flags, 0x2000u, "VMUL.z(max_normal, 2) sets z O");
+            t.Equals(static_cast<uint32_t>(ctx.vu0_status), 0x0348u, "overflow status O/OS preserves sticky U/Z");
+            const auto code = translate(0x100000u, 0x4b02186au);
+            t.IsTrue(contains(code, "ps2_vu0_arith<Ps2VecOp::Mul>") && contains(code, "macUnderflow"), "VMUL must retain pre-flush U: " + code);
+        });
+
         tc.Run("RSQRT is fs / sqrt(|ft|)", [](TestCase &t)
         {
             t.Equals(bits(ps2_vu_rsqrt(1.0f, 4.0f)), bits(0.5f), "1 / sqrt(4)");
