From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 18:24:44 +0200
Subject: [PATCH 48/96] Runtime: PS2X_TRACE_SYSCALLS and PS2X_TRACE_RPC print
 guest syscalls and SIF RPC events (first calls per number; first 2000 RPC
 events)


diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
index 121fcc7105d5585c502bdafd44547403a13eae3a..2cd35c8780e29de2bf560144cf3ed7a42e1eaff8 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
@@ -1,11 +1,44 @@
 #include "Common.h"
 #include "Dispatcher.h"
 #include "System.h"
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <unordered_map>
 
 namespace ps2_syscalls
 {
+    namespace
+    {
+        // PS2X_TRACE_SYSCALLS=1: the first calls of each syscall number, then every 65536th.
+        void traceSyscall(uint32_t syscallNumber, const R5900Context *ctx)
+        {
+            static const bool enabled = [] {
+                const char *value = std::getenv("PS2X_TRACE_SYSCALLS");
+                return value && std::strcmp(value, "1") == 0;
+            }();
+            if (!enabled)
+            {
+                return;
+            }
+            static std::mutex mutex;
+            static std::unordered_map<uint32_t, uint64_t> counts;
+            std::lock_guard<std::mutex> lock(mutex);
+            const uint64_t n = ++counts[syscallNumber];
+            if (n <= 3u || (n & 0xFFFFu) == 0u)
+            {
+                std::cerr << "[syscall] n=" << static_cast<int32_t>(syscallNumber) << " count=" << n
+                          << std::hex << " pc=0x" << ctx->pc << " ra=0x" << GPR_U32(ctx, 31)
+                          << " a0=0x" << GPR_U32(ctx, 4) << " a1=0x" << GPR_U32(ctx, 5)
+                          << " a2=0x" << GPR_U32(ctx, 6) << std::dec << std::endl;
+            }
+        }
+    }
+
     bool dispatchNumericSyscall(uint32_t syscallNumber, uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
+        traceSyscall(syscallNumber, ctx);
         if (dispatchSyscallOverride(syscallNumber, rdram, ctx, runtime))
         {
             return true;
diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
index 07fcd29443acbf4391565fe69c4eeedd9b46a781..36bc9a0cc5860e5abd7163f2fbf7a6230c151a54 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
@@ -20,6 +20,18 @@ namespace ps2_syscalls
         {
             event.seq = ++g_sif_rpc_debug_next_seq;
             g_sif_rpc_debug_history[event.seq % kSifRpcDebugHistoryCount] = event;
+            static const bool trace = [] {
+                const char *value = std::getenv("PS2X_TRACE_RPC");
+                return value && std::strcmp(value, "1") == 0;
+            }();
+            if (trace && event.seq <= 2000u)
+            {
+                std::cerr << "[rpc] #" << event.seq << ' ' << event.op << std::hex << " sid=0x" << event.sid
+                          << " fn=0x" << event.rpcNum << " send=0x" << event.sendSize
+                          << " recv=0x" << event.recvSize << " flags=0x" << event.flags
+                          << " pc=0x" << event.pc << " ra=0x" << event.ra << std::dec
+                          << " result=" << event.result << std::endl;
+            }
         }
 
         void pushSifRpcDebugEvent(SifRpcDebugEvent event)
