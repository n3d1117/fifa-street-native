From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 21:19:46 +0200
Subject: [PATCH 60/81] Diagnostics: PS2X_TRACE_PAD, CD trace names the file on
 every file change, state dump lists physical IOP RPC server SIDs


diff --git a/ps2xIOP/include/ps2x/iop/lbn_map.h b/ps2xIOP/include/ps2x/iop/lbn_map.h
index 7ef698b8e3275fef3a7432b94ca37dd8f78e6f20..7eb6ce38a1ca8e1e6363a29f84258a2560e731c5 100644
--- a/ps2xIOP/include/ps2x/iop/lbn_map.h
+++ b/ps2xIOP/include/ps2x/iop/lbn_map.h
@@ -108,6 +108,9 @@ namespace ps2x::iop
             return nullptr;
         }
 
+        // The file whose extent holds `lbn`, or nullptr.
+        [[nodiscard]] const File *fileContaining(uint32_t lbn) const { return fileAt(lbn); }
+
         // Reads `sectors` sectors starting at `lbn` into dst (sectors * kSectorSize bytes).
         [[nodiscard]] bool read(uint32_t lbn, uint32_t sectors, uint8_t *dst) const
         {
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index 01867c0af79d08e26ece9534a37217e76435eb3b..b06e08500e1bb6f7bd4f3d29be29fb5e339564c9 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -1139,6 +1139,11 @@ namespace ps2x::iop::detail
         return static_cast<uint32_t>(m_impl->kernel.threadCount());
     }
 
+    std::vector<uint32_t> IopEmulator::rpcServerSids() const
+    {
+        return m_impl->rpc.serverSids();
+    }
+
     uint32_t IopEmulator::rpcServerCount() const noexcept
     {
         return static_cast<uint32_t>(m_impl->rpc.serverCount());
diff --git a/ps2xIOP/src/emulator/iop_emulator.h b/ps2xIOP/src/emulator/iop_emulator.h
index ff87276794874b7447f85067bd64ec6ea8104451..9466cc828f268fccfe031d6c9dde4c45126721f9 100644
--- a/ps2xIOP/src/emulator/iop_emulator.h
+++ b/ps2xIOP/src/emulator/iop_emulator.h
@@ -44,6 +44,7 @@ namespace ps2x::iop::detail
         [[nodiscard]] uint32_t loadedModuleCount() const noexcept;
         [[nodiscard]] uint32_t threadCount() const noexcept;
         [[nodiscard]] uint32_t rpcServerCount() const noexcept;
+        [[nodiscard]] std::vector<uint32_t> rpcServerSids() const;
 
     private:
         class Impl;
diff --git a/ps2xIOP/src/emulator/services/iop_rpc.h b/ps2xIOP/src/emulator/services/iop_rpc.h
index 4f5bd4097332e79b9bc27a14cb5ad3441829ab45..3301b03e3b16cef2013530ce091011eac5790590 100644
--- a/ps2xIOP/src/emulator/services/iop_rpc.h
+++ b/ps2xIOP/src/emulator/services/iop_rpc.h
@@ -5,6 +5,7 @@
 #include <cstddef>
 #include <cstdint>
 #include <unordered_map>
+#include <vector>
 
 namespace ps2x::iop
 {
@@ -65,6 +66,13 @@ namespace ps2x::iop::detail
 
         [[nodiscard]] bool hasServer(uint32_t sid) const noexcept;
         [[nodiscard]] size_t serverCount() const noexcept { return m_servers.size(); }
+        [[nodiscard]] std::vector<uint32_t> serverSids() const
+        {
+            std::vector<uint32_t> sids;
+            for (const auto &entry : m_servers)
+                sids.push_back(entry.second.sid);
+            return sids;
+        }
 
     private:
         struct RpcServer
diff --git a/ps2xIOP/src/iop_subsystem.cpp b/ps2xIOP/src/iop_subsystem.cpp
index 6d0a57bdae36c600b77da8672bf090168dbb2013..649d947ea4f4d2703e60b05f5350f079ad58e8bc 100644
--- a/ps2xIOP/src/iop_subsystem.cpp
+++ b/ps2xIOP/src/iop_subsystem.cpp
@@ -1,3 +1,4 @@
+#include <algorithm>
 #include "ps2x/iop/iop_subsystem.h"
 
 #include "iop_service.h"
@@ -272,6 +273,13 @@ namespace ps2x::iop
         snapshot.emulatorLoadedModules = m_impl->emulator.loadedModuleCount();
         snapshot.emulatorThreads = m_impl->emulator.threadCount();
         snapshot.emulatorRpcServers = m_impl->emulator.rpcServerCount();
+        {
+            DebugService physical;
+            physical.name = "physical RPC servers (registered by loaded IRX)";
+            physical.sids = m_impl->emulator.rpcServerSids();
+            std::sort(physical.sids.begin(), physical.sids.end());
+            snapshot.services.push_back(std::move(physical));
+        }
         snapshot.diagnostics = m_impl->loadOutcomes;
         if (!m_impl->lastError.empty())
         {
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
index bafbfdb1072470f53d2fabee46c19c35ce843ab4..fb5d00ef6f5e548705a964fd1d465aa2d947d6bd 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
@@ -278,9 +278,15 @@ namespace
             CdIoTraceCounters &counters = cdIoTraceCounters();
             const uint64_t call = counters.calls.fetch_add(1u, std::memory_order_relaxed) + 1u;
             counters.bytes.fetch_add(byteCount, std::memory_order_relaxed);
-            if (call <= 32u || call % 1024u == 0u)
+            // Log every change of file (the movies and audio streams of a boot read one file for long).
+            static std::string lastFile;
+            const ps2x::iop::LbnMap::File *file = map ? map->fileContaining(lbn) : nullptr;
+            const std::string fileName = file ? file->relativePath : std::string();
+            const bool fileChanged = fileName != lastFile;
+            lastFile = fileName;
+            if (call <= 32u || call % 1024u == 0u || fileChanged)
             {
-                std::cerr << "[cd-io] call=" << call << " ok=" << ok << " lbn=0x" << std::hex << lbn << std::dec
+                std::cerr << "[cd-io] call=" << call << " file=" << fileName << " ok=" << ok << " lbn=0x" << std::hex << lbn << std::dec
                           << " sectors=" << sectors << " us="
                           << std::chrono::duration_cast<std::chrono::microseconds>(
                                  std::chrono::steady_clock::now() - started).count()
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
index 5a6188d6c31fab55cdacb2c93d3a2f42349e6d6c..0b348001acd2eed168b02656cf90d1b8c68cd847 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
@@ -648,6 +648,21 @@ namespace ps2_stubs
             return;
         }
 
+        {
+            // PS2X_TRACE_PAD=1: the first reads and every change of the button bytes.
+            static const bool tracePad = [] {
+                const char *value = std::getenv("PS2X_TRACE_PAD");
+                return value && value[0] == '1';
+            }();
+            static uint32_t reads = 0u, lastButtons = 0xFFFFFFFFu;
+            const uint32_t buttons = (static_cast<uint32_t>(data[2]) << 8) | data[3];
+            ++reads;
+            if (tracePad && (reads <= 4u || buttons != lastButtons))
+                std::fprintf(stderr, "[pad] read #%u port=%d slot=%d id=0x%02x buttons=0x%04x pc=0x%x\n", reads, port, slot,
+                             data[1], buttons, ctx->pc);
+            lastButtons = buttons;
+        }
+
         PS2_IF_AGRESSIVE_LOGS({
             if (g_padReadLogCount < 48)
             {
diff --git a/ps2xRuntime/src/lib/ps2_state_dump.cpp b/ps2xRuntime/src/lib/ps2_state_dump.cpp
index 9e427c48a6ec4c0556cc1f9d2859927934ef2c05..3451237a5603711a51aa3e21ca0f5d7c4aa76113 100644
--- a/ps2xRuntime/src/lib/ps2_state_dump.cpp
+++ b/ps2xRuntime/src/lib/ps2_state_dump.cpp
@@ -149,6 +149,13 @@ void dumpState(PS2Runtime &runtime)
     out << "iop cycles=" << iop.emulatorCycles << " instructions=" << iop.emulatorInstructions
         << " modules=" << iop.emulatorLoadedModules << " threads=" << iop.emulatorThreads
         << " rpc_servers=" << iop.emulatorRpcServers << "\n";
+    for (const auto &service : iop.services)
+    {
+        out << "iop service " << service.name << (service.active ? "" : " (inactive)") << " sids:" << std::hex;
+        for (const uint32_t sid : service.sids)
+            out << " 0x" << sid;
+        out << std::dec << "\n";
+    }
     for (const std::string &line : iop.diagnostics)
         out << "iop diag " << line << "\n";
 
