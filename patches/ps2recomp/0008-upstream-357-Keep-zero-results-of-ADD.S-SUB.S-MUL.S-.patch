Subject: [PATCH 08/64] upstream #357: Keep zero results of ADD.S/SUB.S/MUL.S
 on the fast path


diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 22f204cea8c13b0f2dd54b69e5a62a7a6050c035..4739b4b4d527a7a33c5d8b35421b2c4fa6a0e9b1 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -270,9 +270,12 @@ inline bool ps2_fall_normal(float a, float b, float r)
 
 // The same test on the result alone. An exponent-255 operand always leaves exponent 255 in the host result
 // of an addition, subtraction or multiplication (Inf or NaN), so this finds those operands as well.
+// A zero result stays on the fast path: it needs no operand with exponent 255 (that gives Inf or NaN), and
+// the double path returns the same signed zero, so zeros (common in game maths) skip the out-of-line call.
 inline bool ps2_fnormal(float r)
 {
-    return (std::bit_cast<uint32_t>(r) * 2u + 0x01000000u) >= 0x02000000u;
+    const uint32_t doubled = std::bit_cast<uint32_t>(r) * 2u;
+    return doubled == 0u || (doubled + 0x01000000u) >= 0x02000000u;
 }
 
 inline float ps2_fadd(float a, float b)
diff --git a/ps2xTest/src/ps2_float_semantics_tests.cpp b/ps2xTest/src/ps2_float_semantics_tests.cpp
index 2866d2bff38f63bc1049d4b94d487b019ae1b7c4..4c521c20a7aba9bc622419b240ace8c92a1a9327 100644
--- a/ps2xTest/src/ps2_float_semantics_tests.cpp
+++ b/ps2xTest/src/ps2_float_semantics_tests.cpp
@@ -120,6 +120,39 @@ void register_ps2_float_semantics_tests()
             }
         });
 
+        tc.Run("a zero host result takes the fast path and matches the out-of-line path", [](TestCase &t)
+        {
+            // Zero, both signs of zero, denormals, the smallest normals, ordinary values and exponent 255.
+            const uint32_t magnitudes[] = {0x00000000u, 0x00000001u, 0x007FFFFFu, 0x00800000u, 0x00800001u,
+                                           0x3F800000u, 0x40000000u, 0x7F7FFFFFu, 0x7F800000u, 0x7FFFFFFFu};
+            for (uint32_t ma : magnitudes)
+            {
+                for (uint32_t mb : magnitudes)
+                {
+                    for (uint32_t signs = 0; signs < 4; ++signs)
+                    {
+                        const float a = floatOf(ma | ((signs & 1u) ? 0x80000000u : 0u));
+                        const float b = floatOf(mb | ((signs & 2u) ? 0x80000000u : 0u));
+                        const std::string at = std::string("operands ") + std::to_string(bitsOf(a)) + ", " + std::to_string(bitsOf(b));
+                        if (a + b == 0.0f)
+                            t.Equals(bitsOf(FPU_ADD_S(a, b)), bitsOf(ps2_fadd_slow(a, b)), "add " + at);
+                        if (a - b == 0.0f)
+                            t.Equals(bitsOf(FPU_SUB_S(a, b)), bitsOf(ps2_fsub_slow(a, b)), "sub " + at);
+                        if (a * b == 0.0f)
+                            t.Equals(bitsOf(FPU_MUL_S(a, b)), bitsOf(ps2_fmul_slow(a, b)), "mul " + at);
+                    }
+                }
+            }
+        });
+
+        tc.Run("ps2_fnormal accepts a zero result and rejects a denormal one", [](TestCase &t)
+        {
+            // The macro tests above give the same bits on either path, so only this predicate pins the fast path.
+            t.IsTrue(ps2_fnormal(floatOf(0x00000000u)), "+0 stays on the fast path");
+            t.IsTrue(ps2_fnormal(floatOf(0x80000000u)), "-0 stays on the fast path");
+            t.IsFalse(ps2_fnormal(floatOf(0x00000001u)), "a denormal result takes the out-of-line path");
+        });
+
         tc.Run("exponent 255 is an ordinary exponent, not Inf or NaN", [](TestCase &t)
         {
             const float twoPow128 = floatOf(kTwoPow128);
