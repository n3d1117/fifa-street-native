From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 21:31:49 +0200
Subject: [PATCH 62/84] Report the DualShock 2 packet ID in pressure mode

FIFA Street validates status zero and ID 0x79 at 0x103750..0x10376c before consuming input. The HLE returned analog ID 0x73 after EnterPressMode, so every input packet was rejected. Match PCSX2 Mode::DUALSHOCK2 and cover the enter/exit transitions.

Verified: transition regression fails before the fix; rx build and rx test --full pass after it. Scripted Cross now leaves the language menu and opens EABIGEN.MPC; the subsequent movie-start null call is a separate blocker.

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
index 0b348001acd2eed168b02656cf90d1b8c68cd847..1913d8d55deb07f3d834f723be4b8bbaac967498 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
@@ -7,6 +7,7 @@ namespace ps2_stubs
     {
         constexpr uint8_t kPadModeDigital = 0x41;
         constexpr uint8_t kPadModeDualShock = 0x73;
+        constexpr uint8_t kPadModeDualShock2 = 0x79;
         constexpr uint8_t kPadAnalogCenter = 0x80;
         constexpr int32_t kPadTypeDigital = 4;
         constexpr int32_t kPadTypeDualShock = 7;
@@ -248,7 +249,9 @@ namespace ps2_stubs
         void fillPadStatus(uint8_t *data, const PadInputState &state, const PadPortState &portState)
         {
             std::memset(data, 0, 32);
-            data[1] = portState.analogMode ? kPadModeDualShock : kPadModeDigital;
+            data[1] = portState.analogMode
+                          ? (portState.pressureEnabled ? kPadModeDualShock2 : kPadModeDualShock)
+                          : kPadModeDigital;
             data[2] = static_cast<uint8_t>(state.buttons & 0xFFu);
             data[3] = static_cast<uint8_t>((state.buttons >> 8) & 0xFFu);
             data[4] = state.rx;
diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index 07f9b7a29d133f5ba4e4ed9d4e2ee8ca2d7f5059..eac7f908d63a92b337562f2b8667741892ada607 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -351,6 +351,20 @@ void register_pad_input_tests()
             runPadRead(ctx, rdram);
             t.Equals(data[1], static_cast<uint8_t>(0x73), "mode byte should be 0x73 (analog) after SetMainMode");
 
+            ps2_stubs::scePadEnterPressMode(rdram.data(), &ctx, nullptr);
+            ps2_stubs::setPadOverrideState(static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), 0x80, 0x80, 0x80, 0x80);
+            runPadRead(ctx, rdram);
+            t.Equals(data[0], static_cast<uint8_t>(0), "pressure packet status should indicate success");
+            t.Equals(data[1], static_cast<uint8_t>(0x79), "pressure mode should report the DualShock 2 packet ID");
+            t.Equals(readButtons(rdram), static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross), "pressure packet should retain active-low buttons");
+            t.Equals(data[14], static_cast<uint8_t>(0xFF), "pressure packet should include Cross pressure");
+
+            ps2_stubs::scePadExitPressMode(rdram.data(), &ctx, nullptr);
+            runPadRead(ctx, rdram);
+            t.Equals(data[1], static_cast<uint8_t>(0x73), "exiting pressure mode should restore the analog packet ID");
+            t.Equals(data[14], static_cast<uint8_t>(0), "exiting pressure mode should clear Cross pressure");
+
+            ps2_stubs::clearPadOverrideState();
             closePadPort(ctx, rdram);
         });
 
