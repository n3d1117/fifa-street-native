+    // Vtables, callback tables and jump tables in data hold code addresses no JAL reaches. A word in a
+    // data section that points at 4-aligned code and lands on a function prologue (addiu sp,sp,-N) or a
+    // leaf return (jr ra) is an indirect-call target; seed it so dispatch finds it.
+    void PS2Recompiler::collectDataPointerEntryStarts()
+    {
+        uint32_t codeBegin = std::numeric_limits<uint32_t>::max();
+        uint32_t codeEnd = 0u;
+        for (const Section &section : m_sections)
+        {
+            if (section.isCode && section.size != 0u)
+            {
+                codeBegin = std::min(codeBegin, section.address);
+                codeEnd = std::max(codeEnd, section.address + section.size);
+            }
+        }
+        if (codeBegin >= codeEnd)
+            return;
+
+        size_t seeded = 0u;
+        for (const Section &section : m_sections)
+        {
+            if (section.isCode || section.isBSS || section.data == nullptr || section.size < sizeof(uint32_t))
+                continue;
+            if (section.name != ".data" && section.name != ".rodata" && section.name != ".sdata" &&
+                section.name != ".ctors" && section.name != ".init_array")
+                continue;
+            // A run of two or more adjacent code pointers is a vtable or callback table: accept every entry.
+            // A lone code pointer must land on a function prologue or a leaf return.
+            const uint32_t wordCount = section.size / static_cast<uint32_t>(sizeof(uint32_t));
+            std::vector<uint32_t> values(wordCount);
+            std::memcpy(values.data(), section.data, static_cast<size_t>(wordCount) * sizeof(uint32_t));
+            const auto isCodePointer = [&](uint32_t value)
+            { return value >= codeBegin && value < codeEnd && (value & 3u) == 0u; };
+            for (uint32_t i = 0; i < wordCount; ++i)
+            {
+                const uint32_t target = values[i];
+                if (!isCodePointer(target))
+                    continue;
+                const bool inRun = (i > 0u && isCodePointer(values[i - 1u])) || (i + 1u < wordCount && isCodePointer(values[i + 1u]));
+                bool accept = inRun;
+                if (!accept)
+                {
+                    uint32_t word = 0u;
+                    try
+                    {
+                        word = m_elfParser->readWord(target);
+                    }
+                    catch (const std::exception &)
+                    {
+                        continue;
+                    }
+                    accept = ((word >> 16) == 0x27BDu && (word & 0x8000u) != 0u) || word == 0x03E00008u;
+                }
+                if (accept && m_entryPointHintStarts.insert(target).second)
+                    ++seeded;
+            }
+        }
+
+        // Callbacks passed by address: lui rt,hi followed within a few instructions by addiu/ori rt,rt,lo.
+        const auto looksLikeFunctionStart = [&](uint32_t target) -> bool
+        {
+            if (target < codeBegin || target >= codeEnd || (target & 3u) != 0u)
+                return false;
+            try
+            {
+                const uint32_t word = m_elfParser->readWord(target);
+                return ((word >> 16) == 0x27BDu && (word & 0x8000u) != 0u) || word == 0x03E00008u;
+            }
+            catch (const std::exception &)
+            {
+                return false;
+            }
+        };
+        for (const Section &section : m_sections)
+        {
+            if (!section.isCode || section.data == nullptr || section.size < 8u)
+                continue;
+            const uint32_t words = section.size / 4u;
+            for (uint32_t i = 0; i + 1u < words; ++i)
+            {
+                uint32_t lui = 0u;
+                std::memcpy(&lui, section.data + i * 4u, 4);
+                if ((lui >> 26) != 0x0Fu)
+                    continue;
+                const uint32_t rt = (lui >> 16) & 0x1Fu;
+                const uint32_t high = (lui & 0xFFFFu) << 16;
+                for (uint32_t j = i + 1u; j < words && j <= i + 6u; ++j)
+                {
+                    uint32_t next = 0u;
+                    std::memcpy(&next, section.data + j * 4u, 4);
+                    const uint32_t op = next >> 26;
+                    if ((op == 0x09u || op == 0x0Du) && ((next >> 21) & 0x1Fu) == rt && ((next >> 16) & 0x1Fu) == rt)
+                    {
+                        const uint32_t low = next & 0xFFFFu;
+                        const uint32_t target = op == 0x09u ? high + static_cast<uint32_t>(static_cast<int16_t>(low)) : (high | low);
+                        if (looksLikeFunctionStart(target) && m_entryPointHintStarts.insert(target).second)
+                            ++seeded;
+                        break;
+                    }
+                    // Stop at anything that overwrites rt or ends the straight-line window.
+                    if (((next >> 11) & 0x1Fu) == rt && op == 0u)
+                        break;
+                    if (op >= 0x01u && op <= 0x07u)
+                        break;
+                    if (op != 0u && ((next >> 16) & 0x1Fu) == rt && op >= 0x08u && op <= 0x2Fu)
+                        break;
+                }
+            }
+        }
+        if (seeded != 0u)
+        {
+            std::ostringstream msg;
+            msg << "seeded " << seeded << " code pointer(s) found in data sections and lui/addiu pairs as entry points";
+            m_reporter.progress(msg.str());
+        }
+    }
+
