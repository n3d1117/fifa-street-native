+                t.IsTrue(registration.find("// 0x100020") != std::string::npos,
+                         "an adjacent run of code pointers is a table: every entry is a target");
+                t.IsTrue(registration.find("// 0x100003") == std::string::npos,
+                         "an unaligned data word is not a function");
+            }
+
+            std::error_code removeError;
