From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 22:56:21 +0200
Subject: [PATCH 84/87] vu1: dispatch live and full flag variants


diff --git a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
index 0fa6bb740f509ac9a52492faec47b7fa87923221..540c7d56e3e83d8a3ad1d2c986518b4ed5ac0c62 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
@@ -79,7 +79,9 @@ struct Vu1RecProgram
     const uint64_t *words = nullptr;
     const uint32_t *entries = nullptr;
     size_t entryCount = 0;
+    Vu1RecFn live = nullptr;
     Vu1RecFn full = nullptr;
+    uint8_t liveFlags = 0;
     bool hasDebugBits = false;
 
     bool hasEntry(uint32_t relPc) const
@@ -97,7 +99,8 @@ size_t vu1recProgramCount();
 struct Vu1RecProgramRegistrar
 {
     Vu1RecProgramRegistrar(const char *name, uint32_t slots, uint64_t hash, const uint64_t *words,
-                           const uint32_t *entries, size_t count, Vu1RecFn full, bool hasDebugBits)
+                           const uint32_t *entries, size_t count, Vu1RecFn live, Vu1RecFn full,
+                           uint8_t liveFlags, bool hasDebugBits)
     {
         Vu1RecProgram program;
         program.name = name;
@@ -106,7 +109,9 @@ struct Vu1RecProgramRegistrar
         program.words = words;
         program.entries = entries;
         program.entryCount = count;
+        program.live = live;
         program.full = full;
+        program.liveFlags = liveFlags;
         program.hasDebugBits = hasDebugBits;
         vu1recRegisterProgram(program);
     }
@@ -154,7 +159,7 @@ private:
         uint64_t mscnt = 0;
         uint64_t nativeFailures = 0;
         uint64_t diffCalls = 0;
-        uint64_t diffMismatchFull = 0;
+        uint64_t diffMismatch = 0;
         uint64_t diffInterpBudget = 0;
         uint64_t diffPackets = 0;
         uint64_t diffPacketBytes = 0;
@@ -168,6 +173,7 @@ private:
     void maybePrintPeriodic();
 
     bool m_forceInterpreter = false;
+    bool m_fullFlags = false;
     bool m_diff = false;
     int m_diffLogBudget = 8;
     double m_statsPeriod = 5.0;
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
index 4857e809bcd44afb42734f6c62c46e34f532ae54..ff43d18e8ab6a8c0503f3c3e5f354cd77b33bdd7 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
@@ -186,11 +186,14 @@ Vu1NativeDispatcher::Vu1NativeDispatcher()
     m_forceInterpreter = forced && forced[0] != '\0' && forced[0] != '0';
     const char *diff = std::getenv("PS2X_VU1_DIFF");
     m_diff = diff && diff[0] != '\0' && diff[0] != '0';
+    const char *flags = std::getenv("PS2X_VU1_FLAGS");
+    m_fullFlags = flags && std::strcmp(flags, "full") == 0;
     m_diffLogBudget = envInt("PS2X_VU1_DIFF_LOG", 8);
     m_statsPeriod = 5.0;
     m_ctx = new Vu1RecContext();
     std::fprintf(stderr, "[vu1rec] %zu program(s) registered; mode=%s\n", vu1recProgramCount(),
-                 m_forceInterpreter ? "interpreter (PS2X_VU1_INTERPRETER)" : (m_diff ? "diff (PS2X_VU1_DIFF)" : "native"));
+                 m_forceInterpreter ? "interpreter (PS2X_VU1_INTERPRETER)" :
+                 (m_diff ? "diff (PS2X_VU1_DIFF)" : (m_fullFlags ? "full flags" : "live flags")));
     m_lastStatsTime = nowSeconds();
 }
 
@@ -357,7 +360,8 @@ bool Vu1NativeDispatcher::dispatch(VU1Interpreter &vu1, PS2Memory &memory, GS &g
     ctx.sink = &PacketCapture::sink;
     ctx.sinkUser = &stagedPackets;
     const double t0 = nowSeconds();
-    program->full(ctx, pc);
+    const Vu1RecFn nativeFn = !m_fullFlags && program->live ? program->live : program->full;
+    nativeFn(ctx, pc);
     m_vu1Seconds += nowSeconds() - t0;
     if (ctx.failed)
     {
@@ -394,17 +398,18 @@ void Vu1NativeDispatcher::runDiff(const Vu1RecProgram &program, VU1Interpreter &
     dFull = d0;
     const uint64_t c0 = vu1.cycleCount();
 
-    // native, full-flag variant
-    VU1State sFull = s0;
-    PacketCapture pFull;
-    resetContext(*m_ctx, &sFull, dFull.data(), c0, maxCycles, top, itop, nullptr, nullptr);
+    // Native live-flag variant; output flags outside its generated live-out mask are dead.
+    VU1State sLive = s0;
+    PacketCapture pLive;
+    resetContext(*m_ctx, &sLive, dFull.data(), c0, maxCycles, top, itop, nullptr, nullptr);
     m_ctx->code = memory.getVU1Code();
     m_ctx->relocBase = relocBase;
     m_ctx->sink = &PacketCapture::sink;
-    m_ctx->sinkUser = &pFull;
-    program.full(*m_ctx, pc);
-    const bool fullFailed = m_ctx->failed;
-    const uint64_t fullCycle = m_ctx->cycle;
+    m_ctx->sinkUser = &pLive;
+    const Vu1RecFn liveFn = program.live ? program.live : program.full;
+    liveFn(*m_ctx, pc);
+    const bool liveFailed = m_ctx->failed;
+    const uint64_t liveCycle = m_ctx->cycle;
 
     // interpreter (oracle) on the real state
     PacketCapture pInterp;
@@ -420,8 +425,7 @@ void Vu1NativeDispatcher::runDiff(const Vu1RecProgram &program, VU1Interpreter &
     m_stats.vu1Cycles += interpCycle - c0;
 
     auto compare = [&](const char *variant, const VU1State &s, const std::vector<uint8_t> &d,
-                       const PacketCapture &pk, bool failed, uint64_t cycle, bool checkFlags,
-                       bool checkClip) -> bool
+                       const PacketCapture &pk, bool failed, uint64_t cycle, uint8_t liveFlags) -> bool
     {
         std::vector<std::string> diffs;
         char buf[256];
@@ -461,12 +465,11 @@ void Vu1NativeDispatcher::runDiff(const Vu1RecProgram &program, VU1Interpreter &
         cmpScalar("i", fbits(s.i), fbits(real.i));
         cmpScalar("r", s.r, real.r);
         cmpScalar("pc", s.pc, real.pc);
-        if (checkFlags)
-        {
+        if (liveFlags & 0x1)
             cmpScalar("mac", s.mac, real.mac);
+        if (liveFlags & 0x2)
             cmpScalar("status", s.status, real.status);
-        }
-        if (checkClip)
+        if (liveFlags & 0x4)
             cmpScalar("clip", s.clip, real.clip);
         if (cycle != interpCycle)
         {
@@ -524,8 +527,9 @@ void Vu1NativeDispatcher::runDiff(const Vu1RecProgram &program, VU1Interpreter &
         return false;
     };
 
-    if (!compare("full", sFull, dFull, pFull, fullFailed, fullCycle, true, true))
-        ++m_stats.diffMismatchFull;
+    const uint8_t liveFlags = program.live ? program.liveFlags : 0x7u;
+    if (!compare("live", sLive, dFull, pLive, liveFailed, liveCycle, liveFlags))
+        ++m_stats.diffMismatch;
 
     m_stats.diffPackets += pInterp.packets.size();
     for (const auto &packet : pInterp.packets)
@@ -565,7 +569,7 @@ void Vu1NativeDispatcher::printStats(const char *why)
                  (unsigned long long)s.fallbackNoProgram,
                  (unsigned long long)s.forcedInterpreter, (unsigned long long)s.mscnt,
                  (unsigned long long)s.nativeFailures, (unsigned long long)s.diffCalls,
-                 (unsigned long long)s.diffMismatchFull,
+                 (unsigned long long)s.diffMismatch,
                  (unsigned long long)s.diffInterpBudget,
                  ((s.mscal - l.mscal) + (s.mscnt - l.mscnt)) / dt,
                  (s.vu1Cycles - l.vu1Cycles) / dt / 1e6, vu1Share * 100.0, dt);
