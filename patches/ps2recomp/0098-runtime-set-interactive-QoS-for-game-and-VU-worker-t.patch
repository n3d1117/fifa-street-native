From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Fri, 23 Oct 2026 02:12:12 +0200
Subject: [PATCH 098/108] runtime: set interactive QoS for game and VU worker
 threads


diff --git a/ps2xRuntime/src/lib/ps2_data_stream.cpp b/ps2xRuntime/src/lib/ps2_data_stream.cpp
index 1b46625b955b3aac119acb449e32699d6828cea3..efba67b0d6162d390790d43ef4e6b88ba342fd93 100644
--- a/ps2xRuntime/src/lib/ps2_data_stream.cpp
+++ b/ps2xRuntime/src/lib/ps2_data_stream.cpp
@@ -1,4 +1,8 @@
 #include "ps2_data_stream.h"
+
+#if defined(__APPLE__)
+#include <pthread/qos.h>
+#endif
 #include "runtime/ps2_perf.h"
 #include "ThreadNaming.h"
 
@@ -69,6 +73,11 @@ bool DataStream::start(Mode mode)
         [](const StreamRing::Op &op) { return describe(op); });
     const bool ok = m_ring->start([this] {
                                       if (m_perfEnabled) ThreadNaming::SetCurrentThreadName("VU1GSWorker");
+#if defined(__APPLE__)
+                                      const char *threadQos = std::getenv("PS2X_THREAD_QOS");
+                                      if (!threadQos || std::strcmp(threadQos, "0") != 0)
+                                          pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+#endif
                                       return ps2x_metal_gs_create() != 0;
                                   },
                                   [] { ps2x_metal_gs_destroy(); });
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 98fee21dba8334dd612b96e09abf21d4885a27f9..b1f66e1ecf476c0b7d84694f3ffee0e11ff42769 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -45,6 +45,9 @@ extern "C" void ps2x_metal_host_stop();
 #include <iomanip>
 #include <thread>
 #if defined(__APPLE__)
+#include <pthread/qos.h>
+#endif
+#if defined(__APPLE__)
 #include <pthread.h>
 #include <system_error>
 #endif
@@ -2743,6 +2746,11 @@ void PS2Runtime::run()
     auto gameThreadBody = [&]()
                            {
         ThreadNaming::SetCurrentThreadName("GameThread");
+#if defined(__APPLE__)
+        const char *threadQos = std::getenv("PS2X_THREAD_QOS");
+        if (!threadQos || std::strcmp(threadQos, "0") != 0)
+            pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+#endif
         try
         {
 #if defined(PS2X_USE_METAL)
