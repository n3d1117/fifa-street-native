From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 21:48:01 +0200
Subject: [PATCH 064/100] MPEG GetPicture: repeat the nodata callback while it
 supplies data without a picture

libmpeg calls the input callback until a picture decodes. The HLE parked the
caller after the first serviced callback, so a movie stalled after the first
fragment. A callback that added no data still parks the caller.

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
index 5b4a1c46973be97f3505dd1add9f1470ef79c273..0aa1372bcc50be6857c03c2ba23bb580966c5067 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
@@ -508,6 +508,7 @@ namespace ps2_stubs
             bool streamEnded = false;
             bool decoderFailed = false;
             bool nodataCallbackServiced = false;
+            bool addBsSinceNodata = false;
             uint64_t cdStreamGeneration = 0u;
             bool waitingForVideoSequenceHeader = true;
             std::vector<uint8_t> videoSequenceSyncBuffer;
@@ -2035,6 +2036,8 @@ namespace ps2_stubs
             std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
             MpegPlaybackState &playback = getPlaybackState(mpegAddr);
             const size_t framesBefore = playback.decodedFrames.size();
+            if (byteCount)
+                playback.addBsSinceNodata = true;
             while (copied < byteCount)
             {
                 const uint32_t curAddr = dataAddr + static_cast<uint32_t>(copied);
@@ -2485,7 +2488,11 @@ namespace ps2_stubs
                 runtime->guestFree(callbackData);
                 {
                     std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
-                    getPlaybackState(mpegAddr).nodataCallbackServiced = true;
+                    MpegPlaybackState &pb = getPlaybackState(mpegAddr);
+                    // libmpeg repeats the nodata callback until a picture decodes;
+                    // only a callback that supplied no data parks the caller.
+                    pb.nodataCallbackServiced = !pb.addBsSinceNodata;
+                    pb.addBsSinceNodata = false;
                 }
                 sceMpegGetPicture(rdram, &parent, runtime);
             };
diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
