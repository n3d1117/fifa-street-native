+        else
+        {
+            ps2_stubs::notifyMpegCdStreamEof(runtime);
+        }
+        ctx->pc = 0u;
+    }
+
     void testMpegWaitProducer(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
     {
         gMpegWaitStage.store(2u, std::memory_order_release);
@@ -1373,6 +1389,39 @@ void register_ps2_runtime_expansion_tests()
             t.Equals(gMpegWaitResult.load(), 0, "EOF resumes without inventing a decoded frame");
         });
 
+        tc.Run("MPEG GetPicture requests more input while callbacks make progress without a picture", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            ps2_stubs::notifyMpegCdStreamStart();
+            runtime.registerFunction(kMpegWaitMainPc, testMpegWaitMain);
+            runtime.registerFunction(kMpegWaitResumePc, testMpegWaitResume);
+            runtime.registerFunction(kMpegWaitProducerPc, testMpegFragmentedInputCallback);
+            runtime.registerFunction(kMpegCallbackStopPc, testStopAfterMpegCallback);
+            gMpegInputCallbackCalls.store(0u);
+            gMpegWaitStage.store(0u);
+            gMpegWaitResult.store(-999);
+            R5900Context main{};
+            main.pc = kMpegWaitMainPc;
+            EeScheduler &ee = runtime.eeScheduler();
+            ee.reset(rdram.data(), main);
+            const int watchdog = ee.createThread(EeThreadCreateParams{
+                0u, kMpegCallbackStopPc, 0u, 0u, 0u, 10, 0u});
+            t.IsTrue(watchdog > 1, "a watchdog should bound a premature MPEG wait");
+            t.Equals(ee.startThread(watchdog, 0u, main, false), 0, "watchdog should become ready");
+            R5900Context registration{};
+            setRegU32(registration, 4, kMpegWaitHandle);
+            setRegU32(registration, 5, 1u);
+            setRegU32(registration, 6, kMpegWaitProducerPc);
+            ps2_stubs::sceMpegAddCallback(rdram.data(), &registration, &runtime);
+            ee.run();
+            t.Equals(gMpegInputCallbackCalls.load(), 3u,
+                     "GetPicture must request subsequent fragments until EOF rather than wait after the first");
+            t.Equals(gMpegWaitStage.load(), 3u, "the GetPicture caller should resume after input completes");
+            t.Equals(gMpegWaitResult.load(), 0, "EOF should complete without inventing a picture");
+        });
+
         tc.Run("sceMpegGetPicture blocks as a typed scheduler wait and resumes on EOF", [](TestCase &t)
         {
             PS2Runtime runtime;
