+    void testMpegFragmentedInputCallback(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t call = ++gMpegInputCallbackCalls;
+        if (call < 3u)
+        {
+            setRegU32(*ctx, 5, 0x3000u);
+            setRegU32(*ctx, 6, 2u);
+            ps2_stubs::sceMpegAddBs(rdram, ctx, runtime);
