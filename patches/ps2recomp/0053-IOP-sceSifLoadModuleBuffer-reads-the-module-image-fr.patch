+    void moduleLoadsFromIopMemory()
+    {
+        Host host;
+        IopSubsystem iop(host);
+        auto image = rpcServer(dbcSid, 0xDEADBEEFu);
+        std::vector<uint8_t> bytes(image.bytes.begin(), image.bytes.end());
+        const uint32_t buffer = iop.allocateMemory(static_cast<uint32_t>(bytes.size()), 64u);
+        require(buffer != 0u && iop.writeMemory(buffer, bytes.data(), bytes.size()), "IOP buffer write failed");
+        // sceSifLoadModuleBuffer's pointer is IOP RAM; nothing is installed in EE memory.
+        const auto loaded = iop.loadModuleFromIopMemory(buffer);
+        require(loaded.moduleId > 0 && loaded.startResult == 0, "module from IOP memory failed");
+    }
+
     void mcNewInit()
     {
         Host host;
