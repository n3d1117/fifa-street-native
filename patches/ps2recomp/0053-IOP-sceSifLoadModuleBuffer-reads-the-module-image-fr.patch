+    // The tag identifies a module image by its first bytes in IOP RAM (where the buffer lives).
+    std::string makeSifModuleBufferTag(const PS2Runtime *runtime, uint32_t bufferAddr)
+    {
+        std::vector<uint8_t> probe(kSifModuleBufferProbeBytes, 0u);
+        if (runtime)
+        {
+            (void)runtime->readIopMemory(bufferAddr, probe.data(), probe.size());
+        }
+        uint64_t hash = 0xcbf29ce484222325ull;
+        for (const uint8_t byte : probe)
+        {
+            hash = (hash ^ byte) * 0x100000001b3ull;
+        }
+        char key[96] = {};
+        std::snprintf(key, sizeof(key), "iopbuf:fnv64:%016llx", static_cast<unsigned long long>(hash));
+        return std::string(key);
+    }
+
     std::string makeSifModuleBufferTag(const uint8_t *rdram, uint32_t bufferAddr)
     {
         char key[96] = {};
