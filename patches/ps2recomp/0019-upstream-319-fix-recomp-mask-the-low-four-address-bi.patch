From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 18 Oct 2026 17:13:50 +0200
Subject: [PATCH 19/54] upstream #319: fix(recomp): mask the low four address
 bits of quadword accesses


diff --git a/ps2xRecomp/src/lib/instruction_translator.cpp b/ps2xRecomp/src/lib/instruction_translator.cpp
index 4bf8c7cf866d0af5a8273987505110e419054845..c00c1ae6d279b0b5aa0e3a8ea0e26b07132a8f85 100644
--- a/ps2xRecomp/src/lib/instruction_translator.cpp
+++ b/ps2xRecomp/src/lib/instruction_translator.cpp
@@ -60,6 +60,18 @@ namespace ps2recomp
                 "FAST_WRITE{}({}, _value); }} while (0)",
                 valueType, valueType, val, addr, memoryAccessSize(width), width, width, addr);
         }
+
+        // LQ, SQ, LQC2 and SQC2 ignore the low four bits of their effective address. READ128 and
+        // WRITE128 mask it themselves; the resolved-address and MMIO paths below bypass them.
+        uint32_t accessAddress(int width, uint32_t address)
+        {
+            return width == 128 ? (address & ~0xFu) : address;
+        }
+
+        std::string accessAddressExpr(int width, const std::string &addr)
+        {
+            return width == 128 ? fmt::format("PS2_QWORD_ADDR({})", addr) : addr;
+        }
     }
 
     InstructionTranslator::InstructionTranslator(CodeGenerator &codeGenerator)
@@ -85,7 +97,7 @@ namespace ps2recomp
     {
         if (memoryHint.hasAddress)
         {
-            const uint32_t resolvedAddress = memoryHint.address;
+            const uint32_t resolvedAddress = accessAddress(width, memoryHint.address);
             const std::string resolvedAddressExpr = addressLiteral(resolvedAddress);
             if (inst.isMmio || Ps2IsSpecialAddress(resolvedAddress))
             {
@@ -96,7 +108,7 @@ namespace ps2recomp
 
         if (inst.isMmio)
         {
-            return fmt::format("runtime->Load{}(rdram, ctx, {})", width, addr);
+            return fmt::format("runtime->Load{}(rdram, ctx, {})", width, accessAddressExpr(width, addr));
         }
         return fmt::format("READ{}({})", width, addr);
     }
@@ -109,7 +121,7 @@ namespace ps2recomp
     {
         if (memoryHint.hasAddress)
         {
-            const uint32_t resolvedAddress = memoryHint.address;
+            const uint32_t resolvedAddress = accessAddress(width, memoryHint.address);
             const std::string resolvedAddressExpr = addressLiteral(resolvedAddress);
             if (inst.isMmio || Ps2IsSpecialAddress(resolvedAddress))
             {
@@ -120,7 +132,7 @@ namespace ps2recomp
 
         if (inst.isMmio)
         {
-            return fmt::format("runtime->Store{}(rdram, ctx, {}, {})", width, addr, value);
+            return fmt::format("runtime->Store{}(rdram, ctx, {}, {})", width, accessAddressExpr(width, addr), value);
         }
         return fmt::format("WRITE{}({}, {})", width, addr, value);
     }
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 50689d19124289788487224bc0a2c9f7d00a65bc..036b9ffbd0974591d8342e4478c3ee95366d1f3b 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -666,8 +666,13 @@ static inline void Ps2FastWrite128(uint8_t *rdram, uint32_t addr, __m128i value)
         ? runtime->Load64(rdram, ctx, _addr)                  \
         : FAST_READ64(_addr); }())
 
+// 128-bit accesses are LQ, SQ, LQC2 and SQC2. The EE ignores the low four bits of their effective
+// address (PCSX2's interpreter and recompiler mask them the same way), so neither macro can touch
+// a misaligned quadword.
+#define PS2_QWORD_ADDR(addr) ((uint32_t)(addr) & ~0xFu)
+
 #define READ128(addr) ([&]() -> __m128i {                     \
-    uint32_t _addr = (uint32_t)(addr);                        \
+    uint32_t _addr = PS2_QWORD_ADDR(addr);                    \
     return PS2Runtime::isSpecialAddress(_addr)                \
         ? runtime->Load128(rdram, ctx, _addr)                 \
         : FAST_READ128(_addr); }())
@@ -727,7 +732,7 @@ static inline void Ps2FastWrite128(uint8_t *rdram, uint32_t addr, __m128i value)
 #define WRITE128(addr, val)                                                          \
     do                                                                               \
     {                                                                                \
-        uint32_t _addr = (addr);                                                     \
+        uint32_t _addr = PS2_QWORD_ADDR(addr);                                       \
         __m128i _value = (val);                                                      \
         if (PS2Runtime::isSpecialAddress(_addr))                                     \
             runtime->Store128(rdram, ctx, _addr, _value);                            \
