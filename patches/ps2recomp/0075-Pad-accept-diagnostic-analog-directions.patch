From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 05:31:39 +0200
Subject: [PATCH 75/93] Pad: accept diagnostic analog directions


diff --git a/ps2xRuntime/src/lib/ps2_pad.cpp b/ps2xRuntime/src/lib/ps2_pad.cpp
index 04810690df8c01fcaa823dd3eddf3a869abca452..cf80faa111fe89c3f335bb84866aa07ac1205bc5 100644
--- a/ps2xRuntime/src/lib/ps2_pad.cpp
+++ b/ps2xRuntime/src/lib/ps2_pad.cpp
@@ -100,6 +100,15 @@ bool PSPadBackend::readState(int /*port*/, int /*slot*/, uint8_t *data, size_t s
     if (keyDown(PS2X_KEY_RSHIFT)) clearBit(PAD_R2);
     if (keyDown(PS2X_KEY_ENTER)) clearBit(PAD_START);
     if (keyDown(PS2X_KEY_TAB)) clearBit(PAD_SELECT);
+    const bool stickLeft = keyDown(PS2X_DIAG_LEFT_STICK_LEFT);
+    const bool stickRight = keyDown(PS2X_DIAG_LEFT_STICK_RIGHT);
+    const bool stickUp = keyDown(PS2X_DIAG_LEFT_STICK_UP);
+    const bool stickDown = keyDown(PS2X_DIAG_LEFT_STICK_DOWN);
+    if (stickLeft || stickRight || stickUp || stickDown)
+    {
+        data[6] = stickLeft == stickRight ? kPadStickCenter : (stickLeft ? 0x00 : 0xFF);
+        data[7] = stickUp == stickDown ? kPadStickCenter : (stickUp ? 0x00 : 0xFF);
+    }
 #else
     if (useGamepad)
     {
