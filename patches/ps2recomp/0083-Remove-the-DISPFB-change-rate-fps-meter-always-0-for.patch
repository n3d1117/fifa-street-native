From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 22:38:50 +0200
Subject: [PATCH 83/88] Remove the DISPFB change-rate fps meter (always 0 for
 FIFA Street; pcsx2 GS now counts game frames)


diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index cf226f337062245f581c23fcf3ebc37a472c0666..08b43c565019c98a04204f48564222331e8d9e71 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -287,16 +287,6 @@ public:
     uint64_t dmaStartCount() const { return m_dmaStartCount.load(std::memory_order_relaxed); }
     uint64_t gifCopyCount() const { return m_gifCopyCount.load(std::memory_order_relaxed); }
     uint64_t gsWriteCount() const { return m_gsWriteCount.load(std::memory_order_relaxed); }
-    // DISPFB1/DISPFB2 writes that changed the register (game frame swaps; fps meter).
-    uint64_t dispfbSwapCount() const { return m_dispfbSwapCount.load(std::memory_order_relaxed); }
-    uint64_t dispfb2SwapCount() const { return m_dispfb2SwapCount.load(std::memory_order_relaxed); }
-    void noteGsPrivWrite(const uint64_t *reg, uint64_t oldValue, uint64_t newValue)
-    {
-        if ((reg == &gs_regs.dispfb1 || reg == &gs_regs.dispfb2) && oldValue != newValue)
-            m_dispfbSwapCount.fetch_add(1, std::memory_order_relaxed);
-        if (reg == &gs_regs.dispfb2 && oldValue != newValue)
-            m_dispfb2SwapCount.fetch_add(1, std::memory_order_relaxed);
-    }
     uint64_t vifWriteCount() const { return m_vifWriteCount.load(std::memory_order_relaxed); }
     uint64_t getVU0CodeGeneration() const { return m_vu0CodeGeneration.load(std::memory_order_relaxed); }
     uint64_t getVU1CodeGeneration() const { return m_vu1CodeGeneration.load(std::memory_order_relaxed); }
@@ -413,8 +403,6 @@ public:
     std::atomic<uint64_t> m_dmaStartCount{0};
     std::atomic<uint64_t> m_gifCopyCount{0};
     std::atomic<uint64_t> m_gsWriteCount{0};
-    std::atomic<uint64_t> m_dispfbSwapCount{0};
-    std::atomic<uint64_t> m_dispfb2SwapCount{0};
     std::atomic<uint64_t> m_vifWriteCount{0};
     std::atomic<uint64_t> m_vu0CodeGeneration{0};
     std::atomic<uint64_t> m_vu1CodeGeneration{0};
diff --git a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
index 8af4a90d2c73595a445433cf266be9aaad58eb7e..0fa6bb740f509ac9a52492faec47b7fa87923221 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1_recomp.h
@@ -176,8 +176,6 @@ private:
     Stats m_lastPrinted;
     Vu1RecContext *m_ctx = nullptr;     // heap: holds a 64 KiB kick buffer
     PS2Memory *m_memory = nullptr;
-    uint64_t m_lastSwaps = 0;
-    uint64_t m_lastSwaps2 = 0;
     double m_vu1Seconds = 0.0;
     double m_lastVu1Seconds = 0.0;
     // Position-independent programs found in the current micro memory.
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index ad8859e1ed78f97d093344f2973c8438bd57a1e5..b346a0ae6c7dd586a8abd39ff593c51407e220df 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1017,7 +1017,6 @@ void PS2Memory::write32(uint32_t address, uint32_t value)
         {
             uint64_t mask = 0xFFFFFFFFULL << (off * 8);
             uint64_t newVal = (*reg & ~mask) | ((uint64_t)value << (off * 8));
-            noteGsPrivWrite(reg, *reg, newVal);
             *reg = newVal;
         }
         return;
@@ -1077,7 +1076,6 @@ void PS2Memory::write64(uint32_t address, uint64_t value)
         }
         else if (uint64_t *reg = gsRegPtr(gs_regs, address))
         {
-            noteGsPrivWrite(reg, *reg, value);
             *reg = value;
         }
         return;
@@ -1232,7 +1230,6 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
         {
             const uint64_t mask = 0xFFFFFFFFull << (off * 8u);
             const uint64_t newVal = (*reg & ~mask) | (static_cast<uint64_t>(value) << (off * 8u));
-            noteGsPrivWrite(reg, *reg, newVal);
             *reg = newVal;
         }
         m_gsWriteCount.fetch_add(1, std::memory_order_relaxed);
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
index ac2fa6ae07b256656e3749d4569f5c3c3e4eb38f..4857e809bcd44afb42734f6c62c46e34f532ae54 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_recomp.cpp
@@ -555,18 +555,12 @@ void Vu1NativeDispatcher::printStats(const char *why)
     const Stats &s = m_stats;
     const Stats &l = m_lastPrinted;
     const uint64_t fallbacks = s.fallbackNoProgram + s.fallbackFailed;
-    const uint64_t swaps = m_memory ? m_memory->dispfbSwapCount() : 0u;
-    const double fps = (swaps - m_lastSwaps) / dt;
-    m_lastSwaps = swaps;
-    const uint64_t swaps2 = m_memory ? m_memory->dispfb2SwapCount() : 0u;
-    const double fps2 = (swaps2 - m_lastSwaps2) / dt;
-    m_lastSwaps2 = swaps2;
     const double vu1Share = (m_vu1Seconds - m_lastVu1Seconds) / dt;
     m_lastVu1Seconds = m_vu1Seconds;
     std::fprintf(stderr,
                  "[vu1rec] %s: mscal=%llu native=%llu fallback=%llu (noprogram=%llu) forced=%llu "
                  "mscnt=%llu nativeFail=%llu | diff calls=%llu mismatch=%llu interpBudget=%llu "
-                 "| %.1f calls/s, %.2f Mcyc/s, DISPFB1/2 changes/s %.2f (DISPFB2 %.2f), VU1 time %.1f%% over %.1fs\n",
+                 "| %.1f calls/s, %.2f Mcyc/s, VU1 time %.1f%% over %.1fs\n",
                  why, (unsigned long long)s.mscal, (unsigned long long)s.native, (unsigned long long)fallbacks,
                  (unsigned long long)s.fallbackNoProgram,
                  (unsigned long long)s.forcedInterpreter, (unsigned long long)s.mscnt,
@@ -574,7 +568,7 @@ void Vu1NativeDispatcher::printStats(const char *why)
                  (unsigned long long)s.diffMismatchFull,
                  (unsigned long long)s.diffInterpBudget,
                  ((s.mscal - l.mscal) + (s.mscnt - l.mscnt)) / dt,
-                 (s.vu1Cycles - l.vu1Cycles) / dt / 1e6, fps, fps2, vu1Share * 100.0, dt);
+                 (s.vu1Cycles - l.vu1Cycles) / dt / 1e6, vu1Share * 100.0, dt);
     m_lastPrinted = m_stats;
     m_lastStatsTime = t;
 }
