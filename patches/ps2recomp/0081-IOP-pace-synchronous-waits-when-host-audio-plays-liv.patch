@@ -807,6 +841,7 @@ namespace ps2x::iop::detail
             const uint32_t waitPc = activeCpu ? activeCpu->pc : 0u;
             const uint32_t waitRa = activeCpu ? activeCpu->gpr[31] : 0u;
             const uint64_t idleProbeCycles = std::max<uint64_t>(iopHostSpu2().maxIdleStep, 1u);
+            const OutsidePacer pacer(totalCycles);
             while (!kernel.eventFlagSatisfied(id, bits, mode) && totalCycles < target)
             {
                 // Bound each step before entering scheduleStep: with no next
@@ -815,6 +850,7 @@ namespace ps2x::iop::detail
                 // full one-second fallback in one scheduler call.
