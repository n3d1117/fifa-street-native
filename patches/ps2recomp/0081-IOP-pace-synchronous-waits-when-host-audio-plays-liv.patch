+    // A registered SPU2 interrupt can wake an event waiter, so an unsignaled
+    // flag must consume its bounded fallback. Live output must receive that
+    // second over wall time instead of an audio-ring-sized burst.
+    for (const bool realTime : {false, true})
+    {
+        iop.reset();
+        spu2Hooks.realTime = realTime;
+        iopSetHostSpu2(spu2Hooks);
+        writeRpcEventWaitIrx(host, 0x100u, eventWaitSid, true);
+        const ModuleLoadResult pacedWaitModule = iop.loadModuleBuffer(0x100u);
+        if (!expect(pacedWaitModule.handled && pacedWaitModule.startResult == 0,
+                    "SPU2-interrupt event-wait fixture did not start")) return 1;
+        const uint64_t cyclesBefore = iop.debugSnapshot().emulatorCycles;
+        const auto wallBefore = std::chrono::steady_clock::now();
+        const RpcResult pacedWaitResult = iop.handleRpc(eventWaitRequest);
+        const auto elapsed = std::chrono::steady_clock::now() - wallBefore;
+        const uint64_t cyclesAfter = iop.debugSnapshot().emulatorCycles;
+        const uint64_t cycleDelta = cyclesAfter - cyclesBefore;
+        iopSetHostSpu2(IopHostSpu2{});
+        if (!expect(pacedWaitResult.handled && cycleDelta >= 36'864'000u && cycleDelta < 36'865'000u,
+                    "SPU2-capable event wait did not consume exactly its one-second fallback")) return 1;
+        if (!expect(!realTime || elapsed >= std::chrono::milliseconds(900),
+                    "Live SPU2 event wait advanced one IOP second without pacing host output")) return 1;
+        iop.runEeCycles(cyclesAfter * 8u);
+        if (!expect(iop.debugSnapshot().emulatorCycles == cyclesAfter,
+                    "EE budget counted synchronous event-wait cycles twice")) return 1;
+        iop.runEeCycles(8u);
+        if (!expect(iop.debugSnapshot().emulatorCycles == cyclesAfter + 1u,
+                    "EE budget did not resume after repaying synchronous event-wait cycles")) return 1;
+    }
