+        // A synchronous call blocks the EE for as long as the IOP work takes on hardware. With real host audio the
+        // IOP clock must not run ahead of the host clock inside such a call: the SPU would mix seconds of audio
+        // in one burst, overflow its output ring and then starve while the clock catches up.
+        struct OutsidePacer
+        {
+            const bool active;
+            const uint64_t &total;
+            const uint64_t cycle0;
+            const std::chrono::steady_clock::time_point wall0;
+            OutsidePacer(const uint64_t &totalCycles)
+                : active(iopHostSpu2().realTime), total(totalCycles), cycle0(totalCycles),
+                  wall0(std::chrono::steady_clock::now()) {}
+            void tick() const
+            {
+                if (!active)
+                    return;
+                const uint64_t cycles = total - cycle0;
+                const auto due = wall0 + std::chrono::seconds(cycles / kIopClockHz) +
+                    std::chrono::nanoseconds((cycles % kIopClockHz) * 1'000'000'000ull / kIopClockHz);
+                if (due > std::chrono::steady_clock::now() + std::chrono::milliseconds(1))
+                    std::this_thread::sleep_until(due);
+            }
+        };
+
         bool advanceOutsideScheduler(uint64_t cycles)
         {
             if (cycles == 0u)
@@ -739,8 +765,12 @@ namespace ps2x::iop::detail
