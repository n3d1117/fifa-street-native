From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Wed, 21 Oct 2026 17:04:56 +0200
Subject: [PATCH 089/105] runtime: pause stream watchdog during host drawable
 waits


diff --git a/ps2xRuntime/include/runtime/ps2_host_present.h b/ps2xRuntime/include/runtime/ps2_host_present.h
new file mode 100644
index 0000000000000000000000000000000000000000..435e2c919c4a719034592e7af1dafae4184f3931
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_present.h
@@ -0,0 +1,11 @@
+#ifndef PS2_HOST_PRESENT_H
+#define PS2_HOST_PRESENT_H
+
+#include <atomic>
+
+namespace ps2x
+{
+inline std::atomic<bool> hostPresentInProgress{false};
+}
+
+#endif
diff --git a/ps2xRuntime/include/runtime/ps2_stream_ring.h b/ps2xRuntime/include/runtime/ps2_stream_ring.h
index 0703628c17d03406aa7146df120f1ef07b2b2229..652bf2ace4ae6e0a58637f712b897a5374dd56c7 100644
--- a/ps2xRuntime/include/runtime/ps2_stream_ring.h
+++ b/ps2xRuntime/include/runtime/ps2_stream_ring.h
@@ -15,6 +15,7 @@
 #include <string>
 #include <thread>
 #include <pthread.h>
+#include "runtime/ps2_host_present.h"
 
 // Single-producer single-consumer ordered op ring with one consumer thread.
 //
@@ -207,7 +208,7 @@ private:
     {
         if (m_tail.load(std::memory_order_acquire) >= position)
             return;
-        const auto begin = std::chrono::steady_clock::now();
+        auto begin = std::chrono::steady_clock::now();
         for (int spin = 0; spin < 2000; ++spin)
         {
             if (m_tail.load(std::memory_order_acquire) >= position)
@@ -224,7 +225,11 @@ private:
             }
             if (m_tail.load(std::memory_order_acquire) >= position || m_failed.load(std::memory_order_acquire))
                 break;
-            if (std::chrono::steady_clock::now() - begin > std::chrono::milliseconds(m_watchdogMs))
+            const auto now = std::chrono::steady_clock::now();
+            // macOS may suspend drawable delivery while the display sleeps; that host wait is not an emulation deadlock.
+            if (ps2x::hostPresentInProgress.load(std::memory_order_acquire))
+                begin = now;
+            else if (now - begin > std::chrono::milliseconds(m_watchdogMs))
             {
                 reportHang(why);
                 std::abort();
