diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 8fc54f6ce155b2156b6cb68f8e0ea01faee2c09e..bcb0325f43b2e5e46215d69db48bce88ac678f69 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1406,6 +1406,31 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
             if (channelBase == 0x1000B400u && tryProcessIpuToHleDma(*this, value))
                 return true;
 
+            // PCSX2 dmaVIF1 selects normal-to-memory for DIR=0 even when MOD=chain.
+            if (channelBase == 0x10009000u && (value & 1u) == 0u && qwc != 0u)
+            {
+                const uint32_t destination = translateAddress(madr);
+                const uint32_t capacity = isScratchpad(madr) ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+                uint8_t *base = isScratchpad(madr) ? m_scratchpad : m_rdram;
+                if (destination >= capacity) throw std::runtime_error("VIF1 download destination outside memory");
+                const uint32_t bytes = std::min(qwc, (capacity - destination) / 16u) * 16u;
+                const uint32_t copied = m_gsReadFifoCallback ? m_gsReadFifoCallback(base + destination, bytes) : 0u;
+                if (copied > bytes) throw std::runtime_error("GS download exceeded VIF1 DMA destination");
+                if (copied) markModified(madr, copied);
+                const uint32_t transferred = (copied + 15u) / 16u;
+                m_ioRegisters[channelBase + 0x10u] = madr + transferred * 16u;
+                m_ioRegisters[channelBase + 0x20u] = qwc - transferred;
+                if (transferred == qwc)
+                {
+                    m_ioRegisters[channelBase] &= ~0x100u;
+                    m_ioRegisters[0x1000E010u] |= 1u << 1u;
+                    if (m_ioRegisters[0x1000E010u] & (1u << 17u))
+                        m_ioRegisters[0x1000E010u] |= 1u << 31u;
+                    queueCompletedDmacCause(1u);
+                }
+                return true;
+            }
+
             if (channelBase == 0x10009000u && tryProcessVif1Mfifo(*this))
             {
                 return true;
