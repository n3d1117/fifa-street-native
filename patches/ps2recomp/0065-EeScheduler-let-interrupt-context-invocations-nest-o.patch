From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 22:12:17 +0200
Subject: [PATCH 65/67] EeScheduler: let interrupt-context invocations nest on
 an HLE callback

A guest callback run by an HLE call (libmpeg nodata) polls state that timer and VBlank handlers update; pending invocations only started on a thread with an empty invocation stack, so TIM1 stopped (game tick 1/s instead of 60/s). Interrupt, Alarm and GsCallback invocations now nest on an HleCall.

diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index 04d989533db638b828ed0d5560e0186d6af014b8..9e272698cab83dbf28a0e565aa6faa359ad17298 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -305,7 +305,17 @@ void EeScheduler::run()
             continue;
         }
 
-        if (!m_pendingInvocations.empty() && running->invocations.empty())
+        // A guest callback run by an HLE call (libmpeg nodata, IPU) executes with
+        // interrupts enabled: it may wait for a timer or VBlank handler to progress.
+        const auto interruptContext = [](GuestInvocationKind kind)
+        {
+            return kind == GuestInvocationKind::Interrupt || kind == GuestInvocationKind::Alarm ||
+                   kind == GuestInvocationKind::GsCallback;
+        };
+        if (!m_pendingInvocations.empty() &&
+            (running->invocations.empty() ||
+             (running->invocations.back().kind == GuestInvocationKind::HleCall &&
+              interruptContext(m_pendingInvocations.front().kind))))
         {
             GuestInvocation invocation = std::move(m_pendingInvocations.front());
             m_pendingInvocations.pop_front();
