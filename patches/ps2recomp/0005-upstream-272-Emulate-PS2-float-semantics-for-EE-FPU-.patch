From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: drako <98249188+drakolordx7@users.noreply.github.com>
Date: Wed, 14 Oct 2026 08:47:18 -0500
Subject: [PATCH 05/90] upstream #272: Emulate PS2 float semantics for EE FPU
 results and DIV.S/RSQRT.S


diff --git a/ps2xRecomp/src/lib/fpu_translator.cpp b/ps2xRecomp/src/lib/fpu_translator.cpp
index db8b6bebb3387ae1b86f1616aa72d4fc3a2d2c2c..6f2f1c9d425dd980e5884c28c3fb6874779c3eaa 100644
--- a/ps2xRecomp/src/lib/fpu_translator.cpp
+++ b/ps2xRecomp/src/lib/fpu_translator.cpp
@@ -53,30 +53,21 @@ namespace ps2recomp
             case COP1_S_MUL:
                 return fmt::format("ctx->f[{}] = FPU_MUL_S(ctx->f[{}], ctx->f[{}]);", fd, fs, ft);
             case COP1_S_DIV:
-                // R5900 DIV.S treats zero and denormal divisors as zero and
-                // saturates the quotient to signed FLT_MAX. Capture both
-                // operands before writing Fd so Fs/Ft/Fd aliases are safe.
+                // R5900 DIV.S: a zero or denormal divisor sets the divide-by-zero (or invalid for 0/0)
+                // cause+sticky flags; the quotient comes from FPU_DIV_S (PS2 float semantics, +-0x7FFFFFFF).
+                // Capture both operands before writing Fd so Fs/Ft/Fd aliases are safe.
                 return fmt::format(
                     "{{ const float divFs = ctx->f[{}]; const float divFt = ctx->f[{}]; "
                     "uint32_t divFsBits; uint32_t divFtBits; "
                     "std::memcpy(&divFsBits, &divFs, sizeof(divFsBits)); "
                     "std::memcpy(&divFtBits, &divFt, sizeof(divFtBits)); "
-                    "if ((divFtBits & 0x7f800000u) == 0) {{ "
+                    "if ((divFtBits & 0x7f800000u) == 0) "
                     "ctx->fcr31 |= ((divFsBits & 0x7f800000u) == 0) ? 0x00020040u : 0x00010020u; "
-                    "const uint32_t divResultBits = ((divFsBits ^ divFtBits) & 0x80000000u) | 0x7f7fffffu; "
-                    "std::memcpy(&ctx->f[{}], &divResultBits, sizeof(divResultBits)); "
-                    "}} else ctx->f[{}] = divFs / divFt; }}",
-                    fs, ft, fd, fd);
+                    "ctx->f[{}] = FPU_DIV_S(divFs, divFt); }}",
+                    fs, ft, fd);
             case COP1_S_SQRT:
-                // R5900 SQRT.S reads Ft (not Fs), and takes the absolute
-                // value of negative inputs. Preserve signed zero and avoid
-                // clobbering Ft when Fd aliases it.
-                return fmt::format(
-                    "{{ const float sqrtFt = ctx->f[{}]; uint32_t sqrtFtBits; "
-                    "std::memcpy(&sqrtFtBits, &sqrtFt, sizeof(sqrtFtBits)); "
-                    "ctx->f[{}] = ((sqrtFtBits & 0x7fffffffu) == 0) ? "
-                    "(sqrtFtBits & 0x80000000u) ? -0.0f : 0.0f : FPU_SQRT_S(fabsf(sqrtFt)); }}",
-                    ft, fd);
+                // R5900 SQRT.S reads Ft (not Fs) and takes sqrt(|Ft|); FPU_SQRT_S applies the PS2 float rules.
+                return fmt::format("ctx->f[{}] = FPU_SQRT_S(ctx->f[{}]);", fd, ft);
             case COP1_S_ABS:
                 return fmt::format("ctx->f[{}] = FPU_ABS_S(ctx->f[{}]);", fd, fs);
             case COP1_S_MOV:
@@ -94,17 +85,8 @@ namespace ps2recomp
             case COP1_S_CVT_W:
                 return fmt::format("{{ int32_t tmp = FPU_CVT_W_S(ctx->f[{}]); std::memcpy(&ctx->f[{}], &tmp, sizeof(tmp)); }}", fs, fd);
             case COP1_S_RSQRT:
-                // R5900 RSQRT.S is Fs / sqrt(abs(Ft)), not the unary
-                // reciprocal-square-root operation.  The EE treats zero and
-                // denormal Ft as zero, returning FLT_MAX with Ft's sign.
-                return fmt::format(
-                    "{{ const float rsqrtFs = ctx->f[{}]; "
-                    "uint32_t rsqrtFtBits; std::memcpy(&rsqrtFtBits, &ctx->f[{}], sizeof(rsqrtFtBits)); "
-                    "const float rsqrtFt = fabsf(ctx->f[{}]); "
-                    "ctx->f[{}] = ((rsqrtFtBits & 0x7f800000u) == 0) ? "
-                    "copysignf(0x1.fffffep+127f, ctx->f[{}]) : "
-                    "FPU_DIV_S(rsqrtFs, FPU_SQRT_S(rsqrtFt)); }}",
-                    fs, ft, ft, fd, ft);
+                // R5900 RSQRT.S is Fs / sqrt(abs(Ft)); FPU_RSQRT_S handles zero Ft and PS2 float semantics.
+                return fmt::format("ctx->f[{}] = FPU_RSQRT_S(ctx->f[{}], ctx->f[{}]);", fd, fs, ft);
             case COP1_S_ADDA:
                 return fmt::format("FPU_SET_ACC(ctx, FPU_ADD_S(ctx->f[{}], ctx->f[{}]));", fs, ft);
             case COP1_S_SUBA:
