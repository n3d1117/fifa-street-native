+    tc.Run("EE LQ/SQ align effective addresses while VU0 LQC2/SQC2 preserve them", [](TestCase &t) {
+        CodeGenerator gen({}, {});
+        const std::string lq = gen.translateInstruction(makeIType(0x8F20u, OPCODE_LQ, 1u, 2u, 3u));
+        const std::string sq = gen.translateInstruction(makeIType(0x8F24u, OPCODE_SQ, 1u, 2u, 3u));
+        const std::string lqc2 = gen.translateInstruction(makeIType(0x8F28u, OPCODE_LQC2, 1u, 2u, 3u));
+        const std::string sqc2 = gen.translateInstruction(makeIType(0x8F2Cu, OPCODE_SQC2, 1u, 2u, 3u));
+
+        t.IsTrue(lq.find("& ~0xFu") != std::string::npos, "LQ must align its effective address down to 16 bytes");
+        t.IsTrue(sq.find("& ~0xFu") != std::string::npos, "SQ must align its effective address down to 16 bytes");
+        t.IsTrue(lqc2.find("& ~0xFu") == std::string::npos, "LQC2 must preserve the unaligned effective address");
+        t.IsTrue(sqc2.find("& ~0xFu") == std::string::npos, "SQC2 must preserve the unaligned effective address");
+
+        MemoryAccessHint hint{};
+        hint.hasAddress = true;
+        hint.address = 0x1003u;
+        const std::string hintedLq = gen.translateInstruction(makeIType(0x8F30u, OPCODE_LQ, 1u, 2u, 3u), hint);
+        const std::string hintedLqc2 = gen.translateInstruction(makeIType(0x8F34u, OPCODE_LQC2, 1u, 2u, 3u), hint);
+        t.IsTrue(hintedLq.find("FAST_READ128(0x1000u)") != std::string::npos,
+                 "resolved LQ memory hints must use the aligned effective address");
+        t.IsTrue(hintedLqc2.find("FAST_READ128(0x1003u)") != std::string::npos,
+                 "resolved LQC2 memory hints must retain the raw effective address");
+    });
