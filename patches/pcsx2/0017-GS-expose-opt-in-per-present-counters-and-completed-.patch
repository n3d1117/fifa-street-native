+struct RrvMetalPerfPending
+{
+	std::mutex mutex;
+	RrvGsPerfFrame frame;
+	size_t pending = 0;
+	bool sealed = false;
+
+	void Finish(bool seal, double gpu_ms = 0)
+	{
+		RrvGsPerfFrame completed;
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			frame.gpu_ms += gpu_ms;
+			if (seal)
+				sealed = true;
+			else
+				--pending;
+			if (!sealed || pending != 0)
+				return;
+			completed = frame;
+			completed.completed = 1;
+		}
+		if (const auto callback = g_rrv_perf_callback.load(std::memory_order_acquire))
+			callback(&completed, g_rrv_perf_context.load(std::memory_order_acquire));
+	}
+};
+
+void GSDeviceMTL::TrackPerfBuffer(id<MTLCommandBuffer> buffer)
+{
+	if (!g_rrv_perf_callback.load(std::memory_order_relaxed))
+		return;
+	if (!m_perf_frame)
+		m_perf_frame = std::make_shared<RrvMetalPerfPending>();
+	const auto frame = m_perf_frame;
+	{
+		std::lock_guard<std::mutex> lock(frame->mutex);
+		++frame->pending;
+	}
+	[buffer addCompletedHandler:[frame](id<MTLCommandBuffer> completed)
+	{
+		const double elapsed = [completed GPUEndTime] - [completed GPUStartTime];
+		frame->Finish(false, std::max(0.0, elapsed) * 1000.0);
+	}];
+}
+
+void GSDeviceMTL::SealPerfFrame()
+{
+	if (!g_rrv_perf_callback.load(std::memory_order_relaxed))
+		return;
+	if (!m_perf_frame)
+		m_perf_frame = std::make_shared<RrvMetalPerfPending>();
+	const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	auto& frame = m_perf_frame->frame;
+	frame.t = now;
+	frame.present_dt_ms = m_perf_last_present ? (now - m_perf_last_present) * 1000.0 : 0;
+	m_perf_last_present = now;
+	frame.game_frame = g_rrv_perf_field;
+	const auto delta = [](GSPerfMon::counter_t counter, double& previous) -> u64 {
+		const double current = g_perfmon.GetPerfTotal(counter);
+		const u64 result = static_cast<u64>(current - previous);
+		previous = current;
+		return result;
+	};
+	frame.draws = delta(GSPerfMon::DrawCalls, m_perf_draws);
+	frame.render_passes = delta(GSPerfMon::RenderPasses, m_perf_passes);
+	frame.tex_uploads = delta(GSPerfMon::TextureUploads, m_perf_uploads);
+	frame.tex_upload_bytes = delta(GSPerfMon::TextureUploadBytes, m_perf_upload_bytes);
+	frame.readbacks = delta(GSPerfMon::Readbacks, m_perf_readbacks);
+	frame.pipeline_compiles = m_rrv_runtime_pipeline_compiles - m_perf_pipeline_compiles;
+	m_perf_pipeline_compiles = m_rrv_runtime_pipeline_compiles;
+	RrvGsPerfFrame submitted;
+	{
+		std::lock_guard<std::mutex> lock(m_perf_frame->mutex);
+		submitted = frame;
+	}
+	if (const auto callback = g_rrv_perf_callback.load(std::memory_order_acquire))
+		callback(&submitted, g_rrv_perf_context.load(std::memory_order_acquire));
+	auto completed = std::move(m_perf_frame);
+	completed->Finish(true);
+}
