+struct RrvGsPerfFrame
+{
+    uint32_t struct_size = sizeof(RrvGsPerfFrame);
+    double t = 0, present_dt_ms = 0, gpu_ms = 0, present_wait_ms = 0;
+    uint64_t game_frame = 0, draws = 0, render_passes = 0, tex_uploads = 0;
+    uint64_t tex_upload_bytes = 0, readbacks = 0, pipeline_compiles = 0;
+    uint32_t completed = 0;
+};
+using RrvGsPerfCallback = void (*)(const RrvGsPerfFrame*, void*);
+extern std::atomic<RrvGsPerfCallback> g_rrv_perf_callback;
+extern std::atomic<void*> g_rrv_perf_context;
+extern uint64_t g_rrv_perf_field;
