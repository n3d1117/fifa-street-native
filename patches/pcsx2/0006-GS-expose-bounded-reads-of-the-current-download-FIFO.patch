From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Wed, 21 Oct 2026 04:09:41 +0200
Subject: [PATCH 06/18] GS: expose bounded reads of the current download FIFO

Let VIF1 reverse DMA consume the native transfer cursor without rebuilding descriptors on the EE. Limit each request to the remaining image, use the checked native InitReadFIFO/ReadFIFO path and preserve incremental cursor state.

Verified with the Metal host smoke fixture: two 16-byte downloads reproduce the uploaded pixels and an exhausted transfer returns zero.

diff --git a/pcsx2/GS/GS.cpp b/pcsx2/GS/GS.cpp
index c005e070f78fcb4f9feb6ecd836c08b4ee9201a4..cbebc7ebea68e05ac18d9b8796e282ca6cf6d26e 100644
--- a/pcsx2/GS/GS.cpp
+++ b/pcsx2/GS/GS.cpp
@@ -477,6 +477,14 @@ void GSSyncRasterizer()
 		g_gs_renderer->RrvSyncRasterizer();
 }
 
+u32 GSReadCurrentFIFO(u8* mem, u32 max_bytes)
+{
+	if (!g_gs_renderer || !mem)
+		return 0;
+	GSSyncRasterizer();
+	return g_gs_renderer->RrvReadCurrentFIFO(mem, max_bytes);
+}
+
 bool GSReadLocalMemoryChecked(u8* mem, u32 byte_count, u64 BITBLITBUF, u64 TRXPOS, u64 TRXREG)
 {
 	if (!g_gs_renderer || !mem)
diff --git a/pcsx2/GS/GS.h b/pcsx2/GS/GS.h
index 166c3504ce3194732871534e35948f5bf51c7a0c..3c0aec0e02ff300ee7023c2fb038be6de2b21370 100644
--- a/pcsx2/GS/GS.h
+++ b/pcsx2/GS/GS.h
@@ -69,6 +69,7 @@ void GSReadLocalMemoryUnsync(u8* mem, u32 qwc, u64 BITBLITBUF, u64 TRXPOS, u64 T
 // RRV GS-bridge extension: validate and consume one already-issued native
 // local-to-host transaction. The GSState transfer cursor remains authoritative.
 bool GSReadLocalMemoryChecked(u8* mem, u32 byte_count, u64 BITBLITBUF, u64 TRXPOS, u64 TRXREG);
+u32 GSReadCurrentFIFO(u8* mem, u32 max_bytes);
 // RRV GS-bridge extension: synchronous full 4 MiB GS local-memory transfer.
 // Callers serialize these with all GIF/CRTC work; restoring invalidates cached
 // renderer surfaces before they can be sampled again.
diff --git a/pcsx2/GS/GSState.cpp b/pcsx2/GS/GSState.cpp
index a5d275a122bfaacd0144678d92b1e45412ea3796..8de64eaac3382da2a1c2cd6da2071e914b35d4a3 100644
--- a/pcsx2/GS/GSState.cpp
+++ b/pcsx2/GS/GSState.cpp
@@ -3073,6 +3073,20 @@ void GSState::Read(u8* mem, int len)
 		m_env.TRXDIR.XDIR = 3;
 }
 
+u32 GSState::RrvReadCurrentFIFO(u8* mem, u32 max_bytes)
+{
+	if (!mem || (max_bytes & 15u) || m_env.TRXDIR.XDIR != 1 || m_tr.end < 0)
+		return 0;
+	const u64 total = (static_cast<u64>(m_tr.m_reg.RRW) * m_tr.m_reg.RRH *
+		GSLocalMemory::m_psm[m_tr.m_blit.SPSM].trbpp + 7u) >> 3;
+	if (total <= static_cast<u64>(m_tr.end))
+		return 0;
+	const u32 bytes = static_cast<u32>(std::min<u64>(max_bytes, total - m_tr.end));
+	if (!RrvReadLocalMemoryChecked(mem, bytes, m_tr.m_blit, m_tr.m_pos, m_tr.m_reg))
+		return 0;
+	return (bytes + 15u) & ~15u;
+}
+
 bool GSState::RrvReadLocalMemoryChecked(u8* mem, u32 byte_count, GIFRegBITBLTBUF BITBLTBUF,
 	GIFRegTRXPOS TRXPOS, GIFRegTRXREG TRXREG)
 {
diff --git a/pcsx2/GS/GSState.h b/pcsx2/GS/GSState.h
index 24c6284696f5b59a499408077c399b81a7961b7b..2559da7959395d0286fc54e04bd5f9823f79a70d 100644
--- a/pcsx2/GS/GSState.h
+++ b/pcsx2/GS/GSState.h
@@ -542,6 +542,7 @@ public:
 	// transfer armed by GIFRegHandlerTRXDIR; it owns no bridge-side cursor.
 	bool RrvReadLocalMemoryChecked(u8* mem, u32 byte_count, GIFRegBITBLTBUF BITBLTBUF,
 		GIFRegTRXPOS TRXPOS, GIFRegTRXREG TRXREG);
+	u32 RrvReadCurrentFIFO(u8* mem, u32 max_bytes);
 	template<int index> void Transfer(const u8* mem, u32 size);
 	int Freeze(freezeData* fd, bool sizeonly);
 	int Defrost(const freezeData* fd);
