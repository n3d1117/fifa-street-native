From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Mon, 19 Oct 2026 17:07:24 +0200
Subject: [PATCH 2/9] Remove Tarzan-specific GS traces and the menu-grid
 coverage hack

The UI half-pixel coverage correction matched one game's menu quads; a faithful
port keeps upstream rasterization. The scanout and UI-draw traces were
one-off evidence for that game.

diff --git a/pcsx2/GS/Renderers/Common/GSRenderer.cpp b/pcsx2/GS/Renderers/Common/GSRenderer.cpp
index 4c91ee21812b17785ce6b28f9fbf350e4ac54817..b5c7cc6554c823e518b566dfe22574cd20d31739 100644
--- a/pcsx2/GS/Renderers/Common/GSRenderer.cpp
+++ b/pcsx2/GS/Renderers/Common/GSRenderer.cpp
@@ -632,17 +632,6 @@ void GSRenderer::VSync(u32 field, bool registers_written, bool idle_frame)
 	}
 
 	const bool blank_frame = !Merge(field);
-	// Opt-in evidence for native-port menu flashes. Snapshot APIs retain the
-	// previous merged texture when Merge fails, so screenshots alone hide this.
-	if (std::getenv("TARZAN_TRACE_SCANOUT") && g_perfmon.GetFrame() > 1500)
-	{
-		static unsigned trace_count = 0;
-		if (trace_count++ < 10000)
-			std::fprintf(stderr, "[tarzan-scanout] frame=%llu field=%u blank=%d fbp1=%x fbp2=%x current=%p\n",
-				static_cast<unsigned long long>(g_perfmon.GetFrame()), field, blank_frame ? 1 : 0,
-				m_regs->DISP[0].DISPFB.FBP, m_regs->DISP[1].DISPFB.FBP,
-				static_cast<void*>(g_gs_device->GetCurrent()));
-	}
 
 	m_last_draw_n = s_n;
 	m_last_transfer_n = s_transfer_n;
diff --git a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
index 7a528e430dbdc2c773fc832fab5613c2ee5462ed..837b1e00aad2f38a6b689b61ed6b92b1a2fcc4fa 100644
--- a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
+++ b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
@@ -11,9 +11,6 @@
 #include "common/BitUtils.h"
 #include "common/StringUtil.h"
 #include <bit>
-#include <cstdio>
-#include <cstdlib>
-#include <chrono>
 
 using PS_ATST  = GSShader::PS_ATST;
 using PS_AFAIL = GSShader::PS_AFAIL;
@@ -155,33 +152,10 @@ GSTexture* GSRendererHW::GetOutput(int i, float& scale, int& y_offset)
 
 	GSPCRTCRegs::PCRTCDisplay& curFramebuffer = PCRTCDisplays.PCRTCDisplays[index];
 	const GSVector2i framebufferSize(PCRTCDisplays.GetFramebufferSize(i));
-	static unsigned int scanout_trace_count = 0;
-	const bool trace_scanout = std::getenv("TARZAN_TRACE_SCANOUT") && g_perfmon.GetFrame() > 1500 &&
-		scanout_trace_count < 10000;
-	const auto trace_output = [&](const char* reason, u32 fbp)
-	{
-		if (!trace_scanout)
-			return;
-		++scanout_trace_count;
-		std::fprintf(stderr,
-			"[tarzan-getoutput] frame=%llu circuit_arg=%d index=%d result=%s FBP=%x FBW=%u PSM=%u "
-			"req=%dx%d fbrect=(%d,%d,%d,%d) displayrect=(%d,%d,%d,%d) mag=%dx%d drawfb=%x/%x\n",
-			static_cast<unsigned long long>(g_perfmon.GetFrame()), i, index, reason, fbp, curFramebuffer.FBW,
-			static_cast<unsigned>(curFramebuffer.PSM), framebufferSize.x, framebufferSize.y,
-			curFramebuffer.framebufferRect.x, curFramebuffer.framebufferRect.y,
-			curFramebuffer.framebufferRect.z, curFramebuffer.framebufferRect.w,
-			curFramebuffer.displayRect.x, curFramebuffer.displayRect.y,
-			curFramebuffer.displayRect.z, curFramebuffer.displayRect.w,
-			curFramebuffer.magnification.x, curFramebuffer.magnification.y,
-			m_env.CTXT[0].FRAME.FBP, m_env.CTXT[1].FRAME.FBP);
-	};
 
 	// Try to avoid broken/incomplete setups which are probably ignored on console, but can cause us problems.
 	if (curFramebuffer.framebufferRect.rempty() || curFramebuffer.FBW == 0 || framebufferSize.x < 0 || framebufferSize.y < 0)
-	{
-		trace_output("invalid-geometry", curFramebuffer.Block());
 		return nullptr;
-	}
 
 	PCRTCDisplays.RemoveFramebufferOffset(i);
 	// TRACE(_T("[%d] GetOutput %d %05x (%d)\n"), (int)m_perfmon.GetFrame(), i, (int)TEX0.TBP0, (int)TEX0.PSM);
@@ -193,9 +167,7 @@ GSTexture* GSRendererHW::GetOutput(int i, float& scale, int& y_offset)
 	TEX0.TBW = curFramebuffer.FBW;
 	TEX0.PSM = curFramebuffer.PSM;
 
-	GSTextureCache::Target* rt = g_texture_cache->LookupDisplayTarget(TEX0, framebufferSize, GetTextureScaleFactor(), false);
-	trace_output(rt ? "target-hit" : "target-miss", TEX0.TBP0);
-	if (rt)
+	if (GSTextureCache::Target* rt = g_texture_cache->LookupDisplayTarget(TEX0, framebufferSize, GetTextureScaleFactor(), false))
 	{
 		const u32 bp_adj = (TEX0.TBP0 < rt->m_TEX0.TBP0 && rt->UnwrappedEndBlock() > GS_MAX_BLOCKS) ? (TEX0.TBP0 + GS_MAX_BLOCKS) : TEX0.TBP0;
 		rt->Update();
@@ -2841,66 +2813,6 @@ void GSRendererHW::Draw()
 	m_cached_ctx.TEST = context->TEST;
 	m_cached_ctx.FRAME = context->FRAME;
 	m_cached_ctx.ZBUF = context->ZBUF;
-    // Bounded opt-in geometry evidence for tiled UI upscaling artifacts.
-    static const char* traceDraws = std::getenv("TARZAN_TRACE_UI_DRAWS_AFTER");
-    if (traceDraws)
-    {
-        static const auto firstDraw = std::chrono::steady_clock::now();
-        static unsigned traced = 0;
-        const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - firstDraw).count();
-        if (traced < 128 && elapsed >= std::strtod(traceDraws, nullptr))
-        {
-            ++traced;
-            std::fprintf(stderr, "[tarzan-ui-draw] n=%u ms=%.1f prim=%u fst=%u tme=%u linear=%u verts=%u tex=%x size=%ux%u frame=%x offset=%u,%u clamp=%u,%u\n",
-                traced, elapsed*1000, unsigned(PRIM->PRIM), unsigned(PRIM->FST), unsigned(PRIM->TME),
-                m_vt.IsLinear() ? 1u : 0u, unsigned(vtx_buff.next), unsigned(context->TEX0.TBP0),
-                1u << context->TEX0.TW, 1u << context->TEX0.TH, unsigned(context->FRAME.FBP),
-                unsigned(context->XYOFFSET.OFX), unsigned(context->XYOFFSET.OFY), unsigned(context->CLAMP.WMS), unsigned(context->CLAMP.WMT));
-            for (u32 v = 0; v < std::min<u32>(vtx_buff.next, 6u); ++v)
-            {
-                const GSVertex& vert = vtx_buff.buff[v];
-                std::fprintf(stderr, "[tarzan-ui-vertex] n=%u v=%u xy=%d,%d uv=%u,%u stq=%.8g,%.8g,%.8g rgba=%08x\n", traced, unsigned(v),
-                    int(vert.XYZ.X)-int(context->XYOFFSET.OFX), int(vert.XYZ.Y)-int(context->XYOFFSET.OFY),
-                    unsigned(vert.U), unsigned(vert.V), double(vert.ST.S), double(vert.ST.T), double(vert.RGBAQ.Q), unsigned(vert.RGBAQ.U64 & 0xffffffffu));
-            }
-        }
-    }
-
-
-    // Tarzan UI tile strips need native half-pixel coverage when upscaled.
-    // The title draws these as ST triangle strips, so sprite UV fixes do not apply.
-    static const bool coverUI = [] {
-        const char* value = std::getenv("TARZAN_UPSCALE_UI_COVERAGE");
-        return value && value[0] == '1' && value[1] == 0;
-    }();
-    if (coverUI && GetTextureScaleFactor() > 1.0f && PRIM->PRIM == GS_TRIANGLESTRIP &&
-        PRIM->TME && !PRIM->FST && vtx_buff.next == 4 && context->CLAMP.WMS == 1 && context->CLAMP.WMT == 1 &&
-        context->TEX0.TW == 8 && context->TEX0.TH >= 5)
-    {
-        GSVertex* v = vtx_buff.buff;
-        bool fullRect = v[0].XYZ.X == v[2].XYZ.X && v[1].XYZ.X == v[3].XYZ.X &&
-            v[0].XYZ.Y == v[1].XYZ.Y && v[2].XYZ.Y == v[3].XYZ.Y;
-        for (unsigned i = 0; i < 4; ++i)
-            fullRect = fullRect && v[i].RGBAQ.Q == 1.0f &&
-                (v[i].RGBAQ.U64 & 0xffffffffu) == (v[0].RGBAQ.U64 & 0xffffffffu) &&
-                v[i].XYZ.Z == v[0].XYZ.Z &&
-                (v[i].ST.S == 0.0f || v[i].ST.S == 1.0f) && (v[i].ST.T == 0.0f || v[i].ST.T == 1.0f);
-        if (fullRect)
-        {
-            const u32 maxX = std::max(v[0].XYZ.X, v[1].XYZ.X);
-            const u32 maxY = std::max(v[0].XYZ.Y, v[2].XYZ.Y);
-            if (maxX <= 65527u && maxY <= 65527u)
-            {
-                for (unsigned i = 0; i < 4; ++i)
-                {
-                    if (v[i].XYZ.X == maxX) v[i].XYZ.X += 8;
-                    if (v[i].XYZ.Y == maxY) v[i].XYZ.Y += 8;
-                }
-                m_vt.m_max.p.x += 0.5f;
-                m_vt.m_max.p.y += 0.5f;
-            }
-        }
-    }
 
 	if (IsBadFrame())
 	{
