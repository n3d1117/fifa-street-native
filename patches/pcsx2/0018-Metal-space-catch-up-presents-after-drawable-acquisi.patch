From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Sun, 25 Oct 2026 08:58:26 +0100
Subject: [PATCH 18/18] Metal: space catch-up presents after drawable
 acquisition completes

The flood guard recorded time before nextDrawable, crediting a blocked drawable-pool wait as spacing for the next catch-up field. On Apple TV this repeated a 16.6 ms drawable wait per field and starved EE guest execution through the previous-VSync fence. Record successful acquisition completion instead; the next catch-up field can skip host presentation while GS state and Merge still run. Keep the existing 8 ms threshold and MIN_US=0 kill switch. The disabled control froze during the intro; the enabled 3x/8 NTSC route sustained over 100 seconds of live play at 56.37 fps, 27.79% late frames, 464 underrun frames and zero pipeline compiles. macOS retained 60.0 NTSC / 50.0 PAL and zero underruns; the iPhone route remained live.

diff --git a/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm b/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
index e1ad1ec23d06097bcb186f4855774719bced5b82..a5c9443954b543a8403bb752dffe05e658ee592a 100644
--- a/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
+++ b/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
@@ -1955,19 +1955,24 @@ static void RrvTestPresentStall()
 // minimum interval cannot be shown separately, so they are skipped like
 // PCSX2's own ShouldSkipPresentingFrame skips frames when vsync is on; guest
 // GS state and Merge() are unaffected. RRV_PCSX2_GS_PRESENT_MIN_US=0 disables.
+static double& RrvLastDrawableAcquiredTime()
+{
+	static double last = 0.0;
+	return last;
+}
+
 static bool RrvShouldSkipFloodedPresent()
 {
 	static const double min_interval = [] {
 		const char* v = std::getenv("RRV_PCSX2_GS_PRESENT_MIN_US");
 		return (v && v[0] ? std::strtod(v, nullptr) : 8000.0) * 1e-6;
 	}();
-	static double last = 0.0;
 	if (min_interval <= 0.0)
 		return false;
 	const double now = CACurrentMediaTime();
+	const double last = RrvLastDrawableAcquiredTime();
 	if (last != 0.0 && now - last < min_interval)
 		return true;
-	last = now;
 	return false;
 }
 
@@ -1987,6 +1992,9 @@ static bool RrvShouldSkipFloodedPresent()
 		const bool perf = g_rrv_perf_callback.load(std::memory_order_relaxed) != nullptr;
 		const auto started = perf ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
 		m_current_drawable = MRCRetain([m_layer nextDrawable]);
+		// A drawable-pool wait must not count as spacing for the next catch-up present.
+		if (m_current_drawable)
+			RrvLastDrawableAcquiredTime() = CACurrentMediaTime();
 		if (perf)
 		{
 			if (!m_perf_frame)
