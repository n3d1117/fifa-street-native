From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Thu, 22 Oct 2026 16:26:16 +0200
Subject: [PATCH 14/15] GS: mirror wrapped GS memory with vm_remap on iOS/tvOS

The iOS sandbox denies shm_open, so GSLocalMemory aborted at startup on device
(iPhone 11, iOS 27.0.1 crash: pxOnAssertFail in GSLocalMemory::GSLocalMemory).
The simulator runs as a macOS process and did not reproduce it.

diff --git a/pcsx2/GS/GS.cpp b/pcsx2/GS/GS.cpp
index cbebc7ebea68e05ac18d9b8796e282ca6cf6d26e..10d2838c676d577d8795c1fdaa46cca39016da85 100644
--- a/pcsx2/GS/GS.cpp
+++ b/pcsx2/GS/GS.cpp
@@ -1,6 +1,9 @@
 // SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
 // SPDX-License-Identifier: GPL-3.0+
 
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
 #include "Config.h"
 #include "Counters.h"
 #include "ImGui/FullscreenUI.h"
@@ -1138,6 +1141,42 @@ void GSFreeWrappedMemory(void* ptr, size_t size, size_t repeat)
 	s_fh = NULL;
 }
 
+#elif defined(__APPLE__) && TARGET_OS_IPHONE
+
+#include <mach/mach.h>
+
+// The iOS/tvOS sandbox denies shm_open; mirror the first view with vm_remap instead.
+void* GSAllocateWrappedMemory(size_t size, size_t repeat)
+{
+	vm_address_t base = 0;
+	if (vm_allocate(mach_task_self(), &base, size * repeat, VM_FLAGS_ANYWHERE) != KERN_SUCCESS)
+	{
+		fprintf(stderr, "Failed to reserve %zu bytes of GS memory\n", size * repeat);
+		return nullptr;
+	}
+
+	for (size_t i = 1; i < repeat; i++)
+	{
+		vm_address_t target = base + size * i;
+		vm_prot_t cur, max;
+		if (vm_remap(mach_task_self(), &target, size, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, mach_task_self(),
+				base, FALSE, &cur, &max, VM_INHERIT_DEFAULT) != KERN_SUCCESS ||
+			target != base + size * i)
+		{
+			fprintf(stderr, "Failed to mirror GS memory segment %zu\n", i);
+			vm_deallocate(mach_task_self(), base, size * repeat);
+			return nullptr;
+		}
+	}
+
+	return reinterpret_cast<void*>(base);
+}
+
+void GSFreeWrappedMemory(void* ptr, size_t size, size_t repeat)
+{
+	vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(ptr), size * repeat);
+}
+
 #else
 
 #include <sys/mman.h>
