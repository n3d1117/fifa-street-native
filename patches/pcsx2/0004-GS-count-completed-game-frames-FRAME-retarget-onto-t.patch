From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Tue, 20 Oct 2026 22:30:26 +0200
Subject: [PATCH 04/15] GS: count completed game frames (FRAME retarget onto
 the displayed buffer) and log game_fps


diff --git a/pcsx2/GS/GSState.cpp b/pcsx2/GS/GSState.cpp
index ae280edc595d2d82e02d0048a71e2e6cd20e2bf1..a5d275a122bfaacd0144678d92b1e45412ea3796 100644
--- a/pcsx2/GS/GSState.cpp
+++ b/pcsx2/GS/GSState.cpp
@@ -2177,6 +2177,12 @@ void GSState::GIFRegHandlerFRAME(const GIFReg* RESTRICT r)
 	else
 		m_env.CTXT[i].ZBUF.PSM |= 0x30;
 
+	// FIFA Street never changes DISPFB and draws every game frame once into the displayed
+	// buffer after rendering elsewhere, so each retarget onto it marks one completed frame.
+	if (m_regs && ((m_env.CTXT[i].FRAME.U32[0] ^ NewFrame.U32[0]) & 0x1ff) &&
+		(NewFrame.FBP == m_regs->DISP[0].DISPFB.FBP || NewFrame.FBP == m_regs->DISP[1].DISPFB.FBP))
+		m_game_frames++;
+
 	if ((m_env.CTXT[i].FRAME.U32[0] ^ NewFrame.U32[0]) & 0x3f3f01ff) // FBP FBW PSM
 	{
 		m_env.CTXT[i].offset.fb = m_mem.GetOffset(NewFrame.Block(), NewFrame.FBW, NewFrame.PSM);
diff --git a/pcsx2/GS/GSState.h b/pcsx2/GS/GSState.h
index 909beeedc91025f676f4e9153e2a4a6898f7580a..24c6284696f5b59a499408077c399b81a7961b7b 100644
--- a/pcsx2/GS/GSState.h
+++ b/pcsx2/GS/GSState.h
@@ -285,6 +285,7 @@ public:
 	GIFPath m_path[4] = {};
 	const GIFRegPRIM* PRIM = nullptr;
 	GSPrivRegSet* m_regs = nullptr;
+	u64 m_game_frames = 0; // FRAME writes that retarget a context onto the displayed buffer
 	GSLocalMemory m_mem;
 	GSDrawingEnvironment m_env = {};
 	GSDrawingEnvironment m_prev_env = {};
diff --git a/pcsx2/GS/Renderers/Common/GSRenderer.cpp b/pcsx2/GS/Renderers/Common/GSRenderer.cpp
index b5c7cc6554c823e518b566dfe22574cd20d31739..2bb6edab21b463044b0b6abea419cc9016d01fc4 100644
--- a/pcsx2/GS/Renderers/Common/GSRenderer.cpp
+++ b/pcsx2/GS/Renderers/Common/GSRenderer.cpp
@@ -4,6 +4,8 @@
 #include "ImGui/FullscreenUI.h"
 #include "ImGui/ImGuiManager.h"
 #include "GS/Renderers/Common/GSRenderer.h"
+#include <chrono>
+#include <cstdio>
 #include "GS/GSCapture.h"
 #include "GS/GSDump.h"
 #include "GS/GSGL.h"
@@ -580,6 +582,20 @@ void GSRenderer::EndPresentFrame()
 
 void GSRenderer::VSync(u32 field, bool registers_written, bool idle_frame)
 {
+	{
+		static auto last_time = std::chrono::steady_clock::now();
+		static u64 last_frames = 0;
+		const auto now = std::chrono::steady_clock::now();
+		const double elapsed = std::chrono::duration<double>(now - last_time).count();
+		if (elapsed >= 5.0)
+		{
+			std::fprintf(stderr, "[gs-game] frames=%llu over=%.1fs game_fps=%.2f\n",
+				static_cast<unsigned long long>(m_game_frames - last_frames), elapsed, (m_game_frames - last_frames) / elapsed);
+			last_time = now;
+			last_frames = m_game_frames;
+		}
+	}
+
 	if (GSConfig.ShouldDump(s_n, g_perfmon.GetFrame()))
 	{
 		if (GSConfig.SaveInfo)
