 	const auto extras = fullsel.extras;
@@ -2485,12 +2493,14 @@ static MTLBlendOperation ConvertBlendOp(GSDevice::BlendOp generic)
 	id<MTLFunction> vs = m_hw_vs[vssel_mtl.key];
 
