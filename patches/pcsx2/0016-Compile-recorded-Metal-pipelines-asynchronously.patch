@@ -2559,6 +2569,7 @@ static MTLBlendOperation ConvertBlendOp(GSDevice::BlendOp generic)
 		ps = newps;
 		m_hw_ps.insert(std::make_pair(pssel, std::move(newps)));
 	}
+	}
 
 	MRCOwned<MTLRenderPipelineDescriptor*> pdesc = MRCTransfer([MTLRenderPipelineDescriptor new]);
 	if (vssel_mtl.point_size)
@@ -2601,19 +2612,28 @@ static MTLBlendOperation ConvertBlendOp(GSDevice::BlendOp generic)
 		[color setWriteMask:MTLColorWriteMaskNone];
 	}
 	NSString* pname = [NSString stringWithFormat:@"HW Render %x.%llx.%llx.%x", vssel_mtl.key, pssel.key_hi, pssel.key_lo, extras.fullkey];
+	const auto runtime_compile_start = record_runtime ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
 	auto pipeline = MakePipeline(pdesc, vs, ps, pname);
 
+	id<MTLRenderPipelineState> result;
+	{
+		std::lock_guard<std::mutex> pipeline_guard(m_hw_pipeline_mutex);
+		auto it = m_hw_pipeline.emplace(fullsel, std::move(pipeline)).first;
