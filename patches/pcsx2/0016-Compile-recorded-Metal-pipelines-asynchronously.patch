-	auto idx2 = m_hw_ps.find(pssel);
-	if (idx2 != m_hw_ps.end())
 	{
-		ps = idx2->second;
-	}
-	else
+		std::lock_guard<std::mutex> ps_guard(m_hw_ps_mutex);
+		auto idx2 = m_hw_ps.find(pssel);
+		if (idx2 != m_hw_ps.end())
+		{
+			ps = idx2->second;
+		}
