From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Fri, 30 Oct 2026 11:15:33 +0100
Subject: [PATCH 20/20] gs: expose host-owned drawable presentation
 registration

Register display-timestamp callbacks from the executable so pending blocks do not depend on GS dylib lifetime. Keep the hook optional and independent of guest timing and existing GPU completion telemetry.

diff --git a/pcsx2/GS/GSPerfMon.cpp b/pcsx2/GS/GSPerfMon.cpp
index 7dc742b6f64aa190bcbaf350be0f6b17f3575ba7..2ab1c8c8f98a7604225f46f716e36ef9b0b016f0 100644
--- a/pcsx2/GS/GSPerfMon.cpp
+++ b/pcsx2/GS/GSPerfMon.cpp
@@ -12,6 +12,7 @@ GSPerfMon g_perfmon;
 std::atomic<RrvGsPerfCallback> g_rrv_perf_callback{nullptr};
 std::atomic<void*> g_rrv_perf_context{nullptr};
 uint64_t g_rrv_perf_field = 0;
+std::atomic<RrvGsPresentedRegister> g_rrv_presented_register{nullptr};
 
 GSPerfMon::GSPerfMon() = default;
 
diff --git a/pcsx2/GS/RRVPerf.h b/pcsx2/GS/RRVPerf.h
index 72b41399a225b865b3f6042c251a8843270cf0a3..26fa27283fe7ca6e25539fafda310646574260cb 100644
--- a/pcsx2/GS/RRVPerf.h
+++ b/pcsx2/GS/RRVPerf.h
@@ -15,3 +15,6 @@ using RrvGsPerfCallback = void (*)(const RrvGsPerfFrame*, void*);
 extern std::atomic<RrvGsPerfCallback> g_rrv_perf_callback;
 extern std::atomic<void*> g_rrv_perf_context;
 extern uint64_t g_rrv_perf_field;
+// Synchronous registration only: the host owns the eventual Metal callback.
+using RrvGsPresentedRegister = void (*)(void* drawable, uint64_t field);
+extern std::atomic<RrvGsPresentedRegister> g_rrv_presented_register;
diff --git a/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm b/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
index b1750a50317f6551ab21049ae79608f6d2026cdf..987d2a925f2fa3dd44393ebdb499e43ecc8cd191 100644
--- a/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
+++ b/pcsx2/GS/Renderers/Metal/GSDeviceMTL.mm
@@ -2051,6 +2051,11 @@ static bool RrvShouldSkipFloodedPresent()
 				}
 			}];
 		}
+		if (direct_present && g_rrv_perf_callback.load(std::memory_order_relaxed))
+		{
+			if (const auto record = g_rrv_presented_register.load(std::memory_order_acquire))
+				record((__bridge void*)m_current_drawable.Get(), g_rrv_perf_field);
+		}
 		const bool use_present_drawable = m_use_present_drawable == UsePresentDrawable::Always ||
 			(m_use_present_drawable == UsePresentDrawable::IfVsync && m_vsync_mode == GSVSyncMode::FIFO);
 
