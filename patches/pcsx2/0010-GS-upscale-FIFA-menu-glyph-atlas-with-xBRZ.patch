From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ned <github@edoardo.fyi>
Date: Thu, 22 Oct 2026 02:29:22 +0200
Subject: [PATCH 10/10] GS: upscale FIFA menu glyph atlas with xBRZ


diff --git a/pcsx2/GS/Renderers/HW/GSTextureCache.cpp b/pcsx2/GS/Renderers/HW/GSTextureCache.cpp
index 65ae7a6e00d34a0f766d3a90c1a66daf4fc7e842..01fdb3415be7b5940eea5037df0afb2e4ec94b2f 100644
--- a/pcsx2/GS/Renderers/HW/GSTextureCache.cpp
+++ b/pcsx2/GS/Renderers/HW/GSTextureCache.cpp
@@ -7115,8 +7115,13 @@ GSTextureCache::HashCacheEntry* GSTextureCache::LookupHashCache(const GIFRegTEX0
 		return value && value[0] == '1' && !value[1];
 	}();
 	const float render_scale = (sprite_draw && ui_upscale_enabled) ? g_gs_renderer->GetTextureScaleFactor() : 1.0f;
+	// FIFA's language and menu glyphs use a 256x32 PSMT4 atlas. Keep this
+	// measured font shape separate from the existing small-sprite rule so that
+	// the wider palette does not pull in unrelated flags or HUD textures.
+	const bool fifa_font_atlas = TEX0.PSM == PSMT4 && TEX0.TW == 8 && TEX0.TH == 5;
+	const bool small_ui_texture = TEX0.TW <= 6 && TEX0.TH <= 6;
 	const bool upscale = sprite_draw && ui_upscale_enabled && render_scale >= 2.0f &&
-	                     GSLocalMemory::m_psm[TEX0.PSM].pal > 0 && TEX0.TW <= 6 && TEX0.TH <= 6 &&
+	                     GSLocalMemory::m_psm[TEX0.PSM].pal > 0 && (small_ui_texture || fifa_font_atlas) &&
 	                     (!lod || (lod->x == 0 && lod->y == 0));
 	if (!dump && !replace && !can_cache && !upscale)
 		return nullptr;
@@ -7223,7 +7228,7 @@ GSTextureCache::HashCacheEntry* GSTextureCache::LookupHashCache(const GIFRegTEX0
 		can_cache = true;
 	}
 
-	// xBRZ only touches small direct or palette-expanded sprites. Keep it out of
+	// xBRZ only touches the selected palette-expanded sprites. Keep it out of
 	// the normal path unless the host explicitly enables the option.
 	if (upscale)
 	{
