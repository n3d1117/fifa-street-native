# Cross toolchain for the Apple embedded platforms used by the native bridge.
# Select one with RX_APPLE_PLATFORM (iphonesimulator, iphoneos, appletvos,
# appletvsimulator). Xcode 12.5.1 supplies the 14.5 SDKs and Darwin tools.
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." RX_ROOT)
if(NOT RX_LLVM)
    if(DEFINED ENV{RX_LLVM} AND NOT "$ENV{RX_LLVM}" STREQUAL "")
        set(RX_LLVM "$ENV{RX_LLVM}")
    else()
        set(RX_LLVM "${RX_ROOT}/tools/build/llvm19")
    endif()
endif()
set(RX_LLVM "${RX_LLVM}" CACHE PATH "LLVM 19 install prefix")

if(NOT DEFINED ENV{DEVELOPER_DIR})
    message(FATAL_ERROR "Set DEVELOPER_DIR to Xcode-12.5.1 before configuring")
endif()
set(RX_APPLE_PLATFORM "${RX_APPLE_PLATFORM}" CACHE STRING "Apple embedded platform")
if(NOT RX_APPLE_PLATFORM MATCHES "^(iphonesimulator|iphoneos|appletvos|appletvsimulator)$")
    message(FATAL_ERROR "Set RX_APPLE_PLATFORM to iphonesimulator, iphoneos, appletvos, or appletvsimulator")
endif()

set(_rx_sdk_names
    iphonesimulator iphonesimulator14.5
    iphoneos iphoneos14.5
    appletvos appletvos14.5
    appletvsimulator appletvsimulator14.5)
set(_rx_target_iphonesimulator "arm64-apple-ios14.0-simulator")
set(_rx_target_iphoneos "arm64-apple-ios14.0")
set(_rx_target_appletvos "arm64-apple-tvos14.0")
set(_rx_target_appletvsimulator "arm64-apple-tvos14.0-simulator")
set(_rx_system_iphonesimulator iOS)
set(_rx_system_iphoneos iOS)
set(_rx_system_appletvos tvOS)
set(_rx_system_appletvsimulator tvOS)

set(_rx_sdk_index 0)
foreach(_rx_name IN LISTS _rx_sdk_names)
    math(EXPR _rx_sdk_index "${_rx_sdk_index}+1")
    if(_rx_name STREQUAL RX_APPLE_PLATFORM)
        list(GET _rx_sdk_names ${_rx_sdk_index} _rx_sdk_versioned)
        break()
    endif()
endforeach()
execute_process(COMMAND xcrun --sdk "${_rx_sdk_versioned}" --show-sdk-path
    OUTPUT_VARIABLE CMAKE_OSX_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _rx_sdk_result)
if(NOT _rx_sdk_result EQUAL 0 OR NOT EXISTS "${CMAKE_OSX_SYSROOT}/usr/include")
    message(FATAL_ERROR "Could not locate ${_rx_sdk_versioned} from Xcode 12.5.1")
endif()

if(RX_BUILDING_LIBCXX)
    set(CMAKE_SYSTEM_NAME Darwin)
else()
    set(CMAKE_SYSTEM_NAME "${_rx_system_${RX_APPLE_PLATFORM}}")
endif()
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
if(RX_BUILDING_LIBCXX)
    set(CMAKE_OSX_DEPLOYMENT_TARGET "")
else()
    set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0)
endif()
set(CMAKE_OSX_SYSROOT "${CMAKE_OSX_SYSROOT}" CACHE PATH "Embedded SDK")
set(CMAKE_FIND_ROOT_PATH "${RX_ROOT}/tools/embedded/${RX_APPLE_PLATFORM}/prefix" "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_rx_target "${_rx_target_${RX_APPLE_PLATFORM}}")
set(_rx_cpu "")
if(RX_APPLE_PLATFORM STREQUAL "iphoneos" OR RX_APPLE_PLATFORM STREQUAL "appletvos")
    set(_rx_cpu " -mcpu=apple-a12")
endif()

set(CMAKE_C_COMPILER "${RX_LLVM}/bin/clang")
set(CMAKE_CXX_COMPILER "${RX_LLVM}/bin/clang++")
set(CMAKE_OBJC_COMPILER "${RX_LLVM}/bin/clang")
set(CMAKE_OBJCXX_COMPILER "${RX_LLVM}/bin/clang++")
set(_rx_pch_timestamp_flag "")
find_program(RX_CCACHE ccache HINTS "${RX_ROOT}/tools/build/ccache")
if(CMAKE_BINARY_DIR MATCHES "/CMakeFiles/CMakeScratch/TryCompile-")
    # These throwaway compiler feature checks have unique source paths and
    # cannot reuse entries across configure runs.
    set(RX_CMAKE_TRY_COMPILE ON)
endif()
if(RX_CCACHE AND NOT RX_CMAKE_TRY_COMPILE)
    set(_rx_pch_timestamp_flag " -Xclang -fno-pch-timestamp")
    file(MAKE_DIRECTORY "${RX_ROOT}/build/embedded/${RX_APPLE_PLATFORM}/ccache")
    set(_rx_cache_launcher "${CMAKE_COMMAND}" -E env
        "CCACHE_DIR=${RX_ROOT}/build/embedded/${RX_APPLE_PLATFORM}/ccache"
        "CCACHE_CONFIGPATH=${RX_ROOT}/cmake/ccache-settings.txt"
        "CCACHE_MAXSIZE=2G"
        "${RX_CCACHE}")
    foreach(_lang IN ITEMS C CXX OBJC OBJCXX)
        set(CMAKE_${_lang}_COMPILER_LAUNCHER "${_rx_cache_launcher}")
    endforeach()
endif()
set(CMAKE_C_COMPILER_TARGET "${_rx_target}")
set(CMAKE_CXX_COMPILER_TARGET "${_rx_target}")
set(CMAKE_OBJC_COMPILER_TARGET "${_rx_target}")
set(CMAKE_OBJCXX_COMPILER_TARGET "${_rx_target}")
foreach(_tool AR RANLIB LD)
    string(TOLOWER "${_tool}" _tool_lower)
    execute_process(COMMAND xcrun --find "${_tool_lower}"
        OUTPUT_VARIABLE _rx_${_tool_lower} OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _rx_tool_result)
    if(NOT _rx_tool_result EQUAL 0)
        message(FATAL_ERROR "Xcode tool ${_tool} not found")
    endif()
endforeach()
set(CMAKE_AR "${_rx_ar}" CACHE FILEPATH "Xcode ar")
set(CMAKE_RANLIB "${_rx_ranlib}" CACHE FILEPATH "Xcode ranlib")
set(CMAKE_LINKER "${_rx_ld}" CACHE FILEPATH "Xcode ld")

set(_rx_runtime "${RX_ROOT}/tools/embedded/${RX_APPLE_PLATFORM}/libcxx")
if(NOT RX_BUILDING_LIBCXX)
    if(EXISTS "${_rx_runtime}/include/c++/v1")
        set(_rx_cxx_headers "${_rx_runtime}/include/c++/v1")
    else()
        set(_rx_cxx_headers "${RX_LLVM}/include/c++/v1")
    endif()
    set(_rx_libcxx "-nostdinc++ -isystem ${_rx_cxx_headers} -stdlib=libc++")
    set(_rx_link "-L${_rx_runtime}/lib -stdlib=libc++")
endif()
set(_rx_common "--target=${_rx_target}${_rx_cpu} -isysroot ${CMAKE_OSX_SYSROOT}")
set(_rx_prefix_map "-ffile-prefix-map=${RX_ROOT}=.")
set(CMAKE_C_FLAGS_INIT "${_rx_common} ${_rx_prefix_map}${_rx_pch_timestamp_flag}")
set(CMAKE_OBJC_FLAGS_INIT "${_rx_common} ${_rx_prefix_map}${_rx_pch_timestamp_flag}")
set(CMAKE_CXX_FLAGS_INIT "${_rx_common} ${_rx_libcxx} ${_rx_prefix_map}${_rx_pch_timestamp_flag}")
set(CMAKE_OBJCXX_FLAGS_INIT "${_rx_common} ${_rx_libcxx} ${_rx_prefix_map}${_rx_pch_timestamp_flag}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_rx_common} ${_rx_link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_rx_common} ${_rx_link}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_rx_common} ${_rx_link}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RX_APPLE_PLATFORM RX_LLVM)
set(CMAKE_SKIP_BUILD_RPATH ON)
