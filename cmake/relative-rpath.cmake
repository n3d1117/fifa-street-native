# Give every executable relative (@loader_path) rpaths so no absolute checkout
# path ends up in a binary. Call once after all targets are defined.
function(rx_collect_targets dir out)
    get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(_sub IN LISTS _subdirs)
        rx_collect_targets("${_sub}" _sub_targets)
        list(APPEND _targets ${_sub_targets})
    endforeach()
    set(${out} "${_targets}" PARENT_SCOPE)
endfunction()

function(rx_apply_relative_rpaths)
    # Resolve symlinks first (/tmp -> /private/tmp): relative paths computed
    # from a symlinked spelling point at the wrong directory at run time.
    file(REAL_PATH "${RX_ROOT}" _root)
    file(REAL_PATH "${RX_LLVM}/lib" _llvm_lib)
    set(_dirs "")
    set(_abs_dirs "")
    # An LLVM outside the checkout (e.g. Homebrew) gets an absolute rpath: no
    # relative path to it is stable, and the packaged app bundles its own libc++.
    string(FIND "${_llvm_lib}/" "${_root}/" _inside)
    if(_inside EQUAL 0)
        list(APPEND _dirs "${_llvm_lib}")
    else()
        list(APPEND _abs_dirs "${_llvm_lib}")
    endif()
    if(RX_GAME_READY)
        file(REAL_PATH "${RX_ROOT}/build/metal-bridge/pcsx2/pcsx2-gs-bridge" _bridge)
        list(APPEND _dirs "${_bridge}")
    endif()
    rx_collect_targets("${CMAKE_SOURCE_DIR}" _all)
    foreach(_t IN LISTS _all)
        get_target_property(_type ${_t} TYPE)
        if(NOT _type STREQUAL "EXECUTABLE")
            continue()
        endif()
        set_target_properties(${_t} PROPERTIES SKIP_BUILD_RPATH ON)
        foreach(_d IN LISTS _abs_dirs)
            target_link_options(${_t} PRIVATE "LINKER:-rpath,${_d}")
        endforeach()
        foreach(_d IN LISTS _dirs)
            target_link_options(${_t} PRIVATE
                "LINKER:-rpath,@loader_path/$<PATH:RELATIVE_PATH,${_d},$<TARGET_FILE_DIR:${_t}>>")
        endforeach()
    endforeach()
endfunction()
