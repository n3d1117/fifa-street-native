# Source-only BYOD repo: ignore everything, then allow the maintained layout.
/*
!/rx
!/deps.lock
!/CMakeLists.txt
!/CMakePresets.json
!/README.md
!/AGENTS.md
!/THIRD_PARTY.md
!/LICENSE
!/requirements.txt
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.githooks/
!/cmake/
!/config/
!/docs/
!/host/
!/patches/
!/tests/
!/toolchain/
!/tools/

/config/*
!/config/game.json
!/config/*.template.toml
/docs/*
!/docs/*.md
/patches/*/*
!/patches/*/*.patch

# tools/: scripts and our own subdirs only; toolchains, venv, dep builds, downloads stay out.
/tools/*
!/tools/*.py
!/tools/*.sh
!/tools/package/
!/tools/probe/
!/tools/metal-deps/
/tools/metal-deps/*
!/tools/metal-deps/compat/

# Never track game media, binaries, captures, logs or saves, anywhere.
/runtime/regression/saves/
*.iso
*.rvz
*.wbfs
*.elf
*.bin
*.rom
*.wav
*.png
*.jpg
*.jpeg
*.mov
*.mp4
*.mkv
*.dmp
*.crash
*.log
*.save
*.mcd
*.ps2
*.o
*.a
*.dylib
.DS_Store
