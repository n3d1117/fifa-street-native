# This checkout is a private, source-only BYOD repo. Keep everything out unless
# it is explicitly listed below; game inputs and generated outputs stay local.
/*
!/.gitignore
!/deps.lock
!/README.md
!/STATUS.md
!/LICENSE
!/THIRD_PARTY.md
!/integration/
!/scripts/
!/tests/
!/patches/
!/tools/

# Native host and bridge integration source, headers, and build descriptions.
/integration/*
/integration/**/*
!/integration/**/
!/integration/**/*.c
!/integration/**/*.cc
!/integration/**/*.cpp
!/integration/**/*.cxx
!/integration/**/*.h
!/integration/**/*.hh
!/integration/**/*.hpp
!/integration/**/*.mm
!/integration/**/*.m
!/integration/**/CMakeLists.txt
!/integration/**/*.cmake

# Reproducible helper scripts only.
/scripts/*
/scripts/**/*
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.sh
!/scripts/**/*.m

# Focused test code and readable text fixtures only.
/tests/*
/tests/**/*
!/tests/**/
!/tests/**/*.c
!/tests/**/*.cc
!/tests/**/*.cpp
!/tests/**/*.cxx
!/tests/**/*.h
!/tests/**/*.hh
!/tests/**/*.hpp
!/tests/**/*.mm
!/tests/**/*.m
!/tests/**/*.txt

# Pinned upstream list and our per-dependency format-patch stacks (deps/ stays ignored).
!/deps.lock
/patches/*
!/patches/*/
/patches/*/*
!/patches/*/*.patch

# Keep only the small, maintained VU1 recompilation utility in tools/.
/tools/*
!/tools/deps.py
!/tools/vu1recomp/
/tools/vu1recomp/*
!/tools/vu1recomp/*.py
!/tools/vu1recomp/LICENSE
!/tools/vu1recomp/README.md
!/tools/vu1recomp/test/
/tools/vu1recomp/test/**
!/tools/vu1recomp/test/**/
!/tools/vu1recomp/test/**/*.py
!/tools/vu1recomp/test/**/*.sh
!/tools/vu1recomp/test/**/*.c
!/tools/vu1recomp/test/**/*.cc
!/tools/vu1recomp/test/**/*.cpp
!/tools/vu1recomp/test/**/*.h
!/tools/vu1recomp/test/**/*.hpp
!/tools/vu1recomp/test/**/*.txt
!/tools/vu1recomp/test/**/README.md

# Never publish game media, extracted data, generated code/maps, captures,
# runtime state, build products, dependency caches, or local machine settings.
**/*.iso
**/*.rvz
**/*.wbfs
**/*.elf
**/*.bin
**/*.rom
**/*.wav
**/*.png
**/*.jpg
**/*.jpeg
**/*.mov
**/*.mp4
**/*.mkv
**/*.dmp
**/*.crash
**/*.log
**/*.save
**/*.mcd
**/*.ps2
**/.DS_Store
/build/
/dist/
/extracted/
/generated/
/runtime/
/reports/
/logs/
/mc0/
/mc1/
/source/
/deps/
/config/
/saves/
/captures/
/tmp/
/tools/metal-deps/
/tools/build/
/tools/python/
/tools/ffmpeg/
/tools/pkgconf/
/tools/*.[[]*].app/
*.swp
*.swo
*~

# Exact additional maintained sources; parent directories remain allowlisted.
!/AGENTS.md
!/config/
/config/*
!/config/SLES-50350.template.toml
!/tools/metal-deps/
/tools/metal-deps/*
!/tools/metal-deps/compat/
/tools/metal-deps/compat/*
!/tools/metal-deps/compat/*.c
!/docs/
/docs/*
!/docs/*.md
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
/.github/

!/.gitattributes
