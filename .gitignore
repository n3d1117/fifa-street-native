# This checkout is a private, source-only BYOD repo. Keep everything out unless
# it is explicitly listed below; game inputs and generated outputs stay local.
/*
!/.gitignore
!/deps.lock
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/host/
!/cmake/
!/CMakeLists.txt
!/CMakePresets.json
!/tests/
!/patches/
!/tools/
!/toolchain/
!/requirements.txt
!/tz

# Native host source, headers, and build descriptions; CMake modules.
/cmake/*
!/cmake/*.cmake
/host/*
/host/**/*
!/host/**/
!/host/**/*.c
!/host/**/*.cc
!/host/**/*.cpp
!/host/**/*.cxx
!/host/**/*.h
!/host/**/*.hh
!/host/**/*.hpp
!/host/**/*.mm
!/host/**/*.m
!/host/**/CMakeLists.txt
!/host/**/*.cmake

# Focused test code and readable text fixtures only.
/tests/*
/tests/**/*
!/tests/**/
!/tests/**/*.c
!/tests/**/*.cc
!/tests/**/*.cpp
!/tests/**/*.cxx
!/tests/**/*.h
!/tests/**/*.hh
!/tests/**/*.hpp
!/tests/**/*.mm
!/tests/**/*.m
!/tests/**/*.txt

# Pinned upstream list and our per-dependency format-patch stacks (deps/ stays ignored).
!/deps.lock
/patches/*
!/patches/*/
/patches/*/*
!/patches/*/*.patch

# Keep only the small, maintained VU1 recompilation utility in tools/.
/tools/*
!/tools/deps.py
!/tools/build-deps.sh
!/tools/prepare-metal-bridge.py
!/tools/disc.py
!/tools/generate.py
!/tools/where.py
!/tools/jobs.py
!/tools/check-repo-hygiene.py
!/tools/probe/
/tools/probe/*
!/tools/probe/*.py
!/tools/probe/*.m
!/tools/package/
/tools/package/*
!/tools/package/*.py
!/tools/package/*.m
!/tools/vu/
/tools/vu/*
!/tools/vu/*.py
!/tools/vu/LICENSE
!/tools/vu/README.md
!/tools/vu/test/
/tools/vu/test/**
!/tools/vu/test/**/
!/tools/vu/test/**/*.py
!/tools/vu/test/**/*.sh
!/tools/vu/test/**/*.c
!/tools/vu/test/**/*.cc
!/tools/vu/test/**/*.cpp
!/tools/vu/test/**/*.h
!/tools/vu/test/**/*.hpp
!/tools/vu/test/**/*.txt
!/tools/vu/test/**/README.md

# Never publish game media, extracted data, generated code/maps, captures,
# runtime state, build products, dependency caches, or local machine settings.
**/*.iso
**/*.rvz
**/*.wbfs
**/*.elf
**/*.bin
**/*.rom
**/*.wav
**/*.png
**/*.jpg
**/*.jpeg
**/*.mov
**/*.mp4
**/*.mkv
**/*.dmp
**/*.crash
**/*.log
**/*.save
**/*.mcd
**/*.ps2
**/.DS_Store
/build/
/dist/
/extracted/
/generated/
/runtime/
/reports/
/logs/
/mc0/
/mc1/
/source/
/deps/
/config/
/saves/
/captures/
/tmp/
/tools/metal-deps/
/tools/build/
/tools/python/
/tools/ffmpeg/
/tools/pkgconf/
/tools/*.[[]*].app/
*.swp
*.swo
*~

# Exact additional maintained sources; parent directories remain allowlisted.
!/AGENTS.md
!/config/
/config/*
!/config/SLES-50350.template.toml
!/tools/metal-deps/
/tools/metal-deps/*
!/tools/metal-deps/compat/
/tools/metal-deps/compat/*
!/tools/metal-deps/compat/*.c
!/docs/
/docs/*
!/docs/*.md
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
/.github/

!/.gitattributes
